msgstr "linkgit:git-diff[1]"

#. type: Plain text
#: ../Documentation-sedout/git-difftool.adoc:133
msgid "Show changes between commits, commit and working tree, etc"
msgstr "コミット、コミット、作業ツリー等の間の変更を表示する"

#. type: Labeled list
#: ../Documentation-sedout/git-difftool.adoc:134
#, no-wrap
msgid "linkgit:git-mergetool[1]"
msgstr "linkgit:git-mergetool[1]"

#. type: Plain text
#: ../Documentation-sedout/git-difftool.adoc:136
msgid "Run merge conflict resolution tools to resolve merge conflicts"
msgstr "マージ競合解決ツールを実行して、マージ競合を解決します"

#. type: Labeled list
#: ../Documentation-sedout/git-difftool.adoc:137
#, no-wrap
msgid "linkgit:git-config[1]"
msgstr "linkgit:git-config[1]"

#. type: Plain text
#: ../Documentation-sedout/git-difftool.adoc:139
msgid "Get and set repository or global options"
msgstr "リポジトリまたはグローバルオプションの取得と設定"

#. type: Title -
