#. type: Labeled list
#: ../Documentation-sedout/git-send-email.adoc:280
#, no-wrap
msgid "`--smtp-ssl-cert-path`"
msgstr "`--smtp-ssl-cert-path`"

#. type: Plain text
#: ../Documentation-sedout/git-send-email.adoc:292
#, fuzzy
#| msgid ""
#| "Path to a store of trusted CA certificates for SMTP SSL/TLS certificate "
#| "validation (either a directory that has been processed by 'c_rehash', or "
