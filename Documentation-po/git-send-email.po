#: ../Documentation-sedout/git-send-email.adoc:692
msgid ""
"https://github.com/AdityaGarg8/git-credential-email[git-protonmail] (cross "
"platform client that can send emails using the ProtonMail API)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-email.adoc:695
msgid ""
"https://github.com/AdityaGarg8/git-credential-email[git-msgraph] (cross "
