#: ../Documentation-sedout/git-clean.txt:136
#, no-wrap
msgid "help"
msgstr "help"

#. type: Plain text
#: ../Documentation-sedout/git-clean.txt:139
msgid "Show brief usage of interactive git-clean."
msgstr "git-cleanの対話的な簡単な使用法を示します。"

