#. type: Title =
#: ../Documentation-sedout/git-pull.adoc:2
#, no-wrap
msgid "git-pull(1)"
msgstr "git-pull(1)"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:7
msgid ""
"git-pull - Fetch from and integrate with another repository or a local branch"
msgstr "git-pull - 別のリポジトリまたはローカルブランチから取得して統合する"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:13
msgid "'git pull' [<options>] [<repository> [<refspec>...]]"
msgstr "'git pull' [<options>] [<repository> [<refspec>...]]"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:16
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:19
#, fuzzy
#| msgid "When false, merge the upstream branch into the current branch."
msgid "Integrate changes from a remote repository into the current branch."
msgstr "falseの場合、上流ブランチを現在のブランチにマージします。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:26
msgid ""
"First, `git pull` runs `git fetch` with the same arguments (excluding merge "
"options) to fetch remote branch(es).  Then it decides which remote branch to "
"integrate: if you run `git pull` with no arguments this defaults to the "
"<<UPSTREAM-BRANCHES,upstream>> for the current branch.  Then it integrates "
"that branch into the current branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:28
msgid "There are 4 main options for integrating the remote branch:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:32
msgid ""
"`git pull --ff-only` will only do \"fast-forward\" updates: it fails if your "
"local branch has diverged from the remote branch.  This is the default."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:33
msgid "`git pull --rebase` runs `git rebase`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:34
msgid "`git pull --no-rebase` runs `git merge`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:35
msgid "`git pull --squash` runs `git merge --squash`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:38
msgid ""
"You can also set the configuration options `pull.rebase`, `pull.squash`, or "
"`pull.ff` with your preferred behaviour."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:42
msgid ""
"If there's a merge conflict during the merge or rebase that you don't want "
"to handle, you can safely abort it with `git merge --abort` or `git --rebase "
"abort`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:44
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:46
#, no-wrap
msgid "<repository>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:50
msgid ""
"The \"remote\" repository to pull from.  This can be either a URL (see the "
"section <<URLS,GIT URLS>> below) or the name of a remote (see the section "
"<<REMOTES,REMOTES>> below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:54
msgid ""
"Defaults to the configured upstream for the current branch, or `origin`.  "
"See <<UPSTREAM-BRANCHES,UPSTREAM BRANCHES>> below for more on how to "
"configure upstreams."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:55
#, no-wrap
msgid "<refspec>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:59
msgid ""
"Which branch or other reference(s) to fetch and integrate into the current "
"branch, for example `main` in `git pull origin main`.  Defaults to the "
"configured upstream for the current branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:65
msgid ""
"This can be a branch, tag, or other collection of reference(s).  See <<fetch-"
"refspec,<refspec>>> below under \"Options related to fetching\" for the full "
"syntax, and <<DEFAULT-BEHAVIOUR,DEFAULT BEHAVIOUR>> below for how `git pull` "
"uses this argument to determine which remote branch to integrate."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:66
#, no-wrap
msgid "`-q`"
msgstr "`-q`"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:67
#, no-wrap
msgid "`--quiet`"
msgstr "`--quiet`"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:71
msgid ""
"This is passed to both underlying git-fetch to squelch reporting of during "
"transfer, and underlying git-merge to squelch output during merging."
msgstr ""
"このオプションは git-fetch では転送中のレポートを黙らせる為に、 そして git-"
"merge ではマージ中の出力を黙らせるために、 git-fetch と git-merge の両方に渡"
"されます。"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:72
#, no-wrap
msgid "`-v`"
msgstr "`-v`"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:73
#, no-wrap
msgid "`--verbose`"
msgstr "`--verbose`"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:75
msgid "Pass --verbose to git-fetch and git-merge."
msgstr "`--verbose` を git-fetch と git-merge に渡します。"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:76
#, fuzzy, no-wrap
#| msgid "`--[no-]recurse-submodules[=(yes|on-demand|no)]`"
msgid "`--recurse-submodules[=(yes|on-demand|no)]`"
msgstr "`--[no-]recurse-submodules[=(yes|on-demand|no)]`"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:77
#, fuzzy, no-wrap
#| msgid "`--[no-]recurse-submodules[=(yes|on-demand|no)]`"
msgid "`--no-recurse-submodules`"
msgstr "`--[no-]recurse-submodules[=(yes|on-demand|no)]`"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:82
msgid ""
"This option controls if new commits of populated submodules should be "
"fetched, and if the working trees of active submodules should be updated, "
"too (see linkgit:git-fetch[1], linkgit:git-config[1] and linkgit:"
"gitmodules[5])."
msgstr ""
"このオプションは、入力されたサブモジュールの新しいコミットを取得する必要があ"
"るかどうか、およびアクティブなサブモジュールの作業ツリーも更新する必要がある"
"かどうかを制御します(linkgit:git-fetch[1] 、linkgit:git-config[1] 、linkgit:"
"gitmodules[5] を参照)。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:84
msgid ""
"If the checkout is done via rebase, local submodule commits are rebased as "
"well."
msgstr ""
"チェックアウトがリベースを介して行われる場合、ローカルサブモジュールのコミッ"
"トもリベースされます。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:86
msgid ""
"If the update is done via merge, the submodule conflicts are resolved and "
"checked out."
msgstr ""
"更新がマージを介して行われる場合、サブモジュールの競合(conflicts)は解決され、"
"チェックアウトされます。"

#. type: Title ~
#: ../Documentation-sedout/git-pull.adoc:88
#, no-wrap
msgid "Options related to merging"
msgstr "Options related to merging"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:94
#, no-wrap
msgid "`-r`"
msgstr "`-r`"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:95
#, no-wrap
msgid "`--rebase[=(false|true|merges|interactive)]`"
msgstr "`--rebase[=(false|true|merges|interactive)]`"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:101
msgid ""
"When true, rebase the current branch on top of the upstream branch after "
"fetching. If there is a remote-tracking branch corresponding to the upstream "
"branch and the upstream branch was rebased since last fetched, the rebase "
"uses that information to avoid rebasing non-local changes."
msgstr ""
"trueの場合、 取得後に現在のブランチを上流ブランチの上にリベースします。 上流"
"ブランチに対応するリモート追跡ブランチがあり、上流ブランチが最後に取得されて"
"からリベースされた場合、リベースはその情報を使用して、非ローカル変更のリベー"
"スを回避します。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:105
msgid ""
"When set to `merges`, rebase using `git rebase --rebase-merges` so that the "
"local merge commits are included in the rebase (see linkgit:git-rebase[1] "
"for details)."
msgstr ""
"`merges` に設定すると、 `git rebase --rebase-merges` を使用してリベースし、"
"ローカルマージコミットがリベースに含まれるようにします(詳細については、 "
"linkgit:git-rebase[1] を参照してください)。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:107
msgid "When false, merge the upstream branch into the current branch."
msgstr "falseの場合、上流ブランチを現在のブランチにマージします。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:109
msgid "When `interactive`, enable the interactive mode of rebase."
msgstr "`interactive` の場合、リベースの対話モードを有効にします。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:113
msgid ""
"See `pull.rebase`, `branch.<name>.rebase` and `branch.autoSetupRebase` in "
"linkgit:git-config[1] if you want to make `git pull` always use `--rebase` "
"instead of merging."
msgstr ""
"`git pull` がマージする代わりに、常に `--rebase` を使用するようにしたいな"
"ら、 linkgit:git-config[1] の `pull.rebase` と `branch.<name>.rebase` と "
"`branch.autoSetupRebase` を参照してください。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:119
msgid ""
"This is a potentially _dangerous_ mode of operation.  It rewrites history, "
"which does not bode well when you published that history already.  Do *not* "
"use this option unless you have read linkgit:git-rebase[1] carefully."
msgstr ""
"これは潜在的に「危険」な操作モードです。 それは履歴を塗り替えてしまいます。そ"
"の履歴はすでに公開されているのですから、良くない兆候です。 linkgit:git-"
"rebase[1] を注意深く読んでいない限り、このオプションを使用しないでください。"

#. type: Labeled list
#: ../Documentation-sedout/git-pull.adoc:120
#, no-wrap
msgid "`--no-rebase`"
msgstr "`--no-rebase`"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:122
msgid "This is shorthand for --rebase=false."
msgstr "これは `--rebase=false` の省略形です。"

#. type: Title ~
#: ../Documentation-sedout/git-pull.adoc:124
#, no-wrap
msgid "Options related to fetching"
msgstr "Options related to fetching"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:136
#, no-wrap
msgid "DEFAULT BEHAVIOUR"
msgstr "DEFAULT BEHAVIOUR"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:143
msgid ""
"Often people use `git pull` without giving any parameter.  Traditionally, "
"this has been equivalent to saying `git pull origin`.  However, when "
"configuration `branch.<name>.remote` is present while on branch `<name>`, "
"that value is used instead of `origin`."
msgstr ""
"`git pull` は多くの場合パラメータを指定せずに使われます。伝統的にこれは `git "
"pull origin` と言うのと同じです。 ただし、ブランチ `<name>` に設定 `branch."
"<name>.remote` が存在する場合は、 `origin` の代わりにその値が使用されます。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:148
msgid ""
"In order to determine what URL to use to fetch from, the value of the "
"configuration `remote.<origin>.url` is consulted and if there is not any "
"such variable, the value on the `URL:` line in `$GIT_DIR/remotes/<origin>` "
"is used."
msgstr ""
"取得に使用するURLを決定するために、構成 `remote.<origin>.url` の値が参照さ"
"れ、そのような変数がない場合は、 `$GIT_DIR/remotes/<origin>` の `URL:` 行の値"
"が使用されます。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:157
msgid ""
"In order to determine what remote branches to fetch (and optionally store in "
"the remote-tracking branches) when the command is run without any refspec "
"parameters on the command line, values of the configuration variable `remote."
"<origin>.fetch` are consulted, and if there aren't any, `$GIT_DIR/remotes/"
"<origin>` is consulted and its `Pull:` lines are used.  In addition to the "
"refspec formats described in the OPTIONS section, you can have a globbing "
"refspec that looks like this:"
msgstr ""
"コマンドラインにrefspecパラメーターを指定せずにコマンドを実行したときに取得す"
"る(およびオプションでリモート追跡ブランチに格納する)リモートブランチを決定す"
"るには、構成変数 `remote.<origin>.fetch` の値を参照します。 構成変数 `remote."
"<origin>.fetch` が存在しない場合は、 `$GIT_DIR/remotes/<origin>` が参照され、"
"その `Pull:` 行が使用されます。 「OPTIONS」セクションで説明されているrefspec"
"形式に加えて、以下のようなrefspecグロブを作成できます:"

#. type: delimited block -
#: ../Documentation-sedout/git-pull.adoc:160
#, no-wrap
msgid "refs/heads/*:refs/remotes/origin/*\n"
msgstr "refs/heads/*:refs/remotes/origin/*\n"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:167
msgid ""
"A globbing refspec must have a non-empty RHS (i.e. must store what were "
"fetched in remote-tracking branches), and its LHS and RHS must end with `/"
"*`.  The above specifies that all remote branches are tracked using remote-"
"tracking branches in `refs/remotes/origin/` hierarchy under the same name."
msgstr ""
"グロブの refspec には空でないRHSが必要であり(つまり、リモート追跡ブランチで取"
"得されたものを格納する必要があります)、そのLHSとRHSは `/*` で終わる必要があり"
"ます。 上記では、すべてのリモート・ブランチが、同じ名前の `refs/remotes/"
"origin/` 階層のリモート追跡ブランチを使用して追跡されることを指定しています。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:171
msgid ""
"The rule to determine which remote branch to merge after fetching is a bit "
"involved, in order not to break backward compatibility."
msgstr ""
"下位互換性を損なわないために、 取得後にマージするリモート・ブランチを決定する"
"ルールは少し複雑です。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:174
msgid ""
"If explicit refspecs were given on the command line of `git pull`, they are "
"all merged."
msgstr ""
"`git pull` のコマンドラインで明示的なrefspecが指定されている場合、それらはす"
"べてマージされます。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:179
msgid ""
"When no refspec was given on the command line, then `git pull` uses the "
"refspec from the configuration or `$GIT_DIR/remotes/<origin>`.  In such "
"cases, the following rules apply:"
msgstr ""
"コマンドラインでrefspecが指定されていない場合、 `git pull` は 構成 または "
"`$GIT_DIR/remotes/<origin>` からのrefspecを使用します。このような場合、以下の"
"ルールが適用されます:"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:183
msgid ""
"If `branch.<name>.merge` configuration for the current branch `<name>` "
"exists, that is the name of the branch at the remote site that is merged."
msgstr ""
"現在のブランチ `<name>` の `branch.<name>.merge` 構成が存在する場合、それは"
"マージされるリモートサイトのブランチの名前です。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:185
msgid "If the refspec is a globbing one, nothing is merged."
msgstr "refspecがグロブのものである場合、何もマージされません。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:187
msgid "Otherwise the remote branch of the first refspec is merged."
msgstr "それ以外の場合は、最初のrefspecのリモートブランチがマージされます。"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:190
#, no-wrap
msgid "EXAMPLES"
msgstr "EXAMPLES"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:195
msgid ""
"Update the remote-tracking branches for the repository you cloned from, then "
"merge one of them into your current branch:"
msgstr ""
"クローンを作成したリポジトリのリモート追跡ブランチを更新し、そのうちの1つを現"
"在のブランチにマージします:"

#. type: delimited block -
#: ../Documentation-sedout/git-pull.adoc:199
#, no-wrap
msgid ""
"$ git pull\n"
"$ git pull origin\n"
msgstr ""
"$ git pull\n"
"$ git pull origin\n"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:204
msgid ""
"Normally the branch merged in is the HEAD of the remote repository, but the "
"choice is determined by the branch.<name>.remote and branch.<name>.merge "
"options; see linkgit:git-config[1] for details."
msgstr ""
"通常、マージされるブランチはリモートリポジトリのHEADですが、選択は branch."
"<name>.remote および branch.<name>.merge オプションによって決定されます。 詳"
"細については、 linkgit:git-config[1] を参照してください。"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:206
msgid "Merge into the current branch the remote branch `next`:"
msgstr "現在のブランチにリモートブランチ `next` をマージします:"

#. type: delimited block -
#: ../Documentation-sedout/git-pull.adoc:209
#, no-wrap
msgid "$ git pull origin next\n"
msgstr "$ git pull origin next\n"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:214
msgid ""
"This leaves a copy of `next` temporarily in FETCH_HEAD, and updates the "
"remote-tracking branch `origin/next`.  The same can be done by invoking "
"fetch and merge:"
msgstr ""
"これにより、 `next` のコピーが一時的に FETCH_HEAD に残され、 リモート追跡ブラ"
"ンチの `origin/next` が更新されます。 fetch と merge を呼び出すことで同じこと"
"ができます:"

#. type: delimited block -
#: ../Documentation-sedout/git-pull.adoc:218
#, no-wrap
msgid ""
"$ git fetch origin\n"
"$ git merge origin/next\n"
msgstr ""
"$ git fetch origin\n"
"$ git merge origin/next\n"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:223
msgid ""
"If you tried a pull which resulted in complex conflicts and would want to "
"start over, you can recover with 'git reset'."
msgstr ""
"あなたがプルを試みた結果、複雑な競合が発生し、最初からやり直したい場合は、 "
"`git reset` で回復できます。"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:228
#, no-wrap
msgid "BUGS"
msgstr "BUGS"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:235
msgid ""
"Using --recurse-submodules can only fetch new commits in already checked out "
"submodules right now. When e.g. upstream added a new submodule in the just "
"fetched commits of the superproject the submodule itself cannot be fetched, "
"making it impossible to check out that submodule later without having to do "
"a fetch again. This is expected to be fixed in a future Git version."
msgstr ""
"現在は `--recurse-submodules` を使用すると、 既にチェックアウトされているサブ"
"モジュールでの新しいコミットのみを取得できます。 たとえば、 上流がスーパー・"
"プロジェクトの直前に取得したコミットで新しいサブモジュールを追加した場合、 そ"
"のサブモジュール自体を取得できないため、 後でそのサブモジュールをチェックアウ"
"トするには再度取得する必要があります。 この問題は、 将来の Git バージョンで修"
"正される予定です。"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:237
#, no-wrap
msgid "SEE ALSO"
msgstr "SEE ALSO"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:239
msgid "linkgit:git-fetch[1], linkgit:git-merge[1], linkgit:git-config[1]"
msgstr "linkgit:git-fetch[1], linkgit:git-merge[1], linkgit:git-config[1]"

#. type: Title -
#: ../Documentation-sedout/git-pull.adoc:241
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/git-pull.adoc:242
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"

#~ msgid ""
#~ "Incorporates changes from a remote repository into the current branch.  "
#~ "If the current branch is behind the remote, then by default it will fast-"
#~ "forward the current branch to match the remote.  If the current branch "
#~ "and the remote have diverged, the user needs to specify how to reconcile "
#~ "the divergent branches with `--rebase` or `--no-rebase` (or the "
#~ "corresponding configuration option in `pull.rebase`)."
#~ msgstr ""
#~ "リモート・リポジトリからの変更を現在のブランチに組み込みます。 現在のブラ"
#~ "ンチがリモートの後追いの場合、デフォルトでは、リモートに一致するように現在"
#~ "のブランチを早送り(fast-forward)します。 現在のブランチとリモートが分岐し"
#~ "ている場合、 ユーザーは `--rebase` または `--no-rebase` (または pull."
#~ "rebase の対応する構成オプション)を使用して、 分岐したブランチをどのように"
#~ "統合するかを指定する必要があります。"

#~ msgid ""
#~ "More precisely, `git pull` runs `git fetch` with the given parameters and "
#~ "then depending on configuration options or command line flags, will call "
#~ "either `git rebase` or `git merge` to reconcile diverging branches."
#~ msgstr ""
#~ "より正確には、 `git pull` は指定されたパラメーターで `git fetch` を実行"
#~ "し、 その後、 設定オプションまたはコマンドライン・フラグに応じて、 分岐し"
#~ "たブランチを統合するために `git rebase` または `git merge` を呼び出しま"
#~ "す。"

#~ msgid ""
#~ "<repository> should be the name of a remote repository as passed to "
#~ "linkgit:git-fetch[1].  <refspec> can name an arbitrary remote ref (for "
#~ "example, the name of a tag) or even a collection of refs with "
#~ "corresponding remote-tracking branches (e.g., refs/heads/{asterisk}:refs/"
#~ "remotes/origin/{asterisk}), but usually it is the name of a branch in the "
#~ "remote repository."
#~ msgstr ""
#~ "<repository> は、 linkgit:git-fetch[1] に渡されるリモートリポジトリの名前"
#~ "である必要があります。 <refspec> は任意のリモート ref (たとえば、タグの名"
#~ "前)を指定することも、 リモート追跡ブランチに対応する ref の集合(例: refs/"
#~ "heads/{asterisk}:refs/remotes/origin/{asterisk} )を指定することもできます"
#~ "が、 通常はリモート・リポジトリ内のブランチの名前です。"

#~ msgid ""
#~ "Default values for <repository> and <branch> are read from the \"remote\" "
#~ "and \"merge\" configuration for the current branch as set by linkgit:git-"
#~ "branch[1] `--track`."
#~ msgstr ""
#~ "<repository> と <branch> のデフォルト値は、 linkgit:git-branch[1] の `--"
#~ "track` によって設定された現在のブランチの \"remote\" や \"merge\" 構成から"
#~ "読み取られます。"

#~ msgid ""
#~ "Assume the following history exists and the current branch is "
#~ "\"`master`\":"
#~ msgstr "以下の履歴が存在し、 現在のブランチが `master` であるとします:"

#, no-wrap
#~ msgid ""
#~ "\t  A---B---C master on origin\n"
#~ "\t /\n"
#~ "    D---E---F---G master\n"
#~ "\t^\n"
#~ "\torigin/master in your repository\n"
#~ msgstr ""
#~ "\t  A---B---C master on origin\n"
#~ "\t /\n"
#~ "    D---E---F---G master\n"
#~ "\t^\n"
#~ "\torigin/master in your repository\n"

#~ msgid ""
#~ "Then \"`git pull`\" will fetch and replay the changes from the remote "
#~ "`master` branch since it diverged from the local `master` (i.e., `E`)  "
#~ "until its current commit (`C`) on top of `master` and record the result "
#~ "in a new commit along with the names of the two parent commits and a log "
#~ "message from the user describing the changes."
#~ msgstr ""
#~ "ここで、 `git pull`  を実行すると、 リモートの master ブランチがローカル"
#~ "の master (つまり、上記 E)から分岐した時点から現在のコミット \\(C) までの"
#~ "変更を取得し、 それらを master の上に再生(replay)し、 そして、 2つの親コ"
#~ "ミットの名前とユーザーが変更を説明するログメッセージとともに、 新しいコ"
#~ "ミットとして結果を記録します。"

#, no-wrap
#~ msgid ""
#~ "\t  A---B---C origin/master\n"
#~ "\t /         \\\n"
#~ "    D---E---F---G---H master\n"
#~ msgstr ""
#~ "\t  A---B---C origin/master\n"
#~ "\t /         \\\n"
#~ "    D---E---F---G---H master\n"

#~ msgid ""
#~ "See linkgit:git-merge[1] for details, including how conflicts are "
#~ "presented and handled."
#~ msgstr ""
#~ "競合(conflicts)の、 表示方法や処理方法などの詳細については、 linkgit:git-"
#~ "merge[1] を参照してください。"

#~ msgid ""
#~ "In Git 1.7.0 or later, to cancel a conflicting merge, use `git reset --"
#~ "merge`.  *Warning*: In older versions of Git, running 'git pull' with "
#~ "uncommitted changes is discouraged: while possible, it leaves you in a "
#~ "state that may be hard to back out of in the case of a conflict."
#~ msgstr ""
#~ "Git 1.7.0 以降では、競合するマージをキャンセルするには、 `git reset --"
#~ "merge` を使用します。 *警告* :古いバージョンのGitでは、コミットされていな"
#~ "い変更がある状態で `git pull` を実行することはお勧めしません。それは可能で"
#~ "はありますが、競合が発生した場合に元に戻すのが厳しい状態になることがありま"
#~ "す。"

#~ msgid ""
#~ "If any of the remote changes overlap with local uncommitted changes, the "
#~ "merge will be automatically canceled and the work tree untouched.  It is "
#~ "generally best to get any local changes in working order before pulling "
#~ "or stash them away with linkgit:git-stash[1]."
#~ msgstr ""
#~ "リモートの変更のいずれかがローカルの非コミット変更と重複する場合、 マージ"
#~ "は自動的にキャンセルされ、 作業ツリーは変更されません。 通常はプルする前に"
#~ "ローカルの変更を整理しておくか、 あるいは、 linkgit:git-stash[1] を使って"
#~ "一時的に退避させるのが最善です。"
