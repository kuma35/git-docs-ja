#: ../Documentation-sedout/gitprotocol-v2.adoc:878
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/gitprotocol-v2.adoc:879
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"
