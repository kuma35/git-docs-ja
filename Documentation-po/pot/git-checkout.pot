#. type: Title =
#: ../Documentation-sedout/git-checkout.adoc:2
#, no-wrap
msgid "git-checkout(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:7
msgid "git-checkout - Switch branches or restore working tree files"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:20
msgid ""
"git checkout [-q] [-f] [-m] [<branch>] git checkout [-q] [-f] [-m] --detach "
"[<branch>] git checkout [-q] [-f] [-m] [--detach] <commit> git checkout [-q] "
"[-f] [-m] [[-b|-B|--orphan] <new-branch>] [<start-point>] git checkout "
"<tree-ish> [--] <pathspec>...  git checkout <tree-ish> "
"--pathspec-from-file=<file> [--pathspec-file-nul] git checkout "
"[-f|--ours|--theirs|-m|--conflict=<style>] [--] <pathspec>...  git checkout "
"[-f|--ours|--theirs|-m|--conflict=<style>] --pathspec-from-file=<file> "
"[--pathspec-file-nul] git checkout (-p|--patch) [<tree-ish>] [--] "
"[<pathspec>...]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:22
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:25
msgid "`git checkout` has two main modes:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:27
#, no-wrap
msgid "**Switch branches**, with `git checkout <branch>`\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:29
#, no-wrap
msgid ""
"**Restore a different version of a file**, for example with\n"
"`git checkout <commit> <filename>` or `git checkout <filename>`\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:31
msgid "See ARGUMENT DISAMBIGUATION below for how Git decides which one to do."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:32
#, no-wrap
msgid "`git checkout [<branch>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:38
msgid ""
"Switch to _<branch>_. This sets the current branch to _<branch>_ and updates "
"the files in your working directory. The checkout will fail if there are "
"uncommitted changes to any files where _<branch>_ and your current commit "
"have different content. Uncommitted changes will otherwise be kept."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:42
msgid ""
"If _<branch>_ is not found but there does exist a tracking branch in exactly "
"one remote (call it _<remote>_) with a matching name and `--no-guess` is not "
"specified, treat as equivalent to"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:45
#: ../Documentation-sedout/git-checkout.adoc:188
#, no-wrap
msgid "$ git checkout -b <branch> --track <remote>/<branch>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:49
msgid ""
"Running `git checkout` without specifying a branch has no effect except to "
"print out the tracking information for the current branch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:50
#, no-wrap
msgid "`git checkout -b <new-branch> [<start-point>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:56
msgid ""
"Create a new branch named _<new-branch>_, start it at _<start-point>_ "
"(defaults to the current commit), and check out the new branch.  You can use "
"the `--track` or `--no-track` options to set the branch's upstream tracking "
"information."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:60
msgid ""
"This will fail if there's an error checking out _<new-branch>_, for example "
"if checking out the `<start-point>` commit would overwrite your uncommitted "
"changes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:61
#, no-wrap
msgid "`git checkout -B <branch> [<start-point>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:65
#: ../Documentation-sedout/git-checkout.adoc:159
msgid ""
"The same as `-b`, except that if the branch already exists it resets "
"_<branch>_ to the start point instead of failing."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:66
#, no-wrap
msgid "`git checkout --detach [<branch>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:67
#, no-wrap
msgid "`git checkout [--detach] <commit>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:72
msgid ""
"The same as `git checkout <branch>`, except that instead of pointing `HEAD` "
"at the branch, it points `HEAD` at the commit ID.  See the \"DETACHED HEAD\" "
"section below for more."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:74
msgid "Omitting _<branch>_ detaches `HEAD` at the tip of the current branch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:75
#, no-wrap
msgid "`git checkout <tree-ish> [--] <pathspec>...`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:76
#, no-wrap
msgid "`git checkout <tree-ish> --pathspec-from-file=<file> [--pathspec-file-nul]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:81
msgid ""
"Replace the specified files and/or directories with the version from the "
"given commit or tree and add them to the index (also known as \"staging "
"area\")."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:84
msgid ""
"For example, `git checkout main file.txt` will replace `file.txt` with the "
"version from `main`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:85
#, no-wrap
msgid "`git checkout [-f|--ours|--theirs|-m|--conflict=<style>] [--] <pathspec>...`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:86
#, no-wrap
msgid ""
"`git checkout [-f|--ours|--theirs|-m|--conflict=<style>] "
"--pathspec-from-file=<file> [--pathspec-file-nul]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:90
msgid ""
"Replace the specified files and/or directories with the version from the "
"index."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:94
msgid ""
"For example, if you check out a commit, edit `file.txt`, and then decide "
"those changes were a mistake, `git checkout file.txt` will discard any "
"unstaged changes to `file.txt`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:101
msgid ""
"This will fail if the file has a merge conflict and you haven't yet run `git "
"add file.txt` (or something equivalent) to mark it as resolved.  You can use "
"`-f` to ignore the unmerged files instead of failing, use `--ours` or "
"`--theirs` to replace them with the version from a specific side of the "
"merge, or use `-m` to replace them with the original conflicted merge "
"result."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:102
#, no-wrap
msgid "`git checkout (-p|--patch) [<tree-ish>] [--] [<pathspec>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:107
msgid ""
"This is similar to the previous two modes, but lets you use the interactive "
"interface to show the \"diff\" output and choose which hunks to use in the "
"result.  See below for the description of `--patch` option."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:109
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:110
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:111
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:113
msgid "Quiet, suppress feedback messages."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:114
#, no-wrap
msgid "`--progress`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:115
#, no-wrap
msgid "`--no-progress`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:120
msgid ""
"Progress status is reported on the standard error stream by default when it "
"is attached to a terminal, unless `--quiet` is specified. This flag enables "
"progress reporting even if not attached to a terminal, regardless of "
"`--quiet`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:121
#, no-wrap
msgid "`-f`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:122
#, no-wrap
msgid "`--force`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:127
msgid ""
"When switching branches, proceed even if the index or the working tree "
"differs from `HEAD`, and even if there are untracked files in the way.  This "
"is used to throw away local changes and any untracked files or directories "
"that are in the way."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:130
msgid ""
"When checking out paths from the index, do not fail upon unmerged entries; "
"instead, unmerged entries are ignored."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:131
#, no-wrap
msgid "`--ours`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:132
#, no-wrap
msgid "`--theirs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:135
msgid ""
"When checking out paths from the index, check out stage #2 (`ours`) or #3 "
"(`theirs`) for unmerged paths."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:140
msgid ""
"Note that during `git rebase` and `git pull --rebase`, `ours` and `theirs` "
"may appear swapped; `--ours` gives the version from the branch the changes "
"are rebased onto, while `--theirs` gives the version from the branch that "
"holds your work that is being rebased."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:150
msgid ""
"This is because `rebase` is used in a workflow that treats the history at "
"the remote as the shared canonical one, and treats the work done on the "
"branch you are rebasing as the third-party work to be integrated, and you "
"are temporarily assuming the role of the keeper of the canonical history "
"during the rebase.  As the keeper of the canonical history, you need to view "
"the history from the remote as `ours` (i.e. \"our shared canonical "
"history\"), while what you did on your side branch as `theirs` (i.e. \"one "
"contributor's work on top of it\")."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:151
#, no-wrap
msgid "`-b <new-branch>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:155
msgid ""
"Create a new branch named _<new-branch>_, start it at _<start-point>_, and "
"check the resulting branch out; see linkgit:git-branch[1] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:156
#, no-wrap
msgid "`-B <new-branch>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:160
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:161
#, no-wrap
msgid "`--track[=(direct|inherit)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:165
msgid ""
"When creating a new branch, set up \"upstream\" configuration. See `--track` "
"in linkgit:git-branch[1] for details. As a convenience, --track without -b "
"implies branch creation."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:175
msgid ""
"If no `-b` option is given, the name of the new branch will be derived from "
"the remote-tracking branch, by looking at the local part of the refspec "
"configured for the corresponding remote, and then stripping the initial part "
"up to the \"*\".  This would tell us to use `hack` as the local branch when "
"branching off of `origin/hack` (or `remotes/origin/hack`, or even "
"`refs/remotes/origin/hack`).  If the given name has no slash, or the above "
"guessing results in an empty name, the guessing is aborted.  You can "
"explicitly give a name with `-b` in such a case."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:176
#, no-wrap
msgid "`--no-track`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:179
msgid ""
"Do not set up \"upstream\" configuration, even if the "
"`branch.autoSetupMerge` configuration variable is true."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:180
#, no-wrap
msgid "`--guess`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:181
#, no-wrap
msgid "`--no-guess`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:185
msgid ""
"If _<branch>_ is not found but there does exist a tracking branch in exactly "
"one remote (call it _<remote>_) with a matching name, treat as equivalent to"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:198
msgid ""
"If the branch exists in multiple remotes and one of them is named by the "
"`checkout.defaultRemote` configuration variable, we'll use that one for the "
"purposes of disambiguation, even if the _<branch>_ isn't unique across all "
"remotes. Set it to e.g. `checkout.defaultRemote=origin` to always checkout "
"remote branches from there if _<branch>_ is ambiguous but exists on the "
"'origin' remote. See also `checkout.defaultRemote` in linkgit:git-config[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:200
msgid "`--guess` is the default behavior. Use `--no-guess` to disable it."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:203
msgid ""
"The default behavior can be set via the `checkout.guess` configuration "
"variable."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:204
#, no-wrap
msgid "`-l`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:207
msgid "Create the new branch's reflog; see linkgit:git-branch[1] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:208
#, no-wrap
msgid "`-d`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:209
#, no-wrap
msgid "`--detach`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:215
msgid ""
"Rather than checking out a branch to work on it, check out a commit for "
"inspection and discardable experiments.  This is the default behavior of "
"`git checkout <commit>` when _<commit>_ is not a branch name.  See the "
"\"DETACHED HEAD\" section below for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:216
#, no-wrap
msgid "`--orphan <new-branch>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:222
msgid ""
"Create a new unborn branch, named _<new-branch>_, started from "
"_<start-point>_ and switch to it.  The first commit made on this new branch "
"will have no parents and it will be the root of a new history totally "
"disconnected from all the other branches and commits."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:227
msgid ""
"The index and the working tree are adjusted as if you had previously run "
"`git checkout <start-point>`.  This allows you to start a new history that "
"records a set of paths similar to _<start-point>_ by easily running `git "
"commit -a` to make the root commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:233
msgid ""
"This can be useful when you want to publish the tree from a commit without "
"exposing its full history. You might want to do this to publish an open "
"source branch of a project whose current tree is \"clean\", but whose full "
"history contains proprietary or otherwise encumbered bits of code."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:240
msgid ""
"If you want to start a disconnected history that records a set of paths that "
"is totally different from the one of _<start-point>_, then you should clear "
"the index and the working tree right after creating the orphan branch by "
"running `git rm -rf .` from the top level of the working tree.  Afterwards "
"you will be ready to prepare your new files, repopulating the working tree, "
"by copying them from elsewhere, extracting a tarball, etc."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:241
#, no-wrap
msgid "`--ignore-skip-worktree-bits`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:246
msgid ""
"In sparse checkout mode, `git checkout -- <path>...` would update only "
"entries matched by _<paths>_ and sparse patterns in "
"`$GIT_DIR/info/sparse-checkout`. This option ignores the sparse patterns and "
"adds back any files in `<path>...`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:247
#, no-wrap
msgid "`-m`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:248
#, no-wrap
msgid "`--merge`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:257
msgid ""
"When switching branches, if you have local modifications to one or more "
"files that are different between the current branch and the branch to which "
"you are switching, the command refuses to switch branches in order to "
"preserve your modifications in context.  However, with this option, a "
"three-way merge between the current branch, your working tree contents, and "
"the new branch is done, and you will be on the new branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:262
msgid ""
"When a merge conflict happens, the index entries for conflicting paths are "
"left unmerged, and you need to resolve the conflicts and mark the resolved "
"paths with `git add` (or `git rm` if the merge should result in deletion of "
"the path)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:266
msgid ""
"When checking out paths from the index, this option lets you recreate the "
"conflicted merge in the specified paths.  This option cannot be used when "
"checking out paths from a tree-ish."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:268
msgid "When switching branches with `--merge`, staged changes may be lost."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:269
#, no-wrap
msgid "`--conflict=<style>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:274
msgid ""
"The same as `--merge` option above, but changes the way the conflicting "
"hunks are presented, overriding the `merge.conflictStyle` configuration "
"variable.  Possible values are `merge` (default), `diff3`, and `zdiff3`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:275
#, no-wrap
msgid "`-p`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:276
#, no-wrap
msgid "`--patch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:281
msgid ""
"Interactively select hunks in the difference between the _<tree-ish>_ (or "
"the index, if unspecified) and the working tree.  The chosen hunks are then "
"applied in reverse to the working tree (and if a _<tree-ish>_ was specified, "
"the index)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:285
msgid ""
"This means that you can use `git checkout -p` to selectively discard edits "
"from your current working tree. See the \"Interactive Mode\" section of "
"linkgit:git-add[1] to learn how to operate the `--patch` mode."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:288
msgid ""
"Note that this option uses the no overlay mode by default (see also "
"`--overlay`), and currently doesn't support overlay mode."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:291
#, no-wrap
msgid "`--ignore-other-worktrees`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:296
msgid ""
"`git checkout` refuses when the wanted branch is already checked out or "
"otherwise in use by another worktree. This option makes it check the branch "
"out anyway. In other words, the branch can be in use by more than one "
"worktree."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:297
#, no-wrap
msgid "`--overwrite-ignore`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:298
#, no-wrap
msgid "`--no-overwrite-ignore`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:302
msgid ""
"Silently overwrite ignored files when switching branches. This is the "
"default behavior. Use `--no-overwrite-ignore` to abort the operation when "
"the new branch contains ignored files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:303
#, no-wrap
msgid "`--recurse-submodules`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:304
#, no-wrap
msgid "`--no-recurse-submodules`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:312
msgid ""
"Using `--recurse-submodules` will update the content of all active "
"submodules according to the commit recorded in the superproject. If local "
"modifications in a submodule would be overwritten the checkout will fail "
"unless `-f` is used. If nothing (or `--no-recurse-submodules`)  is used, "
"submodules working trees will not be updated.  Just like "
"linkgit:git-submodule[1], this will detach `HEAD` of the submodule."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:313
#, no-wrap
msgid "`--overlay`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:314
#, no-wrap
msgid "`--no-overlay`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:320
msgid ""
"In the default overlay mode, `git checkout` never removes files from the "
"index or the working tree.  When specifying `--no-overlay`, files that "
"appear in the index and working tree, but not in _<tree-ish>_ are removed, "
"to make them match _<tree-ish>_ exactly."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:321
#, no-wrap
msgid "`--pathspec-from-file=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:328
msgid ""
"Pathspec is passed in _<file>_ instead of commandline args. If _<file>_ is "
"exactly `-` then standard input is used. Pathspec elements are separated by "
"_LF_ or _CR_/_LF_. Pathspec elements can be quoted as explained for the "
"configuration variable `core.quotePath` (see linkgit:git-config[1]). See "
"also `--pathspec-file-nul` and global `--literal-pathspecs`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:329
#, no-wrap
msgid "`--pathspec-file-nul`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:333
msgid ""
"Only meaningful with `--pathspec-from-file`. Pathspec elements are separated "
"with _NUL_ character and all other characters are taken literally (including "
"newlines and quotes)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:334
#, no-wrap
msgid "`<branch>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:340
msgid ""
"Branch to checkout; if it refers to a branch (i.e., a name that, when "
"prepended with \"refs/heads/\", is a valid ref), then that branch is checked "
"out. Otherwise, if it refers to a valid commit, your `HEAD` becomes "
"\"detached\" and you are no longer on any branch (see below for details)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:344
msgid ""
"You can use the `@{-N}` syntax to refer to the N-th last branch/commit "
"checked out using \"git checkout\" operation. You may also specify `-` which "
"is synonymous to `@{-1}`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:348
#: ../Documentation-sedout/git-checkout.adoc:359
#: ../Documentation-sedout/git-checkout.adoc:367
msgid ""
"As a special case, you may use `<rev-a>...<rev-b>` as a shortcut for the "
"merge base of _<rev-a>_ and _<rev-b>_ if there is exactly one merge "
"base. You can leave out at most one of _<rev-a>_ and _<rev-b>_, in which "
"case it defaults to `HEAD`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:349
#, no-wrap
msgid "_<new-branch>_"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:351
msgid "Name for the new branch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:352
#, no-wrap
msgid "_<start-point>_"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:355
msgid ""
"The name of a commit at which to start the new branch; see "
"linkgit:git-branch[1] for details. Defaults to `HEAD`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:360
#, no-wrap
msgid "_<tree-ish>_"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:363
msgid ""
"Tree to checkout from (when paths are given). If not specified, the index "
"will be used."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:368
#, no-wrap
msgid "`--`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:370
msgid "Do not interpret any more arguments as options."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout.adoc:371
#, no-wrap
msgid "`<pathspec>...`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:373
msgid "Limits the paths affected by the operation."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:375
msgid "For more details, see the 'pathspec' entry in linkgit:gitglossary[7]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:377
#, no-wrap
msgid "DETACHED HEAD"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:381
msgid ""
"`HEAD` normally refers to a named branch (e.g. `master`). Meanwhile, each "
"branch refers to a specific commit. Let's look at a repo with three commits, "
"one of them tagged, and with branch `master` checked out:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:390
#, no-wrap
msgid ""
"           HEAD (refers to branch 'master')\n"
"            |\n"
"            v\n"
"a---b---c  branch 'master' (refers to commit 'c')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:397
msgid ""
"When a commit is created in this state, the branch is updated to refer to "
"the new commit. Specifically, `git commit` creates a new commit `d`, whose "
"parent is commit `c`, and then updates branch `master` to refer to new "
"commit `d`. `HEAD` still refers to branch `master` and so indirectly now "
"refers to commit `d`:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:400
#: ../Documentation-sedout/git-checkout.adoc:435
#: ../Documentation-sedout/git-checkout.adoc:452
#, no-wrap
msgid "$ edit; git add; git commit\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:408
#, no-wrap
msgid ""
"               HEAD (refers to branch 'master')\n"
"                |\n"
"                v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:414
msgid ""
"It is sometimes useful to be able to checkout a commit that is not at the "
"tip of any named branch, or even to create a new commit that is not "
"referenced by a named branch. Let's look at what happens when we checkout "
"commit `b` (here we show two ways this may be done):"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:418
#, no-wrap
msgid ""
"$ git checkout v2.0  # or\n"
"$ git checkout master^^\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:426
#, no-wrap
msgid ""
"   HEAD (refers to commit 'b')\n"
"    |\n"
"    v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:432
msgid ""
"Notice that regardless of which checkout command we use, `HEAD` now refers "
"directly to commit `b`. This is known as being in detached `HEAD` state.  It "
"means simply that `HEAD` refers to a specific commit, as opposed to "
"referring to a named branch. Let's see what happens when we create a commit:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:445
#, no-wrap
msgid ""
"     HEAD (refers to commit 'e')\n"
"      |\n"
"      v\n"
"      e\n"
"     /\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:449
msgid ""
"There is now a new commit `e`, but it is referenced only by `HEAD`. We can "
"of course add yet another commit in this state:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:462
#, no-wrap
msgid ""
"\t HEAD (refers to commit 'f')\n"
"\t  |\n"
"\t  v\n"
"      e---f\n"
"     /\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:466
msgid ""
"In fact, we can perform all the normal Git operations. But, let's look at "
"what happens when we then checkout `master`:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:469
#, no-wrap
msgid "$ git checkout master\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:477
#, no-wrap
msgid ""
"               HEAD (refers to branch 'master')\n"
"      e---f     |\n"
"     /          v\n"
"a---b---c---d  branch 'master' (refers to commit 'd')\n"
"    ^\n"
"    |\n"
"  tag 'v2.0' (refers to commit 'b')\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:484
msgid ""
"It is important to realize that at this point nothing refers to commit "
"`f`. Eventually commit `f` (and by extension commit `e`) will be deleted by "
"the routine Git garbage collection process, unless we create a reference "
"before that happens. If we have not yet moved away from commit `f`, any of "
"these will create a reference to it:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:489
#, no-wrap
msgid ""
"$ git checkout -b foo  # or \"git switch -c foo\"  <1>\n"
"$ git branch foo                                 <2>\n"
"$ git tag foo                                    <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:493
msgid ""
"creates a new branch `foo`, which refers to commit `f`, and then updates "
"`HEAD` to refer to branch `foo`. In other words, we'll no longer be in "
"detached `HEAD` state after this command."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:495
msgid ""
"similarly creates a new branch `foo`, which refers to commit `f`, but leaves "
"`HEAD` detached."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:497
msgid ""
"creates a new tag `foo`, which refers to commit `f`, leaving `HEAD` "
"detached."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:502
msgid ""
"If we have moved away from commit `f`, then we must first recover its object "
"name (typically by using git reflog), and then we can create a reference to "
"it. For example, to see the last two commits to which `HEAD` referred, we "
"can use either of these commands:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:506
#, no-wrap
msgid ""
"$ git reflog -2 HEAD # or\n"
"$ git log -g -2 HEAD\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:509
#, no-wrap
msgid "ARGUMENT DISAMBIGUATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:515
msgid ""
"When you run `git checkout <something>`, Git tries to guess whether "
"`<something>` is intended to be a branch, a commit, or a set of file(s), and "
"then either switches to that branch or commit, or restores the specified "
"files."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:519
msgid ""
"If there's any ambiguity, Git will treat `<something>` as a branch or "
"commit, but you can use the double dash `--` to force Git to treat the "
"parameter as a list of files and/or directories, like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:522
#, no-wrap
msgid "git checkout -- file.txt\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout.adoc:525
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Title ===
#: ../Documentation-sedout/git-checkout.adoc:527
#, no-wrap
msgid "1. Paths"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:532
msgid ""
"The following sequence checks out the `master` branch, reverts the "
"`Makefile` to two revisions back, deletes `hello.c` by mistake, and gets it "
"back from the index."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:538
#, no-wrap
msgid ""
"$ git checkout master             <1>\n"
"$ git checkout master~2 Makefile  <2>\n"
"$ rm -f hello.c\n"
"$ git checkout hello.c            <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:540
msgid "switch branch"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:541
msgid "take a file out of another commit"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:542
msgid "restore `hello.c` from the index"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:545
msgid "If you want to check out _all_ C source files out of the index, you can say"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:548
#, no-wrap
msgid "$ git checkout -- '*.c'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:554
msgid ""
"Note the quotes around `*.c`.  The file `hello.c` will also be checked out, "
"even though it is no longer in the working tree, because the file globbing "
"is used to match entries in the index (not in the working tree by the "
"shell)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:558
msgid ""
"If you have an unfortunate branch that is named `hello.c`, this step would "
"be confused as an instruction to switch to that branch.  You should instead "
"write:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:561
#, no-wrap
msgid "$ git checkout -- hello.c\n"
msgstr ""

#. type: Title ===
#: ../Documentation-sedout/git-checkout.adoc:563
#, no-wrap
msgid "2. Merge"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:567
msgid ""
"After working in the wrong branch, switching to the correct branch would be "
"done using:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:570
#, no-wrap
msgid "$ git checkout mytopic\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:575
msgid ""
"However, your \"wrong\" branch and correct `mytopic` branch may differ in "
"files that you have modified locally, in which case the above checkout would "
"fail like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:579
#, no-wrap
msgid ""
"$ git checkout mytopic\n"
"error: You have local changes to 'frotz'; not switching branches.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:583
msgid ""
"You can give the `-m` flag to the command, which would try a three-way "
"merge:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:587
#, no-wrap
msgid ""
"$ git checkout -m mytopic\n"
"Auto-merging frotz\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:592
msgid ""
"After this three-way merge, the local modifications are _not_ registered in "
"your index file, so `git diff` would show you what changes you made since "
"the tip of the new branch."
msgstr ""

#. type: Title ===
#: ../Documentation-sedout/git-checkout.adoc:593
#, no-wrap
msgid "3. Merge conflict"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:597
msgid ""
"When a merge conflict happens during switching branches with the `-m` "
"option, you would see something like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:603
#, no-wrap
msgid ""
"$ git checkout -m mytopic\n"
"Auto-merging frotz\n"
"ERROR: Merge conflict in frotz\n"
"fatal: merge program failed\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout.adoc:609
msgid ""
"At this point, `git diff` shows the changes cleanly merged as in the "
"previous example, as well as the changes in the conflicted files.  Edit and "
"resolve the conflict and mark it resolved with `git add` as usual:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout.adoc:613
#, no-wrap
msgid ""
"$ edit frotz\n"
"$ git add frotz\n"
msgstr ""

