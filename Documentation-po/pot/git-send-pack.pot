#. type: Title =
#: ../Documentation-sedout/git-send-pack.txt:2
#, no-wrap
msgid "git-send-pack(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:7
msgid "git-send-pack - Push objects over Git protocol to another repository"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:17
#, no-wrap
msgid ""
"'git send-pack' [--mirror] [--dry-run] [--force]\n"
"\t\t[--receive-pack=<git-receive-pack>]\n"
"\t\t[--verbose] [--thin] [--atomic]\n"
"\t\t[--[no-]signed | --signed=(true|false|if-asked)]\n"
"\t\t[<host>:]<directory> (--all | <ref>...)\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:19
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:22
msgid ""
"Usually you would want to use 'git push', which is a higher-level wrapper of "
"this command, instead. See linkgit:git-push[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:25
msgid ""
"Invokes 'git-receive-pack' on a possibly remote repository, and updates it "
"from the current repository, sending named refs."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:28
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:29
#, no-wrap
msgid "`--receive-pack=<git-receive-pack>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:34
msgid ""
"Path to the 'git-receive-pack' program on the remote end.  Sometimes useful "
"when pushing to a remote repository over ssh, and you do not have the "
"program in a directory on the default $PATH."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:35
#, no-wrap
msgid "`--exec=<git-receive-pack>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:37
msgid "Same as --receive-pack=<git-receive-pack>."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:38
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:41
msgid ""
"Instead of explicitly specifying which refs to update, update all heads that "
"locally exist."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:42
#, no-wrap
msgid "`--stdin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:47
msgid ""
"Take the list of refs from stdin, one per line. If there are refs specified "
"on the command line in addition to this option, then the refs from stdin are "
"processed after those on the command line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:51
msgid ""
"If `--stateless-rpc` is specified together with this option then the list of "
"refs must be in packet format (pkt-line). Each ref must be in a separate "
"packet, and the list must end with a flush packet."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:52
#, no-wrap
msgid "`--dry-run`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:54
msgid "Do everything except actually send the updates."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:55
#, no-wrap
msgid "`--force`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:61
msgid ""
"Usually, the command refuses to update a remote ref that is not an ancestor "
"of the local ref used to overwrite it.  This flag disables the check.  This "
"means that the remote repository can lose commits; use it with care."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:62
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:64
msgid "Run verbosely."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:65
#, no-wrap
msgid "`--thin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:68
msgid ""
"Send a \"thin\" pack, which records objects in deltified form based on "
"objects not included in the pack to reduce network traffic."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:69
#, no-wrap
msgid "`--atomic`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:73
msgid ""
"Use an atomic transaction for updating the refs. If any of the refs fails to "
"update then the entire push will fail without changing any refs."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:74
#, no-wrap
msgid "`--[no-]signed`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:75
#, no-wrap
msgid "`--signed=(true|false|if-asked)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:84
msgid ""
"GPG-sign the push request to update refs on the receiving side, to allow it "
"to be checked by the hooks and/or be logged.  If `false` or `--no-signed`, "
"no signing will be attempted.  If `true` or `--signed`, the push will fail "
"if the server does not support signed pushes.  If set to `if-asked`, sign if "
"and only if the server supports signed pushes.  The push will also fail if "
"the actual call to `gpg --sign` fails.  See linkgit:git-receive-pack[1] for "
"the details on the receiving end."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:85
#, no-wrap
msgid "`--push-option=<string>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:90
msgid ""
"Pass the specified string as a push option for consumption by hooks on the "
"server side.  If the server doesn't support push options, error out.  See "
"linkgit:git-push[1] and linkgit:githooks[5] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:91
#, no-wrap
msgid "<host>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:95
msgid ""
"A remote host to house the repository.  When this part is specified, "
"'git-receive-pack' is invoked via ssh."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:96
#, no-wrap
msgid "<directory>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:98
msgid "The repository to update."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-send-pack.txt:99
#, no-wrap
msgid "<ref>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:101
msgid "The remote refs to update."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:104
#, no-wrap
msgid "SPECIFYING THE REFS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:108
msgid "There are three ways to specify which refs to update on the remote end."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:112
msgid ""
"With the `--all` flag, all refs that exist locally are transferred to the "
"remote side.  You cannot specify any '<ref>' if you use this flag."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:115
msgid ""
"Without `--all` and without any '<ref>', the heads that exist both on the "
"local side and on the remote side are updated."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:121
msgid ""
"When one or more '<ref>' are specified explicitly (whether on the command "
"line or via `--stdin`), it can be either a single pattern, or a pair of such "
"patterns separated by a colon \":\" (this means that a ref name cannot have "
"a colon in it).  A single pattern '<name>' is just shorthand for "
"'<name>:<name>'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:129
msgid ""
"Each pattern pair consists of the source side (before the colon)  and the "
"destination side (after the colon).  The ref to be pushed is determined by "
"finding a match that matches the source side, and where it is pushed is "
"determined by using the destination side. The rules used to match a ref are "
"the same rules used by 'git rev-parse' to resolve a symbolic ref name. See "
"linkgit:git-rev-parse[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:132
msgid "It is an error if <src> does not match exactly one of the local refs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:134
msgid "It is an error if <dst> matches more than one remote ref."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:136
msgid "If <dst> does not match any remote ref, either"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:139
msgid ""
"it has to start with \"refs/\"; <dst> is used as the destination literally "
"in this case."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:143
msgid ""
"<src> == <dst> and the ref that matched the <src> must not exist in the set "
"of remote refs; the ref matched <src> locally is used as the name of the "
"destination."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:149
msgid ""
"Without `--force`, the <src> ref is stored at the remote only if <dst> does "
"not exist, or <dst> is a proper subset (i.e. an ancestor) of <src>.  This "
"check, known as the \"fast-forward check\", is performed to avoid "
"accidentally overwriting the remote ref and losing other people's commits "
"from there."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:151
msgid "With `--force`, the fast-forward check is disabled for all refs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:154
msgid ""
"Optionally, a <ref> parameter can be prefixed with a plus '+' sign to "
"disable the fast-forward check only on that ref."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-send-pack.txt:156
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-send-pack.txt:157
msgid "Part of the linkgit:git[1] suite"
msgstr ""
