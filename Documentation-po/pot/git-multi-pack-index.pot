#. type: Title =
#: ../Documentation-sedout/git-multi-pack-index.txt:2
#, no-wrap
msgid "git-multi-pack-index(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-multi-pack-index.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:7
msgid "git-multi-pack-index - Write and verify multi-pack-indexes"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-multi-pack-index.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:13
msgid "'git multi-pack-index' [--object-dir=<dir>] [--[no-]bitmap] <sub-command>"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-multi-pack-index.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:17
msgid "Write or verify a multi-pack-index (MIDX) file."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-multi-pack-index.txt:19
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:25
#, no-wrap
msgid ""
"`--object-dir=<dir>::`\n"
"\tUse given directory for the location of Git objects. We check\n"
"\t`<dir>/packs/multi-pack-index` for the current MIDX file, and\n"
"\t`<dir>/packs` for the pack-files to index.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:27
msgid "`<dir>` must be an alternate of the current repository."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:32
#, no-wrap
msgid ""
"`--[no-]progress::`\n"
"\tTurn progress on/off explicitly. If neither is specified, progress is\n"
"\tshown if standard error is connected to a terminal. Supported by\n"
"\tsub-commands `write`, `verify`, `expire`, and `repack.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:34
msgid "The following subcommands are available:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:35
#, no-wrap
msgid "write"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:38
msgid ""
"Write a new MIDX file. The following options are available for the `write` "
"sub-command:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:40
#, no-wrap
msgid "--preferred-pack=<pack>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:45
#, no-wrap
msgid ""
"Optionally specify the tie-breaking pack used when\n"
"multiple packs contain the same object. `<pack>` must\n"
"contain at least one object. If not given, ties are\n"
"broken in favor of the pack with the lowest mtime.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:46
#, no-wrap
msgid "--[no-]bitmap"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:48
#, no-wrap
msgid "Control whether or not a multi-pack bitmap is written.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:49
#, no-wrap
msgid "--stdin-packs"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:52
#, no-wrap
msgid ""
"Write a multi-pack index containing only the set of\n"
"line-delimited pack index basenames provided over stdin.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:53
#, no-wrap
msgid "--refs-snapshot=<path>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:56
#, no-wrap
msgid ""
"With `--bitmap`, optionally specify a file which\n"
"contains a \"refs snapshot\" taken prior to repacking.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:62
msgid ""
"A reference snapshot is composed of line-delimited OIDs corresponding to the "
"reference tips, usually taken by `git repack` prior to generating a new "
"pack. A line may optionally start with a `+` character to indicate that the "
"reference which corresponds to that OID is \"preferred\" (see "
"linkgit:git-config[1]'s `pack.preferBitmapTips`.)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:67
msgid ""
"The file given at `<path>` is expected to be readable, and can contain "
"duplicates. (If a given OID is given more than once, it is marked as "
"preferred if at least one instance of it begins with the special `+` "
"marker)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:68
#, no-wrap
msgid "--incremental"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:73
#, no-wrap
msgid ""
"Write an incremental MIDX file containing only objects\n"
"and packs not present in an existing MIDX layer.\n"
"Migrates non-incremental MIDXs to incremental ones when\n"
"necessary. Incompatible with `--bitmap`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:75
#, no-wrap
msgid "verify"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:77
msgid "Verify the contents of the MIDX file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:78
#, no-wrap
msgid "expire"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:83
msgid ""
"Delete the pack-files that are tracked by the MIDX file, but have no objects "
"referenced by the MIDX (with the exception of `.keep` packs and cruft "
"packs). Rewrite the MIDX file afterward to remove all references to these "
"pack-files."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:85
#: ../Documentation-sedout/git-multi-pack-index.txt:108
msgid "this mode is incompatible with incremental MIDX files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-multi-pack-index.txt:86
#, no-wrap
msgid "repack"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:103
msgid ""
"Create a new pack-file containing objects in small pack-files referenced by "
"the multi-pack-index. If the size given by the `--batch-size=<size>` "
"argument is zero, then create a pack containing all objects referenced by "
"the multi-pack-index. For a non-zero batch size, Select the pack-files by "
"examining packs from oldest-to-newest, computing the \"expected size\" by "
"counting the number of objects in the pack referenced by the "
"multi-pack-index, then divide by the total number of objects in the pack and "
"multiply by the pack size. We select packs with expected size below the "
"batch size until the set of packs have total expected size at least the "
"batch size, or all pack-files are considered. If only one pack-file is "
"selected, then do nothing. If a new pack-file is created, rewrite the "
"multi-pack-index to reference the new pack-file. A later run of 'git "
"multi-pack-index expire' will delete the pack-files that were part of this "
"batch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:106
msgid ""
"If `repack.packKeptObjects` is `false`, then any pack-files with an "
"associated `.keep` file will not be selected for the batch to repack."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-multi-pack-index.txt:110
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:113
msgid "Write a MIDX file for the packfiles in the current `.git` directory."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-multi-pack-index.txt:116
#, no-wrap
msgid "$ git multi-pack-index write\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:120
msgid ""
"Write a MIDX file for the packfiles in the current `.git` directory with a "
"corresponding bitmap."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-multi-pack-index.txt:123
#, no-wrap
msgid "$ git multi-pack-index write --preferred-pack=<pack> --bitmap\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:126
msgid "Write a MIDX file for the packfiles in an alternate object store."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-multi-pack-index.txt:129
#, no-wrap
msgid "$ git multi-pack-index --object-dir <alt> write\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-multi-pack-index.txt:132
msgid "Verify the MIDX file for the packfiles in the current `.git` directory."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-multi-pack-index.txt:135
#, no-wrap
msgid "$ git multi-pack-index verify\n"
msgstr ""

