#. type: Title =
#: ../Documentation-sedout/git-config.txt:2
#, no-wrap
msgid "git-config(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:7
msgid "git-config - Get and set repository or global options"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:20
#, no-wrap
msgid ""
"\t'git config list' [<file-option>] [<display-option>] [--includes]\n"
"\t'git config get' [<file-option>] [<display-option>] [--includes] [--all] "
"[--regexp] [--value=<value>] [--fixed-value] [--default=<default>] <name>\n"
"\t'git config set' [<file-option>] [--type=<type>] [--all] [--value=<value>] "
"[--fixed-value] <name> <value>\n"
"\t'git config unset' [<file-option>] [--all] [--value=<value>] "
"[--fixed-value] <name>\n"
"\t'git config rename-section' [<file-option>] <old-name> <new-name>\n"
"\t'git config remove-section' [<file-option>] <name>\n"
"\t'git config edit' [<file-option>]\n"
"\t'git config' [<file-option>] --get-colorbool <name> [<stdout-is-tty>]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:22
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:26
msgid ""
"You can query/set/replace/unset options with this command. The name is "
"actually the section and the key separated by a dot, and the value will be "
"escaped."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:36
msgid ""
"Multiple lines can be added to an option by using the `--append` option.  If "
"you want to update or unset an option which can occur on multiple lines, a "
"`value-pattern` (which is an extended regular expression, unless the "
"`--fixed-value` option is given) needs to be given.  Only the existing "
"values that match the pattern are updated or unset.  If you want to handle "
"the lines that do *not* match the pattern, just prepend a single exclamation "
"mark in front (see also <<EXAMPLES>>), but note that this only works when "
"the `--fixed-value` option is not in use."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:41
msgid ""
"The `--type=<type>` option instructs 'git config' to ensure that incoming "
"and outgoing values are canonicalize-able under the given <type>.  If no "
"`--type=<type>` is given, no canonicalization will be performed. Callers may "
"unset an existing `--type` specifier with `--no-type`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:47
msgid ""
"When reading, the values are read from the system, global and repository "
"local configuration files by default, and options `--system`, `--global`, "
"`--local`, `--worktree` and `--file <filename>` can be used to tell the "
"command to read from only that location (see <<FILES>>)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:53
msgid ""
"When writing, the new value is written to the repository local configuration "
"file by default, and options `--system`, `--global`, `--worktree`, `--file "
"<filename>` can be used to tell the command to write to that location (you "
"can say `--local` but that is the default)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:56
msgid ""
"This command will fail with non-zero status upon error.  Some exit codes "
"are:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:58
msgid "The section or key is invalid (ret=1),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:59
msgid "no section or name was provided (ret=2),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:60
msgid "the config file is invalid (ret=3),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:61
msgid "the config file cannot be written (ret=4),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:62
msgid "you try to unset an option which does not exist (ret=5),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:63
msgid "you try to unset/set an option for which multiple lines match (ret=5), or"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:64
msgid "you try to use an invalid regexp (ret=6)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:66
msgid "On success, the command returns the exit code 0."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:69
msgid ""
"A list of all available configuration variables can be obtained using the "
"`git help --config` command."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:71
#, no-wrap
msgid "COMMANDS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:73
#, no-wrap
msgid "list"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:75
msgid "List all variables set in config file, along with their values."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:76
#, no-wrap
msgid "get"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:81
msgid ""
"Emits the value of the specified key. If key is present multiple times in "
"the configuration, emits the last value. If `--all` is specified, emits all "
"values associated with key. Returns error code 1 if key is not present."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:82
#, no-wrap
msgid "set"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:88
msgid ""
"Set value for one or more config options. By default, this command refuses "
"to write multi-valued config options. Passing `--all` will replace all "
"multi-valued config options with the new value, whereas `--value=` will "
"replace all config options whose values match the given pattern."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:89
#, no-wrap
msgid "unset"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:94
msgid ""
"Unset value for one or more config options. By default, this command refuses "
"to unset multi-valued keys. Passing `--all` will unset all multi-valued "
"config options, whereas `--value` will unset all config options whose values "
"match the given pattern."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:95
#, no-wrap
msgid "rename-section"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:97
msgid "Rename the given section to a new name."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:98
#, no-wrap
msgid "remove-section"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:100
msgid "Remove the given section from the configuration file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:101
#, no-wrap
msgid "edit"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:105
msgid ""
"Opens an editor to modify the specified config file; either `--system`, "
"`--global`, `--local` (default), `--worktree`, or `--file <config-file>`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:108
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:110
#, no-wrap
msgid "`--replace-all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:113
msgid ""
"Default behavior is to replace at most one line. This replaces all lines "
"matching the key (and optionally the `value-pattern`)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:114
#, no-wrap
msgid "`--append`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:117
msgid ""
"Adds a new line to the option without altering any existing values. This is "
"the same as providing '--value=^$' in `set`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:118
#, no-wrap
msgid "`--comment <message>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:120
msgid "Append a comment at the end of new or modified lines."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:129
msgid ""
"If _<message>_ begins with one or more whitespaces followed by \"#\", it is "
"used as-is.  If it begins with \"#\", a space is prepended before it is "
"used.  Otherwise, a string \" # \" (a space followed by a hash followed by a "
"space) is prepended to it.  And the resulting string is placed immediately "
"after the value defined for the variable.  The _<message>_ must not contain "
"linefeed characters (no multi-line comments are permitted)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:130
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:132
msgid "With `get`, return all values for a multi-valued key."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:133
#, no-wrap
msgid "`--regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:138
msgid ""
"With `get`, interpret the name as a regular expression. Regular expression "
"matching is currently case-sensitive and done against a canonicalized "
"version of the key in which section and variable names are lowercased, but "
"subsection names are not."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:139
#, no-wrap
msgid "`--url=<URL>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:146
msgid ""
"When given a two-part <name> as <section>.<key>, the value for "
"<section>.<URL>.<key> whose <URL> part matches the best to the given URL is "
"returned (if no such key exists, the value for <section>.<key> is used as a "
"fallback).  When given just the <section> as name, do so for all the keys in "
"the section and list them.  Returns error code 1 if no value is found."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:147
#, no-wrap
msgid "`--global`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:152
msgid ""
"For writing options: write to global `~/.gitconfig` file rather than the "
"repository `.git/config`, write to `$XDG_CONFIG_HOME/git/config` file if "
"this file exists and the `~/.gitconfig` file doesn't."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:155
msgid ""
"For reading options: read only from global `~/.gitconfig` and from "
"`$XDG_CONFIG_HOME/git/config` rather than from all available files."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:157
#: ../Documentation-sedout/git-config.txt:167
#: ../Documentation-sedout/git-config.txt:176
#: ../Documentation-sedout/git-config.txt:195
#: ../Documentation-sedout/git-config.txt:461
msgid "See also <<FILES>>."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:158
#, no-wrap
msgid "`--system`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:162
msgid ""
"For writing options: write to system-wide `$(prefix)/etc/gitconfig` rather "
"than the repository `.git/config`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:165
msgid ""
"For reading options: read only from system-wide `$(prefix)/etc/gitconfig` "
"rather than from all available files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:168
#, no-wrap
msgid "`--local`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:171
msgid ""
"For writing options: write to the repository `.git/config` file.  This is "
"the default behavior."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:174
msgid ""
"For reading options: read only from the repository `.git/config` rather than "
"from all available files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:177
#, no-wrap
msgid "`--worktree`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:185
msgid ""
"Similar to `--local` except that `$GIT_DIR/config.worktree` is read from or "
"written to if `extensions.worktreeConfig` is enabled. If not it's the same "
"as `--local`. Note that `$GIT_DIR` is equal to `$GIT_COMMON_DIR` for the "
"main working tree, but is of the form `$GIT_DIR/worktrees/<id>/` for other "
"working trees. See linkgit:git-worktree[1] to learn how to enable "
"`extensions.worktreeConfig`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:186
#, no-wrap
msgid "`-f <config-file>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:187
#, no-wrap
msgid "`--file <config-file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:190
msgid ""
"For writing options: write to the specified file rather than the repository "
"`.git/config`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:193
msgid ""
"For reading options: read only from the specified file rather than from all "
"available files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:196
#, no-wrap
msgid "`--blob <blob>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:202
msgid ""
"Similar to `--file` but use the given blob instead of a file. E.g.  you can "
"use 'master:.gitmodules' to read values from the file '.gitmodules' in the "
"master branch. See \"SPECIFYING REVISIONS\" section in "
"linkgit:gitrevisions[7] for a more complete list of ways to spell blob "
"names."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:203
#, no-wrap
msgid "`--fixed-value`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:208
msgid ""
"When used with the `value-pattern` argument, treat `value-pattern` as an "
"exact string instead of a regular expression. This will restrict the "
"name/value pairs that are matched to only those where the value is exactly "
"equal to the `value-pattern`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:209
#, no-wrap
msgid "`--type <type>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:213
msgid ""
"'git config' will ensure that any input or output is valid under the given "
"type constraint(s), and will canonicalize outgoing values in `<type>`'s "
"canonical form."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:215
msgid "Valid `<type>`'s include:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:217
msgid "'bool': canonicalize values as either \"true\" or \"false\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:220
msgid ""
"'int': canonicalize values as simple decimal numbers. An optional suffix of "
"'k', 'm', or 'g' will cause the value to be multiplied by 1024, 1048576, or "
"1073741824 upon input."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:222
msgid ""
"'bool-or-int': canonicalize according to either 'bool' or 'int', as "
"described above."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:226
msgid ""
"'path': canonicalize by expanding a leading `~` to the value of `$HOME` and "
"`~user` to the home directory for the specified user. This specifier has no "
"effect when setting the value (but you can use `git config section.variable "
"~/` from the command line to let your shell do the expansion.)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:228
msgid ""
"'expiry-date': canonicalize by converting from a fixed or relative "
"date-string to a timestamp. This specifier has no effect when setting the "
"value."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:232
msgid ""
"'color': When getting a value, canonicalize by converting to an ANSI color "
"escape sequence. When setting a value, a sanity-check is performed to ensure "
"that the given value is canonicalize-able as an ANSI color, but it is "
"written as-is."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:234
#, no-wrap
msgid "`--bool`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:235
#, no-wrap
msgid "`--int`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:236
#, no-wrap
msgid "`--bool-or-int`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:237
#, no-wrap
msgid "`--path`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:238
#, no-wrap
msgid "`--expiry-date`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:241
msgid ""
"Historical options for selecting a type specifier. Prefer instead `--type` "
"(see above)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:242
#, no-wrap
msgid "`--no-type`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:246
msgid ""
"Un-sets the previously set type specifier (if one was previously set). This "
"option requests that 'git config' not canonicalize the retrieved variable.  "
"`--no-type` has no effect without `--type=<type>` or `--<type>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:247
#, no-wrap
msgid "`-z`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:248
#, no-wrap
msgid "`--null`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:255
msgid ""
"For all options that output values and/or keys, always end values with the "
"null character (instead of a newline). Use newline instead as a delimiter "
"between key and value. This allows for secure parsing of the output without "
"getting confused e.g. by values that contain line breaks."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:256
#, no-wrap
msgid "`--name-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:259
msgid "Output only the names of config variables for `list` or `get`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:260
#, no-wrap
msgid "`--show-origin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:265
msgid ""
"Augment the output of all queried config options with the origin type (file, "
"standard input, blob, command line) and the actual origin (config file path, "
"ref, or blob id if applicable)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:266
#, no-wrap
msgid "`--show-scope`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:270
msgid ""
"Similar to `--show-origin` in that it augments the output of all queried "
"config options with the scope of that value (worktree, local, global, "
"system, command)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:271
#, no-wrap
msgid "`--get-colorbool <name> [<stdout-is-tty>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:281
msgid ""
"Find the color setting for `<name>` (e.g. `color.diff`) and output \"true\" "
"or \"false\".  `<stdout-is-tty>` should be either \"true\" or \"false\", and "
"is taken into account when configuration says \"auto\".  If "
"`<stdout-is-tty>` is missing, then checks the standard output of the command "
"itself, and exits with status 0 if color is to be used, or exits with status "
"1 otherwise.  When the color setting for `name` is undefined, the command "
"uses `color.ui` as fallback."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:282
#, no-wrap
msgid "`--[no-]includes`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:287
msgid ""
"Respect `include.*` directives in config files when looking up "
"values. Defaults to `off` when a specific file is given (e.g., using "
"`--file`, `--global`, etc) and `on` when searching all config files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:288
#, no-wrap
msgid "`--default <value>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:291
msgid ""
"When using `get`, and the requested variable is not found, behave as if "
"<value> were the value assigned to that variable."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:293
#, no-wrap
msgid "DEPRECATED MODES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:297
msgid ""
"The following modes have been deprecated in favor of subcommands. It is "
"recommended to migrate to the new syntax."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:298
#, no-wrap
msgid "'git config <name>'"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:300
msgid "Replaced by `git config get <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:301
#, no-wrap
msgid "'git config <name> <value> [<value-pattern>]'"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:303
msgid "Replaced by `git config set [--value=<pattern>] <name> <value>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:304
#, no-wrap
msgid "`-l`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:305
#, no-wrap
msgid "`--list`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:307
msgid "Replaced by `git config list`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:308
#, no-wrap
msgid "`--get <name> [<value-pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:310
msgid "Replaced by `git config get [--value=<pattern>] <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:311
#, no-wrap
msgid "`--get-all <name> [<value-pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:313
msgid "Replaced by `git config get [--value=<pattern>] --all <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:314
#, no-wrap
msgid "`--get-regexp <name-regexp>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:316
msgid "Replaced by `git config get --all --show-names --regexp <name-regexp>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:317
#, no-wrap
msgid "`--get-urlmatch <name> <URL>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:319
msgid "Replaced by `git config get --all --show-names --url=<URL> <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:320
#, no-wrap
msgid "`--get-color <name> [<default>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:322
msgid "Replaced by `git config get --type=color [--default=<default>] <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:323
#, no-wrap
msgid "`--add <name> <value>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:325
msgid "Replaced by `git config set --append <name> <value>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:326
#, no-wrap
msgid "`--unset <name> [<value-pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:328
msgid "Replaced by `git config unset [--value=<pattern>] <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:329
#, no-wrap
msgid "`--unset-all <name> [<value-pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:331
msgid "Replaced by `git config unset [--value=<pattern>] --all <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:332
#, no-wrap
msgid "`--rename-section <old-name> <new-name>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:334
msgid "Replaced by `git config rename-section <old-name> <new-name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:335
#, no-wrap
msgid "`--remove-section <name>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:337
msgid "Replaced by `git config remove-section <name>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:338
#, no-wrap
msgid "`-e`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:339
#, no-wrap
msgid "`--edit`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:341
msgid "Replaced by `git config edit`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:343
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:347
msgid ""
"`pager.config` is only respected when listing configuration, i.e., when "
"using `list` or `get` which may return multiple results. The default is to "
"use a pager."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:350
#, no-wrap
msgid "FILES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:354
msgid ""
"By default, 'git config' will read configuration options from multiple "
"files:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:355
#: ../Documentation-sedout/git-config.txt:405
#, no-wrap
msgid "$(prefix)/etc/gitconfig"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:357
msgid "System-wide configuration file."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:358
#: ../Documentation-sedout/git-config.txt:408
#, no-wrap
msgid "$XDG_CONFIG_HOME/git/config"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:359
#: ../Documentation-sedout/git-config.txt:410
#, no-wrap
msgid "~/.gitconfig"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:363
msgid ""
"User-specific configuration files. When the XDG_CONFIG_HOME environment "
"variable is not set or empty, $HOME/.config/ is used as $XDG_CONFIG_HOME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:366
msgid ""
"These are also called \"global\" configuration files. If both files exist, "
"both files are read in the order given above."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:367
#: ../Documentation-sedout/git-config.txt:413
#, no-wrap
msgid "$GIT_DIR/config"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:369
msgid "Repository specific configuration file."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:370
#: ../Documentation-sedout/git-config.txt:416
#, no-wrap
msgid "$GIT_DIR/config.worktree"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:373
msgid ""
"This is optional and is only searched when `extensions.worktreeConfig` is "
"present in $GIT_DIR/config."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:376
msgid ""
"You may also provide additional configuration parameters when running any "
"git command by using the `-c` option. See linkgit:git[1] for details."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:382
msgid ""
"Options will be read from all of these files that are available. If the "
"global or the system-wide configuration files are missing or unreadable they "
"will be ignored. If the repository configuration file is missing or "
"unreadable, 'git config' will exit with a non-zero error code. An error "
"message is produced if the file is unreadable, but not if it is missing."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:386
msgid ""
"The files are read in the order given above, with last value found taking "
"precedence over values read earlier.  When multiple values are taken then "
"all values of a key from all files will be used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:390
msgid ""
"By default, options are only written to the repository specific "
"configuration file. Note that this also affects options like `set` and "
"`unset`. *'git config' will only ever change one file at a time*."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:395
msgid ""
"You can limit which configuration sources are read from or written to by "
"specifying the path of a file with the `--file` option, or by specifying a "
"configuration scope with `--system`, `--global`, `--local`, or "
"`--worktree`.  For more, see <<OPTIONS>> above."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:398
#, no-wrap
msgid "SCOPES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:402
msgid ""
"Each configuration source falls within a configuration scope. The scopes "
"are:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:403
#, no-wrap
msgid "system"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:406
#, no-wrap
msgid "global"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:411
#, no-wrap
msgid "local"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:414
#, no-wrap
msgid "worktree"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:417
#, no-wrap
msgid "command"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:420
msgid ""
"GIT_CONFIG_{COUNT,KEY,VALUE} environment variables (see <<ENVIRONMENT>> "
"below)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:422
msgid "the `-c` option"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:425
msgid ""
"With the exception of 'command', each scope corresponds to a command line "
"option: `--system`, `--global`, `--local`, `--worktree`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:430
msgid ""
"When reading options, specifying a scope will only read options from the "
"files within that scope. When writing options, specifying a scope will write "
"to the files within that scope (instead of the repository specific "
"configuration file). See <<OPTIONS>> above for a complete description."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:434
msgid ""
"Most configuration options are respected regardless of the scope it is "
"defined in, but some options are only respected in certain scopes. See the "
"respective option's documentation for the full details."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-config.txt:436
#, no-wrap
msgid "Protected configuration"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:441
msgid ""
"Protected configuration refers to the 'system', 'global', and 'command' "
"scopes.  For security reasons, certain options are only respected when they "
"are specified in protected configuration, and ignored otherwise."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:446
msgid ""
"Git treats these scopes as if they are controlled by the user or a trusted "
"administrator. This is because an attacker who controls these scopes can do "
"substantial harm without using Git, so it is assumed that the user's "
"environment protects these scopes against attackers."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:449
#, no-wrap
msgid "ENVIRONMENT"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:451
#, no-wrap
msgid "GIT_CONFIG_GLOBAL"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:452
#, no-wrap
msgid "GIT_CONFIG_SYSTEM"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:455
msgid ""
"Take the configuration from the given files instead from global or "
"system-level configuration. See linkgit:git[1] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:456
#, no-wrap
msgid "GIT_CONFIG_NOSYSTEM"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:459
msgid ""
"Whether to skip reading settings from the system-wide "
"$(prefix)/etc/gitconfig file. See linkgit:git[1] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:462
#, no-wrap
msgid "GIT_CONFIG_COUNT"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:463
#, no-wrap
msgid "GIT_CONFIG_KEY_<n>"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:464
#, no-wrap
msgid "GIT_CONFIG_VALUE_<n>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:473
msgid ""
"If GIT_CONFIG_COUNT is set to a positive number, all environment pairs "
"GIT_CONFIG_KEY_<n> and GIT_CONFIG_VALUE_<n> up to that number will be added "
"to the process's runtime configuration. The config pairs are "
"zero-indexed. Any missing key or value is treated as an error. An empty "
"GIT_CONFIG_COUNT is treated the same as GIT_CONFIG_COUNT=0, namely no pairs "
"are processed. These environment variables will override values in "
"configuration files, but will be overridden by any explicit options passed "
"via `git -c`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:477
msgid ""
"This is useful for cases where you want to spawn multiple git commands with "
"a common configuration but cannot depend on a configuration file, for "
"example when writing scripts."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-config.txt:478
#, no-wrap
msgid "GIT_CONFIG"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:484
msgid ""
"If no `--file` option is provided to `git config`, use the file given by "
"`GIT_CONFIG` as if it were provided via `--file`. This variable has no "
"effect on other Git commands, and is mostly for historical compatibility; "
"there is generally no reason to use it instead of the `--file` option."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:487
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:490
msgid "Given a .git/config like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:497
#, no-wrap
msgid ""
"#\n"
"# This is the config file, and\n"
"# a '#' or ';' character indicates\n"
"# a comment\n"
"#\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:502
#, no-wrap
msgid ""
"; core variables\n"
"[core]\n"
"\t; Don't trust file modes\n"
"\tfilemode = false\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:507
#, no-wrap
msgid ""
"; Our diff algorithm\n"
"[diff]\n"
"\texternal = /usr/local/bin/diff-wrapper\n"
"\trenames = true\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:512
#, no-wrap
msgid ""
"; Proxy settings\n"
"[core]\n"
"\tgitproxy=proxy-command for kernel.org\n"
"\tgitproxy=default-proxy ; for all the rest\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:519
#, no-wrap
msgid ""
"; HTTP\n"
"[http]\n"
"\tsslVerify\n"
"[http \"https://weak.example.com\"]\n"
"\tsslVerify = false\n"
"\tcookieFile = /tmp/cookie.txt\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:522
msgid "you can set the filemode to true with"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:525
#, no-wrap
msgid "% git config set core.filemode true\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:530
msgid ""
"The hypothetical proxy command entries actually have a postfix to discern "
"what URL they apply to. Here is how to change the entry for kernel.org to "
"\"ssh\"."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:533
#, no-wrap
msgid ""
"% git config set --value='for kernel.org$' core.gitproxy '\"ssh\" for "
"kernel.org'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:536
msgid "This makes sure that only the key/value pair for kernel.org is replaced."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:538
msgid "To delete the entry for renames, do"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:541
#, no-wrap
msgid "% git config unset diff.renames\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:545
msgid ""
"If you want to delete an entry for a multivar (like core.gitproxy above), "
"you have to provide a regex matching the value of exactly one line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:547
msgid "To query the value for a given key, do"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:550
#, no-wrap
msgid "% git config get core.filemode\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:553
msgid "or, to query a multivar:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:556
#, no-wrap
msgid "% git config get --value=\"for kernel.org$\" core.gitproxy\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:559
msgid "If you want to know all the values for a multivar, do:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:562
#, no-wrap
msgid "% git config get --all --show-names core.gitproxy\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:566
msgid ""
"If you like to live dangerously, you can replace *all* core.gitproxy by a "
"new one with"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:569
#, no-wrap
msgid "% git config set --all core.gitproxy ssh\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:573
msgid ""
"However, if you really only want to replace the line for the default proxy, "
"i.e. the one without a \"for ...\" postfix, do something like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:576
#, no-wrap
msgid "% git config set --value='! for ' core.gitproxy ssh\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:579
msgid "To actually match only values with an exclamation mark, you have to"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:582
#, no-wrap
msgid "% git config set --value='[!]' section.key value\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:585
msgid "To add a new proxy, without altering any of the existing ones, use"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:588
#, no-wrap
msgid ""
"% git config set --append core.gitproxy '\"proxy-command\" for "
"example.com'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:592
msgid "An example to use customized color from the configuration in your script:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:598
#, no-wrap
msgid ""
"#!/bin/sh\n"
"WS=$(git config get --type=color --default=\"blue reverse\" "
"color.diff.whitespace)\n"
"RESET=$(git config get --type=color --default=\"reset\" \"\")\n"
"echo \"${WS}your whitespace color or blue reverse${RESET}\"\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:602
msgid ""
"For URLs in `https://weak.example.com`, `http.sslVerify` is set to false, "
"while it is set to `true` for all others:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:611
#, no-wrap
msgid ""
"% git config get --type=bool --url=https://good.example.com http.sslverify\n"
"true\n"
"% git config get --type=bool --url=https://weak.example.com http.sslverify\n"
"false\n"
"% git config get --url=https://weak.example.com http\n"
"http.cookieFile /tmp/cookie.txt\n"
"http.sslverify false\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:616
#, no-wrap
msgid "BUGS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:621
msgid ""
"When using the deprecated `[section.subsection]` syntax, changing a value "
"will result in adding a multi-line key instead of a change, if the "
"subsection is given with at least one uppercase character. For example when "
"the config looks like"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:625
#, no-wrap
msgid ""
"  [section.subsection]\n"
"    key = value1\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:628
msgid "and running `git config section.Subsection.key value2` will result in"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-config.txt:633
#, no-wrap
msgid ""
"  [section.subsection]\n"
"    key = value1\n"
"    key = value2\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-config.txt:637
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-config.txt:638
msgid "Part of the linkgit:git[1] suite"
msgstr ""
