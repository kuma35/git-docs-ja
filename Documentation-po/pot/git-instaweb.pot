#. type: Title =
#: ../Documentation-sedout/git-instaweb.txt:2
#, no-wrap
msgid "git-instaweb(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-instaweb.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:7
msgid "git-instaweb - Instantly browse your working repository in gitweb"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-instaweb.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:14
#, no-wrap
msgid ""
"'git instaweb' [--local] [--httpd=<httpd>] [--port=<port>]\n"
"               [--browser=<browser>]\n"
"'git instaweb' [--start] [--stop] [--restart]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-instaweb.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:19
msgid ""
"A simple script to set up `gitweb` and a web server for browsing the local "
"repository."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-instaweb.txt:21
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:26
#, no-wrap
msgid ""
"`-l::`\n"
"`--local::`\n"
"\tOnly bind the web server to the local IP (127.0.0.1).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:35
#, no-wrap
msgid ""
"`-d::`\n"
"`--httpd::`\n"
"\tThe HTTP daemon command-line that will be executed.\n"
"\tCommand-line options may be specified here, and the\n"
"\tconfiguration file will be added at the end of the command-line.\n"
"\tCurrently apache2, lighttpd, mongoose, plackup, python and\n"
"\twebrick are supported.\n"
"\t(Default: lighttpd)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:40
#, no-wrap
msgid ""
"`-m::`\n"
"`--module-path::`\n"
"\tThe module path (only needed if httpd is Apache).\n"
"\t(Default: /usr/lib/apache2/modules)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:44
#, no-wrap
msgid ""
"`-p::`\n"
"`--port::`\n"
"\tThe port number to bind the httpd to.  (Default: 1234)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:52
#, no-wrap
msgid ""
"`-b::`\n"
"`--browser::`\n"
"\tThe web browser that should be used to view the gitweb\n"
"\tpage. This will be passed to the 'git web{litdd}browse' helper\n"
"\tscript along with the URL of the gitweb instance. See\n"
"\tlinkgit:git-web{litdd}browse[1] for more information about this. If\n"
"\tthe script fails, the URL will be printed to stdout.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-instaweb.txt:53
#, no-wrap
msgid "start"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:57
#, no-wrap
msgid ""
"`--start::`\n"
"\tStart the httpd instance and exit.  Regenerate configuration files\n"
"\tas necessary for spawning a new instance.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-instaweb.txt:58
#, no-wrap
msgid "stop"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:63
#, no-wrap
msgid ""
"`--stop::`\n"
"\tStop the httpd instance and exit.  This does not generate\n"
"\tany of the configuration files for spawning a new instance,\n"
"\tnor does it close the browser.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-instaweb.txt:64
#, no-wrap
msgid "restart"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:68
#, no-wrap
msgid ""
"`--restart::`\n"
"\tRestart the httpd instance and exit.  Regenerate configuration files\n"
"\tas necessary for spawning a new instance.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-instaweb.txt:70
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:73
msgid "You may specify configuration in your .git/config"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-instaweb.txt:81
#, no-wrap
msgid ""
"[instaweb]\n"
"\tlocal = true\n"
"\thttpd = apache2 -f\n"
"\tport = 4321\n"
"\tbrowser = konqueror\n"
"\tmodulePath = /usr/lib/apache2/modules\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-instaweb.txt:87
msgid ""
"If the configuration variable `instaweb.browser` is not set, `web.browser` "
"will be used instead if it is defined. See linkgit:git-web{litdd}browse[1] "
"for more information about this."
msgstr ""

