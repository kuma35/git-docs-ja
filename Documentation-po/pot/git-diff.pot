#. type: Title =
#: ../Documentation-sedout/git-diff.adoc:2
#, no-wrap
msgid "git-diff(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:7
msgid "git-diff - Show changes between commits, commit and working tree, etc"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:18
msgid ""
"git diff [<options>] [<commit>] [--] [<path>...] git diff [<options>] "
"--cached [--merge-base] [<commit>] [--] [<path>...] git diff [<options>] "
"[--merge-base] <commit> [<commit>...] <commit> [--] [<path>...] git diff "
"[<options>] <commit>...<commit> [--] [<path>...] git diff [<options>] <blob> "
"<blob> git diff [<options>] --no-index [--] <path> <path> [<pathspec>...]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff.adoc:20
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:25
msgid ""
"Show changes between the working tree and the index or a tree, changes "
"between the index and a tree, changes between two trees, changes resulting "
"from a merge, changes between two blob objects, or changes between two files "
"on disk."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:26
#, no-wrap
msgid "`git diff [<options>] [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:33
msgid ""
"This form is to view the changes you made relative to the index (staging "
"area for the next commit).  In other words, the differences are what you "
"_could_ tell Git to further add to the index but you still haven't.  You can "
"stage these changes by using linkgit:git-add[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:34
#, no-wrap
msgid "`git diff [<options>] --no-index [--] <path> <path> [<pathspec>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:46
msgid ""
"This form is to compare the given two paths on the filesystem.  You can omit "
"the `--no-index` option when running the command in a working tree "
"controlled by Git and at least one of the paths points outside the working "
"tree, or when running the command outside a working tree controlled by "
"Git. This form implies `--exit-code`. If both paths point to directories, "
"additional pathspecs may be provided. These will limit the files included in "
"the difference. All such pathspecs must be relative as they apply to both "
"sides of the diff."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:47
#, no-wrap
msgid "`git diff [<options>] --cached [--merge-base] [<commit>] [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:56
msgid ""
"This form is to view the changes you staged for the next commit relative to "
"the named _<commit>_.  Typically you would want comparison with the latest "
"commit, so if you do not give _<commit>_, it defaults to `HEAD`.  If `HEAD` "
"does not exist (e.g. unborn branches) and _<commit>_ is not given, it shows "
"all staged changes.  `--staged` is a synonym of `--cached`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:60
msgid ""
"If `--merge-base` is given, instead of using _<commit>_, use the merge base "
"of _<commit>_ and `HEAD`.  `git diff --cached --merge-base A` is equivalent "
"to `git diff --cached $(git merge-base A HEAD)`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:61
#, no-wrap
msgid "`git diff [<options>] [--merge-base] <commit> [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:68
msgid ""
"This form is to view the changes you have in your working tree relative to "
"the named _<commit>_.  You can use `HEAD` to compare it with the latest "
"commit, or a branch name to compare with the tip of a different branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:72
msgid ""
"If `--merge-base` is given, instead of using _<commit>_, use the merge base "
"of _<commit>_ and `HEAD`.  `git diff --merge-base A` is equivalent to `git "
"diff $(git merge-base A HEAD)`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:73
#, no-wrap
msgid "`git diff [<options>] [--merge-base] <commit> <commit> [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:77
msgid "This is to view the changes between two arbitrary _<commit>_."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:81
msgid ""
"If `--merge-base` is given, use the merge base of the two commits for the "
"\"before\" side.  `git diff --merge-base A B` is equivalent to `git diff "
"$(git merge-base A B) B`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:82
#, no-wrap
msgid "`git diff [<options>] <commit> <commit>...<commit> [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:90
msgid ""
"This form is to view the results of a merge commit.  The first listed "
"_<commit>_ must be the merge itself; the remaining two or more commits "
"should be its parents.  Convenient ways to produce the desired set of "
"revisions are to use the suffixes `@` and `^!`.  If `A` is a merge commit, "
"then `git diff A A^@`, `git diff A^!` and `git show A` all give the same "
"combined diff."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:91
#, no-wrap
msgid "`git diff [<options>] <commit>..<commit> [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:97
msgid ""
"This is synonymous to the earlier form (without the `..`) for viewing the "
"changes between two arbitrary _<commit>_.  If _<commit>_ on one side is "
"omitted, it will have the same effect as using `HEAD` instead."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:98
#, no-wrap
msgid "`git diff [<options>] <commit>...<commit> [--] [<path>...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:105
msgid ""
"This form is to view the changes on the branch containing and up to the "
"second _<commit>_, starting at a common ancestor of both _<commit>_.  `git "
"diff A...B` is equivalent to `git diff $(git merge-base A B) B`.  You can "
"omit any one of _<commit>_, which has the same effect as using `HEAD` "
"instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:114
msgid ""
"Just in case you are doing something exotic, it should be noted that all of "
"the _<commit>_ in the above description, except in the `--merge-base` case "
"and in the last two forms that use `..` notations, can be any _<tree>_. A "
"tree of interest is the one pointed to by the ref named `AUTO_MERGE`, which "
"is written by the `ort` merge strategy upon hitting merge conflicts (see "
"linkgit:git-merge[1]).  Comparing the working tree with `AUTO_MERGE` shows "
"changes you've made so far to resolve textual conflicts (see the examples "
"below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:121
msgid ""
"For a more complete list of ways to spell _<commit>_, see \"SPECIFYING "
"REVISIONS\" section in linkgit:gitrevisions[7].  However, `diff` is about "
"comparing two _endpoints_, not ranges, and the range notations "
"(`<commit>..<commit>` and `<commit>...<commit>`)  do not mean a range as "
"defined in the \"SPECIFYING RANGES\" section in linkgit:gitrevisions[7]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:122
#, no-wrap
msgid "`git diff [<options>] <blob> <blob>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:126
msgid ""
"This form is to view the differences between the raw contents of two blob "
"objects."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff.adoc:128
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:132
#, no-wrap
msgid "`-1`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:133
#, no-wrap
msgid "`--base`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:134
#, no-wrap
msgid "`-2`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:135
#, no-wrap
msgid "`--ours`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:136
#, no-wrap
msgid "`-3`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:137
#, no-wrap
msgid "`--theirs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:139
msgid "Compare the working tree with"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:142
msgid "the \"base\" version (stage #1) when using `-1` or `--base`,"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:143
msgid "\"our branch\" (stage #2) when using `-2` or `--ours`, or"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:144
msgid "\"their branch\" (stage #3) when using `-3` or `--theirs`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:149
msgid ""
"The index contains these stages only for unmerged entries i.e.  while "
"resolving conflicts.  See linkgit:git-read-tree[1] section \"3-Way Merge\" "
"for detailed information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:150
#, no-wrap
msgid "`-0`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:154
msgid ""
"Omit diff output for unmerged entries and just show \"Unmerged\".  Can be "
"used only when comparing the working tree with the index."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:155
#, no-wrap
msgid "`<path>...`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:159
msgid ""
"The _<path>_ parameters, when given, are used to limit the diff to the named "
"paths (you can give directory names and get diff for all files under them)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff.adoc:164
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:166
#, no-wrap
msgid "Various ways to check your working tree"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-diff.adoc:173
#, no-wrap
msgid ""
"$ git diff            <1>\n"
"$ git diff --cached   <2>\n"
"$ git diff HEAD       <3>\n"
"$ git diff AUTO_MERGE <4>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:176
msgid "Changes in the working tree not yet staged for the next commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:178
msgid ""
"Changes between the index and your last commit; what you would be committing "
"if you run `git commit` without `-a` option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:180
msgid ""
"Changes in the working tree since your last commit; what you would be "
"committing if you run `git commit -a`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:182
msgid "Changes in the working tree you've made to resolve textual conflicts so far."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:183
#, no-wrap
msgid "Comparing with arbitrary commits"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-diff.adoc:189
#, no-wrap
msgid ""
"$ git diff test            <1>\n"
"$ git diff HEAD -- ./test  <2>\n"
"$ git diff HEAD^ HEAD      <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:193
msgid ""
"Instead of using the tip of the current branch, compare with the tip of "
"\"test\" branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:196
msgid ""
"Instead of comparing with the tip of \"test\" branch, compare with the tip "
"of the current branch, but limit the comparison to the file \"test\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:197
msgid "Compare the version before the last commit and the last commit."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:198
#, no-wrap
msgid "Comparing branches"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-diff.adoc:204
#, no-wrap
msgid ""
"$ git diff topic master    <1>\n"
"$ git diff topic..master   <2>\n"
"$ git diff topic...master  <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:207
msgid "Changes between the tips of the topic and the master branches."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:208
msgid "Same as above."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:210
msgid ""
"Changes that occurred on the master branch since when the topic branch was "
"started off it."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:211
#, no-wrap
msgid "Limiting the diff output"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-diff.adoc:217
#, no-wrap
msgid ""
"$ git diff --diff-filter=MRC            <1>\n"
"$ git diff --name-status                <2>\n"
"$ git diff arch/i386 include/asm-i386   <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:221
msgid "Show only modification, rename, and copy, but not addition or deletion."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:223
msgid "Show only names and the nature of change, but not actual diff output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:224
msgid "Limit diff output to named subtrees."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff.adoc:225
#, no-wrap
msgid "Munging the diff output"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-diff.adoc:230
#, no-wrap
msgid ""
"$ git diff --find-copies-harder -B -C  <1>\n"
"$ git diff -R                          <2>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:234
msgid ""
"Spend extra cycles to find renames, copies and complete rewrites (very "
"expensive)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff.adoc:235
msgid "Output diff in reverse."
msgstr ""

