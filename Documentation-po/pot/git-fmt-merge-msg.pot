#. type: Title =
#: ../Documentation-sedout/git-fmt-merge-msg.txt:2
#, no-wrap
msgid "git-fmt-merge-msg(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:7
msgid "git-fmt-merge-msg - Produce a merge commit message"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:14
msgid ""
"'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | "
"--no-log] 'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F "
"<file>"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:20
msgid ""
"Takes the list of merged objects on stdin and produces a suitable commit "
"message to be used for the merge commit, usually to be passed as the "
"'<merge-message>' argument of 'git merge'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:23
msgid ""
"This command is intended mostly for internal use by scripts automatically "
"invoking 'git merge'."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:25
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:33
#, no-wrap
msgid ""
"`--log[=<n>]::`\n"
"\tIn addition to branch names, populate the log message with\n"
"\tone-line descriptions from the actual commits that are being\n"
"\tmerged.  At most <n> commits from each merge parent will be\n"
"\tused (20 if <n> is omitted).  This overrides the `merge.log`\n"
"\tconfiguration variable.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:37
#, no-wrap
msgid ""
"`--no-log::`\n"
"\tDo not list one-line descriptions from the actual commits being\n"
"\tmerged.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:41
#, no-wrap
msgid ""
"`--[no-]summary::`\n"
"\tSynonyms to --log and --no-log; these are deprecated and will be\n"
"\tremoved in the future.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:46
#, no-wrap
msgid ""
"`-m`\n"
"`--message`\n"
"\tUse <message> instead of the branch names for the first line\n"
"\tof the log message.  For use with `--log`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:50
#, no-wrap
msgid ""
"`--into-name`\n"
"\tPrepare the merge message as if merging to the branch `<branch>`,\n"
"\tinstead of the name of the real branch to which the merge is made.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:55
#, no-wrap
msgid ""
"`-F`\n"
"`--file`\n"
"\tTake the list of merged objects from <file> instead of\n"
"\tstdin.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:57
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.txt:60
#, no-wrap
msgid "merge.summary"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:63
msgid ""
"Synonym to `merge.log`; this is deprecated and will be removed in the "
"future."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:65
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:70
#, no-wrap
msgid ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:74
msgid ""
"Print a log message describing a merge of the \"master\" branch from the "
"\"origin\" remote."
msgstr ""

