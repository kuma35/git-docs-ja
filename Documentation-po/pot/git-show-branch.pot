#. type: Title =
#: ../Documentation-sedout/git-show-branch.adoc:2
#, no-wrap
msgid "git-show-branch(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:7
msgid "git-show-branch - Show branches and their commits"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:17
#, no-wrap
msgid ""
"\t'git show-branch' [-a | --all] [-r | --remotes] [--topo-order | "
"--date-order]\n"
"\t\t\t[--current] [--color[=<when>] | --no-color] [--sparse]\n"
"\t\t\t[--more=<n> | --list | --independent | --merge-base]\n"
"\t\t\t[--no-name | --sha1-name] [--topics]\n"
"\t\t\t[(<rev> | <glob>)...]\n"
"\t'git show-branch' (-g | --reflog)[=<n>[,<base>]] [--list] [<ref>]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:19
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:24
msgid ""
"Shows the commit ancestry graph starting from the commits named with <rev>s "
"or <glob>s (or all refs under refs/heads and/or refs/tags) semi-visually."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:26
msgid "It cannot show more than 26 branches and commits at a time."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:29
msgid ""
"It uses `showbranch.default` multi-valued configuration items if no <rev> or "
"<glob> is given on the command line."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:32
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:33
#, no-wrap
msgid "<rev>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:36
msgid ""
"Arbitrary extended SHA-1 expression (see linkgit:gitrevisions[7])  that "
"typically names a branch head or a tag."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:37
#, no-wrap
msgid "<glob>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:42
msgid ""
"A glob pattern that matches branch or tag names under refs/.  For example, "
"if you have many topic branches under refs/heads/topic, giving `topic/*` "
"would show all of them."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:43
#, no-wrap
msgid "`-r`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:44
#, no-wrap
msgid "`--remotes`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:46
msgid "Show the remote-tracking branches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:47
#, no-wrap
msgid "`-a`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:48
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:50
msgid "Show both remote-tracking branches and local branches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:51
#, no-wrap
msgid "`--current`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:55
msgid ""
"With this option, the command includes the current branch in the list of "
"revs to be shown when it is not given on the command line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:56
#, no-wrap
msgid "`--topo-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:61
msgid ""
"By default, the branches and their commits are shown in reverse "
"chronological order.  This option makes them appear in topological order "
"(i.e., descendant commits are shown before their parents)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:62
#, no-wrap
msgid "`--date-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:66
msgid ""
"This option is similar to `--topo-order` in the sense that no parent comes "
"before all of its children, but otherwise commits are ordered according to "
"their commit date."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:67
#, no-wrap
msgid "`--sparse`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:71
msgid ""
"By default, the output omits merges that are reachable from only one tip "
"being shown.  This option makes them visible."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:72
#, no-wrap
msgid "`--more=<n>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:78
msgid ""
"Usually the command stops output upon showing the commit that is the common "
"ancestor of all the branches.  This flag tells the command to go <n> more "
"common commits beyond that.  When <n> is negative, display only the <ref>s "
"given, without showing the commit ancestry tree."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:79
#, no-wrap
msgid "`--list`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:81
msgid "Synonym to `--more=-1`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:82
#, no-wrap
msgid "`--merge-base`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:88
msgid ""
"Instead of showing the commit list, determine possible merge bases for the "
"specified commits. All merge bases will be contained in all specified "
"commits. This is different from how linkgit:git-merge-base[1] handles the "
"case of three or more commits."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:89
#, no-wrap
msgid "`--independent`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:92
msgid ""
"Among the <ref>s given, display only the ones that cannot be reached from "
"any other <ref>."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:93
#, no-wrap
msgid "`--no-name`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:95
msgid "Do not show naming strings for each commit."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:96
#, no-wrap
msgid "`--sha1-name`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:101
msgid ""
"Instead of naming the commits using the path to reach them from heads "
"(e.g. \"master~2\" to mean the grandparent of \"master\"), name them with "
"the unique prefix of their object names."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:102
#, no-wrap
msgid "`--topics`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:109
msgid ""
"Shows only commits that are NOT on the first branch given.  This helps track "
"topic branches by hiding any commit that is already in the main line of "
"development.  When given \"git show-branch --topics master topic1 topic2\", "
"this will show the revisions given by \"git rev-list {caret}master topic1 "
"topic2\""
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:110
#, no-wrap
msgid "`-g`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:111
#, no-wrap
msgid "`--reflog[=<n>[,<base>]] [<ref>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:117
msgid ""
"Shows <n> most recent ref-log entries for the given ref.  If <base> is "
"given, <n> entries going back from that entry.  <base> can be specified as "
"count or date.  When no explicit <ref> parameter is given, it defaults to "
"the current branch (or `HEAD` if it is detached)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:118
#, no-wrap
msgid "`--color[=<when>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:122
msgid ""
"Color the status sign (one of these: `*` `!` `+` `-`) of each commit "
"corresponding to the branch it's in.  The value must be always (the "
"default), never, or auto."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-branch.adoc:123
#, no-wrap
msgid "`--no-color`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:127
msgid ""
"Turn off colored output, even when the configuration file gives the default "
"to color output.  Same as `--color=never`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:130
msgid ""
"Note that --more, --list, --independent, and --merge-base options are "
"mutually exclusive."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:133
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:139
msgid ""
"Given N <ref>s, the first N lines are the one-line description from their "
"commit message. The branch head that is pointed at by $GIT_DIR/HEAD is "
"prefixed with an asterisk `*` character while other heads are prefixed with "
"a `!` character."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:146
msgid ""
"Following these N lines, a one-line log for each commit is displayed, "
"indented N places.  If a commit is on the I-th branch, the I-th indentation "
"character shows a `+` sign; otherwise it shows a space.  Merge commits are "
"denoted by a `-` sign.  Each commit shows a short name that can be used as "
"an extended SHA-1 to name that commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:149
msgid ""
"The following example shows three branches, \"master\", \"fixes\", and "
"\"mhf\":"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-branch.adoc:155
#, no-wrap
msgid ""
"$ git show-branch master fixes mhf\n"
"* [master] Add 'git show-branch'.\n"
" ! [fixes] Introduce \"reset type\" flag to \"git reset\"\n"
"  ! [mhf] Allow \"+remote:local\" refspec to cause --force when fetching.\n"
"---\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-branch.adoc:167
#, no-wrap
msgid ""
"  + [mhf] Allow \"+remote:local\" refspec to cause --force when fetching.\n"
"  + [mhf~1] Use git-octopus when pulling more than one head.\n"
" +  [fixes] Introduce \"reset type\" flag to \"git reset\"\n"
"  + [mhf~2] \"git fetch --force\".\n"
"  + [mhf~3] Use .git/remote/origin, not .git/branches/origin.\n"
"  + [mhf~4] Make \"git pull\" and \"git fetch\" default to origin\n"
"  + [mhf~5] Infamous 'octopus merge'\n"
"  + [mhf~6] Retire git-parse-remote.\n"
"  + [mhf~7] Multi-head fetch.\n"
"  + [mhf~8] Start adding the $GIT_DIR/remotes/ support.\n"
"*++ [master] Add 'git show-branch'.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:174
msgid ""
"These three branches all forked from a common commit, [master], whose commit "
"message is \"Add \\'git show-branch'\".  The \"fixes\" branch adds one "
"commit \"Introduce \"reset type\" flag to \"git reset\"\". The \"mhf\" "
"branch adds many other commits.  The current branch is \"master\"."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:177
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:182
msgid ""
"If you keep your primary branches immediately under `refs/heads`, and topic "
"branches in subdirectories of it, having the following in the configuration "
"file may help:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-branch.adoc:187
#, no-wrap
msgid ""
"[showbranch]\n"
"\tdefault = --topo-order\n"
"\tdefault = heads/*\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:193
msgid ""
"With this, `git show-branch` without extra parameters would show only the "
"primary branches.  In addition, if you happen to be on your topic branch, it "
"is shown as well."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-branch.adoc:196
#, no-wrap
msgid "$ git show-branch --reflog=\"10,1 hour ago\" --list master\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-branch.adoc:201
msgid ""
"shows 10 reflog entries going back from the tip as of 1 hour ago.  Without "
"`--list`, the output also shows how these tips are topologically related to "
"each other."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-branch.adoc:203
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

