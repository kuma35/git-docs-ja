#. type: Title =
#: ../Documentation-sedout/git-check-mailmap.txt:2
#, no-wrap
msgid "git-check-mailmap(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:7
msgid "git-check-mailmap - Show canonical names and email addresses of contacts"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:13
msgid "'git check-mailmap' [<options>] <contact>..."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:22
msgid ""
"For each ``Name $$<user@host>$$'', ``$$<user@host>$$'', or ``$$user@host$$'' "
"from the command-line or standard input (when using `--stdin`), look up the "
"person's canonical name and email address (see \"Mapping Authors\" "
"below). If found, print them; otherwise print the input as-is."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:25
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:29
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tRead contacts, one per line, from the standard input after exhausting\n"
"\tcontacts provided on the command-line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:34
#, no-wrap
msgid ""
"`--mailmap-file=<file>::`\n"
"\tIn addition to any configured mailmap files, read the specified\n"
"\tmailmap file. Entries in this file take precedence over entries in\n"
"\teither the default mailmap file or any configured mailmap file.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:40
#, no-wrap
msgid ""
"`--mailmap-blob=<blob>::`\n"
"\tLike `--mailmap-file`, but consider the value as a reference to a\n"
"\tblob in the repository. If both `--mailmap-file` and\n"
"\t`--mailmap-blob` are specified, entries in `--mailmap-file` will\n"
"\ttake precedence.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:42
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:47
msgid ""
"For each contact, a single line is output, terminated by a newline.  If the "
"name is provided or known to the 'mailmap', ``Name $$<user@host>$$'' is "
"printed; otherwise only ``$$<user@host>$$'' is printed."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:50
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:54
msgid ""
"See `mailmap.file` and `mailmap.blob` in linkgit:git-config[1] for how to "
"specify a custom `.mailmap` target file or object."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:57
#, no-wrap
msgid "MAPPING AUTHORS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:60
msgid "See linkgit:gitmailmap[5]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-check-mailmap.txt:63
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-check-mailmap.txt:64
msgid "Part of the linkgit:git[1] suite"
msgstr ""
