#. type: Title =
#: ../Documentation-sedout/git-var.txt:2
#, no-wrap
msgid "git-var(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:7
msgid "git-var - Show a Git logical variable"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:13
msgid "'git var' (-l | <variable>)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:18
msgid ""
"Prints a Git logical variable. Exits with code 1 if the variable has no "
"value."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:20
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:21
#, no-wrap
msgid "`-l`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:26
msgid ""
"Display the logical variables. In addition, all the variables of the Git "
"configuration file .git/config are listed as well. (However, the "
"configuration variables listing functionality is deprecated in favor of `git "
"config -l`.)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:28
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:31
#, no-wrap
msgid ""
"\t$ git var GIT_AUTHOR_IDENT\n"
"\tEric W. Biederman <ebiederm@lnxi.com> 1121223278 -0600\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:34
#, no-wrap
msgid "VARIABLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:35
#, no-wrap
msgid "GIT_AUTHOR_IDENT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:37
msgid "The author of a piece of code."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:38
#, no-wrap
msgid "GIT_COMMITTER_IDENT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:40
msgid "The person who put a piece of code into Git."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:41
#, no-wrap
msgid "GIT_EDITOR"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:49
msgid ""
"Text editor for use by Git commands.  The value is meant to be interpreted "
"by the shell when it is used.  Examples: `~/bin/vi`, "
"`$SOME_ENVIRONMENT_VARIABLE`, `\"C:\\Program Files\\Vim\\gvim.exe\" "
"--nofork`.  The order of preference is the `$GIT_EDITOR` environment "
"variable, then `core.editor` configuration, then `$VISUAL`, then `$EDITOR`, "
"and then the default chosen at compile time, which is usually 'vi'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:51
#, no-wrap
msgid "    The build you are using chose '{git-default-editor}' as the default.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:53
#, no-wrap
msgid "GIT_SEQUENCE_EDITOR"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:60
msgid ""
"Text editor used to edit the 'todo' file while running `git rebase -i`. Like "
"`GIT_EDITOR`, the value is meant to be interpreted by the shell when it is "
"used. The order of preference is the `$GIT_SEQUENCE_EDITOR` environment "
"variable, then `sequence.editor` configuration, and then the value of `git "
"var GIT_EDITOR`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:61
#, no-wrap
msgid "GIT_PAGER"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:67
msgid ""
"Text viewer for use by Git commands (e.g., 'less').  The value is meant to "
"be interpreted by the shell.  The order of preference is the `$GIT_PAGER` "
"environment variable, then `core.pager` configuration, then `$PAGER`, and "
"then the default chosen at compile time (usually 'less')."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:69
#, no-wrap
msgid "    The build you are using chose '{git-default-pager}' as the default.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:71
#, no-wrap
msgid "GIT_DEFAULT_BRANCH"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:73
msgid "The name of the first branch created in newly initialized repositories."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:74
#, no-wrap
msgid "GIT_SHELL_PATH"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:76
msgid ""
"The path of the binary providing the POSIX shell for commands which use the "
"shell."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:77
#, no-wrap
msgid "GIT_ATTR_SYSTEM"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:79
msgid "The path to the system linkgit:gitattributes[5] file, if one is enabled."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:80
#, no-wrap
msgid "GIT_ATTR_GLOBAL"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:82
msgid "The path to the global (per-user) linkgit:gitattributes[5] file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:83
#, no-wrap
msgid "GIT_CONFIG_SYSTEM"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:85
msgid "The path to the system configuration file, if one is enabled."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-var.txt:86
#, no-wrap
msgid "GIT_CONFIG_GLOBAL"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:88
msgid "The path to the global (per-user) configuration files, if any."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:93
msgid ""
"Most path values contain only one value. However, some can contain multiple "
"values, which are separated by newlines, and are listed in order from "
"highest to lowest priority.  Callers should be prepared for any such path "
"value to contain multiple items."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-var.txt:96
msgid ""
"Note that paths are printed even if they do not exist, but not if they are "
"disabled by other environment variables."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-var.txt:98
#, no-wrap
msgid "SEE ALSO"
msgstr ""

