#. type: Title =
#: ../Documentation-sedout/git-init.adoc:2
#, no-wrap
msgid "git-init(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:7
msgid "git-init - Create an empty Git repository or reinitialize an existing one"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:17
#, no-wrap
msgid ""
"\tgit init [-q | --quiet] [--bare] [--template=<template-directory>]\n"
"\t\t [--separate-git-dir <git-dir>] [--object-format=<format>]\n"
"\t\t [--ref-format=<format>]\n"
"\t\t [-b <branch-name> | --initial-branch=<branch-name>]\n"
"\t\t [--shared[=<permissions>]] [<directory>]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:20
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:27
msgid ""
"This command creates an empty Git repository - basically a `.git` directory "
"with subdirectories for `objects`, `refs/heads`, `refs/tags`, and template "
"files.  An initial branch without any commits will be created (see the "
"`--initial-branch` option below for its name)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:30
msgid ""
"If the `GIT_DIR` environment variable is set then it specifies a path to use "
"instead of `./.git` for the base of the repository."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:35
msgid ""
"If the object storage directory is specified via the `GIT_OBJECT_DIRECTORY` "
"environment variable then the sha1 directories are created underneath; "
"otherwise, the default `$GIT_DIR/objects` directory is used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:40
msgid ""
"Running `git init` in an existing repository is safe. It will not overwrite "
"things that are already there. The primary reason for rerunning `git init` "
"is to pick up newly added templates (or to move the repository to another "
"place if `--separate-git-dir` is given)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:42
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:44
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:45
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:48
msgid "Only print error and warning messages; all other output will be suppressed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:49
#, no-wrap
msgid "`--bare`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:53
msgid ""
"Create a bare repository. If `GIT_DIR` environment is not set, it is set to "
"the current working directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:54
#, no-wrap
msgid "`--object-format=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:57
msgid ""
"Specify the given object _<format>_ (hash algorithm) for the repository.  "
"The valid values are `sha1` and (if enabled) `sha256`.  `sha1` is the "
"default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:60
#, no-wrap
msgid "`--ref-format=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:62
msgid ""
"Specify the given ref storage _<format>_ for the repository. The valid "
"values are:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:65
#, no-wrap
msgid "`--template=<template-directory>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:68
msgid ""
"Specify the directory from which templates will be used.  (See the "
"\"TEMPLATE DIRECTORY\" section below.)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:69
#, no-wrap
msgid "`--separate-git-dir=<git-dir>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:74
msgid ""
"Instead of initializing the repository as a directory to either `$GIT_DIR` "
"or `./.git/`, create a text file there containing the path to the actual "
"repository.  This file acts as a filesystem-agnostic Git symbolic link to "
"the repository."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:76
msgid ""
"If this is a reinitialization, the repository will be moved to the specified "
"path."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:77
#, no-wrap
msgid "`-b <branch-name>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:78
#, no-wrap
msgid "`--initial-branch=<branch-name>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:83
msgid ""
"Use _<branch-name>_ for the initial branch in the newly created repository.  "
"If not specified, fall back to the default name (currently `master`, but "
"this will change to `main` when Git 3.0 is released)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:88
msgid ""
"Use _<branch-name>_ for the initial branch in the newly created repository.  "
"If not specified, fall back to the default name `main`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:91
msgid ""
"The default name can be customized via the `init.defaultBranch` "
"configuration variable."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:92
#, no-wrap
msgid "`--shared[=(false|true|umask|group|all|world|everybody|<perm>)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:100
msgid ""
"Specify that the Git repository is to be shared amongst several users.  This "
"allows users belonging to the same group to push into that repository.  When "
"specified, the config variable `core.sharedRepository` is set so that files "
"and directories under `$GIT_DIR` are created with the requested "
"permissions.  When not specified, Git will use permissions reported by "
"`umask`(2)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:103
msgid ""
"The option can have the following values, defaulting to `group` if no value "
"is given:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:105
#, no-wrap
msgid "`umask`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:106
#, no-wrap
msgid "`false`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:110
msgid ""
"Use permissions reported by `umask`(2). The default, when `--shared` is not "
"specified."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:111
#, no-wrap
msgid "`group`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:112
#, no-wrap
msgid "`true`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:120
msgid ""
"Make the repository group-writable, (and `g+sx`, since the git group may not "
"be the primary group of all users). This is used to loosen the permissions "
"of an otherwise safe `umask`(2) value. Note that the umask still applies to "
"the other permission bits (e.g. if umask is `0022`, using `group` will not "
"remove read privileges from other (non-group) users). See `0xxx` for how to "
"exactly specify the repository permissions."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:121
#, no-wrap
msgid "`all`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:122
#, no-wrap
msgid "`world`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:123
#, no-wrap
msgid "`everybody`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:126
msgid "Same as `group`, but make the repository readable by all users."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:127
#, no-wrap
msgid "_<perm>_"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:137
msgid ""
"_<perm>_ is a 3-digit octal number prefixed with `0` and each file will have "
"mode _<perm>_. _<perm>_ will override users' `umask`(2)  value (and not only "
"loosen permissions as `group` and `all` do). `0640` will create a repository "
"which is group-readable, but not group-writable or accessible to "
"others. `0660` will create a repo that is readable and writable to the "
"current user and group, but inaccessible to others (directories and "
"executable files get their `x` bit from the `r` bit for corresponding "
"classes of users)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:142
msgid ""
"By default, the configuration flag `receive.denyNonFastForwards` is enabled "
"in shared repositories, so that you cannot force a non fast-forwarding push "
"into it."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:145
msgid ""
"If you provide a _<directory>_, the command is run inside it. If this "
"directory does not exist, it will be created."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:147
#, no-wrap
msgid "TEMPLATE DIRECTORY"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:151
msgid ""
"Files and directories in the template directory whose name do not start with "
"a dot will be copied to the `$GIT_DIR` after it is created."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:153
msgid "The template directory will be one of the following (in order):"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:155
msgid "the argument given with the `--template` option;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:157
msgid "the contents of the `$GIT_TEMPLATE_DIR` environment variable;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:159
msgid "the `init.templateDir` configuration variable; or"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:161
msgid "the default template directory: `/usr/share/git-core/templates`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:164
msgid ""
"The default template directory includes some directory structure, suggested "
"\"exclude patterns\" (see linkgit:gitignore[5]), and sample hook files."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:167
msgid ""
"The sample hooks are all disabled by default. To enable one of the sample "
"hooks rename it by removing its `.sample` suffix."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:169
msgid "See linkgit:githooks[5] for more general info on hook execution."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-init.adoc:171
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-init.adoc:173
#, no-wrap
msgid "Start a new Git repository for an existing code base"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-init.adoc:180
#, no-wrap
msgid ""
"$ cd /path/to/my/codebase\n"
"$ git init      <1>\n"
"$ git add .     <2>\n"
"$ git commit    <3>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:183
msgid "Create a `/path/to/my/codebase/.git` directory."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:184
msgid "Add all existing files to the index."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-init.adoc:185
msgid "Record the pristine state as the first commit in the history."
msgstr ""

