#. type: Title =
#: ../Documentation-sedout/git-fetch-pack.txt:2
#, no-wrap
msgid "git-fetch-pack(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fetch-pack.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:7
msgid "git-fetch-pack - Receive missing objects from another repository"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fetch-pack.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:16
#, no-wrap
msgid ""
"'git fetch-pack' [--all] [--quiet|-q] [--keep|-k] [--thin] [--include-tag]\n"
"\t[--upload-pack=<git-upload-pack>]\n"
"\t[--depth=<n>] [--no-progress]\n"
"\t[-v] <repository> [<refs>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fetch-pack.txt:18
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:21
msgid ""
"Usually you would want to use 'git fetch', which is a higher level wrapper "
"of this command, instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:27
msgid ""
"Invokes 'git-upload-pack' on a possibly remote repository and asks it to "
"send objects missing from this repository, to update the named heads.  The "
"list of commits available locally is found out by scanning the local refs/ "
"hierarchy and sent to 'git-upload-pack' running on the other end."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:31
msgid ""
"This command degenerates to download everything to complete the asked refs "
"from the remote side when the local side does not have a common ancestor "
"commit."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fetch-pack.txt:34
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:37
#, no-wrap
msgid ""
"`--all::`\n"
"\tFetch all remote refs.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:43
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tTake the list of refs from stdin, one per line. If there\n"
"\tare refs specified on the command line in addition to this\n"
"\toption, then the refs from stdin are processed after those\n"
"\ton the command line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:47
msgid ""
"If `--stateless-rpc` is specified together with this option then the list of "
"refs must be in packet format (pkt-line). Each ref must be in a separate "
"packet, and the list must end with a flush packet."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:52
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tPass `-q` flag to 'git unpack-objects'; this makes the\n"
"\tcloning process less verbose.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:59
#, no-wrap
msgid ""
"`-k::`\n"
"`--keep::`\n"
"\tDo not invoke 'git unpack-objects' on received data, but\n"
"\tcreate a single packfile out of it instead, and store it\n"
"\tin the object database. If provided twice then the pack is\n"
"\tlocked against repacking.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:63
#, no-wrap
msgid ""
"`--thin::`\n"
"\tFetch a \"thin\" pack, which records objects in deltified form based\n"
"\ton objects not included in the pack to reduce network traffic.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:69
#, no-wrap
msgid ""
"`--include-tag::`\n"
"\tIf the remote side supports it, annotated tags objects will\n"
"\tbe downloaded on the same connection as the other objects if\n"
"\tthe object the tag references is downloaded.  The caller must\n"
"\totherwise determine the tags this option made available.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:81
#, no-wrap
msgid ""
"`--upload-pack=<git-upload-pack>::`\n"
"\tUse this to specify the path to 'git-upload-pack' on the\n"
"\tremote side, if it is not found on your $PATH.\n"
"\tInstallations of sshd ignores the user's environment\n"
"\tsetup scripts for login shells (e.g. .bash_profile) and\n"
"\tyour privately installed git may not be found on the system\n"
"\tdefault $PATH.  Another workaround suggested is to set\n"
"\tup your $PATH in \".bashrc\", but this flag is for people\n"
"\twho do not want to pay the overhead for non-interactive\n"
"\tshells by having a lean .bashrc file (they set most of\n"
"\tthe things up in .bash_profile).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:84
#, no-wrap
msgid ""
"`--exec=<git-upload-pack>::`\n"
"\tSame as --upload-pack=<git-upload-pack>.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:89
#, no-wrap
msgid ""
"`--depth=<n>::`\n"
"\tLimit fetching to ancestor-chains not longer than n.\n"
"\t'git-upload-pack' treats the special depth 2147483647 as\n"
"\tinfinite even if there is an ancestor-chain that long.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:93
#, no-wrap
msgid ""
"`--shallow-since=<date>::`\n"
"\tDeepen or shorten the history of a shallow repository to\n"
"\tinclude all reachable commits after <date>.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:98
#, no-wrap
msgid ""
"`--shallow-exclude=<ref>::`\n"
"\tDeepen or shorten the history of a shallow repository to\n"
"\texclude commits reachable from a specified remote branch or tag.\n"
"\tThis option can be specified multiple times.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:103
#, no-wrap
msgid ""
"`--deepen-relative::`\n"
"\tArgument --depth specifies the number of commits from the\n"
"\tcurrent shallow boundary instead of from the tip of each\n"
"\tremote branch history.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:107
#, no-wrap
msgid ""
"`--refetch::`\n"
"\tSkips negotiating commits with the server in order to fetch all matching\n"
"\tobjects. Use to reapply a new partial clone blob/tree filter.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:110
#, no-wrap
msgid ""
"`--no-progress::`\n"
"\tDo not show the progress.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:114
#, no-wrap
msgid ""
"`--check-self-contained-and-connected::`\n"
"\tOutput \"connectivity-ok\" if the received pack is\n"
"\tself-contained and connected.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:117
#, no-wrap
msgid ""
"`-v::`\n"
"\tRun verbosely.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fetch-pack.txt:118
#, no-wrap
msgid "<repository>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:120
msgid "The URL to the remote repository."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fetch-pack.txt:121
#, no-wrap
msgid "<refs>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:125
msgid ""
"The remote heads to update from. This is relative to $GIT_DIR "
"(e.g. \"HEAD\", \"refs/heads/master\").  When unspecified, update from all "
"heads the remote side has."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fetch-pack.txt:129
msgid ""
"If the remote has enabled the options `uploadpack.allowTipSHA1InWant`, "
"`uploadpack.allowReachableSHA1InWant`, or `uploadpack.allowAnySHA1InWant`, "
"they may alternatively be 40-hex sha1s present on the remote."
msgstr ""

