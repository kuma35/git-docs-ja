#. type: Title =
#: ../Documentation-sedout/git-http-fetch.adoc:2
#, no-wrap
msgid "git-http-fetch(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:7
msgid "git-http-fetch - Download from a remote Git repository via HTTP"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:13
msgid ""
"'git http-fetch' [-c] [-t] [-a] [-d] [-v] [-w <filename>] [--recover] "
"[--stdin | --packfile=<hash> | <commit>] <URL>"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.adoc:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:17
msgid "Downloads a remote Git repository via HTTP."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:21
msgid ""
"This command always gets all objects. Historically, there were three options "
"`-a`, `-c` and `-t` for choosing which objects to download. They are now "
"silently ignored."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.adoc:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:24
#, no-wrap
msgid "commit-id"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:27
msgid "Either the hash or the filename under [URL]/refs/ to pull."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:28
#, no-wrap
msgid "`-a`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:29
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:30
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:32
msgid "These options are ignored for historical reasons."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:33
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:35
msgid "Report what is downloaded."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:36
#, no-wrap
msgid "`-w <filename>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:39
msgid ""
"Writes the commit-id into the specified filename under "
"$GIT_DIR/refs/<filename> on the local end after the transfer is complete."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:40
#, no-wrap
msgid "`--stdin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:43
msgid ""
"Instead of a commit id on the command line (which is not expected in this "
"case), 'git http-fetch' expects lines on stdin in the format"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:45
#, no-wrap
msgid "<commit-id>['\\t'<filename-as-in--w>]\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:46
#, no-wrap
msgid "`--packfile=<hash>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:54
msgid ""
"For internal use only. Instead of a commit id on the command line (which is "
"not expected in this case), 'git http-fetch' fetches the packfile directly "
"at the given URL and uses index-pack to generate corresponding .idx and "
".keep files.  The hash is used to determine the name of the temporary file "
"and is arbitrary. The output of index-pack is printed to stdout. Requires "
"--index-pack-args."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:55
#, no-wrap
msgid "`--index-pack-args=<args>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:58
msgid ""
"For internal use only. The command to run on the contents of the downloaded "
"pack. Arguments are URL-encoded separated by spaces."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.adoc:59
#, no-wrap
msgid "`--recover`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:62
msgid ""
"Verify that everything reachable from target is fetched.  Used after an "
"earlier fetch is interrupted."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.adoc:64
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.adoc:65
msgid "Part of the linkgit:git[1] suite"
msgstr ""
