#. type: Title =
#: ../Documentation-sedout/git-http-fetch.txt:2
#, no-wrap
msgid "git-http-fetch(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:7
msgid "git-http-fetch - Download from a remote Git repository via HTTP"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:13
msgid ""
"'git http-fetch' [-c] [-t] [-a] [-d] [-v] [-w <filename>] [--recover] "
"[--stdin | --packfile=<hash> | <commit>] <URL>"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:17
msgid "Downloads a remote Git repository via HTTP."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:21
msgid ""
"This command always gets all objects. Historically, there were three options "
"`-a`, `-c` and `-t` for choosing which objects to download. They are now "
"silently ignored."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.txt:24
#, no-wrap
msgid "commit-id"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:27
msgid "Either the hash or the filename under [URL]/refs/ to pull."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:32
#, no-wrap
msgid ""
"`-a,`\n"
"\tThese options are ignored for historical reasons.\n"
"`-v::`\n"
"\tReport what is downloaded.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:36
#, no-wrap
msgid ""
"`-w`\n"
"\tWrites the commit-id into the specified filename under "
"$GIT_DIR/refs/<filename> on\n"
"        the local end after the transfer is complete.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:40
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tInstead of a commit id on the command line (which is not expected in "
"this\n"
"\tcase), 'git http-fetch' expects lines on stdin in the format\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:42
#, no-wrap
msgid "\t\t<commit-id>['\\t'<filename-as-in--w>]\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:51
#, no-wrap
msgid ""
"`--packfile=<hash>::`\n"
"\tFor internal use only. Instead of a commit id on the command\n"
"\tline (which is not expected in\n"
"\tthis case), 'git http-fetch' fetches the packfile directly at the given\n"
"\tURL and uses index-pack to generate corresponding .idx and .keep files.\n"
"\tThe hash is used to determine the name of the temporary file and is\n"
"\tarbitrary. The output of index-pack is printed to stdout. Requires\n"
"\t--index-pack-args.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:55
#, no-wrap
msgid ""
"`--index-pack-args=<args>::`\n"
"\tFor internal use only. The command to run on the contents of the\n"
"\tdownloaded pack. Arguments are URL-encoded separated by spaces.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:59
#, no-wrap
msgid ""
"`--recover::`\n"
"\tVerify that everything reachable from target is fetched.  Used after\n"
"\tan earlier fetch is interrupted.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:61
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:62
msgid "Part of the linkgit:git[1] suite"
msgstr ""
