#. type: Title =
#: ../Documentation-sedout/git-quiltimport.adoc:2
#, no-wrap
msgid "git-quiltimport(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-quiltimport.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:7
msgid "git-quiltimport - Applies a quilt patchset onto the current branch"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-quiltimport.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:14
#, no-wrap
msgid ""
"\t'git quiltimport' [--dry-run | -n] [--author <author>] [--patches <dir>]\n"
"\t\t\t[--series <file>] [--keep-non-patch]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-quiltimport.adoc:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:21
msgid ""
"Applies a quilt patchset onto the current Git branch, preserving the patch "
"boundaries, patch order, and patch descriptions present in the quilt "
"patchset."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:27
msgid ""
"For each patch the code attempts to extract the author from the patch "
"description.  If that fails it falls back to the author specified with "
"--author.  If the --author flag was not given the patch description is "
"displayed and the user is asked to interactively enter the author of the "
"patch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:30
msgid ""
"If a subject is not found in the patch description the patch name is "
"preserved as the 1 line subject in the Git description."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-quiltimport.adoc:32
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:34
#, no-wrap
msgid "`-n`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:35
#, no-wrap
msgid "`--dry-run`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:40
msgid ""
"Walk through the patches in the series and warn if we cannot find all of the "
"necessary information to commit a patch.  At the time of this writing only "
"missing author information is warned about."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:41
#, no-wrap
msgid "`--author 'Author Name <Author Email>'`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:44
msgid ""
"The author name and email address to use when no author information can be "
"found in the patch description."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:45
#, no-wrap
msgid "`--patches <dir>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:47
msgid "The directory to find the quilt patches."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:51
msgid ""
"The default for the patch directory is 'patches' or the value of the "
"`$QUILT_PATCHES` environment variable."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:52
#, no-wrap
msgid "`--series <file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:54
msgid "The quilt series file."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:58
msgid ""
"The default for the series file is <patches>/series or the value of the "
"`$QUILT_SERIES` environment variable."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-quiltimport.adoc:59
#, no-wrap
msgid "`--keep-non-patch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:61
msgid "Pass `-b` flag to 'git mailinfo' (see linkgit:git-mailinfo[1])."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-quiltimport.adoc:63
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-quiltimport.adoc:64
msgid "Part of the linkgit:git[1] suite"
msgstr ""
