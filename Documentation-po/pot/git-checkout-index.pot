#. type: Title =
#: ../Documentation-sedout/git-checkout-index.txt:2
#, no-wrap
msgid "git-checkout-index(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:7
msgid "git-checkout-index - Copy files from the index to the working tree"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:18
#, no-wrap
msgid ""
"'git checkout-index' [-u] [-q] [-a] [-f] [-n] [--prefix=<string>]\n"
"\t\t   [--stage=<number>|all]\n"
"\t\t   [--temp]\n"
"\t\t   [--ignore-skip-worktree-bits]\n"
"\t\t   [-z] [--stdin]\n"
"\t\t   [--] [<file>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:20
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:23
msgid ""
"Copies all listed files from the index to the working directory (not "
"overwriting existing files)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:25
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:30
#, no-wrap
msgid ""
"`-u::`\n"
"`--index::`\n"
"\tupdate stat information for the checked out entries in\n"
"\tthe index file.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:34
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tbe quiet if files exist or are not in the index\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:38
#, no-wrap
msgid ""
"`-f::`\n"
"`--force::`\n"
"\tforces overwrite of existing files\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:44
#, no-wrap
msgid ""
"`-a::`\n"
"`--all::`\n"
"\tchecks out all files in the index except for those with the\n"
"\tskip-worktree bit set (see `--ignore-skip-worktree-bits`).\n"
"\tCannot be used together with explicit filenames.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:49
#, no-wrap
msgid ""
"`-n::`\n"
"`--no-create::`\n"
"\tDon't checkout new files, only refresh files already checked\n"
"\tout.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:53
#, no-wrap
msgid ""
"`--prefix=<string>::`\n"
"\tWhen creating files, prepend <string> (usually a directory\n"
"\tincluding a trailing /)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:58
#, no-wrap
msgid ""
"`--stage=<number>|all::`\n"
"\tInstead of checking out unmerged entries, copy out the\n"
"\tfiles from the named stage.  <number> must be between 1 and 3.\n"
"\tNote: --stage=all automatically implies --temp.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:63
#, no-wrap
msgid ""
"`--temp::`\n"
"\tInstead of copying the files to the working directory,\n"
"\twrite the content to temporary files.  The temporary name\n"
"\tassociations will be written to stdout.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:67
#, no-wrap
msgid ""
"`--ignore-skip-worktree-bits::`\n"
"\tCheck out all files, including those with the skip-worktree bit\n"
"\tset.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:72
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tInstead of taking a list of paths from the command line,\n"
"\tread the list of paths from the standard input.  Paths are\n"
"\tseparated by LF (i.e. one path per line) by default.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:76
#, no-wrap
msgid ""
"`-z::`\n"
"\tOnly meaningful with `--stdin`; paths are separated with\n"
"\tNUL character instead of LF.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout-index.txt:77
#, no-wrap
msgid "\\--"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:79
msgid "Do not interpret any more arguments as options."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:81
msgid "The order of the flags used to matter, but not anymore."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:85
msgid ""
"Just doing `git checkout-index` does nothing. You probably meant `git "
"checkout-index -a`. And if you want to force it, you want `git "
"checkout-index -f -a`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:89
msgid ""
"Intuitiveness is not the goal here. Repeatability is. The reason for the "
"\"no arguments means no work\" behavior is that from scripts you are "
"supposed to be able to do:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:92
#, no-wrap
msgid "$ find . -name '*.h' -print0 | xargs -0 git checkout-index -f --\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:98
msgid ""
"which will force all existing `*.h` files to be replaced with their cached "
"copies. If an empty command line implied \"all\", then this would "
"force-refresh everything in the index, which was not the point.  But since "
"'git checkout-index' accepts --stdin it would be faster to use:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:101
#, no-wrap
msgid "$ find . -name '*.h' -print0 | git checkout-index -f -z --stdin\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:106
msgid ""
"The `--` is just a good idea when you know the rest will be filenames; it "
"will prevent problems with a filename of, for example, `-a`.  Using `--` is "
"probably a good policy in scripts."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:109
#, no-wrap
msgid "Using --temp or --stage=all"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:116
msgid ""
"When `--temp` is used (or implied by `--stage=all`)  'git checkout-index' "
"will create a temporary file for each index entry being checked out.  The "
"index will not be updated with stat information.  These options can be "
"useful if the caller needs all stages of all unmerged entries so that the "
"unmerged files can be processed by an external merge tool."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:120
msgid ""
"A listing will be written to stdout providing the association of temporary "
"file names to tracked path names.  The listing format has two variations:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:123
#, no-wrap
msgid ". tempname TAB path RS\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:129
msgid ""
"The first format is what gets used when `--stage` is omitted or is not "
"`--stage=all`. The field tempname is the temporary file name holding the "
"file content and path is the tracked path name in the index.  Only the "
"requested entries are output."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:132
#, no-wrap
msgid ". stage1temp SP stage2temp SP stage3tmp TAB path RS\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:139
msgid ""
"The second format is what gets used when `--stage=all`.  The three stage "
"temporary fields (stage1temp, stage2temp, stage3temp) list the name of the "
"temporary file if there is a stage entry in the index or `.` if there is no "
"stage entry.  Paths which only have a stage 0 entry will always be omitted "
"from the output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:146
msgid ""
"In both formats RS (the record separator) is newline by default but will be "
"the null byte if -z was passed on the command line.  The temporary file "
"names are always safe strings; they will never contain directory separators "
"or whitespace characters.  The path field is always relative to the current "
"directory and the temporary file names are always relative to the top level "
"directory."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:150
msgid ""
"If the object being copied out to a temporary file is a symbolic link the "
"content of the link will be written to a normal file.  It is up to the "
"end-user or the Porcelain to make use of this information."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-checkout-index.txt:153
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout-index.txt:154
#, no-wrap
msgid "To update and refresh only the files already checked out"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:158
#, no-wrap
msgid ""
"$ git checkout-index -n -f -a && git update-index --ignore-missing "
"--refresh\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout-index.txt:160
#, no-wrap
msgid "Using 'git checkout-index' to \"export an entire tree\""
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:164
msgid ""
"The prefix ability basically makes it trivial to use 'git checkout-index' as "
"an \"export as tree\" function.  Just read the desired tree into the index, "
"and do:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:167
#, no-wrap
msgid "$ git checkout-index --prefix=git-export-dir/ -a\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:171
msgid "`git checkout-index` will \"export\" the index into the specified directory."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:175
msgid ""
"The final \"/\" is important. The exported name is literally just prefixed "
"with the specified string.  Contrast this with the following example."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-checkout-index.txt:176
#, no-wrap
msgid "Export files with a prefix"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-checkout-index.txt:180
#, no-wrap
msgid "$ git checkout-index --prefix=.merged- Makefile\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-checkout-index.txt:184
msgid ""
"This will check out the currently cached copy of `Makefile` into the file "
"`.merged-Makefile`."
msgstr ""

