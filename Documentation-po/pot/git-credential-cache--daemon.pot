#. type: Title =
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:2
#, no-wrap
msgid "git-credential-cache{litdd}daemon(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:7
msgid "git-credential-cache--daemon - Temporarily store user credentials in memory"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:12
#, no-wrap
msgid "\t'git credential-cache{litdd}daemon' [--debug] <socket-path>\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:14
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:18
msgid ""
"You probably don't want to invoke this command yourself; it is started "
"automatically when you use linkgit:git-credential-cache[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:23
msgid ""
"This command listens on the Unix domain socket specified by `<socket-path>` "
"for `git-credential-cache` clients. Clients may store and retrieve "
"credentials. Each credential is held for a timeout specified by the client; "
"once no credentials are held, the daemon exits."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:27
msgid ""
"If the `--debug` option is specified, the daemon does not close its stderr "
"stream, and may output extra diagnostics to it even after it has begun "
"listening for clients."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:29
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-credential-cache--daemon.adoc:30
msgid "Part of the linkgit:git[1] suite"
msgstr ""
