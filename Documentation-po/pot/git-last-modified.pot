#. type: Title =
#: ../Documentation-sedout/git-last-modified.adoc:2
#, no-wrap
msgid "git-last-modified(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:7
msgid "git-last-modified - EXPERIMENTAL: Show when files were last modified"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:13
#, no-wrap
msgid ""
"\tgit last-modified [--recursive] [--show-trees] [<revision-range>] [[--] "
"<path>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:19
msgid ""
"Shows which commit last modified each of the relevant files and "
"subdirectories.  A commit renaming a path, or changing it's mode is also "
"taken into account."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:21
msgid "THIS COMMAND IS EXPERIMENTAL. THE BEHAVIOR MAY CHANGE."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:25
#, no-wrap
msgid "`-r`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:26
#, no-wrap
msgid "`--recursive`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:29
msgid ""
"Instead of showing tree entries, step into subtrees and show all entries "
"inside them recursively."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:30
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:31
#, no-wrap
msgid "`--show-trees`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:34
msgid ""
"Show tree entries even when recursing into them. It has no effect without "
"`--recursive`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:35
#, no-wrap
msgid "`<revision-range>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:41
msgid ""
"Only traverse commits in the specified revision range. When no "
"`<revision-range>` is specified, it defaults to `HEAD` (i.e. the whole "
"history leading to the current commit). For a complete list of ways to spell "
"`<revision-range>`, see the 'Specifying Ranges' section of "
"linkgit:gitrevisions[7]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:42
#, no-wrap
msgid "`[--] <path>...`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:46
msgid ""
"For each _<path>_ given, the commit which last modified it is returned.  "
"Without an optional path parameter, all files and subdirectories in path "
"traversal the are included in the output."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:48
#, no-wrap
msgid "SEE ALSO"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:51
msgid "linkgit:git-blame[1], linkgit:git-log[1]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:53
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:54
msgid "Part of the linkgit:git[1] suite"
msgstr ""
