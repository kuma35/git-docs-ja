#. type: Labeled list
#: ../Documentation-sedout/diff-context-options.adoc:1
#, no-wrap
msgid "`-U<n>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-context-options.adoc:2
#, no-wrap
msgid "`--unified=<n>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-context-options.adoc:5
msgid ""
"Generate diffs with _<n>_ lines of context. Defaults to `diff.context` or 3 "
"if the config option is unset."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-context-options.adoc:6
#, no-wrap
msgid "`--inter-hunk-context=<n>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-context-options.adoc:10
msgid ""
"Show the context between diff hunks, up to the specified _<number>_ of "
"lines, thereby fusing hunks that are close to each other.  Defaults to "
"`diff.interHunkContext` or 0 if the config option is unset."
msgstr ""
