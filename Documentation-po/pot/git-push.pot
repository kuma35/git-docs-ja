#: ../Documentation-sedout/git-push.txt:708
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-push.txt:709
msgid "Part of the linkgit:git[1] suite"
msgstr ""
