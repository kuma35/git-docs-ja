#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:17
#, no-wrap
msgid "`--no-stat`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:19
msgid "Generate plain patches without any diffstats."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:23
#, no-wrap
msgid "`-u`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:24
#, no-wrap
msgid "`--patch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:26
msgid "Generate patch (see <<generate_patch_text_with_p>>)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:28
#: ../Documentation-sedout/diff-options.adoc:152
#, no-wrap
msgid "\tThis is the default.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:30
#, no-wrap
msgid "`-s`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:31
#, no-wrap
msgid "`--no-patch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:36
msgid ""
"Suppress all output from the diff machinery.  Useful for commands like `git "
"show` that show the patch by default to squelch their output, or to cancel "
"the effect of options like `--patch`, `--stat` earlier on the command line "
"in an alias."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:40
#, no-wrap
msgid "`-m`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:44
msgid ""
"Show diffs for merge commits in the default format. This is similar to "
"`--diff-merges=on`, except `-m` will produce no output unless `-p` is given "
"as well."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:45
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:48
msgid ""
"Produce combined diff output for merge commits.  Shortcut for "
"`--diff-merges=combined -p`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:49
#, no-wrap
msgid "`--cc`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:52
msgid ""
"Produce dense combined diff output for merge commits.  Shortcut for "
"`--diff-merges=dense-combined -p`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:53
#, no-wrap
msgid "`--dd`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:57
msgid ""
"Produce diff with respect to first parent for both merge and regular "
"commits.  Shortcut for `--diff-merges=first-parent -p`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:58
#, no-wrap
msgid "`--remerge-diff`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:61
msgid ""
"Produce remerge-diff output for merge commits.  Shortcut for "
"`--diff-merges=remerge -p`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:62
#, no-wrap
msgid "`--no-diff-merges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:64
msgid "Synonym for `--diff-merges=off`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:65
#, no-wrap
msgid "`--diff-merges=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:69
msgid ""
"Specify diff format to be used for merge commits. Default is "
"{diff-merges-default} unless `--first-parent` is in use, in which case "
"`first-parent` is the default."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:71
msgid "The following formats are supported:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:73
#, no-wrap
msgid "`off`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:74
#: ../Documentation-sedout/diff-options.adoc:471
#, no-wrap
msgid "`none`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:77
msgid "Disable output of diffs for merge commits. Useful to override implied value."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:78
#, no-wrap
msgid "`on`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:79
#, no-wrap
msgid "`m`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:84
msgid ""
"Make diff output for merge commits to be shown in the default format. The "
"default format can be changed using `log.diffMerges` configuration variable, "
"whose default value is `separate`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:85
#, no-wrap
msgid "`first-parent`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:86
#, no-wrap
msgid "`1`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:89
msgid ""
"Show full diff with respect to first parent. This is the same format as "
"`--patch` produces for non-merge commits."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:90
#, no-wrap
msgid "`separate`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:93
msgid ""
"Show full diff with respect to each of parents.  Separate log entry and diff "
"is generated for each parent."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:94
#, no-wrap
msgid "`combined`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:95
#, no-wrap
msgid "`c`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:100
msgid ""
"Show differences from each of the parents to the merge result simultaneously "
"instead of showing pairwise diff between a parent and the result one at a "
"time. Furthermore, it lists only files which were modified from all parents."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:101
#, no-wrap
msgid "`dense-combined`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:102
#, no-wrap
msgid "`cc`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:107
msgid ""
"Further compress output produced by `--diff-merges=combined` by omitting "
"uninteresting hunks whose contents in the parents have only two variants and "
"the merge result picks one of them without modification."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:108
#, no-wrap
msgid "`remerge`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:109
#, no-wrap
msgid "`r`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:113
msgid ""
"Remerge two-parent merge commits to create a temporary tree "
"object--potentially containing files with conflict markers and such.  A diff "
"is then shown between that temporary tree and the actual merge commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:118
msgid ""
"The output emitted when this option is used is subject to change, and so is "
"its interaction with other options (unless explicitly documented)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:120
#, no-wrap
msgid "`--combined-all-paths`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:126
msgid ""
"Cause combined diffs (used for merge commits) to list the name of the file "
"from all parents.  It thus only has effect when "
"`--diff-merges=[dense-]combined` is in use, and is likely only useful if "
"filename changes are detected (i.e.  when either rename or copy detection "
"have been requested)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:128
#, no-wrap
msgid "`-U<n>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:129
#, no-wrap
msgid "`--unified=<n>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:132
msgid "Generate diffs with _<n>_ lines of context instead of the usual three."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:134
#: ../Documentation-sedout/diff-options.adoc:545
#, no-wrap
msgid "\tImplies `--patch`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:136
#, no-wrap
msgid "`--output=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:138
msgid "Output to a specific file instead of stdout."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:139
#, no-wrap
msgid "`--output-indicator-new=<char>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:140
#, no-wrap
msgid "`--output-indicator-old=<char>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:141
#, no-wrap
msgid "`--output-indicator-context=<char>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:145
msgid ""
"Specify the character used to indicate new, old or context lines in the "
"generated patch. Normally they are `+`, `-` and ' ' respectively."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:147
#, no-wrap
msgid "`--raw`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:150
#, no-wrap
msgid "\tGenerate the diff in raw format.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:160
#, no-wrap
msgid ""
"\tFor each commit, show a summary of changes using the raw diff\n"
"\tformat. See the \"RAW OUTPUT FORMAT\" section of\n"
"\tlinkgit:git-diff[1]. This is different from showing the log\n"
"\titself in raw format, which you can achieve with\n"
"\t`--format=raw`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:164
#, no-wrap
msgid "`--patch-with-raw`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:166
msgid "Synonym for `-p --raw`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:169
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:171
msgid "Show the tree objects in the diff output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:173
#, no-wrap
msgid "`--indent-heuristic`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:176
msgid ""
"Enable the heuristic that shifts diff hunk boundaries to make patches easier "
"to read. This is the default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:177
#, no-wrap
msgid "`--no-indent-heuristic`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:179
msgid "Disable the indent heuristic."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:180
#, no-wrap
msgid "`--minimal`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:183
#: ../Documentation-sedout/diff-options.adoc:210
msgid "Spend extra time to make sure the smallest possible diff is produced."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:184
#, no-wrap
msgid "`--patience`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:186
msgid "Generate a diff using the \"patience diff\" algorithm."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:187
#, no-wrap
msgid "`--histogram`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:189
msgid "Generate a diff using the \"histogram diff\" algorithm."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:190
#, no-wrap
msgid "`--anchored=<text>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:192
msgid "Generate a diff using the \"anchored diff\" algorithm."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:194
msgid "This option may be specified more than once."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:199
msgid ""
"If a line exists in both the source and destination, exists only once, and "
"starts with _<text>_, this algorithm attempts to prevent it from appearing "
"as a deletion or addition in the output. It uses the \"patience diff\" "
"algorithm internally."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:200
#, no-wrap
msgid "`--diff-algorithm=(patience|minimal|histogram|myers)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:202
msgid "Choose a diff algorithm. The variants are as follows:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:204
#: ../Documentation-sedout/diff-options.adoc:389
#, no-wrap
msgid "`default`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:205
#, no-wrap
msgid "`myers`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:207
msgid "The basic greedy diff algorithm. Currently, this is the default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:207
#, no-wrap
msgid "`minimal`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:210
#, no-wrap
msgid "`patience`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:212
msgid "Use \"patience diff\" algorithm when generating patches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:212
#, no-wrap
msgid "`histogram`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:215
msgid ""
"This algorithm extends the patience algorithm to \"support low-occurrence "
"common elements\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:220
msgid ""
"For instance, if you configured the `diff.algorithm` variable to a "
"non-default value and want to use the default one, then you have to use "
"`--diff-algorithm=default` option."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:221
#, no-wrap
msgid "`--stat[=<width>[,<name-width>[,<count>]]]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:236
msgid ""
"Generate a diffstat. By default, as much space as necessary will be used for "
"the filename part, and the rest for the graph part. Maximum width defaults "
"to terminal width, or 80 columns if not connected to a terminal, and can be "
"overridden by _<width>_. The width of the filename part can be limited by "
"giving another width _<name-width>_ after a comma or by setting "
"`diff.statNameWidth=<name-width>`. The width of the graph part can be "
"limited by using `--stat-graph-width=<graph-width>` or by setting "
"`diff.statGraphWidth=<graph-width>`. Using `--stat` or `--stat-graph-width` "
"affects all commands generating a stat graph, while setting "
"`diff.statNameWidth` or `diff.statGraphWidth` does not affect `git "
"format-patch`.  By giving a third parameter _<count>_, you can limit the "
"output to the first _<count>_ lines, followed by `...` if there are more."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:239
msgid ""
"These parameters can also be set individually with `--stat-width=<width>`, "
"`--stat-name-width=<name-width>` and `--stat-count=<count>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:240
#, no-wrap
msgid "`--compact-summary`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:247
msgid ""
"Output a condensed summary of extended header information such as file "
"creations or deletions (\"new\" or \"gone\", optionally `+l` if it's a "
"symlink) and mode changes (`+x` or `-x` for adding or removing executable "
"bit respectively) in diffstat. The information is put between the filename "
"part and the graph part. Implies `--stat`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:248
#, no-wrap
msgid "`--numstat`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:254
msgid ""
"Similar to `--stat`, but shows number of added and deleted lines in decimal "
"notation and pathname without abbreviation, to make it more machine "
"friendly.  For binary files, outputs two `-` instead of saying `0 0`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:255
#, no-wrap
msgid "`--shortstat`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:259
msgid ""
"Output only the last line of the `--stat` format containing total number of "
"modified files, as well as number of added and deleted lines."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:260
#, no-wrap
msgid "`-X [<param>,...]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:261
#, no-wrap
msgid "`--dirstat[=<param>,...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:268
msgid ""
"Output the distribution of relative amount of changes for each "
"sub-directory. The behavior of `--dirstat` can be customized by passing it a "
"comma separated list of parameters.  The defaults are controlled by the "
"`diff.dirstat` configuration variable (see linkgit:git-config[1]).  The "
"following parameters are available:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:270
#, no-wrap
msgid "`changes`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:276
msgid ""
"Compute the dirstat numbers by counting the lines that have been removed "
"from the source, or added to the destination. This ignores the amount of "
"pure code movements within a file.  In other words, rearranging lines in a "
"file is not counted as much as other changes.  This is the default behavior "
"when no parameter is given."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:276
#, no-wrap
msgid "`lines`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:284
msgid ""
"Compute the dirstat numbers by doing the regular line-based diff analysis, "
"and summing the removed/added line counts. (For binary files, count 64-byte "
"chunks instead, since binary files have no natural concept of lines). This "
"is a more expensive `--dirstat` behavior than the `changes` behavior, but it "
"does count rearranged lines within a file as much as other changes. The "
"resulting output is consistent with what you get from the other `--*stat` "
"options."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:284
#, no-wrap
msgid "`files`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:289
msgid ""
"Compute the dirstat numbers by counting the number of files changed.  Each "
"changed file counts equally in the dirstat analysis. This is the "
"computationally cheapest `--dirstat` behavior, since it does not have to "
"look at the file contents at all."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:289
#, no-wrap
msgid "`cumulative`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:294
msgid ""
"Count changes in a child directory for the parent directory as well.  Note "
"that when using `cumulative`, the sum of the percentages reported may exceed "
"100%. The default (non-cumulative) behavior can be specified with the "
"`noncumulative` parameter."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:294
#, no-wrap
msgid "_<limit>_"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:298
msgid ""
"An integer parameter specifies a cut-off percent (3% by default).  "
"Directories contributing less than this percentage of the changes are not "
"shown in the output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:304
msgid ""
"Example: The following will count changed files, while ignoring directories "
"with less than 10% of the total amount of changed files, and accumulating "
"child directory counts in the parent directories: "
"`--dirstat=files,10,cumulative`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:305
#, no-wrap
msgid "`--cumulative`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:307
msgid "Synonym for `--dirstat=cumulative`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:308
#, no-wrap
msgid "`--dirstat-by-file[=<param>,...]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:310
msgid "Synonym for `--dirstat=files,<param>,...`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:311
#, no-wrap
msgid "`--summary`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:314
msgid ""
"Output a condensed summary of extended header information such as creations, "
"renames and mode changes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:316
#, no-wrap
msgid "`--patch-with-stat`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:318
msgid "Synonym for `-p --stat`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:322
#, no-wrap
msgid "`-z`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:325
#, no-wrap
msgid "\tSeparate the commits with __NUL__s instead of newlines.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:328
msgid ""
"Also, when `--raw` or `--numstat` has been given, do not munge pathnames and "
"use __NUL__s as output field terminators."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:332
#, no-wrap
msgid ""
"\tWhen `--raw`, `--numstat`, `--name-only` or `--name-status` has been\n"
"\tgiven, do not munge pathnames and use NULs as output field terminators.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:337
msgid ""
"Without this option, pathnames with \"unusual\" characters are quoted as "
"explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:338
#, no-wrap
msgid "`--name-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:343
msgid ""
"Show only the name of each changed file in the post-image tree.  The file "
"names are often encoded in UTF-8.  For more information see the discussion "
"about encoding in the linkgit:git-log[1] manual page."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:344
#, no-wrap
msgid "`--name-status`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:348
msgid ""
"Show only the name(s) and status of each changed file. See the description "
"of the `--diff-filter` option on what the status letters mean.  Just like "
"`--name-only` the file names are often encoded in UTF-8."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:349
#, no-wrap
msgid "`--submodule[=<format>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:360
msgid ""
"Specify how differences in submodules are shown.  When specifying "
"`--submodule=short` the `short` format is used.  This format just shows the "
"names of the commits at the beginning and end of the range.  When "
"`--submodule` or `--submodule=log` is specified, the `log` format is used.  "
"This format lists the commits in the range like linkgit:git-submodule[1] "
"`summary` does.  When `--submodule=diff` is specified, the `diff` format is "
"used.  This format shows an inline diff of the changes in the submodule "
"contents between the commit range.  Defaults to `diff.submodule` or the "
"`short` format if the config option is unset."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:361
#, no-wrap
msgid "`--color[=<when>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:365
msgid ""
"Show colored diff.  `--color` (i.e. without `=<when>`) is the same as "
"`--color=always`.  _<when>_ can be one of `always`, `never`, or `auto`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:368
#, no-wrap
msgid ""
"\tIt can be changed by the `color.ui` and `color.diff`\n"
"\tconfiguration settings.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:370
#, no-wrap
msgid "`--no-color`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:372
msgid "Turn off colored diff."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:374
#, no-wrap
msgid "\tThis can be used to override configuration settings.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:376
#, no-wrap
msgid "\tIt is the same as `--color=never`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:377
#, no-wrap
msgid "`--color-moved[=<mode>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:379
msgid "Moved lines of code are colored differently."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:381
#, no-wrap
msgid "\tIt can be changed by the `diff.colorMoved` configuration setting.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:385
#, no-wrap
msgid ""
"\tThe _<mode>_ defaults to `no` if the option is not given\n"
"\tand to `zebra` if the option with no mode is given.\n"
"\tThe mode must be one of:\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:387
#: ../Documentation-sedout/diff-options.adoc:429
#, no-wrap
msgid "`no`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:389
msgid "Moved lines are not highlighted."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:392
msgid ""
"Is a synonym for `zebra`. This may change to a more sensible mode in the "
"future."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:392
#: ../Documentation-sedout/diff-options.adoc:460
#, no-wrap
msgid "`plain`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:399
msgid ""
"Any line that is added in one location and was removed in another location "
"will be colored with `color.diff.newMoved`.  Similarly `color.diff.oldMoved` "
"will be used for removed lines that are added somewhere else in the "
"diff. This mode picks up any moved line, but it is not very useful in a "
"review to determine if a block of code was moved without permutation."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:399
#, no-wrap
msgid "`blocks`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:404
msgid ""
"Blocks of moved text of at least 20 alphanumeric characters are detected "
"greedily. The detected blocks are painted using either the "
"`color.diff.(old|new)Moved` color.  Adjacent blocks cannot be told apart."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:404
#, no-wrap
msgid "`zebra`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:409
msgid ""
"Blocks of moved text are detected as in `blocks` mode. The blocks are "
"painted using either the `color.diff.(old|new)Moved` color or "
"`color.diff.(old|new)MovedAlternative`. The change between the two colors "
"indicates that a new block was detected."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:409
#, no-wrap
msgid "`dimmed-zebra`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:414
msgid ""
"Similar to `zebra`, but additional dimming of uninteresting parts of moved "
"code is performed. The bordering lines of two adjacent blocks are considered "
"interesting, the rest is uninteresting.  `dimmed_zebra` is a deprecated "
"synonym."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:416
#, no-wrap
msgid "`--no-color-moved`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:419
msgid ""
"Turn off move detection. This can be used to override configuration "
"settings. It is the same as `--color-moved=no`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:420
#, no-wrap
msgid "`--color-moved-ws=<mode>,...`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:423
msgid ""
"This configures how whitespace is ignored when performing the move detection "
"for `--color-moved`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:425
#, no-wrap
msgid "\tIt can be set by the `diff.colorMovedWS` configuration setting.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:427
#, no-wrap
msgid "\tThese modes can be given as a comma separated list:\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:431
msgid "Do not ignore whitespace when performing move detection."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:431
#, no-wrap
msgid "`ignore-space-at-eol`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:433
#: ../Documentation-sedout/diff-options.adoc:787
msgid "Ignore changes in whitespace at EOL."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:433
#, no-wrap
msgid "`ignore-space-change`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:437
#: ../Documentation-sedout/diff-options.adoc:793
msgid ""
"Ignore changes in amount of whitespace.  This ignores whitespace at line "
"end, and considers all other sequences of one or more whitespace characters "
"to be equivalent."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:437
#, no-wrap
msgid "`ignore-all-space`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:440
msgid ""
"Ignore whitespace when comparing lines. This ignores differences even if one "
"line has whitespace where the other line has none."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:440
#, no-wrap
msgid "`allow-indentation-change`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:445
msgid ""
"Initially ignore any whitespace in the move detection, then group the moved "
"code blocks only into a block if the change in whitespace is the same per "
"line. This is incompatible with the other modes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:447
#, no-wrap
msgid "`--no-color-moved-ws`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:451
msgid ""
"Do not ignore whitespace when performing move detection. This can be used to "
"override configuration settings. It is the same as `--color-moved-ws=no`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:452
#, no-wrap
msgid "`--word-diff[=<mode>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:456
msgid ""
"By default, words are delimited by whitespace; see `--word-diff-regex` "
"below.  The _<mode>_ defaults to `plain`, and must be one of:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:458
#, no-wrap
msgid "`color`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:460
msgid "Highlight changed words using only colors.  Implies `--color`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:464
msgid ""
"Show words as ++[-removed-]++ and ++{+added+}++.  Makes no attempts to "
"escape the delimiters if they appear in the input, so the output may be "
"ambiguous."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:464
#, no-wrap
msgid "`porcelain`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:471
msgid ""
"Use a special line-based format intended for script consumption.  "
"Added/removed/unchanged runs are printed in the usual unified diff format, "
"starting with a `+`/`-`/` ` character at the beginning of the line and "
"extending to the end of the line.  Newlines in the input are represented by "
"a tilde `~` on a line of its own."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:473
msgid "Disable word diff again."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:477
msgid ""
"Note that despite the name of the first mode, color is used to highlight the "
"changed parts in all modes if enabled."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:478
#, no-wrap
msgid "`--word-diff-regex=<regex>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:482
msgid ""
"Use _<regex>_ to decide what a word is, instead of considering runs of "
"non-whitespace to be a word.  Also implies `--word-diff` unless it was "
"already enabled."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:490
msgid ""
"Every non-overlapping match of the _<regex>_ is considered a word.  Anything "
"between these matches is considered whitespace and ignored(!) for the "
"purposes of finding differences.  You may want to append `|[^[:space:]]` to "
"your regular expression to make sure that it matches all non-whitespace "
"characters.  A match that contains a newline is silently truncated(!) at the "
"newline."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:493
msgid ""
"For example, `--word-diff-regex=.` will treat each character as a word and, "
"correspondingly, show differences character by character."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:498
msgid ""
"The regex can also be set via a diff driver or configuration option, see "
"linkgit:gitattributes[5] or linkgit:git-config[1].  Giving it explicitly "
"overrides any diff driver or configuration setting.  Diff drivers override "
"configuration settings."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:499
#, no-wrap
msgid "`--color-words[=<regex>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:502
msgid ""
"Equivalent to `--word-diff=color` plus (if a regex was specified) "
"`--word-diff-regex=<regex>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:504
#, no-wrap
msgid "`--no-renames`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:507
msgid ""
"Turn off rename detection, even when the configuration file gives the "
"default to do so."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:508
#, no-wrap
msgid "`--rename-empty`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:509
#, no-wrap
msgid "`--no-rename-empty`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:511
msgid "Whether to use empty blobs as rename source."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:513
#, no-wrap
msgid "`--check`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:522
msgid ""
"Warn if changes introduce conflict markers or whitespace errors.  What are "
"considered whitespace errors is controlled by `core.whitespace` "
"configuration.  By default, trailing whitespaces (including lines that "
"consist solely of whitespaces) and a space character that is immediately "
"followed by a tab character inside the initial indent of the line are "
"considered whitespace errors.  Exits with non-zero status if problems are "
"found. Not compatible with `--exit-code`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:523
#, no-wrap
msgid "`--ws-error-highlight=<kind>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:532
msgid ""
"Highlight whitespace errors in the `context`, `old` or `new` lines of the "
"diff.  Multiple values are separated by comma, `none` resets previous "
"values, `default` reset the list to `new` and `all` is a shorthand for "
"`old,new,context`.  When this option is not given, and the configuration "
"variable `diff.wsErrorHighlight` is not set, only whitespace errors in `new` "
"lines are highlighted. The whitespace errors are colored with "
"`color.diff.whitespace`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:535
#, no-wrap
msgid "`--full-index`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:539
msgid ""
"Instead of the first handful of characters, show the full pre- and "
"post-image blob object names on the \"index\" line when generating patch "
"format output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:540
#, no-wrap
msgid "`--binary`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:543
msgid ""
"In addition to `--full-index`, output a binary diff that can be applied with "
"`git-apply`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:547
#, no-wrap
msgid "`--abbrev[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:556
msgid ""
"Instead of showing the full 40-byte hexadecimal object name in diff-raw "
"format output and diff-tree header lines, show the shortest prefix that is "
"at least _<n>_ hexdigits long that uniquely refers the object.  In "
"diff-patch output format, `--full-index` takes higher precedence, i.e. if "
"`--full-index` is specified, full blob names will be shown regardless of "
"`--abbrev`.  Non default number of digits can be specified with "
"`--abbrev=<n>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:557
#, no-wrap
msgid "`-B[<n>][/<m>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:558
#, no-wrap
msgid "`--break-rewrites[=[<n>][/<m>]]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:561
msgid ""
"Break complete rewrite changes into pairs of delete and create. This serves "
"two purposes:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:571
msgid ""
"It affects the way a change that amounts to a total rewrite of a file not as "
"a series of deletion and insertion mixed together with a very few lines that "
"happen to match textually as the context, but as a single deletion of "
"everything old followed by a single insertion of everything new, and the "
"number _<m>_ controls this aspect of the `-B` option (defaults to "
"60%). `-B/70%` specifies that less than 30% of the original should remain in "
"the result for Git to consider it a total rewrite (i.e. otherwise the "
"resulting patch will be a series of deletion and insertion mixed together "
"with context lines)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:579
msgid ""
"When used with `-M`, a totally-rewritten file is also considered as the "
"source of a rename (usually `-M` only considers a file that disappeared as "
"the source of a rename), and the number _<n>_ controls this aspect of the "
"`-B` option (defaults to 50%). `-B20%` specifies that a change with addition "
"and deletion compared to 20% or more of the file's size are eligible for "
"being picked up as a possible source of a rename to another file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:580
#, no-wrap
msgid "`-M[<n>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:581
#, no-wrap
msgid "`--find-renames[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:584
#, no-wrap
msgid "\tDetect renames.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:589
#, no-wrap
msgid ""
"\tIf generating diffs, detect and report renames for each commit.\n"
"\tFor following files across renames while traversing history, see\n"
"\t`--follow`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:599
#, no-wrap
msgid ""
"\tIf _<n>_ is specified, it is a threshold on the similarity\n"
"\tindex (i.e. amount of addition/deletions compared to the\n"
"\tfile's size). For example, `-M90%` means Git should consider a\n"
"\tdelete/add pair to be a rename if more than 90% of the file\n"
"\thasn't changed.  Without a `%` sign, the number is to be read as\n"
"\ta fraction, with a decimal point before it.  I.e., `-M5` becomes\n"
"\t0.5, and is thus the same as `-M50%`.  Similarly, `-M05` is\n"
"\tthe same as `-M5%`.  To limit detection to exact renames, use\n"
"\t`-M100%`.  The default similarity index is 50%.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:600
#, no-wrap
msgid "`-C[<n>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:601
#, no-wrap
msgid "`--find-copies[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:604
msgid ""
"Detect copies as well as renames.  See also `--find-copies-harder`.  If "
"_<n>_ is specified, it has the same meaning as for `-M<n>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:605
#, no-wrap
msgid "`--find-copies-harder`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:613
msgid ""
"For performance reasons, by default, `-C` option finds copies only if the "
"original file of the copy was modified in the same changeset.  This flag "
"makes the command inspect unmodified files as candidates for the source of "
"copy.  This is a very expensive operation for large projects, so use it with "
"caution.  Giving more than one `-C` option has the same effect."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:614
#, no-wrap
msgid "`-D`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:615
#, no-wrap
msgid "`--irreversible-delete`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:623
msgid ""
"Omit the preimage for deletes, i.e. print only the header but not the diff "
"between the preimage and `/dev/null`. The resulting patch is not meant to be "
"applied with `patch` or `git apply`; this is solely for people who want to "
"just concentrate on reviewing the text after the change. In addition, the "
"output obviously lacks enough information to apply such a patch in reverse, "
"even manually, hence the name of the option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:626
msgid ""
"When used together with `-B`, omit also the preimage in the deletion part of "
"a delete/create pair."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:627
#, no-wrap
msgid "`-l<num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:639
msgid ""
"The `-M` and `-C` options involve some preliminary steps that can detect "
"subsets of renames/copies cheaply, followed by an exhaustive fallback "
"portion that compares all remaining unpaired destinations to all relevant "
"sources.  (For renames, only remaining unpaired sources are relevant; for "
"copies, all original sources are relevant.)  For N sources and destinations, "
"this exhaustive check is O(N^2).  This option prevents the exhaustive "
"portion of rename/copy detection from running if the number of "
"source/destination files involved exceeds the specified number.  Defaults to "
"`diff.renameLimit`.  Note that a value of 0 is treated as unlimited."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:641
#, no-wrap
msgid "`--diff-filter=[(A|C|D|M|R|T|U|X|B)...[*]]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:652
msgid ""
"Select only files that are Added (`A`), Copied (`C`), Deleted (`D`), "
"Modified (`M`), Renamed (`R`), have their type (i.e. regular file, symlink, "
"submodule, ...) changed (`T`), are Unmerged (`U`), are Unknown (`X`), or "
"have had their pairing Broken (`B`).  Any combination of the filter "
"characters (including none) can be used.  When `*` (All-or-none) is added to "
"the combination, all paths are selected if there is any file that matches "
"other criteria in the comparison; if there is no file that matches other "
"criteria, nothing is selected."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:655
msgid ""
"Also, these upper-case letters can be downcased to exclude.  E.g.  "
"`--diff-filter=ad` excludes added and deleted paths."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:658
msgid ""
"Note that not all diffs can feature all types. For instance, copied and "
"renamed entries cannot appear if detection for those types is disabled."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:659
#, no-wrap
msgid "`-S<string>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:663
msgid ""
"Look for differences that change the number of occurrences of the specified "
"_<string>_ (i.e. addition/deletion) in a file.  Intended for the scripter's "
"use."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:669
msgid ""
"It is useful when you're looking for an exact block of code (like a struct), "
"and want to know the history of that block since it first came into being: "
"use the feature iteratively to feed the interesting block in the preimage "
"back into `-S`, and keep going until you get the very first version of the "
"block."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:671
msgid "Binary files are searched as well."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:672
#, no-wrap
msgid "`-G<regex>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:675
msgid ""
"Look for differences whose patch text contains added/removed lines that "
"match _<regex>_."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:679
msgid ""
"To illustrate the difference between `-S<regex>` `--pickaxe-regex` and "
"`-G<regex>`, consider a commit with the following diff in the same file:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/diff-options.adoc:684
#, no-wrap
msgid ""
"+    return frotz(nitfol, two->ptr, 1, 0);\n"
"...\n"
"-    hit = frotz(nitfol, mf2.ptr, 1, 0);\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:689
msgid ""
"While `git log -G\"frotz\\(nitfol\"` will show this commit, `git log "
"-S\"frotz\\(nitfol\" --pickaxe-regex` will not (because the number of "
"occurrences of that string did not change)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:692
msgid ""
"Unless `--text` is supplied patches of binary files without a textconv "
"filter will be ignored."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:695
msgid "See the 'pickaxe' entry in linkgit:gitdiffcore[7] for more information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:696
#, no-wrap
msgid "`--find-object=<object-id>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:701
msgid ""
"Look for differences that change the number of occurrences of the specified "
"object. Similar to `-S`, just the argument is different in that it doesn't "
"search for a specific string but for a specific object id."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:704
msgid ""
"The object can be a blob or a submodule commit. It implies the `-t` option "
"in `git-log` to also find trees."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:705
#, no-wrap
msgid "`--pickaxe-all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:709
msgid ""
"When `-S` or `-G` finds a change, show all the changes in that changeset, "
"not just the files that contain the change in _<string>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:710
#, no-wrap
msgid "`--pickaxe-regex`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:713
msgid ""
"Treat the _<string>_ given to `-S` as an extended POSIX regular expression "
"to match."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:716
#, no-wrap
msgid "`-O<orderfile>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:721
msgid ""
"Control the order in which files appear in the output.  This overrides the "
"`diff.orderFile` configuration variable (see linkgit:git-config[1]).  To "
"cancel `diff.orderFile`, use `-O/dev/null`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:733
msgid ""
"The output order is determined by the order of glob patterns in "
"_<orderfile>_.  All files with pathnames that match the first pattern are "
"output first, all files with pathnames that match the second pattern (but "
"not the first) are output next, and so on.  All files with pathnames that do "
"not match any pattern are output last, as if there was an implicit match-all "
"pattern at the end of the file.  If multiple pathnames have the same rank "
"(they match the same pattern but no earlier patterns), their output order "
"relative to each other is the normal order."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:735
msgid "_<orderfile>_ is parsed as follows:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:739
msgid "Blank lines are ignored, so they can be used as separators for readability."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:743
msgid ""
"Lines starting with a hash (\"`#`\") are ignored, so they can be used for "
"comments.  Add a backslash (\"`\\`\") to the beginning of the pattern if it "
"starts with a hash."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:745
msgid "Each other line contains a single pattern."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:752
msgid ""
"Patterns have the same syntax and semantics as patterns used for "
"`fnmatch`(3) without the `FNM_PATHNAME` flag, except a pathname also matches "
"a pattern if removing any number of the final pathname components matches "
"the pattern.  For example, the pattern \"`foo*bar`\" matches "
"\"`fooasdfbar`\" and \"`foo/bar/baz/asdf`\" but not \"`foobarx`\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:753
#, no-wrap
msgid "`--skip-to=<file>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:754
#, no-wrap
msgid "`--rotate-to=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:760
msgid ""
"Discard the files before the named _<file>_ from the output (i.e. 'skip "
"to'), or move them to the end of the output (i.e. 'rotate to').  These "
"options were invented primarily for the use of the `git difftool` command, "
"and may not be very useful otherwise."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:762
#, no-wrap
msgid "`-R`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:765
msgid ""
"Swap two inputs; that is, show differences from index or on-disk file to "
"tree contents."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:767
#, no-wrap
msgid "`--relative[=<path>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:768
#, no-wrap
msgid "`--no-relative`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:777
msgid ""
"When run from a subdirectory of the project, it can be told to exclude "
"changes outside the directory and show pathnames relative to it with this "
"option.  When you are not in a subdirectory (e.g. in a bare repository), you "
"can name which subdirectory to make the output relative to by giving a "
"_<path>_ as an argument.  `--no-relative` can be used to countermand both "
"`diff.relative` config option and previous `--relative`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:778
#, no-wrap
msgid "`-a`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:779
#, no-wrap
msgid "`--text`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:781
msgid "Treat all files as text."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:782
#, no-wrap
msgid "`--ignore-cr-at-eol`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:784
msgid "Ignore carriage-return at the end of line when doing a comparison."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:785
#, no-wrap
msgid "`--ignore-space-at-eol`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:788
#, no-wrap
msgid "`-b`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:789
#, no-wrap
msgid "`--ignore-space-change`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:794
#, no-wrap
msgid "`-w`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:795
#, no-wrap
msgid "`--ignore-all-space`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:799
msgid ""
"Ignore whitespace when comparing lines.  This ignores differences even if "
"one line has whitespace where the other line has none."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:800
#, no-wrap
msgid "`--ignore-blank-lines`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:802
msgid "Ignore changes whose lines are all blank."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:804
#, no-wrap
msgid "`-I<regex>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:805
#, no-wrap
msgid "`--ignore-matching-lines=<regex>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:808
msgid ""
"Ignore changes whose all lines match _<regex>_.  This option may be "
"specified more than once."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:809
#, no-wrap
msgid "`--inter-hunk-context=<number>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:814
msgid ""
"Show the context between diff hunks, up to the specified _<number>_ of "
"lines, thereby fusing hunks that are close to each other.  Defaults to "
"`diff.interHunkContext` or 0 if the config option is unset."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:815
#, no-wrap
msgid "`-W`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:816
#, no-wrap
msgid "`--function-context`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:821
msgid ""
"Show whole function as context lines for each change.  The function names "
"are determined in the same way as `git diff` works out patch hunk headers "
"(see \"Defining a custom hunk-header\" in linkgit:gitattributes[5])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:824
#, no-wrap
msgid "`--exit-code`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:828
msgid ""
"Make the program exit with codes similar to `diff`(1).  That is, it exits "
"with 1 if there were differences and 0 means no differences."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:829
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:836
msgid ""
"Disable all output of the program. Implies `--exit-code`.  Disables "
"execution of external diff helpers whose exit code is not trusted, "
"i.e. their respective configuration option `diff.trustExitCode` or "
"++diff.++__<driver>__++.trustExitCode++ or environment variable "
"`GIT_EXTERNAL_DIFF_TRUST_EXIT_CODE` is false."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:839
#, no-wrap
msgid "`--ext-diff`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:843
msgid ""
"Allow an external diff helper to be executed. If you set an external diff "
"driver with linkgit:gitattributes[5], you need to use this option with "
"linkgit:git-log[1] and friends."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:844
#, no-wrap
msgid "`--no-ext-diff`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:846
msgid "Disallow external diff drivers."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:847
#, no-wrap
msgid "`--textconv`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:848
#, no-wrap
msgid "`--no-textconv`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:857
msgid ""
"Allow (or disallow) external text conversion filters to be run when "
"comparing binary files. See linkgit:gitattributes[5] for details. Because "
"textconv filters are typically a one-way conversion, the resulting diff is "
"suitable for human consumption, but cannot be applied. For this reason, "
"textconv filters are enabled by default only for linkgit:git-diff[1] and "
"linkgit:git-log[1], but not for linkgit:git-format-patch[1] or diff plumbing "
"commands."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:859
#, no-wrap
msgid "`--ignore-submodules[=(none|untracked|dirty|all)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:870
msgid ""
"Ignore changes to submodules in the diff generation. `all` is the default.  "
"Using `none` will consider the submodule modified when it either contains "
"untracked or modified files or its `HEAD` differs from the commit recorded "
"in the superproject and can be used to override any settings of the `ignore` "
"option in linkgit:git-config[1] or linkgit:gitmodules[5]. When `untracked` "
"is used submodules are not considered dirty when they only contain untracked "
"content (but they are still scanned for modified content). Using `dirty` "
"ignores all changes to the work tree of submodules, only changes to the "
"commits stored in the superproject are shown (this was the behavior until "
"1.7.0). Using `all` hides all changes to submodules."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:871
#, no-wrap
msgid "`--src-prefix=<prefix>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:873
msgid "Show the given source _<prefix>_ instead of \"a/\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:874
#, no-wrap
msgid "`--dst-prefix=<prefix>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:876
msgid "Show the given destination _<prefix>_ instead of \"b/\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:877
#, no-wrap
msgid "`--no-prefix`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:879
msgid "Do not show any source or destination prefix."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:880
#, no-wrap
msgid "`--default-prefix`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:885
msgid ""
"Use the default source and destination prefixes (\"a/\" and \"b/\").  This "
"overrides configuration variables such as `diff.noprefix`, `diff.srcPrefix`, "
"`diff.dstPrefix`, and `diff.mnemonicPrefix` (see linkgit:git-config[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:886
#, no-wrap
msgid "`--line-prefix=<prefix>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:888
msgid "Prepend an additional _<prefix>_ to every line of output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:889
#, no-wrap
msgid "`--ita-invisible-in-index`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:896
msgid ""
"By default entries added by `git add -N` appear as an existing empty file in "
"`git diff` and a new file in `git diff --cached`.  This option makes the "
"entry appear as a new file in `git diff` and non-existent in `git diff "
"--cached`. This option could be reverted with `--ita-visible-in-index`. Both "
"options are experimental and could be removed in future."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/diff-options.adoc:897
#, no-wrap
msgid "`--max-depth=<depth>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:903
msgid ""
"For each pathspec given on command line, descend at most `<depth>` levels of "
"directories. A value of `-1` means no limit.  Cannot be combined with "
"wildcards in the pathspec.  Given a tree containing `foo/bar/baz`, the "
"following list shows the matches generated by each set of options:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:906
msgid "`--max-depth=0 -- foo`: `foo`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:908
msgid "`--max-depth=1 -- foo`: `foo/bar`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:910
msgid "`--max-depth=1 -- foo/bar`: `foo/bar/baz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:912
msgid "`--max-depth=1 -- foo foo/bar`: `foo/bar/baz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:914
msgid "`--max-depth=2 -- foo`: `foo/bar/baz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:921
msgid ""
"If no pathspec is given, the depth is measured as if all top-level entries "
"were specified. Note that this is different than measuring from the root, in "
"that `--max-depth=0` would still return `foo`. This allows you to still "
"limit depth while asking for a subset of the top-level entries."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:924
msgid ""
"Note that this option is only supported for diffs between tree objects, not "
"against the index or working tree."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/diff-options.adoc:926
msgid ""
"For more detailed explanation on these common options, see also "
"linkgit:gitdiffcore[7]."
msgstr ""
