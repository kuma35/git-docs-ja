#. type: Title =
#: ../Documentation-sedout/git-replace.txt:2
#, no-wrap
msgid "git-replace(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:7
msgid "git-replace - Create, list, delete refs to replace objects"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:17
#, no-wrap
msgid ""
"\t'git replace' [-f] <object> <replacement>\n"
"\t'git replace' [-f] --edit <object>\n"
"\t'git replace' [-f] --graft <commit> [<parent>...]\n"
"\t'git replace' [-f] --convert-graft-file\n"
"\t'git replace' -d <object>...\n"
"\t'git replace' [--format=<format>] [-l [<pattern>]]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:19
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:21
msgid "Adds a 'replace' reference in `refs/replace/` namespace."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:25
msgid ""
"The name of the 'replace' reference is the SHA-1 of the object that is "
"replaced. The content of the 'replace' reference is the SHA-1 of the "
"replacement object."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:28
msgid ""
"The replaced object and the replacement object must be of the same type.  "
"This restriction can be bypassed using `-f`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:30
msgid "Unless `-f` is given, the 'replace' reference must not yet exist."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:33
msgid ""
"There is no other restriction on the replaced and replacement objects.  "
"Merge commits can be replaced by non-merge commits and vice versa."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:37
msgid ""
"Replacement references will be used by default by all Git commands except "
"those doing reachability traversal (prune, pack transfer and fsck)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:40
msgid ""
"It is possible to disable the use of replacement references for any command "
"using the `--no-replace-objects` option just after 'git'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:42
msgid "For example if commit 'foo' has been replaced by commit 'bar':"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-replace.txt:45
#, no-wrap
msgid "$ git --no-replace-objects cat-file commit foo\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:48
msgid "shows information about commit 'foo', while:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-replace.txt:51
#, no-wrap
msgid "$ git cat-file commit foo\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:54
msgid "shows information about commit 'bar'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:57
msgid ""
"The `GIT_NO_REPLACE_OBJECTS` environment variable can be set to achieve the "
"same effect as the `--no-replace-objects` option."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:59
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:64
#, no-wrap
msgid ""
"`-f::`\n"
"`--force::`\n"
"\tIf an existing replace ref for the same object exists, it will\n"
"\tbe overwritten (instead of failing).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:68
#, no-wrap
msgid ""
"`-d::`\n"
"`--delete::`\n"
"\tDelete existing replace refs for the given objects.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:77
#, no-wrap
msgid ""
"`--edit`\n"
"\tEdit an object's content interactively. The existing content\n"
"\tfor <object> is pretty-printed into a temporary file, an\n"
"\teditor is launched on the file, and the result is parsed to\n"
"\tcreate a new object of the same type as <object>. A\n"
"\treplacement ref is then created to replace <object> with the\n"
"\tnewly created object. See linkgit:git-var[1] for details about\n"
"\thow the editor will be chosen.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:85
#, no-wrap
msgid ""
"`--raw::`\n"
"\tWhen editing, provide the raw object contents rather than\n"
"\tpretty-printed ones. Currently this only affects trees, which\n"
"\twill be shown in their binary form. This is harder to work with,\n"
"\tbut can help when repairing a tree that is so corrupted it\n"
"\tcannot be pretty-printed. Note that you may need to configure\n"
"\tyour editor to cleanly read and write binary data.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:93
#, no-wrap
msgid ""
"`--graft`\n"
"\tCreate a graft commit. A new commit is created with the same\n"
"\tcontent as <commit> except that its parents will be\n"
"\t[<parent>...] instead of <commit>'s parents. A replacement ref\n"
"\tis then created to replace <commit> with the newly created\n"
"\tcommit. Use `--convert-graft-file` to convert a\n"
"\t`$GIT_DIR/info/grafts` file and use replace refs instead.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:98
#, no-wrap
msgid ""
"`--convert-graft-file::`\n"
"\tCreates graft commits for all entries in `$GIT_DIR/info/grafts`\n"
"\tand deletes that file upon success. The purpose is to help users\n"
"\twith transitioning off of the now-deprecated graft file.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:105
#, no-wrap
msgid ""
"`-l`\n"
"`--list`\n"
"\tList replace refs for objects that match the given pattern (or\n"
"\tall if no pattern is given).\n"
"\tTyping \"git replace\" without arguments, also lists all replace\n"
"\trefs.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:110
#, no-wrap
msgid ""
"`--format=<format>::`\n"
"\tWhen listing, use the specified <format>, which can be one of\n"
"\t'short', 'medium' and 'long'. When omitted, the format\n"
"\tdefaults to 'short'.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:112
#, no-wrap
msgid "FORMATS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:115
msgid "The following formats are available:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:117
msgid "'short':"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:118
msgid "<replaced-sha1>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:119
msgid "'medium':"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:120
msgid "<replaced-sha1> -> <replacement-sha1>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:121
msgid "'long':"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:122
msgid "<replaced-sha1> (<replaced-type>) -> <replacement-sha1> (<replacement-type>)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:124
#, no-wrap
msgid "CREATING REPLACEMENT OBJECTS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:131
msgid ""
"linkgit:git-hash-object[1], linkgit:git-rebase[1], and "
"https://github.com/newren/git-filter-repo[git-filter-repo], among other git "
"commands, can be used to create replacement objects from existing "
"objects. The `--edit` option can also be used with 'git replace' to create a "
"replacement object by editing an existing object."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:137
msgid ""
"If you want to replace many blobs, trees or commits that are part of a "
"string of commits, you may just want to create a replacement string of "
"commits and then only replace the commit at the tip of the target string of "
"commits with the commit at the tip of the replacement string of commits."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:139
#, no-wrap
msgid "BUGS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:144
msgid ""
"Comparing blobs or trees that have been replaced with those that replace "
"them will not work properly. And using `git reset --hard` to go back to a "
"replaced commit will move the branch to the replacement commit instead of "
"the replaced commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-replace.txt:147
msgid ""
"There may be other problems when using 'git rev-list' related to pending "
"objects."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-replace.txt:149
#, no-wrap
msgid "SEE ALSO"
msgstr ""

