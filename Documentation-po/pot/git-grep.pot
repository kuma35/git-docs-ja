#. type: Title =
#: ../Documentation-sedout/git-grep.txt:2
#, no-wrap
msgid "git-grep(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:7
msgid "git-grep - Print lines matching a pattern"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:33
#, no-wrap
msgid ""
"'git grep' [-a | --text] [-I] [--textconv] [-i | --ignore-case] [-w | "
"--word-regexp]\n"
"\t   [-v | --invert-match] [-h|-H] [--full-name]\n"
"\t   [-E | --extended-regexp] [-G | --basic-regexp]\n"
"\t   [-P | --perl-regexp]\n"
"\t   [-F | --fixed-strings] [-n | --line-number] [--column]\n"
"\t   [-l | --files-with-matches] [-L | --files-without-match]\n"
"\t   [(-O | --open-files-in-pager) [<pager>]]\n"
"\t   [-z | --null]\n"
"\t   [ -o | --only-matching ] [-c | --count] [--all-match] [-q | --quiet]\n"
"\t   [--max-depth <depth>] [--[no-]recursive]\n"
"\t   [--color[=<when>] | --no-color]\n"
"\t   [--break] [--heading] [-p | --show-function]\n"
"\t   [-A <post-context>] [-B <pre-context>] [-C <context>]\n"
"\t   [-W | --function-context]\n"
"\t   [(-m | --max-count) <num>]\n"
"\t   [--threads <num>]\n"
"\t   [-f <file>] [-e] <pattern>\n"
"\t   [--and|--or|--not|(|)|-e <pattern>...]\n"
"\t   [--recurse-submodules] [--parent-basename <basename>]\n"
"\t   [ [--[no-]exclude-standard] [--cached | --untracked | --no-index] | "
"<tree>...]\n"
"\t   [--] [<pathspec>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:35
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:40
msgid ""
"Look for specified patterns in the tracked files in the work tree, blobs "
"registered in the index file, or blobs in given tree objects.  Patterns are "
"lists of one or more search expressions separated by newline characters.  An "
"empty string as search expression matches all lines."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:43
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:47
#, no-wrap
msgid ""
"`--cached::`\n"
"\tInstead of searching tracked files in the working tree, search\n"
"\tblobs registered in the index file.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:51
#, no-wrap
msgid ""
"`--untracked::`\n"
"\tIn addition to searching in the tracked files in the working\n"
"\ttree, search also in untracked files.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:59
#, no-wrap
msgid ""
"`--no-index::`\n"
"\tSearch files in the current directory that is not managed by Git,\n"
"\tor by ignoring that the current directory is managed by Git.  This\n"
"\tis rather similar to running the regular `grep(1)` utility with its\n"
"\t`-r` option specified, but with some additional benefits, such as\n"
"\tusing pathspec patterns to limit paths;  see the 'pathspec' entry\n"
"\tin linkgit:gitglossary[7] for more information.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:62
msgid ""
"This option cannot be used together with `--cached` or `--untracked`.  See "
"also `grep.fallbackToNoIndex` in 'CONFIGURATION' below."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:66
#, no-wrap
msgid ""
"`--no-exclude-standard::`\n"
"\tAlso search in ignored files by not honoring the `.gitignore`\n"
"\tmechanism. Only useful with `--untracked`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:71
#, no-wrap
msgid ""
"`--exclude-standard::`\n"
"\tDo not pay attention to ignored files specified via the `.gitignore`\n"
"\tmechanism.  Only useful when searching files in the current directory\n"
"\twith `--no-index`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:78
#, no-wrap
msgid ""
"`--recurse-submodules::`\n"
"\tRecursively search in each submodule that is active and\n"
"\tchecked out in the repository.  When used in combination with the\n"
"\t_<tree>_ option the prefix of all submodule output will be the name of\n"
"\tthe parent project's _<tree>_ object.  This option cannot be used "
"together\n"
"\twith `--untracked`, and it has no effect if `--no-index` is specified.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:82
#, no-wrap
msgid ""
"`-a::`\n"
"`--text::`\n"
"\tProcess binary files as if they were text.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:85
#, no-wrap
msgid ""
"`--textconv::`\n"
"\tHonor textconv filter settings.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:89
#, no-wrap
msgid ""
"`--no-textconv::`\n"
"\tDo not honor textconv filter settings.\n"
"\tThis is the default.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:94
#, no-wrap
msgid ""
"`-i::`\n"
"`--ignore-case::`\n"
"\tIgnore case differences between the patterns and the\n"
"\tfiles.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:97
#, no-wrap
msgid ""
"`-I::`\n"
"\tDon't match the pattern in binary files.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:104
#, no-wrap
msgid ""
"`--max-depth`\n"
"\tFor each <pathspec> given on command line, descend at most <depth>\n"
"\tlevels of directories. A value of -1 means no limit.\n"
"\tThis option is ignored if <pathspec> contains active wildcards.\n"
"\tIn other words if \"a*\" matches a directory named \"a*\",\n"
"\t\"*\" is matched literally so --max-depth is still effective.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:108
#, no-wrap
msgid ""
"`-r::`\n"
"`--recursive::`\n"
"\tSame as `--max-depth=-1`; this is the default.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:111
#, no-wrap
msgid ""
"`--no-recursive::`\n"
"\tSame as `--max-depth=0`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:117
#, no-wrap
msgid ""
"`-w::`\n"
"`--word-regexp::`\n"
"\tMatch the pattern only at word boundary (either begin at the\n"
"\tbeginning of a line, or preceded by a non-word character; end at\n"
"\tthe end of a line or followed by a non-word character).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:121
#, no-wrap
msgid ""
"`-v::`\n"
"`--invert-match::`\n"
"\tSelect non-matching lines.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:129
#, no-wrap
msgid ""
"`-h::`\n"
"`-H::`\n"
"\tBy default, the command shows the filename for each\n"
"\tmatch.  `-h` option is used to suppress this output.\n"
"\t`-H` is there for completeness and does not do anything\n"
"\texcept it overrides `-h` given earlier on the command\n"
"\tline.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:135
#, no-wrap
msgid ""
"`--full-name::`\n"
"\tWhen run from a subdirectory, the command usually\n"
"\toutputs paths relative to the current directory.  This\n"
"\toption forces paths to be output relative to the project\n"
"\ttop directory.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:142
#, no-wrap
msgid ""
"`-E::`\n"
"`--extended-regexp::`\n"
"`-G::`\n"
"`--basic-regexp::`\n"
"\tUse POSIX extended/basic regexp for patterns.  Default\n"
"\tis to use basic regexp.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:146
#, no-wrap
msgid ""
"`-P::`\n"
"`--perl-regexp::`\n"
"\tUse Perl-compatible regular expressions for patterns.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:150
msgid ""
"Support for these types of regular expressions is an optional compile-time "
"dependency. If Git wasn't compiled with support for them providing this "
"option will cause it to die."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:155
#, no-wrap
msgid ""
"`-F::`\n"
"`--fixed-strings::`\n"
"\tUse fixed strings for patterns (don't interpret pattern\n"
"\tas a regex).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:159
#, no-wrap
msgid ""
"`-n::`\n"
"`--line-number::`\n"
"\tPrefix the line number to matching lines.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:163
#, no-wrap
msgid ""
"`--column::`\n"
"\tPrefix the 1-indexed byte-offset of the first match from the start of "
"the\n"
"\tmatching line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:173
#, no-wrap
msgid ""
"`-l::`\n"
"`--files-with-matches::`\n"
"`--name-only::`\n"
"`-L::`\n"
"`--files-without-match::`\n"
"\tInstead of showing every matched line, show only the\n"
"\tnames of files that contain (or do not contain) matches.\n"
"\tFor better compatibility with 'git diff', `--name-only` is a\n"
"\tsynonym for `--files-with-matches`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:183
#, no-wrap
msgid ""
"`-O[<pager>]::`\n"
"`--open-files-in-pager[=<pager>]::`\n"
"\tOpen the matching files in the pager (not the output of 'grep').\n"
"\tIf the pager happens to be \"less\" or \"vi\", and the user\n"
"\tspecified only one pattern, the first file is positioned at\n"
"\tthe first match automatically. The `pager` argument is\n"
"\toptional; if specified, it must be stuck to the option\n"
"\twithout a space. If `pager` is unspecified, the default pager\n"
"\twill be used (see `core.pager` in linkgit:git-config[1]).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:190
#, no-wrap
msgid ""
"`-z::`\n"
"`--null::`\n"
"\tUse \\0 as the delimiter for pathnames in the output, and print\n"
"\tthem verbatim. Without this option, pathnames with \"unusual\"\n"
"\tcharacters are quoted as explained for the configuration\n"
"\tvariable `core.quotePath` (see linkgit:git-config[1]).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:195
#, no-wrap
msgid ""
"`-o::`\n"
"`--only-matching::`\n"
"\tPrint only the matched (non-empty) parts of a matching line, with each "
"such\n"
"\tpart on a separate output line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:200
#, no-wrap
msgid ""
"`-c::`\n"
"`--count::`\n"
"\tInstead of showing every matched line, show the number of\n"
"\tlines that match.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:204
#, no-wrap
msgid ""
"`--color[=<when>]::`\n"
"\tShow colored matches.\n"
"\tThe value must be always (the default), never, or auto.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:209
#, no-wrap
msgid ""
"`--no-color::`\n"
"\tTurn off match highlighting, even when the configuration file\n"
"\tgives the default to color output.\n"
"\tSame as `--color=never`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:212
#, no-wrap
msgid ""
"`--break::`\n"
"\tPrint an empty line between matches from different files.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:216
#, no-wrap
msgid ""
"`--heading::`\n"
"\tShow the filename above the matches in that file instead of\n"
"\tat the start of each shown line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:224
#, no-wrap
msgid ""
"`-p::`\n"
"`--show-function::`\n"
"\tShow the preceding line that contains the function name of\n"
"\tthe match, unless the matching line is a function name itself.\n"
"\tThe name is determined in the same way as `git diff` works out\n"
"\tpatch hunk headers (see 'Defining a custom hunk-header' in\n"
"\tlinkgit:gitattributes[5]).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:230
#, no-wrap
msgid ""
"`-<num>::`\n"
"`-C`\n"
"`--context`\n"
"\tShow <num> leading and trailing lines, and place a line\n"
"\tcontaining `--` between contiguous groups of matches.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:235
#, no-wrap
msgid ""
"`-A`\n"
"`--after-context`\n"
"\tShow <num> trailing lines, and place a line containing\n"
"\t`--` between contiguous groups of matches.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:240
#, no-wrap
msgid ""
"`-B`\n"
"`--before-context`\n"
"\tShow <num> leading lines, and place a line containing\n"
"\t`--` between contiguous groups of matches.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:249
#, no-wrap
msgid ""
"`-W::`\n"
"`--function-context::`\n"
"\tShow the surrounding text from the previous line containing a\n"
"\tfunction name up to the one before the next function name,\n"
"\teffectively showing the whole function in which the match was\n"
"\tfound. The function names are determined in the same way as\n"
"\t`git diff` works out patch hunk headers (see 'Defining a\n"
"\tcustom hunk-header' in linkgit:gitattributes[5]).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:257
#, no-wrap
msgid ""
"`-m`\n"
"`--max-count`\n"
"\tLimit the amount of matches per file. When using the `-v` or\n"
"\t`--invert-match` option, the search stops after the specified\n"
"\tnumber of non-matches. A value of -1 will return unlimited\n"
"\tresults (the default). A value of 0 will exit immediately with\n"
"\ta non-zero status.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:261
#, no-wrap
msgid ""
"`--threads`\n"
"\tNumber of `grep` worker threads to use.  See 'NOTES ON THREADS'\n"
"\tand `grep.threads` in 'CONFIGURATION' for more information.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:264
#, no-wrap
msgid ""
"`-f`\n"
"\tRead patterns from <file>, one per line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:267
msgid ""
"Passing the pattern via <file> allows for providing a search pattern "
"containing a \\0."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:272
msgid ""
"Not all pattern types support patterns containing \\0. Git will error out if "
"a given pattern type can't support such a pattern. The `--perl-regexp` "
"pattern type when compiled against the PCRE v2 backend has the widest "
"support for these types of patterns."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:277
msgid ""
"In versions of Git before 2.23.0 patterns containing \\0 would be silently "
"considered fixed. This was never documented, there were also odd and "
"undocumented interactions between e.g. non-ASCII patterns containing \\0 and "
"`--ignore-case`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:281
msgid ""
"In future versions we may learn to support patterns containing \\0 for more "
"search backends, until then we'll die when the pattern type in question "
"doesn't support them."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:287
#, no-wrap
msgid ""
"`-e::`\n"
"\tThe next parameter is the pattern. This option has to be\n"
"\tused for patterns starting with `-` and should be used in\n"
"\tscripts passing user input to grep.  Multiple patterns are\n"
"\tcombined by 'or'.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:291
msgid "`--and::` `--or::` `--not::`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:291
#, no-wrap
msgid "( ... )"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:296
msgid ""
"Specify how multiple patterns are combined using Boolean expressions.  "
"`--or` is the default operator.  `--and` has higher precedence than `--or`.  "
"`-e` has to be used for all patterns."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:301
#, no-wrap
msgid ""
"`--all-match::`\n"
"\tWhen giving multiple pattern expressions combined with `--or`,\n"
"\tthis flag is specified to limit the match to files that\n"
"\thave lines to match all of them.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:306
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tDo not output matched lines; instead, exit with status 0 when\n"
"\tthere is a match and with non-zero status when there isn't.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:307
#, no-wrap
msgid "<tree>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:310
msgid ""
"Instead of searching tracked files in the working tree, search blobs in the "
"given trees."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:311
#, no-wrap
msgid "\\--"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:314
msgid ""
"Signals the end of options; the rest of the parameters are <pathspec> "
"limiters."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:315
#, no-wrap
msgid "<pathspec>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:318
msgid ""
"If given, limit the search to paths matching at least one pattern.  Both "
"leading paths match and glob(7) patterns are supported."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:321
msgid ""
"For more details about the <pathspec> syntax, see the 'pathspec' entry in "
"linkgit:gitglossary[7]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:323
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:325
#, no-wrap
msgid "`git grep 'time_t' -- '*.[ch]'`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:328
msgid ""
"Looks for `time_t` in all tracked .c and .h files in the working directory "
"and its subdirectories."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:329
#, no-wrap
msgid "`git grep -e '#define' --and \\( -e MAX_PATH -e PATH_MAX \\)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:332
msgid "Looks for a line that has `#define` and either `MAX_PATH` or `PATH_MAX`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:333
#, no-wrap
msgid "`git grep --all-match -e NODE -e Unexpected`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:336
msgid ""
"Looks for a line that has `NODE` or `Unexpected` in files that have lines "
"that match both."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:337
#, no-wrap
msgid "`git grep solution -- :^Documentation`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:339
msgid "Looks for `solution`, excluding files in `Documentation`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:341
#, no-wrap
msgid "NOTES ON THREADS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:345
msgid ""
"The `--threads` option (and the `grep.threads` configuration) will be "
"ignored when `--open-files-in-pager` is used, forcing a single-threaded "
"execution."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:350
msgid ""
"When grepping the object store (with `--cached` or giving tree objects), "
"running with multiple threads might perform slower than single-threaded if "
"`--textconv` is given and there are too many text conversions.  Thus, if low "
"performance is experienced in this case, it might be desirable to use "
"`--threads=1`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:352
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:359
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:360
msgid "Part of the linkgit:git[1] suite"
msgstr ""
