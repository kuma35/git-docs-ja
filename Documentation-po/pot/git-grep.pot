#. type: Title =
#: ../Documentation-sedout/git-grep.txt:2
#, no-wrap
msgid "git-grep(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:7
msgid "git-grep - Print lines matching a pattern"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:33
#, no-wrap
msgid ""
"'git grep' [-a | --text] [-I] [--textconv] [-i | --ignore-case] [-w | "
"--word-regexp]\n"
"\t   [-v | --invert-match] [-h|-H] [--full-name]\n"
"\t   [-E | --extended-regexp] [-G | --basic-regexp]\n"
"\t   [-P | --perl-regexp]\n"
"\t   [-F | --fixed-strings] [-n | --line-number] [--column]\n"
"\t   [-l | --files-with-matches] [-L | --files-without-match]\n"
"\t   [(-O | --open-files-in-pager) [<pager>]]\n"
"\t   [-z | --null]\n"
"\t   [ -o | --only-matching ] [-c | --count] [--all-match] [-q | --quiet]\n"
"\t   [--max-depth <depth>] [--[no-]recursive]\n"
"\t   [--color[=<when>] | --no-color]\n"
"\t   [--break] [--heading] [-p | --show-function]\n"
"\t   [-A <post-context>] [-B <pre-context>] [-C <context>]\n"
"\t   [-W | --function-context]\n"
"\t   [(-m | --max-count) <num>]\n"
"\t   [--threads <num>]\n"
"\t   [-f <file>] [-e] <pattern>\n"
"\t   [--and|--or|--not|(|)|-e <pattern>...]\n"
"\t   [--recurse-submodules] [--parent-basename <basename>]\n"
"\t   [ [--[no-]exclude-standard] [--cached | --untracked | --no-index] | "
"<tree>...]\n"
"\t   [--] [<pathspec>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:35
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:40
msgid ""
"Look for specified patterns in the tracked files in the work tree, blobs "
"registered in the index file, or blobs in given tree objects.  Patterns are "
"lists of one or more search expressions separated by newline characters.  An "
"empty string as search expression matches all lines."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:43
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:44
#, no-wrap
msgid "`--cached`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:47
msgid ""
"Instead of searching tracked files in the working tree, search blobs "
"registered in the index file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:48
#, no-wrap
msgid "`--untracked`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:51
msgid ""
"In addition to searching in the tracked files in the working tree, search "
"also in untracked files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:52
#, no-wrap
msgid "`--no-index`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:59
msgid ""
"Search files in the current directory that is not managed by Git, or by "
"ignoring that the current directory is managed by Git.  This is rather "
"similar to running the regular `grep(1)` utility with its `-r` option "
"specified, but with some additional benefits, such as using pathspec "
"patterns to limit paths; see the 'pathspec' entry in linkgit:gitglossary[7] "
"for more information."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:62
msgid ""
"This option cannot be used together with `--cached` or `--untracked`.  See "
"also `grep.fallbackToNoIndex` in 'CONFIGURATION' below."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:63
#, no-wrap
msgid "`--no-exclude-standard`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:66
msgid ""
"Also search in ignored files by not honoring the `.gitignore` "
"mechanism. Only useful with `--untracked`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:67
#, no-wrap
msgid "`--exclude-standard`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:71
msgid ""
"Do not pay attention to ignored files specified via the `.gitignore` "
"mechanism.  Only useful when searching files in the current directory with "
"`--no-index`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:72
#, no-wrap
msgid "`--recurse-submodules`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:78
msgid ""
"Recursively search in each submodule that is active and checked out in the "
"repository.  When used in combination with the _<tree>_ option the prefix of "
"all submodule output will be the name of the parent project's _<tree>_ "
"object.  This option cannot be used together with `--untracked`, and it has "
"no effect if `--no-index` is specified."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:79
#, no-wrap
msgid "`-a`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:80
#, no-wrap
msgid "`--text`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:82
msgid "Process binary files as if they were text."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:83
#, no-wrap
msgid "`--textconv`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:85
msgid "Honor textconv filter settings."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:86
#, no-wrap
msgid "`--no-textconv`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:89
msgid "Do not honor textconv filter settings.  This is the default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:90
#, no-wrap
msgid "`-i`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:91
#, no-wrap
msgid "`--ignore-case`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:94
msgid "Ignore case differences between the patterns and the files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:95
#, no-wrap
msgid "`-I`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:97
msgid "Don't match the pattern in binary files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:98
#, no-wrap
msgid "`--max-depth <depth>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:104
msgid ""
"For each <pathspec> given on command line, descend at most <depth> levels of "
"directories. A value of -1 means no limit.  This option is ignored if "
"<pathspec> contains active wildcards.  In other words if \"a*\" matches a "
"directory named \"a*\", \"*\" is matched literally so --max-depth is still "
"effective."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:105
#, no-wrap
msgid "`-r`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:106
#, no-wrap
msgid "`--recursive`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:108
msgid "Same as `--max-depth=-1`; this is the default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:109
#, no-wrap
msgid "`--no-recursive`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:111
msgid "Same as `--max-depth=0`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:112
#, no-wrap
msgid "`-w`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:113
#, no-wrap
msgid "`--word-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:117
msgid ""
"Match the pattern only at word boundary (either begin at the beginning of a "
"line, or preceded by a non-word character; end at the end of a line or "
"followed by a non-word character)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:118
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:119
#, no-wrap
msgid "`--invert-match`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:121
msgid "Select non-matching lines."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:122
#, no-wrap
msgid "`-h`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:123
#, no-wrap
msgid "`-H`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:129
msgid ""
"By default, the command shows the filename for each match.  `-h` option is "
"used to suppress this output.  `-H` is there for completeness and does not "
"do anything except it overrides `-h` given earlier on the command line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:130
#, no-wrap
msgid "`--full-name`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:135
msgid ""
"When run from a subdirectory, the command usually outputs paths relative to "
"the current directory.  This option forces paths to be output relative to "
"the project top directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:136
#, no-wrap
msgid "`-E`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:137
#, no-wrap
msgid "`--extended-regexp`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:138
#, no-wrap
msgid "`-G`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:139
#, no-wrap
msgid "`--basic-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:142
msgid ""
"Use POSIX extended/basic regexp for patterns.  Default is to use basic "
"regexp."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:143
#, no-wrap
msgid "`-P`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:144
#, no-wrap
msgid "`--perl-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:146
msgid "Use Perl-compatible regular expressions for patterns."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:150
msgid ""
"Support for these types of regular expressions is an optional compile-time "
"dependency. If Git wasn't compiled with support for them providing this "
"option will cause it to die."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:151
#, no-wrap
msgid "`-F`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:152
#, no-wrap
msgid "`--fixed-strings`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:155
msgid "Use fixed strings for patterns (don't interpret pattern as a regex)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:156
#, no-wrap
msgid "`-n`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:157
#, no-wrap
msgid "`--line-number`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:159
msgid "Prefix the line number to matching lines."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:160
#, no-wrap
msgid "`--column`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:163
msgid ""
"Prefix the 1-indexed byte-offset of the first match from the start of the "
"matching line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:164
#, no-wrap
msgid "`-l`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:165
#, no-wrap
msgid "`--files-with-matches`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:166
#, no-wrap
msgid "`--name-only`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:167
#, no-wrap
msgid "`-L`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:168
#, no-wrap
msgid "`--files-without-match`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:173
msgid ""
"Instead of showing every matched line, show only the names of files that "
"contain (or do not contain) matches.  For better compatibility with 'git "
"diff', `--name-only` is a synonym for `--files-with-matches`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:174
#, no-wrap
msgid "`-O[<pager>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:175
#, no-wrap
msgid "`--open-files-in-pager[=<pager>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:183
msgid ""
"Open the matching files in the pager (not the output of 'grep').  If the "
"pager happens to be \"less\" or \"vi\", and the user specified only one "
"pattern, the first file is positioned at the first match automatically. The "
"`pager` argument is optional; if specified, it must be stuck to the option "
"without a space. If `pager` is unspecified, the default pager will be used "
"(see `core.pager` in linkgit:git-config[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:184
#, no-wrap
msgid "`-z`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:185
#, no-wrap
msgid "`--null`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:190
msgid ""
"Use \\0 as the delimiter for pathnames in the output, and print them "
"verbatim. Without this option, pathnames with \"unusual\" characters are "
"quoted as explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:191
#, no-wrap
msgid "`-o`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:192
#, no-wrap
msgid "`--only-matching`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:195
msgid ""
"Print only the matched (non-empty) parts of a matching line, with each such "
"part on a separate output line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:196
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:197
#, no-wrap
msgid "`--count`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:200
msgid "Instead of showing every matched line, show the number of lines that match."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:201
#, no-wrap
msgid "`--color[=<when>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:204
msgid ""
"Show colored matches.  The value must be always (the default), never, or "
"auto."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:205
#, no-wrap
msgid "`--no-color`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:209
msgid ""
"Turn off match highlighting, even when the configuration file gives the "
"default to color output.  Same as `--color=never`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:210
#, no-wrap
msgid "`--break`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:212
msgid "Print an empty line between matches from different files."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:213
#, no-wrap
msgid "`--heading`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:216
msgid ""
"Show the filename above the matches in that file instead of at the start of "
"each shown line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:217
#, no-wrap
msgid "`-p`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:218
#, no-wrap
msgid "`--show-function`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:224
msgid ""
"Show the preceding line that contains the function name of the match, unless "
"the matching line is a function name itself.  The name is determined in the "
"same way as `git diff` works out patch hunk headers (see 'Defining a custom "
"hunk-header' in linkgit:gitattributes[5])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:225
#, no-wrap
msgid "`-<num>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:226
#, no-wrap
msgid "`-C <num>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:227
#, no-wrap
msgid "`--context <num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:230
msgid ""
"Show <num> leading and trailing lines, and place a line containing `--` "
"between contiguous groups of matches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:231
#, no-wrap
msgid "`-A <num>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:232
#, no-wrap
msgid "`--after-context <num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:235
msgid ""
"Show <num> trailing lines, and place a line containing `--` between "
"contiguous groups of matches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:236
#, no-wrap
msgid "`-B <num>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:237
#, no-wrap
msgid "`--before-context <num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:240
msgid ""
"Show <num> leading lines, and place a line containing `--` between "
"contiguous groups of matches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:241
#, no-wrap
msgid "`-W`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:242
#, no-wrap
msgid "`--function-context`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:249
msgid ""
"Show the surrounding text from the previous line containing a function name "
"up to the one before the next function name, effectively showing the whole "
"function in which the match was found. The function names are determined in "
"the same way as `git diff` works out patch hunk headers (see 'Defining a "
"custom hunk-header' in linkgit:gitattributes[5])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:250
#, no-wrap
msgid "`-m <num>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:251
#, no-wrap
msgid "`--max-count <num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:257
msgid ""
"Limit the amount of matches per file. When using the `-v` or "
"`--invert-match` option, the search stops after the specified number of "
"non-matches. A value of -1 will return unlimited results (the default). A "
"value of 0 will exit immediately with a non-zero status."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:258
#, no-wrap
msgid "`--threads <num>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:261
msgid ""
"Number of `grep` worker threads to use.  See 'NOTES ON THREADS' and "
"`grep.threads` in 'CONFIGURATION' for more information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:262
#, no-wrap
msgid "`-f <file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:264
msgid "Read patterns from <file>, one per line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:267
msgid ""
"Passing the pattern via <file> allows for providing a search pattern "
"containing a \\0."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:272
msgid ""
"Not all pattern types support patterns containing \\0. Git will error out if "
"a given pattern type can't support such a pattern. The `--perl-regexp` "
"pattern type when compiled against the PCRE v2 backend has the widest "
"support for these types of patterns."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:277
msgid ""
"In versions of Git before 2.23.0 patterns containing \\0 would be silently "
"considered fixed. This was never documented, there were also odd and "
"undocumented interactions between e.g. non-ASCII patterns containing \\0 and "
"`--ignore-case`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:281
msgid ""
"In future versions we may learn to support patterns containing \\0 for more "
"search backends, until then we'll die when the pattern type in question "
"doesn't support them."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:282
#, no-wrap
msgid "`-e`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:287
msgid ""
"The next parameter is the pattern. This option has to be used for patterns "
"starting with `-` and should be used in scripts passing user input to grep.  "
"Multiple patterns are combined by 'or'."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:288
#, no-wrap
msgid "`--and`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:289
#, no-wrap
msgid "`--or`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:290
#, no-wrap
msgid "`--not`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:291
#, no-wrap
msgid "( ... )"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:296
msgid ""
"Specify how multiple patterns are combined using Boolean expressions.  "
"`--or` is the default operator.  `--and` has higher precedence than `--or`.  "
"`-e` has to be used for all patterns."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:297
#, no-wrap
msgid "`--all-match`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:301
msgid ""
"When giving multiple pattern expressions combined with `--or`, this flag is "
"specified to limit the match to files that have lines to match all of them."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:302
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:303
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:306
msgid ""
"Do not output matched lines; instead, exit with status 0 when there is a "
"match and with non-zero status when there isn't."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:307
#, no-wrap
msgid "<tree>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:310
msgid ""
"Instead of searching tracked files in the working tree, search blobs in the "
"given trees."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:311
#, no-wrap
msgid "\\--"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:314
msgid ""
"Signals the end of options; the rest of the parameters are <pathspec> "
"limiters."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:315
#, no-wrap
msgid "<pathspec>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:318
msgid ""
"If given, limit the search to paths matching at least one pattern.  Both "
"leading paths match and glob(7) patterns are supported."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:321
msgid ""
"For more details about the <pathspec> syntax, see the 'pathspec' entry in "
"linkgit:gitglossary[7]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:323
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:325
#, no-wrap
msgid "`git grep 'time_t' -- '*.[ch]'`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:328
msgid ""
"Looks for `time_t` in all tracked .c and .h files in the working directory "
"and its subdirectories."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:329
#, no-wrap
msgid "`git grep -e '#define' --and \\( -e MAX_PATH -e PATH_MAX \\)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:332
msgid "Looks for a line that has `#define` and either `MAX_PATH` or `PATH_MAX`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:333
#, no-wrap
msgid "`git grep --all-match -e NODE -e Unexpected`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:336
msgid ""
"Looks for a line that has `NODE` or `Unexpected` in files that have lines "
"that match both."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-grep.txt:337
#, no-wrap
msgid "`git grep solution -- :^Documentation`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:339
msgid "Looks for `solution`, excluding files in `Documentation`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-grep.txt:341
#, no-wrap
msgid "NOTES ON THREADS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:345
msgid ""
"The `--threads` option (and the `grep.threads` configuration) will be "
"ignored when `--open-files-in-pager` is used, forcing a single-threaded "
"execution."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-grep.txt:350
msgid ""
"When grepping the object store (with `--cached` or giving tree objects), "
"running with multiple threads might perform slower than single-threaded if "
"`--textconv` is given and there are too many text conversions.  Thus, if low "
"performance is experienced in this case, it might be desirable to use "
"`--threads=1`."
msgstr ""

