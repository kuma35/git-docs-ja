#. type: Title =
#: ../Documentation-sedout/git-refs.adoc:2
#, no-wrap
msgid "git-refs(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:7
msgid "git-refs - Low-level access to refs"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:23
#, no-wrap
msgid ""
"\tgit refs migrate --ref-format=<format> [--no-reflog] [--dry-run]\n"
"\tgit refs verify [--strict] [--verbose]\n"
"\tgit refs list [--count=<count>] [--shell|--perl|--python|--tcl]\n"
"\t\t\t   [(--sort=<key>)...] [--format=<format>]\n"
"\t\t\t   [--include-root-refs] [--points-at=<object>]\n"
"\t\t\t   [--merged[=<object>]] [--no-merged[=<object>]]\n"
"\t\t\t   [--contains[=<object>]] [--no-contains[=<object>]]\n"
"\t\t\t   [(--exclude=<pattern>)...] [--start-after=<marker>]\n"
"\t\t\t   [ --stdin | (<pattern>...)]\n"
"\tgit refs exists <ref>\n"
"\tgit refs optimize [--all] [--no-prune] [--auto] [--include <pattern>] "
"[--exclude <pattern>]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:25
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:28
msgid "This command provides low-level access to refs."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:30
#, no-wrap
msgid "COMMANDS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:32
#, no-wrap
msgid "`migrate`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:34
msgid "Migrate ref store between different formats."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:35
#, no-wrap
msgid "`verify`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:37
msgid "Verify reference database consistency."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:38
#, no-wrap
msgid "list"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:42
msgid ""
"List references in the repository with support for filtering, formatting, "
"and sorting. This subcommand is an alias for linkgit:git-for-each-ref[1] and "
"offers identical functionality."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:43
#, no-wrap
msgid "exists"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:48
msgid ""
"Check whether the given reference exists. Returns an exit code of 0 if it "
"does, 2 if it is missing, and 1 in case looking up the reference failed with "
"an error other than the reference being missing. This does not verify "
"whether the reference resolves to an actual object."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:49
#, no-wrap
msgid "optimize"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:53
msgid ""
"Optimizes references to improve repository performance and reduce disk "
"usage. This subcommand is an alias for linkgit:git-pack-refs[1] and offers "
"identical functionality."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:55
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:58
msgid "The following options are specific to `git refs migrate`:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:59
#, no-wrap
msgid "`--ref-format=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:61
msgid "The ref format to migrate the ref store to. Can be one of:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:64
#, no-wrap
msgid "`--dry-run`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:70
msgid ""
"Perform the migration, but do not modify the repository. The migrated refs "
"will be written into a separate directory that can be inspected "
"separately. The name of the directory will be reported on stdout. This can "
"be used to double check that the migration works as expected before "
"performing the actual migration."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:71
#, no-wrap
msgid "`--reflog`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:72
#, no-wrap
msgid "`--no-reflog`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:75
msgid ""
"Choose between migrating the reflog data to the new backend, and discarding "
"them.  The default is \"--reflog\", to migrate."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:77
msgid "The following options are specific to `git refs verify`:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:78
#, no-wrap
msgid "`--strict`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:81
msgid ""
"Enable stricter error checking. This will cause warnings to be reported as "
"errors. See linkgit:git-fsck[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-refs.adoc:82
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:84
msgid "When verifying the reference database consistency, be chatty."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:86
msgid "The following options are specific to 'git refs list':"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:90
msgid "The following options are specific to 'git refs optimize':"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:94
#, no-wrap
msgid "KNOWN LIMITATIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:97
msgid "The ref format migration has several known limitations in its current form:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:99
msgid "It is not possible to migrate repositories that have worktrees."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:105
msgid ""
"There is no way to block concurrent writes to the repository during an "
"ongoing migration. Concurrent writes can lead to an inconsistent migrated "
"state. Users are expected to block writes on a higher level. If your "
"repository is registered for scheduled maintenance, it is recommended to "
"unregister it first with git-maintenance(1)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:107
msgid "These limitations may eventually be lifted."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-refs.adoc:109
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-refs.adoc:110
msgid "Part of the linkgit:git[1] suite"
msgstr ""
