#. type: Title =
#: ../Documentation-sedout/git-help.txt:2
#, no-wrap
msgid "git-help(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:7
msgid "git-help - Display help information about Git"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:17
#, no-wrap
msgid ""
"'git help' [-a|--all] [--[no-]verbose] [--[no-]external-commands] "
"[--[no-]aliases]\n"
"'git help' [[-i|--info] [-m|--man] [-w|--web]] [<command>|<doc>]\n"
"'git help' [-g|--guides]\n"
"'git help' [-c|--config]\n"
"'git help' [--user-interfaces]\n"
"'git help' [--developer-interfaces]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:19
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:24
msgid ""
"With no options and no '<command>' or '<doc>' given, the synopsis of the "
"'git' command and a list of the most commonly used Git commands are printed "
"on the standard output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:27
msgid ""
"If the option `--all` or `-a` is given, all available commands are printed "
"on the standard output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:30
msgid ""
"If the option `--guides` or `-g` is given, a list of the Git concept guides "
"is also printed on the standard output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:35
msgid ""
"If a command or other documentation is given, the relevant manual page will "
"be brought up. The 'man' program is used by default for this purpose, but "
"this can be overridden by other options or configuration variables."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:39
msgid ""
"If an alias is given, git shows the definition of the alias on standard "
"output. To get the manual page for the aliased command, use `git <command> "
"--help`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:42
msgid ""
"Note that `git --help ...` is identical to `git help ...` because the former "
"is internally converted into the latter."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:44
msgid "To display the linkgit:git[1] man page, use `git help git`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:46
msgid "This page can be displayed with 'git help help' or `git help --help`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:48
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:49
#, no-wrap
msgid "`-a`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:50
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:52
msgid "Print all the available commands on the standard output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:53
#, no-wrap
msgid "`--no-external-commands`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:56
msgid ""
"When used with `--all`, exclude the listing of external \"git-*\" commands "
"found in the `$PATH`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:57
#, no-wrap
msgid "`--no-aliases`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:60
msgid "When used with `--all`, exclude the listing of configured aliases."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:61
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:64
msgid ""
"When used with `--all`, print description for all recognized commands. This "
"is the default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:65
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:66
#, no-wrap
msgid "`--config`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:69
msgid ""
"List all available configuration variables. This is a short summary of the "
"list in linkgit:git-config[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:70
#, no-wrap
msgid "`-g`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:71
#, no-wrap
msgid "`--guides`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:73
msgid "Print a list of the Git concept guides on the standard output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:74
#, no-wrap
msgid "`--user-interfaces`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:77
msgid ""
"Print a list of the repository, command and file interfaces documentation on "
"the standard output."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:81
msgid ""
"In-repository file interfaces such as `.git/info/exclude` are documented "
"here (see linkgit:gitrepository-layout[5]), as well as in-tree configuration "
"such as `.mailmap` (see linkgit:gitmailmap[5])."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:86
msgid ""
"This section of the documentation also covers general or widespread "
"user-interface conventions (e.g. linkgit:gitcli[7]), and "
"pseudo-configuration such as the file-based `.git/hooks/*` interface "
"described in linkgit:githooks[5]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:87
#, no-wrap
msgid "`--developer-interfaces`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:90
msgid ""
"Print a list of file formats, protocols and other developer interfaces "
"documentation on the standard output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:91
#, no-wrap
msgid "`-i`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:92
#, no-wrap
msgid "`--info`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:95
msgid ""
"Display manual page for the command in the 'info' format. The 'info' program "
"will be used for that purpose."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:96
#, no-wrap
msgid "`-m`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:97
#, no-wrap
msgid "`--man`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:101
msgid ""
"Display manual page for the command in the 'man' format. This option may be "
"used to override a value set in the `help.format` configuration variable."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:105
msgid ""
"By default the 'man' program will be used to display the manual page, but "
"the `man.viewer` configuration variable may be used to choose other display "
"programs (see below)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:106
#, no-wrap
msgid "`-w`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-help.txt:107
#, no-wrap
msgid "`--web`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:110
msgid ""
"Display manual page for the command in the 'web' (HTML)  format. A web "
"browser will be used for that purpose."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:116
msgid ""
"The web browser can be specified using the configuration variable "
"`help.browser`, or `web.browser` if the former is not set. If neither of "
"these config variables is set, the 'git web{litdd}browse' helper script "
"(called by 'git help') will pick a suitable default. See "
"linkgit:git-web{litdd}browse[1] for more information about this."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:118
#, no-wrap
msgid "CONFIGURATION VARIABLES"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:121
#, no-wrap
msgid "help.format"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:127
msgid ""
"If no command-line option is passed, the `help.format` configuration "
"variable will be checked. The following values are supported for this "
"variable; they make 'git help' behave as their corresponding command- line "
"option:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:129
msgid "\"man\" corresponds to '-m|--man',"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:130
msgid "\"info\" corresponds to '-i|--info',"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:131
msgid "\"web\" or \"html\" correspond to '-w|--web'."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:133
#, no-wrap
msgid "help.browser, web.browser, and browser.<tool>.path"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:139
msgid ""
"The `help.browser`, `web.browser` and `browser.<tool>.path` will also be "
"checked if the 'web' format is chosen (either by command-line option or "
"configuration variable). See '-w|--web' in the OPTIONS section above and "
"linkgit:git-web{litdd}browse[1]."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:141
#, no-wrap
msgid "man.viewer"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:145
msgid ""
"The `man.viewer` configuration variable will be checked if the 'man' format "
"is chosen. The following values are currently supported:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:147
msgid "\"man\": use the 'man' program as usual,"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:149
msgid ""
"\"woman\": use 'emacsclient' to launch the \"woman\" mode in emacs (this "
"only works starting with emacsclient versions 22),"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:151
msgid ""
"\"konqueror\": use 'kfmclient' to open the man page in a new konqueror tab "
"(see 'Note about konqueror' below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:154
msgid ""
"Values for other tools can be used if there is a corresponding "
"`man.<tool>.cmd` configuration entry (see below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:158
msgid ""
"Multiple values may be given to the `man.viewer` configuration "
"variable. Their corresponding programs will be tried in the order listed in "
"the configuration file."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:160
msgid "For example, this configuration:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-help.txt:165
#, no-wrap
msgid ""
"\t[man]\n"
"\t\tviewer = konqueror\n"
"\t\tviewer = woman\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:169
msgid ""
"will try to use konqueror first. But this may fail (for example, if DISPLAY "
"is not set) and in that case emacs' woman mode will be tried."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:173
msgid ""
"If everything fails, or if no viewer is configured, the viewer specified in "
"the `GIT_MAN_VIEWER` environment variable will be tried.  If that fails too, "
"the 'man' program will be tried anyway."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:175
#, no-wrap
msgid "man.<tool>.path"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:182
msgid ""
"You can explicitly provide a full path to your preferred man viewer by "
"setting the configuration variable `man.<tool>.path`. For example, you can "
"configure the absolute path to konqueror by setting "
"'man.konqueror.path'. Otherwise, 'git help' assumes the tool is available in "
"PATH."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:184
#, no-wrap
msgid "man.<tool>.cmd"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:192
msgid ""
"When the man viewer, specified by the `man.viewer` configuration variables, "
"is not among the supported ones, then the corresponding `man.<tool>.cmd` "
"configuration variable will be looked up. If this variable exists then the "
"specified tool will be treated as a custom command and a shell eval will be "
"used to run the command with the man page passed as arguments."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:194
#, no-wrap
msgid "Note about konqueror"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:199
msgid ""
"When 'konqueror' is specified in the `man.viewer` configuration variable, we "
"launch 'kfmclient' to try to open the man page on an already opened "
"konqueror in a new tab if possible."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:203
msgid ""
"For consistency, we also try such a trick if 'man.konqueror.path' is set to "
"something like `A_PATH_TO/konqueror`. That means we will try to launch "
"`A_PATH_TO/kfmclient` instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:206
msgid ""
"If you really want to use 'konqueror', then you can use something like the "
"following:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-help.txt:210
#, no-wrap
msgid ""
"\t[man]\n"
"\t\tviewer = konq\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-help.txt:213
#, no-wrap
msgid ""
"\t[man \"konq\"]\n"
"\t\tcmd = A_PATH_TO/konqueror\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-help.txt:216
#, no-wrap
msgid "Note about git config --global"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:220
msgid ""
"Note that all these configuration variables should probably be set using the "
"`--global` flag, for example like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-help.txt:224
#, no-wrap
msgid ""
"$ git config --global help.format web\n"
"$ git config --global web.browser firefox\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:228
msgid ""
"as they are probably more user specific than repository specific.  See "
"linkgit:git-config[1] for more information about this."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-help.txt:230
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-help.txt:231
msgid "Part of the linkgit:git[1] suite"
msgstr ""
