#. type: Title =
#: ../Documentation-sedout/git-ls-files.txt:2
#, no-wrap
msgid "git-ls-files(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:7
msgid ""
"git-ls-files - Show information about files in the index and the working "
"tree"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:25
#, no-wrap
msgid ""
"'git ls-files' [-z] [-t] [-v] [-f]\n"
"\t\t[-c|--cached] [-d|--deleted] [-o|--others] [-i|--ignored]\n"
"\t\t[-s|--stage] [-u|--unmerged] [-k|--killed] [-m|--modified]\n"
"\t\t[--resolve-undo]\n"
"\t\t[--directory [--no-empty-directory]] [--eol]\n"
"\t\t[--deduplicate]\n"
"\t\t[-x <pattern>|--exclude=<pattern>]\n"
"\t\t[-X <file>|--exclude-from=<file>]\n"
"\t\t[--exclude-per-directory=<file>]\n"
"\t\t[--exclude-standard]\n"
"\t\t[--error-unmatch] [--with-tree=<tree-ish>]\n"
"\t\t[--full-name] [--recurse-submodules]\n"
"\t\t[--abbrev[=<n>]] [--format=<format>] [--] [<file>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:27
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:30
msgid ""
"This command merges the file listing in the index with the actual working "
"directory list, and shows different combinations of the two."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:35
msgid ""
"Several flags can be used to determine which files are shown, and each file "
"may be printed multiple times if there are multiple entries in the index or "
"if multiple statuses are applicable for the relevant file selection options."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:37
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:38
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:39
#, no-wrap
msgid "`--cached`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:43
msgid ""
"Show all files cached in Git's index, i.e. all tracked files.  (This is the "
"default if no -c/-s/-d/-o/-u/-k/-m/--resolve-undo options are specified.)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:44
#, no-wrap
msgid "`-d`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:45
#, no-wrap
msgid "`--deleted`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:47
msgid "Show files with an unstaged deletion"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:48
#, no-wrap
msgid "`-m`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:49
#, no-wrap
msgid "`--modified`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:52
msgid ""
"Show files with an unstaged modification (note that an unstaged deletion "
"also counts as an unstaged modification)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:53
#, no-wrap
msgid "`-o`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:54
#, no-wrap
msgid "`--others`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:56
msgid "Show other (i.e. untracked) files in the output"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:57
#, no-wrap
msgid "`-i`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:58
#, no-wrap
msgid "`--ignored`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:67
msgid ""
"Show only ignored files in the output.  Must be used with either an explicit "
"'-c' or '-o'.  When showing files in the index (i.e. when used with '-c'), "
"print only those files matching an exclude pattern.  When showing \"other\" "
"files (i.e. when used with '-o'), show only those matched by an exclude "
"pattern.  Standard ignore rules are not automatically activated; therefore, "
"at least one of the `--exclude*` options is required."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:68
#, no-wrap
msgid "`-s`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:69
#, no-wrap
msgid "`--stage`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:71
msgid "Show staged contents' mode bits, object name and stage number in the output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:72
#, no-wrap
msgid "`--directory`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:76
msgid ""
"If a whole directory is classified as \"other\", show just its name (with a "
"trailing slash) and not its whole contents.  Has no effect without "
"-o/--others."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:77
#, no-wrap
msgid "`--no-empty-directory`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:79
msgid "Do not list empty directories. Has no effect without --directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:80
#, no-wrap
msgid "`-u`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:81
#, no-wrap
msgid "`--unmerged`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:85
msgid ""
"Show information about unmerged files in the output, but do not show any "
"other tracked files (forces --stage, overrides --cached)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:86
#, no-wrap
msgid "`-k`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:87
#, no-wrap
msgid "`--killed`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:91
msgid ""
"Show untracked files on the filesystem that need to be removed due to "
"file/directory conflicts for tracked files to be able to be written to the "
"filesystem."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:92
#, no-wrap
msgid "`--resolve-undo`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:98
msgid ""
"Show files having resolve-undo information in the index together with their "
"resolve-undo information.  (resolve-undo information is what is used to "
"implement \"git checkout -m $PATH\", i.e. to recreate merge conflicts that "
"were accidentally resolved)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:99
#, no-wrap
msgid "`-z`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:102
msgid ""
"\\0 line termination on output and do not quote filenames.  See OUTPUT below "
"for more information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:103
#, no-wrap
msgid "`--deduplicate`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:109
msgid ""
"When only filenames are shown, suppress duplicates that may come from having "
"multiple stages during a merge, or giving `--deleted` and `--modified` "
"option at the same time.  When any of the `-t`, `--unmerged`, or `--stage` "
"option is in use, this option has no effect."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:110
#, no-wrap
msgid "`-x <pattern>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:111
#, no-wrap
msgid "`--exclude=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:115
msgid ""
"Skip untracked files matching pattern.  Note that pattern is a shell "
"wildcard pattern. See EXCLUDE PATTERNS below for more information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:116
#, no-wrap
msgid "`-X <file>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:117
#, no-wrap
msgid "`--exclude-from=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:119
msgid "Read exclude patterns from <file>; 1 per line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:120
#, no-wrap
msgid "`--exclude-per-directory=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:126
msgid ""
"Read additional exclude patterns that apply only to the directory and its "
"subdirectories in <file>.  If you are trying to emulate the way Porcelain "
"commands work, using the `--exclude-standard` option instead is easier and "
"more thorough."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:127
#, no-wrap
msgid "`--exclude-standard`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:130
msgid ""
"Add the standard Git exclusions: .git/info/exclude, .gitignore in each "
"directory, and the user's global exclusion file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:131
#, no-wrap
msgid "`--error-unmatch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:134
msgid ""
"If any <file> does not appear in the index, treat this as an error (return "
"1)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:135
#, no-wrap
msgid "`--with-tree=<tree-ish>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:141
msgid ""
"When using --error-unmatch to expand the user supplied <file> (i.e. path "
"pattern) arguments to paths, pretend that paths which were removed in the "
"index since the named <tree-ish> are still present.  Using this option with "
"`-s` or `-u` options does not make any sense."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:142
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:149
msgid ""
"Show status tags together with filenames.  Note that for scripting purposes, "
"linkgit:git-status[1] `--porcelain` and linkgit:git-diff-files[1] "
"`--name-status` are almost always superior alternatives; users should look "
"at linkgit:git-status[1] `--short` or linkgit:git-diff[1] `--name-status` "
"for more user-friendly alternatives."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:154
msgid ""
"This option provides a reason for showing each filename, in the form of a "
"status tag (which is followed by a space and then the filename).  The status "
"tags are all single characters from the following list:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:155
#, no-wrap
msgid "H"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:156
msgid "tracked file that is not either unmerged or skip-worktree"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:156
#, no-wrap
msgid "S"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:157
msgid "tracked file that is skip-worktree"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:157
#, no-wrap
msgid "M"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:158
msgid "tracked file that is unmerged"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:158
#, no-wrap
msgid "R"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:159
msgid "tracked file with unstaged removal/deletion"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:159
#, no-wrap
msgid "C"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:160
msgid "tracked file with unstaged modification/change"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:160
#, no-wrap
msgid "K"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:162
msgid ""
"untracked paths which are part of file/directory conflicts which prevent "
"checking out tracked files"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:162
#, no-wrap
msgid "?"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:163
msgid "untracked file"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:163
#, no-wrap
msgid "U"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:164
msgid "file with resolve-undo information"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:166
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:170
msgid ""
"Similar to `-t`, but use lowercase letters for files that are marked as "
"'assume unchanged' (see linkgit:git-update-index[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:171
#, no-wrap
msgid "`-f`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:175
msgid ""
"Similar to `-t`, but use lowercase letters for files that are marked as "
"'fsmonitor valid' (see linkgit:git-update-index[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:176
#, no-wrap
msgid "`--full-name`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:181
msgid ""
"When run from a subdirectory, the command usually outputs paths relative to "
"the current directory.  This option forces paths to be output relative to "
"the project top directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:182
#, no-wrap
msgid "`--recurse-submodules`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:185
msgid ""
"Recursively calls ls-files on each active submodule in the repository.  "
"Currently there is only support for the --cached and --stage modes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:186
#, no-wrap
msgid "`--abbrev[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:191
msgid ""
"Instead of showing the full 40-byte hexadecimal object lines, show the "
"shortest prefix that is at least '<n>' hexdigits long that uniquely refers "
"the object.  Non default number of digits can be specified with "
"--abbrev=<n>."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:192
#, no-wrap
msgid "`--debug`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:197
msgid ""
"After each line that describes a file, add more data about its cache entry.  "
"This is intended to show as much information as possible for manual "
"inspection; the exact format may change at any time."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:198
#, no-wrap
msgid "`--eol`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:203
msgid ""
"Show <eolinfo> and <eolattr> of files.  <eolinfo> is the file content "
"identification used by Git when the \"text\" attribute is \"auto\" (or not "
"set and core.autocrlf is not false).  <eolinfo> is either \"-text\", "
"\"none\", \"lf\", \"crlf\", \"mixed\" or \"\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:206
msgid ""
"\"\" means the file is not a regular file, it is not in the index or not "
"accessible in the working tree."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:210
msgid ""
"<eolattr> is the attribute that is used when checking out or committing, it "
"is either \"\", \"-text\", \"text\", \"text=auto\", \"text eol=lf\", \"text "
"eol=crlf\".  Since Git 2.10 \"text=auto eol=lf\" and \"text=auto eol=crlf\" "
"are supported."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:214
msgid ""
"Both the <eolinfo> in the index (\"i/<eolinfo>\")  and in the working tree "
"(\"w/<eolinfo>\") are shown for regular files, followed by the "
"(\"attr/<eolattr>\")."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:215
#, no-wrap
msgid "`--sparse`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:219
msgid ""
"If the index is sparse, show the sparse directories without expanding to the "
"contained files. Sparse directories will be shown with a trailing slash, "
"such as \"x/\" for a sparse directory \"x\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:220
#, no-wrap
msgid "`--format=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:227
msgid ""
"A string that interpolates `%(fieldname)` from the result being shown.  It "
"also interpolates `%%` to `%`, and `%xXX` where `XX` are hex digits "
"interpolates to character with hex code `XX`; for example `%x00` "
"interpolates to `\\0` (NUL), `%x09` to `\\t` (TAB) and %x0a to `\\n` (LF).  "
"--format cannot be combined with `-s`, `-o`, `-k`, `-t`, `--resolve-undo` "
"and `--eol`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:227
#, no-wrap
msgid "\\--"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:229
msgid "Do not interpret any more arguments as options."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:230
#, no-wrap
msgid "<file>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:233
msgid ""
"Files to show. If no files are given all files which match the other "
"specified criteria are shown."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:235
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:238
msgid ""
"'git ls-files' just outputs the filenames unless `--stage` is specified in "
"which case it outputs:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:240
#, no-wrap
msgid "        [<tag> ]<mode> <object> <stage> <file>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:243
#, no-wrap
msgid ""
"'git ls-files --eol' will show\n"
"\ti/<eolinfo><SPACES>w/<eolinfo><SPACES>attr/<eolattr><SPACE*><TAB><file>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:246
msgid ""
"'git ls-files --unmerged' and 'git ls-files --stage' can be used to examine "
"detailed information on unmerged paths."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:252
msgid ""
"For an unmerged path, instead of recording a single mode/SHA-1 pair, the "
"index records up to three such pairs; one from tree O in stage 1, A in stage "
"2, and B in stage 3.  This information can be used by the user (or the "
"porcelain) to see what should eventually be recorded at the path. (see "
"linkgit:git-read-tree[1] for more information on state)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:257
msgid ""
"Without the `-z` option, pathnames with \"unusual\" characters are quoted as "
"explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1]).  Using `-z` the filename is output verbatim and the "
"line is terminated by a NUL byte."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:263
msgid ""
"It is possible to print in a custom format by using the `--format` option, "
"which is able to interpolate different fields using a `%(fieldname)` "
"notation. For example, if you only care about the \"objectname\" and "
"\"path\" fields, you can execute with a specific \"--format\" like"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:265
#, no-wrap
msgid "\tgit ls-files --format='%(objectname) %(path)'\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-files.txt:267
#, no-wrap
msgid "FIELD NAMES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:272
msgid ""
"The way each path is shown can be customized by using the "
"`--format=<format>` option, where the %(fieldname) in the <format> string "
"for various aspects of the index entry are interpolated.  The following "
"\"fieldname\" are understood:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:273
#, no-wrap
msgid "objectmode"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:275
msgid "The mode of the file which is recorded in the index."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:275
#, no-wrap
msgid "objecttype"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:277
msgid "The object type of the file which is recorded in the index."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:277
#, no-wrap
msgid "objectname"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:279
msgid "The name of the file which is recorded in the index."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:279
#, no-wrap
msgid "objectsize[:padded]"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:283
msgid ""
"The object size of the file which is recorded in the index (\"-\" if the "
"object is a `commit` or `tree`).  It also supports a padded format of size "
"with \"%(objectsize:padded)\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:283
#, no-wrap
msgid "stage"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:285
msgid "The stage of the file which is recorded in the index."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:285
#, no-wrap
msgid "eolinfo:index"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-files.txt:286
#, no-wrap
msgid "eolinfo:worktree"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-files.txt:289
msgid ""
