#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1143
msgid ""
"For example, the multi-threaded preload-index code can be instrumented with "
"a region around the thread pool and then per-thread start and exit events "
"within the thread-proc."
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1149
#, no-wrap
msgid ""
"static void *preload_thread(void *_data)\n"
"{\n"
"\t// start the per-thread clock and emit a message.\n"
"\ttrace2_thread_start(\"preload_thread\");\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1153
#, no-wrap
msgid ""
"\t// report which chunk of the array this thread was assigned.\n"
"\ttrace2_data_intmax(\"index\", the_repository, \"offset\", p->offset);\n"
"\ttrace2_data_intmax(\"index\", the_repository, \"count\", nr);\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1158
#, no-wrap
msgid ""
"\tdo {\n"
"\t    ...\n"
"\t} while (--nr > 0);\n"
"\t...\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1163
#, no-wrap
msgid ""
"\t// report elapsed time taken by this thread.\n"
"\ttrace2_thread_exit();\n"
"\treturn NULL;\n"
"}\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1169
#, no-wrap
msgid ""
"void preload_index(struct index_state *index,\n"
"\tconst struct pathspec *pathspec,\n"
"\tunsigned int refresh_flags)\n"
"{\n"
"\ttrace2_region_enter(\"index\", \"preload\", the_repository);\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1173
#, no-wrap
msgid ""
"\tfor (i = 0; i < threads; i++) {\n"
"\t    ... /* create thread */\n"
"\t}\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1177
#, no-wrap
msgid ""
"\tfor (i = 0; i < threads; i++) {\n"
"\t    ... /* join thread */\n"
"\t}\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1180
#, no-wrap
msgid ""
"\ttrace2_region_leave(\"index\", \"preload\", the_repository);\n"
"}\n"
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1189
msgid ""
"In this example preload_index() was executed by the `main` thread and "
"started the `preload` region.  Seven threads, named `th01:preload_thread` "
"through `th07:preload_thread`, were started.  Events from each thread are "
"atomically appended to the shared target stream as they occur so they may "
"appear in random order with respect other threads. Finally, the main thread "
"waits for the threads to finish and leaves the region."
msgstr ""

