#. type: Labeled list
#: ../Documentation/technical/api-trace2.txt:1244
#, no-wrap
msgid "Config (def param) Events"
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1247
msgid "Dump \"interesting\" config values to trace2 log."
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1251
msgid ""
"We can optionally emit configuration events, see `trace2.configparams` in "
"linkgit:git-config[1] for how to enable it."
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1260
#, no-wrap
msgid ""
"$ git config --system color.ui never\n"
"$ git config --global color.ui always\n"
"$ git config --local color.ui auto\n"
"$ git config --list --show-scope | grep 'color.ui'\n"
"system  color.ui=never\n"
"global  color.ui=always\n"
"local   color.ui=auto\n"
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1264
msgid ""
"Then, mark the config `color.ui` as \"interesting\" config with "
"`GIT_TRACE2_CONFIG_PARAMS`:"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1282
#, no-wrap
msgid ""
"$ export GIT_TRACE2_PERF_BRIEF=1\n"
"$ export GIT_TRACE2_PERF=~/log.perf\n"
"$ export GIT_TRACE2_CONFIG_PARAMS=color.ui\n"
"$ git version\n"
"...\n"
"$ cat ~/log.perf\n"
"d0 | main                     | version      |     |           |           |              "
"| ...\n"
"d0 | main                     | start        |     |  0.001642 |           |              "
"| /usr/local/bin/git version\n"
"d0 | main                     | cmd_name     |     |           |           |              "
"| version (version)\n"
"d0 | main                     | def_param    |     |           |           | "
"scope:system | color.ui:never\n"
"d0 | main                     | def_param    |     |           |           | "
"scope:global | color.ui:always\n"
"d0 | main                     | def_param    |     |           |           | "
"scope:local  | color.ui:auto\n"
"d0 | main                     | data         | r0  |  0.002100 |  0.002100 | "
"fsync        | fsync/writeout-only:0\n"
"d0 | main                     | data         | r0  |  0.002126 |  0.002126 | "
"fsync        | fsync/hardware-flush:0\n"
"d0 | main                     | exit         |     |  0.000470 |           |              "
"| code:0\n"
"d0 | main                     | atexit       |     |  0.000477 |           |              "
"| code:0\n"
msgstr ""

#. type: Labeled list
#: ../Documentation/technical/api-trace2.txt:1284
#, no-wrap
msgid "Stopwatch Timer Events"
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1289
msgid ""
"Measure the time spent in a function call or span of code that might be "
"called from many places within the code throughout the life of the process."
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1299
#, no-wrap
msgid ""
"static void expensive_function(void)\n"
"{\n"
"\ttrace2_timer_start(TRACE2_TIMER_ID_TEST1);\n"
"\t...\n"
"\tsleep_millisec(1000); // Do something expensive\n"
"\t...\n"
"\ttrace2_timer_stop(TRACE2_TIMER_ID_TEST1);\n"
"}\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1303
#, no-wrap
msgid ""
"static int ut_100timer(int argc, const char **argv)\n"
"{\n"
"\t...\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1305
#: ../Documentation/technical/api-trace2.txt:1309
#: ../Documentation/technical/api-trace2.txt:1313
#, no-wrap
msgid "\texpensive_function();\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1307
#, no-wrap
msgid "\t// Do something else 1...\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1311
#, no-wrap
msgid "\t// Do something else 2...\n"
msgstr ""

#. type: Plain text
#: ../Documentation/technical/api-trace2.txt:1321
msgid ""
"In this example, we measure the total time spent in `expensive_function()` "
"regardless of when it is called in the overall flow of the program."
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1334
#, no-wrap
msgid ""
"$ export GIT_TRACE2_PERF_BRIEF=1\n"
"$ export GIT_TRACE2_PERF=~/log.perf\n"
"$ t/helper/test-tool trace2 100timer 3 1000\n"
"...\n"
"$ cat ~/log.perf\n"
"d0 | main                     | version      |     |           |           |              "
"| ...\n"
"d0 | main                     | start        |     |  0.001453 |           |              "
"| t/helper/test-tool trace2 100timer 3 1000\n"
"d0 | main                     | cmd_name     |     |           |           |              "
"| trace2 (trace2)\n"
"d0 | main                     | exit         |     |  3.003667 |           |              "
"| code:0\n"
"d0 | main                     | timer        |     |           |           | "
"test         | name:test1 intervals:3 total:3.001686 min:1.000254 "
"max:1.000929\n"
"d0 | main                     | atexit       |     |  3.003796 |           |              "
"| code:0\n"
msgstr ""

