msgid ""
"void wt_status_collect(struct wt_status *s)\n"
"{\n"
"\ttrace2_region_enter(\"status\", \"worktrees\", s->repo);\n"
"\twt_status_collect_changes_worktree(s);\n"
"\ttrace2_region_leave(\"status\", \"worktrees\", s->repo);\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:998
#, no-wrap
msgid ""
"\ttrace2_region_enter(\"status\", \"index\", s->repo);\n"
"\twt_status_collect_changes_index(s);\n"
"\ttrace2_region_leave(\"status\", \"index\", s->repo);\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1003
#, no-wrap
msgid ""
"\ttrace2_region_enter(\"status\", \"untracked\", s->repo);\n"
"\twt_status_collect_untracked(s);\n"
"\ttrace2_region_leave(\"status\", \"untracked\", s->repo);\n"
"}\n"
msgstr ""

#. type: delimited block -
#: ../Documentation/technical/api-trace2.txt:1012
#, no-wrap
msgid ""
"void wt_status_print(struct wt_status *s)\n"
"{\n"
"\ttrace2_region_enter(\"status\", \"print\", s->repo);\n"
"\tswitch (s->status_format) {\n"
"\t    ...\n"
"\t}\n"
"\ttrace2_region_leave(\"status\", \"print\", s->repo);\n"
"}\n"
msgstr ""

