#. type: Title =
#: ../Documentation-sedout/git-restore.txt:2
#, no-wrap
msgid "git-restore(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-restore.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:7
msgid "git-restore - Restore working tree files"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-restore.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:14
#, no-wrap
msgid ""
"\t'git restore' [<options>] [--source=<tree>] [--staged] [--worktree] [--] "
"<pathspec>...\n"
"\t'git restore' [<options>] [--source=<tree>] [--staged] [--worktree] "
"--pathspec-from-file=<file> [--pathspec-file-nul]\n"
"\t'git restore' (-p|--patch) [<options>] [--source=<tree>] [--staged] "
"[--worktree] [--] [<pathspec>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-restore.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:20
msgid ""
"Restore specified paths in the working tree with some contents from a "
"restore source. If a path is tracked but does not exist in the restore "
"source, it will be removed to match the source."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:24
msgid ""
"The command can also be used to restore the content in the index with "
"`--staged`, or restore both the working tree and the index with `--staged "
"--worktree`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:27
msgid ""
"By default, if `--staged` is given, the contents are restored from `HEAD`, "
"otherwise from the index. Use `--source` to restore from a different commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:30
msgid ""
"See \"Reset, restore and revert\" in linkgit:git[1] for the differences "
"between the three commands."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:32
msgid "THIS COMMAND IS EXPERIMENTAL. THE BEHAVIOR MAY CHANGE."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-restore.txt:34
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:40
#, no-wrap
msgid ""
"`-s`\n"
"`--source=<tree>::`\n"
"\tRestore the working tree files with the content from the given\n"
"\ttree. It is common to specify the source tree by naming a\n"
"\tcommit, branch or tag associated with it.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:43
msgid ""
"If not specified, the contents are restored from `HEAD` if `--staged` is "
"given, otherwise from the index."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:47
msgid ""
"As a special case, you may use `\"A...B\"` as a shortcut for the merge base "
"of `A` and `B` if there is exactly one merge base. You can leave out at most "
"one of `A` and `B`, in which case it defaults to `HEAD`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:54
#, no-wrap
msgid ""
"`-p::`\n"
"`--patch::`\n"
"\tInteractively select hunks in the difference between the\n"
"\trestore source and the restore location. See the ``Interactive\n"
"\tMode'' section of linkgit:git-add[1] to learn how to operate\n"
"\tthe `--patch` mode.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:57
msgid ""
"Note that `--patch` can accept no pathspec and will prompt to restore all "
"modified paths."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:65
#, no-wrap
msgid ""
"`-W::`\n"
"`--worktree::`\n"
"`-S::`\n"
"`--staged::`\n"
"\tSpecify the restore location. If neither option is specified,\n"
"\tby default the working tree is restored. Specifying `--staged`\n"
"\twill only restore the index. Specifying both restores both.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:69
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tQuiet, suppress feedback messages. Implies `--no-progress`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:76
#, no-wrap
msgid ""
"`--progress::`\n"
"`--no-progress::`\n"
"\tProgress status is reported on the standard error stream\n"
"\tby default when it is attached to a terminal, unless `--quiet`\n"
"\tis specified. This flag enables progress reporting even if not\n"
"\tattached to a terminal, regardless of `--quiet`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:83
#, no-wrap
msgid ""
"`--ours::`\n"
"`--theirs::`\n"
"\tWhen restoring files in the working tree from the index, use\n"
"\tstage #2 ('ours') or #3 ('theirs') for unmerged paths.\n"
"\tThis option cannot be used when checking out paths from a\n"
"\ttree-ish (i.e. with the `--source` option).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:87
msgid ""
"Note that during `git rebase` and `git pull --rebase`, 'ours' and 'theirs' "
"may appear swapped. See the explanation of the same options in "
"linkgit:git-checkout[1] for details."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:94
#, no-wrap
msgid ""
"`-m::`\n"
"`--merge::`\n"
"\tWhen restoring files on the working tree from the index,\n"
"\trecreate the conflicted merge in the unmerged paths.\n"
"\tThis option cannot be used when checking out paths from a\n"
"\ttree-ish (i.e. with the `--source` option).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:100
#, no-wrap
msgid ""
"`--conflict=<style>::`\n"
"\tThe same as `--merge` option above, but changes the way the\n"
"\tconflicting hunks are presented, overriding the\n"
"\t`merge.conflictStyle` configuration variable.  Possible values\n"
"\tare \"merge\" (default), \"diff3\", and \"zdiff3\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:106
#, no-wrap
msgid ""
"`--ignore-unmerged::`\n"
"\tWhen restoring files on the working tree from the index, do\n"
"\tnot abort the operation if there are unmerged entries and\n"
"\tneither `--ours`, `--theirs`, `--merge` or `--conflict` is\n"
"\tspecified. Unmerged paths on the working tree are left alone.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:113
#, no-wrap
msgid ""
"`--ignore-skip-worktree-bits::`\n"
"\tIn sparse checkout mode, the default is to only update entries\n"
"\tmatched by `<pathspec>` and sparse patterns in\n"
"\t$GIT_DIR/info/sparse-checkout. This option ignores the sparse\n"
"\tpatterns and unconditionally restores any files in\n"
"\t`<pathspec>`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:124
#, no-wrap
msgid ""
"`--recurse-submodules::`\n"
"`--no-recurse-submodules::`\n"
"\tIf `<pathspec>` names an active submodule and the restore location\n"
"\tincludes the working tree, the submodule will only be updated if\n"
"\tthis option is given, in which case its working tree will be\n"
"\trestored to the commit recorded in the superproject, and any local\n"
"\tmodifications overwritten. If nothing (or\n"
"\t`--no-recurse-submodules`) is used, submodules working trees will\n"
"\tnot be updated. Just like linkgit:git-checkout[1], this will detach\n"
"\t`HEAD` of the submodule.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:131
#, no-wrap
msgid ""
"`--overlay::`\n"
"`--no-overlay::`\n"
"\tIn overlay mode, the command never removes files when\n"
"\trestoring. In no-overlay mode, tracked files that do not\n"
"\tappear in the `--source` tree are removed, to make them match\n"
"\t`<tree>` exactly. The default is no-overlay mode.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:139
#, no-wrap
msgid ""
"`--pathspec-from-file=<file>::`\n"
"\tPathspec is passed in `<file>` instead of commandline args. If\n"
"\t`<file>` is exactly `-` then standard input is used. Pathspec\n"
"\telements are separated by LF or CR/LF. Pathspec elements can be\n"
"\tquoted as explained for the configuration variable `core.quotePath`\n"
"\t(see linkgit:git-config[1]). See also `--pathspec-file-nul` and\n"
"\tglobal `--literal-pathspecs`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:144
#, no-wrap
msgid ""
"`--pathspec-file-nul::`\n"
"\tOnly meaningful with `--pathspec-from-file`. Pathspec elements are\n"
"\tseparated with NUL character and all other characters are taken\n"
"\tliterally (including newlines and quotes).\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-restore.txt:145
#, no-wrap
msgid "\\--"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:147
msgid "Do not interpret any more arguments as options."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-restore.txt:148
#, no-wrap
msgid "<pathspec>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:150
msgid "Limits the paths affected by the operation."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:152
msgid "For more details, see the 'pathspec' entry in linkgit:gitglossary[7]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-restore.txt:154
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:159
msgid ""
"The following sequence switches to the `master` branch, reverts the "
"`Makefile` to two revisions back, deletes hello.c by mistake, and gets it "
"back from the index."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:165
#, no-wrap
msgid ""
"$ git switch master\n"
"$ git restore --source master~2 Makefile  <1>\n"
"$ rm -f hello.c\n"
"$ git restore hello.c                     <2>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:168
msgid "take a file out of another commit"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:169
msgid "restore hello.c from the index"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:172
msgid ""
"If you want to restore _all_ C source files to match the version in the "
"index, you can say"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:175
#, no-wrap
msgid "$ git restore '*.c'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:181
msgid ""
"Note the quotes around `*.c`.  The file `hello.c` will also be restored, "
"even though it is no longer in the working tree, because the file globbing "
"is used to match entries in the index (not in the working tree by the "
"shell)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:183
msgid "To restore all files in the current directory"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:186
#, no-wrap
msgid "$ git restore .\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:190
msgid ""
"or to restore all working tree files with 'top' pathspec magic (see "
"linkgit:gitglossary[7])"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:193
#, no-wrap
msgid "$ git restore :/\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:197
msgid ""
"To restore a file in the index to match the version in `HEAD` (this is the "
"same as using linkgit:git-reset[1])"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:200
#, no-wrap
msgid "$ git restore --staged hello.c\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:204
msgid ""
"or you can restore both the index and the working tree (this is the same as "
"using linkgit:git-checkout[1])"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:207
#, no-wrap
msgid "$ git restore --source=HEAD --staged --worktree hello.c\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-restore.txt:210
msgid "or the short form which is more practical but less readable:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-restore.txt:213
#, no-wrap
msgid "$ git restore -s@ -SW hello.c\n"
msgstr ""

