#. type: Title =
#: ../Documentation-sedout/git-update-server-info.txt:2
#, no-wrap
msgid "git-update-server-info(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:7
msgid "git-update-server-info - Update auxiliary info file to help dumb servers"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:13
msgid "'git update-server-info' [-f | --force]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:21
msgid ""
"A dumb server that does not do on-the-fly pack generations must have some "
"auxiliary information files in $GIT_DIR/info and $GIT_OBJECT_DIRECTORY/info "
"directories to help clients discover what references and packs the server "
"has.  This command generates such auxiliary files."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-update-server-info.txt:24
#, no-wrap
msgid "`-f`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-update-server-info.txt:25
#, no-wrap
msgid "`--force`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:27
msgid "Update the info files from scratch."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:29
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:34
msgid ""
"Currently the command updates the following files.  Please see "
"linkgit:gitrepository-layout[5] for a description of what they are for:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:36
msgid "objects/info/packs"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:38
msgid "info/refs"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-update-server-info.txt:40
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-update-server-info.txt:41
msgid "Part of the linkgit:git[1] suite"
msgstr ""
