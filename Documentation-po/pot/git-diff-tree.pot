#. type: Title =
#: ../Documentation-sedout/git-diff-tree.txt:2
#, no-wrap
msgid "git-diff-tree(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff-tree.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:7
msgid ""
"git-diff-tree - Compares the content and mode of blobs found via two tree "
"objects"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff-tree.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:15
#, no-wrap
msgid ""
"'git diff-tree' [--stdin] [-m] [-s] [-v] [--no-commit-id] [--pretty]\n"
"\t      [-t] [-r] [-c | --cc] [--combined-all-paths] [--root] "
"[--merge-base]\n"
"\t      [<common-diff-options>] <tree-ish> [<tree-ish>] [<path>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff-tree.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:19
msgid "Compare the content and mode of blobs found via two tree objects."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:22
msgid ""
"If there is only one <tree-ish> given, the commit is compared with its "
"parents (see --stdin below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:24
msgid "Note that 'git diff-tree' can use the tree encapsulated in a commit object."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-diff-tree.txt:26
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff-tree.txt:29
#, no-wrap
msgid "<tree-ish>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:31
msgid "The id of a tree object."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-diff-tree.txt:32
#, no-wrap
msgid "<path>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:35
msgid ""
"If provided, the results are limited to a subset of files matching one of "
"the provided pathspecs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:38
#, no-wrap
msgid ""
"`-r::`\n"
"\tRecurse into sub-trees.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:41
#, no-wrap
msgid ""
"`-t::`\n"
"\tShow tree entry itself as well as subtrees.  Implies -r.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:45
#, no-wrap
msgid ""
"`--root::`\n"
"\tWhen `--root` is specified the initial commit will be shown as a big\n"
"\tcreation event. This is equivalent to a diff against the NULL tree.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:50
#, no-wrap
msgid ""
"`--merge-base::`\n"
"\tInstead of comparing the <tree-ish>s directly, use the merge\n"
"\tbase between the two <tree-ish>s as the \"before\" side.  There\n"
"\tmust be two <tree-ish>s given and they must both be commits.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:57
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tWhen `--stdin` is specified, the command does not take\n"
"\t<tree-ish> arguments from the command line.  Instead, it\n"
"\treads lines containing either two <tree>, one <commit>, or a\n"
"\tlist of <commit> from its standard input.  (Use a single space\n"
"\tas separator.)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:62
msgid ""
"When two trees are given, it compares the first tree with the second.  When "
"a single commit is given, it compares the commit with its parents.  The "
"remaining commits, when given, are used as if they are parents of the first "
"commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:67
msgid ""
"When comparing two trees, the ID of both trees (separated by a space and "
"terminated by a newline) is printed before the difference.  When comparing "
"commits, the ID of the first (or only) commit, followed by a newline, is "
"printed."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:70
msgid ""
"The following flags further affect the behavior when comparing commits (but "
"not trees)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:76
#, no-wrap
msgid ""
"`-m::`\n"
"\tBy default, 'git diff-tree --stdin' does not show\n"
"\tdifferences for merge commits.  With this flag, it shows\n"
"\tdifferences to that commit from all of its parents. See\n"
"\talso `-c`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:82
#, no-wrap
msgid ""
"`-s::`\n"
"\tBy default, 'git diff-tree --stdin' shows differences,\n"
"\teither in machine-readable form (without `-p`) or in patch\n"
"\tform (with `-p`).  This output can be suppressed.  It is\n"
"\tonly useful with the `-v` flag.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:86
#, no-wrap
msgid ""
"`-v::`\n"
"\tThis flag causes 'git diff-tree --stdin' to also show\n"
"\tthe commit message before the differences.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:92
#, no-wrap
msgid ""
"`--no-commit-id::`\n"
"\t'git diff-tree' outputs a line with the commit ID when\n"
"\tapplicable.  This flag suppresses the commit ID output.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:102
#, no-wrap
msgid ""
"`-c::`\n"
"\tThis flag changes the way a merge commit is displayed\n"
"\t(which means it is useful only when the command is given\n"
"\tone <tree-ish>, or `--stdin`).  It shows the differences\n"
"\tfrom each of the parents to the merge result simultaneously\n"
"\tinstead of showing pairwise diff between a parent and the\n"
"\tresult one at a time (which is what the `-m` option does).\n"
"\tFurthermore, it lists only files which were modified\n"
"\tfrom all parents.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:112
#, no-wrap
msgid ""
"`--cc::`\n"
"\tThis flag changes the way a merge commit patch is displayed,\n"
"\tin a similar way to the `-c` option. It implies the `-c`\n"
"\tand `-p` options and further compresses the patch output\n"
"\tby omitting uninteresting hunks whose contents in the parents\n"
"\thave only two variants and the merge result picks one of them\n"
"\twithout modification.  When all hunks are uninteresting, the commit\n"
"\titself and the commit log message are not shown, just like in any other\n"
"\t\"empty diff\" case.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:119
#, no-wrap
msgid ""
"`--combined-all-paths::`\n"
"\tThis flag causes combined diffs (used for merge commits) to\n"
"\tlist the name of the file from all parents.  It thus only has\n"
"\teffect when -c or --cc are specified, and is likely only\n"
"\tuseful if filename changes are detected (i.e. when either\n"
"\trename or copy detection have been requested).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-diff-tree.txt:123
#, no-wrap
msgid ""
"`--always::`\n"
"\tShow the commit itself and the commit log message even\n"
"\tif the diff itself is empty.\n"
msgstr ""

