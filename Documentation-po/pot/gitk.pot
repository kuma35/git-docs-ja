#. type: Title =
#: ../Documentation-sedout/gitk.txt:2
#, no-wrap
msgid "gitk(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:7
msgid "gitk - The Git repository browser"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:12
msgid "'gitk' [<options>] [<revision-range>] [--] [<path>...]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:14
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:18
msgid ""
"Displays changes in a repository or a selected set of commits. This includes "
"visualizing the commit graph, showing information related to each commit, "
"and the files in the trees of each revision."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:20
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:27
msgid ""
"To control which revisions to show, gitk supports most options applicable to "
"the 'git rev-list' command.  It also supports a few options applicable to "
"the 'git diff-*' commands to control how the changes each commit introduces "
"are shown.  Finally, it supports some gitk-specific options."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:31
msgid ""
"gitk generally only understands options with arguments in the 'stuck' form "
"(see linkgit:gitcli[7]) due to limitations in the command-line parser."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/gitk.txt:33
#, no-wrap
msgid "rev-list options and arguments"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:37
msgid ""
"This manual page describes only the most frequently used options.  See "
"linkgit:git-rev-list[1] for a complete list."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:39
msgid "`--all::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:41
#, no-wrap
msgid "\tShow all refs (branches, tags, etc.).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:45
msgid "`--branches[=<pattern>]::` `--tags[=<pattern>]::` `--remotes[=<pattern>]::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:51
#, no-wrap
msgid ""
"\tPretend as if all the branches (tags, remote branches, resp.)\n"
"\tare listed on the command line as '<commit>'. If '<pattern>'\n"
"\tis given, limit refs to ones matching given shell glob. If\n"
"\tpattern lacks '?', '{asterisk}', or '[', '/{asterisk}' at the\n"
"\tend is implied.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:53
msgid "`--since=<date>::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:55
#, no-wrap
msgid "\tShow commits more recent than a specific date.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:57
msgid "`--until=<date>::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:59
#, no-wrap
msgid "\tShow commits older than a specific date.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:61
msgid "`--date-order::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:63
#, no-wrap
msgid "\tSort commits by date when possible.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:65
msgid "`--merge::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:70
#, no-wrap
msgid ""
"\tAfter an attempt to merge stops with conflicts, show the commits on\n"
"\tthe history between two branches (i.e. the HEAD and the MERGE_HEAD)\n"
"\tthat modify the conflicted files and do not exist on all the heads\n"
"\tbeing merged.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:72
msgid "`--left-right::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:76
#, no-wrap
msgid ""
"\tMark which side of a symmetric difference a commit is reachable\n"
"\tfrom.  Commits from the left side are prefixed with a `<`\n"
"\tsymbol and those from the right with a `>` symbol.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:78
msgid "`--full-history::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:82
#, no-wrap
msgid ""
"\tWhen filtering history with '<path>...', does not prune some\n"
"\thistory.  (See \"History simplification\" in linkgit:git-log[1]\n"
"\tfor a more detailed explanation.)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:84
msgid "`--simplify-merges::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:90
#, no-wrap
msgid ""
"\tAdditional option to `--full-history` to remove some needless\n"
"\tmerges from the resulting history, as there are no selected\n"
"\tcommits contributing to this merge.  (See \"History\n"
"\tsimplification\" in linkgit:git-log[1] for a more detailed\n"
"\texplanation.)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:92
msgid "`--ancestry-path::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:100
#, no-wrap
msgid ""
"\tWhen given a range of commits to display\n"
"\t(e.g. 'commit1..commit2' or 'commit2 {caret}commit1'), only\n"
"\tdisplay commits that exist directly on the ancestry chain\n"
"\tbetween the 'commit1' and 'commit2', i.e. commits that are\n"
"\tboth descendants of 'commit1', and ancestors of 'commit2'.\n"
"\t(See \"History simplification\" in linkgit:git-log[1] for a more\n"
"\tdetailed explanation.)\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/gitk.txt:103
#, no-wrap
msgid "<revision range>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:111
msgid ""
"Limit the revisions to show. This can be either a single revision meaning "
"show from the given revision and back, or it can be a range in the form "
"\"'<from>'..'<to>'\" to show all revisions between '<from>' and back to "
"'<to>'. Note, more advanced revision selection can be applied.  For a more "
"complete list of ways to spell object names, see linkgit:gitrevisions[7]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/gitk.txt:112
#, no-wrap
msgid "<path>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:117
msgid ""
"Limit commits to the ones touching files in the given paths. Note, to avoid "
"ambiguity with respect to revision names use \"--\" to separate the paths "
"from any preceding options."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/gitk.txt:119
#, no-wrap
msgid "gitk-specific options"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:122
msgid "`--argscmd=<command>::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:129
#, no-wrap
msgid ""
"\tCommand to be run each time gitk has to determine the revision\n"
"\trange to show.  The command is expected to print on its\n"
"\tstandard output a list of additional revisions to be shown,\n"
"\tone per line.  Use this instead of explicitly specifying a\n"
"\t'<revision-range>' if the set of commits to show may vary\n"
"\tbetween refreshes.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:131
msgid "`--select-commit=<ref>::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:134
#, no-wrap
msgid ""
"\tSelect the specified commit after loading the graph.\n"
"\tDefault behavior is equivalent to specifying '--select-commit=HEAD'.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:136
#, no-wrap
msgid "Examples"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/gitk.txt:137
#, no-wrap
msgid "gitk v2.6.12.. include/scsi drivers/scsi"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:141
msgid ""
"Show the changes since version 'v2.6.12' that changed any file in the "
"include/scsi or drivers/scsi subdirectories"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/gitk.txt:142
#, no-wrap
msgid "gitk --since=\"2 weeks ago\" \\-- gitk"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:147
msgid ""
"Show the changes during the last two weeks to the file 'gitk'.  The \"--\" "
"is necessary to avoid confusion with the *branch* named 'gitk'"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/gitk.txt:148
#, no-wrap
msgid "gitk --max-count=100 --all \\-- Makefile"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:152
msgid ""
"Show at most 100 changes made to the file 'Makefile'. Instead of only "
"looking for changes in the current branch look in all branches."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/gitk.txt:154
#, no-wrap
msgid "Files"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:156
msgid "User configuration and preferences are stored at:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:158
msgid "`$XDG_CONFIG_HOME/git/gitk` if it exists, otherwise"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:159
msgid "`$HOME/.gitk` if it exists"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitk.txt:163
msgid ""
"If neither of the above exist then `$XDG_CONFIG_HOME/git/gitk` is created "
"and used by default. If '$XDG_CONFIG_HOME' is not set it defaults to "
"`$HOME/.config` in all cases."
msgstr ""

#. type: Title -
