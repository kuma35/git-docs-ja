#. type: Title =
#: ../Documentation-sedout/git-ls-remote.txt:2
#, no-wrap
msgid "git-ls-remote(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:7
msgid "git-ls-remote - List references in a remote repository"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:15
#, no-wrap
msgid ""
"'git ls-remote' [--branches] [--tags] [--refs] [--upload-pack=<exec>]\n"
"\t      [-q | --quiet] [--exit-code] [--get-url] [--sort=<key>]\n"
"\t      [--symref] [<repository> [<patterns>...]]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:20
msgid ""
"Displays references available in a remote repository along with the "
"associated commit IDs."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:36
#, no-wrap
msgid ""
"`-b::`\n"
"`--branches::`\n"
"`-t::`\n"
"`--tags::`\n"
"\tLimit to only local branches and local tags, respectively.\n"
"\tThese options are _not_ mutually exclusive; when given\n"
"\tboth, references stored in refs/heads and refs/tags are\n"
"\tdisplayed.  Note that `--heads` and `-h` are deprecated\n"
"\tsynonyms for `--branches` and `-b` and may be removed in\n"
"\tthe future.  Also note that `git ls-remote -h` used without\n"
"\tanything else on the command line gives help, consistent\n"
"\twith other git subcommands.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:39
#, no-wrap
msgid ""
"`--refs::`\n"
"\tDo not show peeled tags or pseudorefs like `HEAD` in the output.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:43
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tDo not print remote URL to stderr.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:49
#, no-wrap
msgid ""
"`--upload-pack=<exec>::`\n"
"\tSpecify the full path of 'git-upload-pack' on the remote\n"
"\thost. This allows listing references from repositories accessed via\n"
"\tSSH and where the SSH daemon does not use the PATH configured by the\n"
"\tuser.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:55
#, no-wrap
msgid ""
"`--exit-code::`\n"
"\tExit with status \"2\" when no matching refs are found in the remote\n"
"\trepository. Usually the command exits with status \"0\" to indicate\n"
"\tit successfully talked with the remote repository, whether it\n"
"\tfound any matching refs.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:60
#, no-wrap
msgid ""
"`--get-url::`\n"
"\tExpand the URL of the given remote repository taking into account any\n"
"\t\"url.<base>.insteadOf\" config setting (See linkgit:git-config[1]) and\n"
"\texit without talking to the remote.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:66
#, no-wrap
msgid ""
"`--symref::`\n"
"\tIn addition to the object pointed by it, show the underlying\n"
"\tref pointed by it when showing a symbolic ref.  Currently,\n"
"\tupload-pack only shows the symref HEAD, so it will be the only\n"
"\tone shown by ls-remote.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:76
#, no-wrap
msgid ""
"`--sort=<key>::`\n"
"\tSort based on the key given. Prefix `-` to sort in descending order\n"
"\tof the value. Supports \"version:refname\" or \"v:refname\" (tag names\n"
"\tare treated as versions). The \"version:refname\" sort order can also\n"
"\tbe affected by the \"versionsort.suffix\" configuration variable.\n"
"\tSee linkgit:git-for-each-ref[1] for more sort options, but be aware\n"
"\tkeys like `committerdate` that require access to the objects\n"
"\tthemselves will not work for refs whose objects have not yet been\n"
"\tfetched from the remote, and will give a `missing object` error.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:87
#, no-wrap
msgid ""
"`-o`\n"
"`--server-option=<option>::`\n"
"\tTransmit the given string to the server when communicating using\n"
"\tprotocol version 2.  The given string must not contain a NUL or LF\n"
"\tcharacter.\n"
"\tWhen multiple `--server-option=<option>` are given, they are all\n"
"\tsent to the other side in the order listed on the command line.\n"
"\tWhen no `--server-option=<option>` is given from the command line,\n"
"\tthe values of configuration variable `remote.<name>.serverOption`\n"
"\tare used instead.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:88
#, no-wrap
msgid "<repository>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:92
msgid ""
"The \"remote\" repository to query.  This parameter can be either a URL or "
"the name of a remote (see the GIT URLS and REMOTES sections of "
"linkgit:git-fetch[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:93
#, no-wrap
msgid "<patterns>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:103
msgid ""
"When unspecified, all references, after filtering done with --heads and "
"--tags, are shown.  When <patterns>... are specified, only references "
"matching one or more of the given patterns are displayed. Each pattern is "
"interpreted as a glob (see `glob` in linkgit:gitglossary[7]) which is "
"matched against the \"tail\" of a ref, starting either from the start of the "
"ref (so a full name like `refs/heads/foo` matches) or from a slash separator "
"(so `bar` matches `refs/heads/bar` but not `refs/heads/foobar`)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:105
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:108
msgid "The output is in the format:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:111
#, no-wrap
msgid "<oid> TAB <ref> LF\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:117
msgid ""
"When showing an annotated tag, unless `--refs` is given, two such lines are "
"shown: one with the refname for the tag itself as `<ref>`, and another with "
"`<ref>` followed by `^{}`. The `<oid>` on the latter line shows the name of "
"the object the tag points at."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:119
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:123
msgid "List all references (including symbolics and pseudorefs), peeling tags:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:131
#, no-wrap
msgid ""
"$ git ls-remote\n"
"27d43aaaf50ef0ae014b88bba294f93658016a2e\tHEAD\n"
"950264636c68591989456e3ba0a5442f93152c1a\trefs/heads/main\n"
"d9ab777d41f92a8c1684c91cfb02053d7dd1046b\trefs/heads/next\n"
"d4ca2e3147b409459955613c152220f4db848ee1\trefs/tags/v2.40.0\n"
"73876f4861cd3d187a4682290ab75c9dccadbc56\trefs/tags/v2.40.0^{}\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:134
msgid "List all references matching given patterns:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:139
#, no-wrap
msgid ""
"$ git ls-remote http://www.kernel.org/pub/scm/git/git.git master seen rc\n"
"5fe978a5381f1fbad26a80e682ddd2a401966740\trefs/heads/master\n"
"c781a84b5204fb294c9ccc79f8b3baceeb32c061\trefs/heads/seen\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:142
msgid "List only tags matching a given wildcard pattern:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:149
#, no-wrap
msgid ""
"$ git ls-remote --tags http://www.kernel.org/pub/scm/git/git.git v\\*\n"
"485a869c64a68cc5795dd99689797c5900f4716d\trefs/tags/v2.39.2\n"
"cbf04937d5b9fcf0a76c28f69e6294e9e3ecd7e6\trefs/tags/v2.39.2^{}\n"
"d4ca2e3147b409459955613c152220f4db848ee1\trefs/tags/v2.40.0\n"
"73876f4861cd3d187a4682290ab75c9dccadbc56\trefs/tags/v2.40.0^{}\n"
msgstr ""

