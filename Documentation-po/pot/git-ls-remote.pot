#. type: Title =
#: ../Documentation-sedout/git-ls-remote.txt:2
#, no-wrap
msgid "git-ls-remote(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:7
msgid "git-ls-remote - List references in a remote repository"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:15
#, no-wrap
msgid ""
"'git ls-remote' [--branches] [--tags] [--refs] [--upload-pack=<exec>]\n"
"\t      [-q | --quiet] [--exit-code] [--get-url] [--sort=<key>]\n"
"\t      [--symref] [<repository> [<patterns>...]]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:20
msgid ""
"Displays references available in a remote repository along with the "
"associated commit IDs."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:24
#, no-wrap
msgid "`-b`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:25
#, no-wrap
msgid "`--branches`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:26
#, no-wrap
msgid "`-t`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:27
#, no-wrap
msgid "`--tags`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:36
msgid ""
"Limit to only local branches and local tags, respectively.  These options "
"are _not_ mutually exclusive; when given both, references stored in "
"refs/heads and refs/tags are displayed.  Note that `--heads` and `-h` are "
"deprecated synonyms for `--branches` and `-b` and may be removed in the "
"future.  Also note that `git ls-remote -h` used without anything else on the "
"command line gives help, consistent with other git subcommands."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:37
#, no-wrap
msgid "`--refs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:39
msgid "Do not show peeled tags or pseudorefs like `HEAD` in the output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:40
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:41
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:43
msgid "Do not print remote URL to stderr."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:44
#, no-wrap
msgid "`--upload-pack=<exec>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:49
msgid ""
"Specify the full path of 'git-upload-pack' on the remote host. This allows "
"listing references from repositories accessed via SSH and where the SSH "
"daemon does not use the PATH configured by the user."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:50
#, no-wrap
msgid "`--exit-code`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:55
msgid ""
"Exit with status \"2\" when no matching refs are found in the remote "
"repository. Usually the command exits with status \"0\" to indicate it "
"successfully talked with the remote repository, whether it found any "
"matching refs."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:56
#, no-wrap
msgid "`--get-url`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:60
msgid ""
"Expand the URL of the given remote repository taking into account any "
"\"url.<base>.insteadOf\" config setting (See linkgit:git-config[1]) and exit "
"without talking to the remote."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:61
#, no-wrap
msgid "`--symref`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:66
msgid ""
"In addition to the object pointed by it, show the underlying ref pointed by "
"it when showing a symbolic ref.  Currently, upload-pack only shows the "
"symref HEAD, so it will be the only one shown by ls-remote."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:67
#, no-wrap
msgid "`--sort=<key>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:76
msgid ""
"Sort based on the key given. Prefix `-` to sort in descending order of the "
"value. Supports \"version:refname\" or \"v:refname\" (tag names are treated "
"as versions). The \"version:refname\" sort order can also be affected by the "
"\"versionsort.suffix\" configuration variable.  See "
"linkgit:git-for-each-ref[1] for more sort options, but be aware keys like "
"`committerdate` that require access to the objects themselves will not work "
"for refs whose objects have not yet been fetched from the remote, and will "
"give a `missing object` error."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:77
#, no-wrap
msgid "`-o <option>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:78
#, no-wrap
msgid "`--server-option=<option>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:87
msgid ""
"Transmit the given string to the server when communicating using protocol "
"version 2.  The given string must not contain a NUL or LF character.  When "
"multiple `--server-option=<option>` are given, they are all sent to the "
"other side in the order listed on the command line.  When no "
"`--server-option=<option>` is given from the command line, the values of "
"configuration variable `remote.<name>.serverOption` are used instead."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:88
#, no-wrap
msgid "<repository>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:92
msgid ""
"The \"remote\" repository to query.  This parameter can be either a URL or "
"the name of a remote (see the GIT URLS and REMOTES sections of "
"linkgit:git-fetch[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-remote.txt:93
#, no-wrap
msgid "<patterns>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:103
msgid ""
"When unspecified, all references, after filtering done with --heads and "
"--tags, are shown.  When <patterns>... are specified, only references "
"matching one or more of the given patterns are displayed. Each pattern is "
"interpreted as a glob (see `glob` in linkgit:gitglossary[7]) which is "
"matched against the \"tail\" of a ref, starting either from the start of the "
"ref (so a full name like `refs/heads/foo` matches) or from a slash separator "
"(so `bar` matches `refs/heads/bar` but not `refs/heads/foobar`)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:105
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:108
msgid "The output is in the format:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:111
#, no-wrap
msgid "<oid> TAB <ref> LF\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:117
msgid ""
"When showing an annotated tag, unless `--refs` is given, two such lines are "
"shown: one with the refname for the tag itself as `<ref>`, and another with "
"`<ref>` followed by `^{}`. The `<oid>` on the latter line shows the name of "
"the object the tag points at."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-remote.txt:119
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:123
msgid "List all references (including symbolics and pseudorefs), peeling tags:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:131
#, no-wrap
msgid ""
"$ git ls-remote\n"
"27d43aaaf50ef0ae014b88bba294f93658016a2e\tHEAD\n"
"950264636c68591989456e3ba0a5442f93152c1a\trefs/heads/main\n"
"d9ab777d41f92a8c1684c91cfb02053d7dd1046b\trefs/heads/next\n"
"d4ca2e3147b409459955613c152220f4db848ee1\trefs/tags/v2.40.0\n"
"73876f4861cd3d187a4682290ab75c9dccadbc56\trefs/tags/v2.40.0^{}\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:134
msgid "List all references matching given patterns:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:139
#, no-wrap
msgid ""
"$ git ls-remote http://www.kernel.org/pub/scm/git/git.git master seen rc\n"
"5fe978a5381f1fbad26a80e682ddd2a401966740\trefs/heads/master\n"
"c781a84b5204fb294c9ccc79f8b3baceeb32c061\trefs/heads/seen\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-remote.txt:142
msgid "List only tags matching a given wildcard pattern:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-ls-remote.txt:149
#, no-wrap
msgid ""
"$ git ls-remote --tags http://www.kernel.org/pub/scm/git/git.git v\\*\n"
"485a869c64a68cc5795dd99689797c5900f4716d\trefs/tags/v2.39.2\n"
"cbf04937d5b9fcf0a76c28f69e6294e9e3ecd7e6\trefs/tags/v2.39.2^{}\n"
"d4ca2e3147b409459955613c152220f4db848ee1\trefs/tags/v2.40.0\n"
"73876f4861cd3d187a4682290ab75c9dccadbc56\trefs/tags/v2.40.0^{}\n"
msgstr ""

