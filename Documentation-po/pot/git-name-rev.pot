#. type: Title =
#: ../Documentation-sedout/git-name-rev.txt:2
#, no-wrap
msgid "git-name-rev(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-name-rev.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:7
msgid "git-name-rev - Find symbolic names for given revs"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-name-rev.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:14
#, no-wrap
msgid ""
"'git name-rev' [--tags] [--refs=<pattern>]\n"
"\t       ( --all | --annotate-stdin | <commit-ish>... )\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-name-rev.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:19
msgid ""
"Finds symbolic names suitable for human digestion for revisions given in any "
"format parsable by 'git rev-parse'."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-name-rev.txt:22
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:26
#, no-wrap
msgid ""
"`--tags::`\n"
"\tDo not use branch names, but only tags to name the commits\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:32
#, no-wrap
msgid ""
"`--refs=<pattern>::`\n"
"\tOnly use refs whose names match a given shell pattern.  The pattern\n"
"\tcan be a branch name, a tag name, or a fully qualified ref name. If\n"
"\tgiven multiple times, use refs whose names match any of the given shell\n"
"\tpatterns. Use `--no-refs` to clear any previous ref patterns given.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:41
#, no-wrap
msgid ""
"`--exclude=<pattern>::`\n"
"\tDo not use any ref whose name matches a given shell pattern. The\n"
"\tpattern can be one of branch name, tag name or fully qualified ref\n"
"\tname. If given multiple times, a ref will be excluded when it matches\n"
"\tany of the given patterns. When used together with --refs, a ref will\n"
"\tbe used as a match only when it matches at least one --refs pattern and\n"
"\tdoes not match any --exclude patterns. Use `--no-exclude` to clear the\n"
"\tlist of exclude patterns.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:44
#, no-wrap
msgid ""
"`--all::`\n"
"\tList all commits reachable from all refs\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:51
#, no-wrap
msgid ""
"`--annotate-stdin::`\n"
"\tTransform stdin by substituting all the 40-character SHA-1\n"
"\thexes (say $hex) with \"$hex ($rev_name)\".  When used with\n"
"\t--name-only, substitute with \"$rev_name\", omitting $hex\n"
"\taltogether. This option was called `--stdin` in older versions\n"
"\tof Git.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:53
msgid "For example:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:56
#, no-wrap
msgid "$ cat sample.txt\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:60
#, no-wrap
msgid ""
"An abbreviated revision 2ae0a9cb82 will not be substituted.\n"
"The full name after substitution is "
"2ae0a9cb8298185a94e5998086f380a355dd8907,\n"
"while its tree object is 70d105cc79e63b81cfdcb08a15297c23e60b07ad\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:62
#, no-wrap
msgid "$ git name-rev --annotate-stdin <sample.txt\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:66
#, no-wrap
msgid ""
"An abbreviated revision 2ae0a9cb82 will not be substituted.\n"
"The full name after substitution is 2ae0a9cb8298185a94e5998086f380a355dd8907 "
"(master),\n"
"while its tree object is 70d105cc79e63b81cfdcb08a15297c23e60b07ad\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:68
#, no-wrap
msgid "$ git name-rev --name-only --annotate-stdin <sample.txt\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:72
#, no-wrap
msgid ""
"An abbreviated revision 2ae0a9cb82 will not be substituted.\n"
"The full name after substitution is master,\n"
"while its tree object is 70d105cc79e63b81cfdcb08a15297c23e60b07ad\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:79
#, no-wrap
msgid ""
"`--name-only::`\n"
"\tInstead of printing both the SHA-1 and the name, print only\n"
"\tthe name.  If given with --tags the usual tag prefix of\n"
"\t\"tags/\" is also omitted from the name, matching the output\n"
"\tof `git-describe` more closely.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:83
#, no-wrap
msgid ""
"`--no-undefined::`\n"
"\tDie with error code != 0 when a reference is undefined,\n"
"\tinstead of printing `undefined`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:86
#, no-wrap
msgid ""
"`--always::`\n"
"\tShow uniquely abbreviated commit object as fallback.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-name-rev.txt:88
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:94
msgid ""
"Given a commit, find out where it is relative to the local refs. Say "
"somebody wrote you about that fantastic commit "
"33db5f4d9027a10e477ccf054b2c1ab94f74c85a.  Of course, you look into the "
"commit, but that only tells you what happened, but not the context."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:96
msgid "Enter 'git name-rev':"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:100
#, no-wrap
msgid ""
"% git name-rev 33db5f4d9027a10e477ccf054b2c1ab94f74c85a\n"
"33db5f4d9027a10e477ccf054b2c1ab94f74c85a tags/v0.99~940\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:103
msgid ""
"Now you are wiser, because you know that it happened 940 revisions before "
"v0.99."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-name-rev.txt:105
msgid "Another nice thing you can do is:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-name-rev.txt:108
#, no-wrap
msgid "% git log | git name-rev --annotate-stdin\n"
msgstr ""

