#. type: Title =
#: ../Documentation-sedout/git-log.txt:2
#, no-wrap
msgid "git-log(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:7
msgid "git-log - Show commit logs"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:13
msgid "'git log' [<options>] [<revision-range>] [[--] <path>...]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:17
msgid "Shows the commit logs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:25
msgid ""
"The command takes options applicable to the linkgit:git-rev-list[1] command "
"to control what is shown and how, and options applicable to the "
"linkgit:git-diff[1] command to control how the changes each commit "
"introduces are shown."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:28
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:30
#, no-wrap
msgid "`--follow`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:33
msgid ""
"Continue listing the history of a file beyond renames (works only for a "
"single file)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:34
#, no-wrap
msgid "`--no-decorate`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:35
#, no-wrap
msgid "`--decorate[=short|full|auto|no]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:45
msgid ""
"Print out the ref names of any commits that are shown. If 'short' is "
"specified, the ref name prefixes 'refs/heads/', 'refs/tags/' and "
"'refs/remotes/' will not be printed. If 'full' is specified, the full ref "
"name (including prefix) will be printed. If 'auto' is specified, then if the "
"output is going to a terminal, the ref names are shown as if 'short' were "
"given, otherwise no ref names are shown. The option `--decorate` is "
"short-hand for `--decorate=short`.  Default to configuration value of "
"`log.decorate` if configured, otherwise, `auto`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:46
#, no-wrap
msgid "`--decorate-refs=<pattern>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:47
#, no-wrap
msgid "`--decorate-refs-exclude=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:54
msgid ""
"For each candidate reference, do not use it for decoration if it matches any "
"patterns given to `--decorate-refs-exclude` or if it doesn't match any of "
"the patterns given to `--decorate-refs`. The `log.excludeDecoration` config "
"option allows excluding refs from the decorations, but an explicit "
"`--decorate-refs` pattern will override a match in `log.excludeDecoration`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:58
msgid ""
"If none of these options or config settings are given, then references are "
"used as decoration if they match `HEAD`, `refs/heads/`, `refs/remotes/`, "
"`refs/stash/`, or `refs/tags/`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:59
#, no-wrap
msgid "`--clear-decorations`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:65
msgid ""
"When specified, this option clears all previous `--decorate-refs` or "
"`--decorate-refs-exclude` options and relaxes the default decoration filter "
"to include all references. This option is assumed if the config value "
"`log.initialDecorationSet` is set to `all`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:66
#, no-wrap
msgid "`--source`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:69
msgid ""
"Print out the ref name given on the command line by which each commit was "
"reached."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:70
#, no-wrap
msgid "`--[no-]mailmap`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:71
#, no-wrap
msgid "`--[no-]use-mailmap`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:75
msgid ""
"Use mailmap file to map author and committer names and email addresses to "
"canonical real names and email addresses. See linkgit:git-shortlog[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:76
#, no-wrap
msgid "`--full-diff`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:82
msgid ""
"Without this flag, `git log -p <path>...` shows commits that touch the "
"specified paths, and diffs about the same specified paths.  With this, the "
"full diff is shown for commits that touch the specified paths; this means "
"that \"<path>...\" limits only commits, and doesn't limit diff for those "
"commits."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:85
msgid ""
"Note that this affects all diff-based output types, e.g. those produced by "
"`--stat`, etc."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:86
#, no-wrap
msgid "`--log-size`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:91
msgid ""
"Include a line ``log size <number>'' in the output for each commit, where "
"<number> is the length of that commit's message in bytes.  Intended to speed "
"up tools that read log messages from `git log` output by allowing them to "
"allocate space in advance."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:94
#, no-wrap
msgid "<revision-range>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:102
msgid ""
"Show only commits in the specified revision range.  When no <revision-range> "
"is specified, it defaults to `HEAD` (i.e. the whole history leading to the "
"current commit).  `origin..HEAD` specifies all the commits reachable from "
"the current commit (i.e. `HEAD`), but not from `origin`. For a complete list "
"of ways to spell <revision-range>, see the 'Specifying Ranges' section of "
"linkgit:gitrevisions[7]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:103
#, no-wrap
msgid "[--] <path>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:108
msgid ""
"Show only commits that are enough to explain how the files that match the "
"specified paths came to be.  See 'History Simplification' below for details "
"and other simplification modes."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:111
msgid ""
"Paths may need to be prefixed with `--` to separate them from options or the "
"revision range, when confusion arises."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:117
#, no-wrap
msgid "DIFF FORMATTING"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:121
msgid ""
"By default, `git log` does not generate any diff output. The options below "
"can be used to show the changes made by each commit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:128
msgid ""
"Note that unless one of `--diff-merges` variants (including short `-m`, "
"`-c`, `--cc`, and `--dd` options) is explicitly given, merge commits will "
"not show a diff, even if a diff format like `--patch` is selected, nor will "
"they match search options like `-S`. The exception is when `--first-parent` "
"is in use, in which case `first-parent` is the default format for merge "
"commits."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:136
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:137
#, no-wrap
msgid "`git log --no-merges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:140
msgid "Show the whole commit history, but skip any merges"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:141
#, no-wrap
msgid "`git log v2.6.12.. include/scsi drivers/scsi`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:145
msgid ""
"Show all commits since version 'v2.6.12' that changed any file in the "
"`include/scsi` or `drivers/scsi` subdirectories"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:146
#, no-wrap
msgid "`git log --since=\"2 weeks ago\" -- gitk`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:151
msgid ""
"Show the changes during the last two weeks to the file 'gitk'.  The `--` is "
"necessary to avoid confusion with the *branch* named 'gitk'"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:152
#, no-wrap
msgid "`git log --name-status release..test`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:157
msgid ""
"Show the commits that are in the \"test\" branch but not yet in the "
"\"release\" branch, along with the list of paths each commit modifies."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:158
#, no-wrap
msgid "`git log --follow builtin/rev-list.c`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:163
msgid ""
"Shows the commits that changed `builtin/rev-list.c`, including those commits "
"that occurred before the file was given its present name."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:164
#, no-wrap
msgid "`git log --branches --not --remotes=origin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:169
msgid ""
"Shows all commits that are in any of local branches but not in any of "
"remote-tracking branches for 'origin' (what you have that origin doesn't)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:170
#, no-wrap
msgid "`git log master --not --remotes=*/master`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:174
msgid ""
"Shows all commits that are in local master but not in any remote repository "
"master branches."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:175
#, no-wrap
msgid "`git log -p -m --first-parent`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:182
msgid ""
"Shows the history including change diffs, but only from the ``main branch'' "
"perspective, skipping commits that come from merged branches, and showing "
"full diffs of changes introduced by the merges.  This makes sense only when "
"following a strict policy of merging all topic branches when staying on a "
"single integration branch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:183
#, no-wrap
msgid "`git log -L '/int main/',/^}/:main.c`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:187
msgid "Shows how the function `main()` in the file `main.c` evolved over time."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:188
#, no-wrap
msgid "`git log -3`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:191
msgid "Limits the number of commits to show to 3."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:193
#, no-wrap
msgid "DISCUSSION"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:198
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:202
msgid ""
"See linkgit:git-config[1] for core variables and linkgit:git-diff[1] for "
"settings related to diff generation."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:203
#, no-wrap
msgid "format.pretty"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:206
msgid ""
"Default for the `--format` option.  (See 'Pretty Formats' above.)  Defaults "
"to `medium`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-log.txt:207
#, no-wrap
msgid "i18n.logOutputEncoding"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-log.txt:211
msgid ""
"Encoding to use when displaying logs.  (See 'Discussion' above.)  Defaults "
"to the value of `i18n.commitEncoding` if set, and UTF-8 otherwise."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-log.txt:219
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
