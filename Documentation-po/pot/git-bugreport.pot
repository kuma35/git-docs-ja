#. type: Title =
#: ../Documentation-sedout/git-bugreport.txt:2
#, no-wrap
msgid "git-bugreport(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-bugreport.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:7
msgid "git-bugreport - Collect information for user to file a bug report"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-bugreport.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:14
#, no-wrap
msgid ""
"'git bugreport' [(-o | --output-directory) <path>]\n"
"\t\t[(-s | --suffix) <format> | --no-suffix]\n"
"\t\t[--diagnose[=<mode>]]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-bugreport.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:22
msgid ""
"Collects information about the user's machine, Git client, and repository "
"state, in addition to a form requesting information about the behavior the "
"user observed, and stores it in a single text file which the user can then "
"share, for example to the Git mailing list, in order to report an observed "
"bug."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:24
msgid "The following information is requested from the user:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:26
msgid "Reproduction steps"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:27
msgid "Expected behavior"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:28
msgid "Actual behavior"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:30
msgid "The following information is captured automatically:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:32
msgid "'git version --build-options'"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:33
msgid "uname sysname, release, version, and machine strings"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:34
msgid "Compiler-specific info string"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:35
msgid "A list of enabled hooks"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:36
msgid "$SHELL"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:40
msgid ""
"Additional information may be gathered into a separate zip archive using the "
"`--diagnose` option, and can be attached alongside the bugreport document to "
"provide additional context to readers."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:45
msgid ""
"This tool is invoked via the typical Git setup process, which means that in "
"some cases, it might not be able to launch - for example, if a relevant "
"config file is unreadable. In this kind of scenario, it may be helpful to "
"manually gather the kind of information listed above when manually asking "
"for help."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-bugreport.txt:47
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:52
#, no-wrap
msgid ""
"`-o`\n"
"`--output-directory`\n"
"\tPlace the resulting bug report file in `<path>` instead of the current\n"
"\tdirectory.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:61
#, no-wrap
msgid ""
"`-s`\n"
"`--suffix`\n"
"`--no-suffix::`\n"
"\tSpecify an alternate suffix for the bugreport name, to create a file\n"
"\tnamed 'git-bugreport-<formatted-suffix>'. This should take the form of a\n"
"\tstrftime(3) format string; the current local time will be used.\n"
"\t`--no-suffix` disables the suffix and the file is just named\n"
"\t`git-bugreport` without any disambiguation measure.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:68
#, no-wrap
msgid ""
"`--no-diagnose::`\n"
"`--diagnose[=<mode>]::`\n"
"\tCreate a zip archive of supplemental information about the user's\n"
"\tmachine, Git client, and repository state. The archive is written to the\n"
"\tsame output directory as the bug report and is named\n"
"\t'git-diagnostics-<formatted-suffix>'.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-bugreport.txt:74
msgid ""
"Without `mode` specified, the diagnostic archive will contain the default "
"set of statistics reported by `git diagnose`. An optional `mode` value may "
"be specified to change which information is included in the archive. See "
"linkgit:git-diagnose[1] for the list of valid values for `mode` and details "
"about their usage."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-bugreport.txt:76
#, no-wrap
msgid "GIT"
msgstr ""

