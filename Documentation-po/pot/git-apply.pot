#. type: Title =
#: ../Documentation-sedout/git-apply.txt:2
#, no-wrap
msgid "git-apply(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:7
msgid "git-apply - Apply a patch to files and/or to the index"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:21
#, no-wrap
msgid ""
"'git apply' [--stat] [--numstat] [--summary] [--check]\n"
"\t  [--index | --intent-to-add] [--3way] [--ours | --theirs | --union]\n"
"\t  [--apply] [--no-add] [--build-fake-ancestor=<file>] [-R | --reverse]\n"
"\t  [--allow-binary-replacement | --binary] [--reject] [-z]\n"
"\t  [-p<n>] [-C<n>] [--inaccurate-eof] [--recount] [--cached]\n"
"\t  [--ignore-space-change | --ignore-whitespace]\n"
"\t  [--whitespace=(nowarn|warn|fix|error|error-all)]\n"
"\t  [--exclude=<path>] [--include=<path>] [--directory=<root>]\n"
"\t  [--verbose | --quiet] [--unsafe-paths] [--allow-empty] [<patch>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:23
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:31
msgid ""
"Reads the supplied diff output (i.e. \"a patch\") and applies it to files.  "
"When running from a subdirectory in a repository, patched paths outside the "
"directory are ignored.  With the `--index` option, the patch is also applied "
"to the index, and with the `--cached` option, the patch is only applied to "
"the index.  Without these options, the command applies the patch only to "
"files, and does not require them to be in a Git repository."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:35
msgid ""
"This command applies the patch but does not create a commit.  Use "
"linkgit:git-am[1] to create commits from patches generated by "
"linkgit:git-format-patch[1] and/or received by email."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:37
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-apply.txt:38
#, no-wrap
msgid "<patch>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:41
msgid ""
"The files to read the patch from.  '-' can be used to read from the standard "
"input."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:45
#, no-wrap
msgid ""
"`--stat::`\n"
"\tInstead of applying the patch, output diffstat for the\n"
"\tinput.  Turns off \"apply\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:52
#, no-wrap
msgid ""
"`--numstat::`\n"
"\tSimilar to `--stat`, but shows the number of added and\n"
"\tdeleted lines in decimal notation and the pathname without\n"
"\tabbreviation, to make it more machine friendly.  For\n"
"\tbinary files, outputs two `-` instead of saying\n"
"\t`0 0`.  Turns off \"apply\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:58
#, no-wrap
msgid ""
"`--summary::`\n"
"\tInstead of applying the patch, output a condensed\n"
"\tsummary of information obtained from git diff extended\n"
"\theaders, such as creations, renames, and mode changes.\n"
"\tTurns off \"apply\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:63
#, no-wrap
msgid ""
"`--check::`\n"
"\tInstead of applying the patch, see if the patch is\n"
"\tapplicable to the current working tree and/or the index\n"
"\tfile and detects errors.  Turns off \"apply\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:72
#, no-wrap
msgid ""
"`--index::`\n"
"\tApply the patch to both the index and the working tree (or\n"
"\tmerely check that it would apply cleanly to both if `--check` is\n"
"\tin effect). Note that `--index` expects index entries and\n"
"\tworking tree copies for relevant paths to be identical (their\n"
"\tcontents and metadata such as file mode must match), and will\n"
"\traise an error if they are not, even if the patch would apply\n"
"\tcleanly to both the index and the working tree in isolation.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:77
#, no-wrap
msgid ""
"`--cached::`\n"
"\tApply the patch to just the index, without touching the working\n"
"\ttree. If `--check` is in effect, merely check that it would\n"
"\tapply cleanly to the index entry.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:85
#, no-wrap
msgid ""
"`--intent-to-add::`\n"
"\tWhen applying the patch only to the working tree, mark new\n"
"\tfiles to be added to the index later (see `--intent-to-add`\n"
"\toption in linkgit:git-add[1]). This option is ignored unless\n"
"\trunning in a Git repository and `--index` is not specified.\n"
"\tNote that `--index` could be implied by other options such\n"
"\tas `--cached` or `--3way`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:95
#, no-wrap
msgid ""
"`-3::`\n"
"`--3way::`\n"
"\tAttempt 3-way merge if the patch records the identity of blobs it is "
"supposed\n"
"\tto apply to and we have those blobs available locally, possibly leaving "
"the\n"
"\tconflict markers in the files in the working tree for the user to\n"
"\tresolve.  This option implies the `--index` option unless the\n"
"\t`--cached` option is used, and is incompatible with the `--reject` "
"option.\n"
"\tWhen used with the `--cached` option, any conflicts are left at higher "
"stages\n"
"\tin the cache.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:101
#, no-wrap
msgid ""
"`--ours::`\n"
"`--theirs::`\n"
"`--union::`\n"
"\tInstead of leaving conflicts in the file, resolve conflicts favouring\n"
"\tour (or their or both) side of the lines. Requires --3way.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:108
#, no-wrap
msgid ""
"`--build-fake-ancestor=<file>::`\n"
"\tNewer 'git diff' output has embedded 'index information'\n"
"\tfor each blob to help identify the original version that\n"
"\tthe patch applies to.  When this flag is given, and if\n"
"\tthe original versions of the blobs are available locally,\n"
"\tbuilds a temporary index containing those blobs.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:111
msgid ""
"When a pure mode change is encountered (which has no index information), the "
"information is read from the current index instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:115
#, no-wrap
msgid ""
"`-R::`\n"
"`--reverse::`\n"
"\tApply the patch in reverse.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:122
#, no-wrap
msgid ""
"`--reject::`\n"
"\tFor atomicity, 'git apply' by default fails the whole patch and\n"
"\tdoes not touch the working tree when some of the hunks\n"
"\tdo not apply.  This option makes it apply\n"
"\tthe parts of the patch that are applicable, and leave the\n"
"\trejected hunks in corresponding *.rej files.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:126
#, no-wrap
msgid ""
"`-z::`\n"
"\tWhen `--numstat` has been given, do not munge pathnames,\n"
"\tbut use a NUL-terminated machine-readable format.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:130
msgid ""
"Without this option, pathnames with \"unusual\" characters are quoted as "
"explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1])."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:136
#, no-wrap
msgid ""
"`-p<n>::`\n"
"\tRemove <n> leading path components (separated by slashes) from\n"
"\ttraditional diff paths. E.g., with `-p2`, a patch against\n"
"\t`a/dir/file` will be applied directly to `file`. The default is\n"
"\t1.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:142
#, no-wrap
msgid ""
"`-C<n>::`\n"
"\tEnsure at least <n> lines of surrounding context match before\n"
"\tand after each change.  When fewer lines of surrounding\n"
"\tcontext exist they all must match.  By default no context is\n"
"\tever ignored.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:149
#, no-wrap
msgid ""
"`--unidiff-zero::`\n"
"\tBy default, 'git apply' expects that the patch being\n"
"\tapplied is a unified diff with at least one line of context.\n"
"\tThis provides good safety measures, but breaks down when\n"
"\tapplying a diff generated with `--unified=0`. To bypass these\n"
"\tchecks use `--unidiff-zero`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:152
msgid ""
"Note, for the reasons stated above, the usage of context-free patches is "
"discouraged."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:159
#, no-wrap
msgid ""
"`--apply::`\n"
"\tIf you use any of the options marked \"Turns off\n"
"\t'apply'\" above, 'git apply' reads and outputs the\n"
"\trequested information without actually applying the\n"
"\tpatch.  Give this flag after those flags to also apply\n"
"\tthe patch.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:166
#, no-wrap
msgid ""
"`--no-add::`\n"
"\tWhen applying a patch, ignore additions made by the\n"
"\tpatch.  This can be used to extract the common part between\n"
"\ttwo files by first running 'diff' on them and applying\n"
"\tthe result with this option, which would apply the\n"
"\tdeletion part but not the addition part.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:173
#, no-wrap
msgid ""
"`--allow-binary-replacement::`\n"
"`--binary::`\n"
"\tHistorically we did not allow binary patch application\n"
"\twithout an explicit permission from the user, and this\n"
"\tflag was the way to do so.  Currently, we always allow binary\n"
"\tpatch application, so this is a no-op.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:178
#, no-wrap
msgid ""
"`--exclude=<path-pattern>::`\n"
"\tDon't apply changes to files matching the given path pattern. This can\n"
"\tbe useful when importing patchsets, where you want to exclude certain\n"
"\tfiles or directories.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:183
#, no-wrap
msgid ""
"`--include=<path-pattern>::`\n"
"\tApply changes to files matching the given path pattern. This can\n"
"\tbe useful when importing patchsets, where you want to include certain\n"
"\tfiles or directories.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:189
msgid ""
"When `--exclude` and `--include` patterns are used, they are examined in the "
"order they appear on the command line, and the first match determines if a "
"patch to each path is used.  A patch to a path that does not match any "
"include/exclude pattern is used by default if there is no include pattern on "
"the command line, and ignored if there is any include pattern."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:197
#, no-wrap
msgid ""
"`--ignore-space-change::`\n"
"`--ignore-whitespace::`\n"
"\tWhen applying a patch, ignore changes in whitespace in context\n"
"\tlines if necessary.\n"
"\tContext lines will preserve their whitespace, and they will not\n"
"\tundergo whitespace fixing regardless of the value of the\n"
"\t`--whitespace` option. New lines will still be fixed, though.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:206
#, no-wrap
msgid ""
"`--whitespace=<action>::`\n"
"\tWhen applying a patch, detect a new or modified line that has\n"
"\twhitespace errors.  What are considered whitespace errors is\n"
"\tcontrolled by `core.whitespace` configuration.  By default,\n"
"\ttrailing whitespaces (including lines that solely consist of\n"
"\twhitespaces) and a space character that is immediately followed\n"
"\tby a tab character inside the initial indent of the line are\n"
"\tconsidered whitespace errors.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:210
msgid ""
"By default, the command outputs warning messages but applies the patch.  "
"When `git-apply` is used for statistics and not applying a patch, it "
"defaults to `nowarn`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:213
msgid "You can use different `<action>` values to control this behavior:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:215
msgid "`nowarn` turns off the trailing whitespace warning."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:217
msgid ""
"`warn` outputs warnings for a few such errors, but applies the patch as-is "
"(default)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:221
msgid ""
"`fix` outputs warnings for a few such errors, and applies the patch after "
"fixing them (`strip` is a synonym -- the tool used to consider only trailing "
"whitespace characters as errors, and the fix involved 'stripping' them, but "
"modern Gits do more)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:223
msgid ""
"`error` outputs warnings for a few such errors, and refuses to apply the "
"patch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:224
msgid "`error-all` is similar to `error` but shows all errors."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:231
#, no-wrap
msgid ""
"`--inaccurate-eof::`\n"
"\tUnder certain circumstances, some versions of 'diff' do not correctly\n"
"\tdetect a missing new-line at the end of the file. As a result, patches\n"
"\tcreated by such 'diff' programs do not record incomplete lines\n"
"\tcorrectly. This option adds support for applying such patches by\n"
"\tworking around this bug.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:237
#, no-wrap
msgid ""
"`-v::`\n"
"`--verbose::`\n"
"\tReport progress to stderr. By default, only a message about the\n"
"\tcurrent patch being applied will be printed. This option will cause\n"
"\tadditional information to be reported.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:242
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tSuppress stderr output. Messages about patch status and progress\n"
"\twill not be printed.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:247
#, no-wrap
msgid ""
"`--recount::`\n"
"\tDo not trust the line counts in the hunk headers, but infer them\n"
"\tby inspecting the patch (e.g. after editing the patch without\n"
"\tadjusting the hunk headers appropriately).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:251
#, no-wrap
msgid ""
"`--directory=<root>::`\n"
"\tPrepend <root> to all filenames.  If a \"-p\" argument was also passed,\n"
"\tit is applied before prepending the new root.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:255
msgid ""
"For example, a patch that talks about updating `a/git-gui.sh` to "
"`b/git-gui.sh` can be applied to the file in the working tree "
"`modules/git-gui/git-gui.sh` by running `git apply "
"--directory=modules/git-gui`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:261
#, no-wrap
msgid ""
"`--unsafe-paths::`\n"
"\tBy default, a patch that affects outside the working area\n"
"\t(either a Git controlled working tree, or the current working\n"
"\tdirectory when \"git apply\" is used as a replacement of GNU\n"
"\tpatch) is rejected as a mistake (or a mischief).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:265
msgid ""
"When `git apply` is used as a \"better GNU patch\", the user can pass the "
"`--unsafe-paths` option to override this safety check.  This option has no "
"effect when `--index` or `--cached` is in use."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:269
#, no-wrap
msgid ""
"`--allow-empty::`\n"
"\tDon't return an error for patches containing no diff. This includes\n"
"\tempty patches and patches with commit text only.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:271
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-apply.txt:278
#, no-wrap
msgid "SUBMODULES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:281
msgid ""
"If the patch contains any changes to submodules then 'git apply' treats "
"these changes as follows."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:287
msgid ""
"If `--index` is specified (explicitly or implicitly), then the submodule "
"commits must match the index exactly for the patch to apply.  If any of the "
"submodules are checked-out, then these check-outs are completely ignored, "
"i.e., they are not required to be up to date or clean and they are not "
"updated."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-apply.txt:291
msgid ""
"If `--index` is not specified, then the submodule commits in the patch are "
"ignored and only the absence or presence of the corresponding subdirectory "
"is checked and (if possible) updated."
msgstr ""

