#. type: Title =
#: ../Documentation-sedout/git-mailinfo.txt:2
#, no-wrap
msgid "git-mailinfo(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mailinfo.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:7
msgid "git-mailinfo - Extracts patch and authorship from a single e-mail message"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mailinfo.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:15
#, no-wrap
msgid ""
"'git mailinfo' [-k|-b] [-u | --encoding=<encoding> | -n]\n"
"\t       [--[no-]scissors] [--quoted-cr=<action>]\n"
"\t       <msg> <patch>\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mailinfo.txt:18
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:25
msgid ""
"Reads a single e-mail message from the standard input, and writes the commit "
"log message in <msg> file, and the patches in <patch> file.  The author "
"name, e-mail and e-mail subject are written out to the standard output to be "
"used by 'git am' to create a commit.  It is usually not necessary to use "
"this command directly.  See linkgit:git-am[1] instead."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mailinfo.txt:28
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:34
#, no-wrap
msgid ""
"`-k::`\n"
"\tUsually the program removes email cruft from the Subject:\n"
"\theader line to extract the title line for the commit log\n"
"\tmessage.  This option prevents this munging, and is most\n"
"\tuseful when used to read back 'git format-patch -k' output.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:36
msgid "Specifically, the following are removed until none of them remain:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:39
msgid "Leading and trailing whitespace."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:41
msgid "Leading `Re:`, `re:`, and `:`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:43
msgid "Leading bracketed strings (between `[` and `]`, usually"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:44
msgid "`[PATCH]`)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:48
msgid ""
"Finally, runs of whitespace are normalized to a single ASCII space "
"character."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:53
#, no-wrap
msgid ""
"`-b::`\n"
"\tWhen -k is not in effect, all leading strings bracketed with '['\n"
"\tand ']' pairs are stripped.  This option limits the stripping to\n"
"\tonly the pairs whose bracketed string contains the word \"PATCH\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:60
#, no-wrap
msgid ""
"`-u::`\n"
"\tThe commit log message, author name and author email are\n"
"\ttaken from the e-mail, and after minimally decoding MIME\n"
"\ttransfer encoding, re-coded in the charset specified by\n"
"\t`i18n.commitEncoding` (defaulting to UTF-8) by transliterating\n"
"\tthem.  This used to be optional but now it is the default.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:63
msgid ""
"Note that the patch is always used as-is without charset conversion, even "
"with this flag."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:67
#, no-wrap
msgid ""
"`--encoding=<encoding>::`\n"
"\tSimilar to -u.  But when re-coding, the charset specified here is\n"
"\tused instead of the one specified by `i18n.commitEncoding` or UTF-8.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:70
#, no-wrap
msgid ""
"`-n::`\n"
"\tDisable all charset re-coding of the metadata.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:75
#, no-wrap
msgid ""
"`-m::`\n"
"`--message-id::`\n"
"\tCopy the Message-ID header at the end of the commit message.  This\n"
"\tis useful in order to associate commits with mailing list discussions.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:83
#, no-wrap
msgid ""
"`--scissors::`\n"
"\tRemove everything in body before a scissors line (e.g. \"-- >8 --\").\n"
"\tThe line represents scissors and perforation marks, and is used to\n"
"\trequest the reader to cut the message at that line.  If that line\n"
"\tappears in the body of the message before the patch, everything\n"
"\tbefore it (including the scissors line itself) is ignored when\n"
"\tthis option is used.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:88
msgid ""
"This is useful if you want to begin your message in a discussion thread with "
"comments and suggestions on the message you are responding to, and to "
"conclude it with a patch submission, separating the discussion and the "
"beginning of the proposed commit log message with a scissors line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:90
msgid ""
"This can be enabled by default with the configuration option "
"mailinfo.scissors."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:93
#, no-wrap
msgid ""
"`--no-scissors::`\n"
"\tIgnore scissors lines. Useful for overriding mailinfo.scissors settings.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:98
#, no-wrap
msgid ""
"`--quoted-cr=<action>::`\n"
"\tAction when processes email messages sent with base64 or\n"
"\tquoted-printable encoding, and the decoded lines end with a CRLF\n"
"\tinstead of a simple LF.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:100
msgid "The valid actions are:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:103
msgid "`nowarn`: Git will do nothing when such a CRLF is found."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:104
msgid "`warn`: Git will issue a warning for each message if such a CRLF is"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:105
msgid "found."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:106
msgid "`strip`: Git will convert those CRLF to LF."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:110
msgid ""
"The default action could be set by configuration option "
"`mailinfo.quotedCR`.  If no such configuration option has been set, `warn` "
"will be used."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-mailinfo.txt:111
#, no-wrap
msgid "<msg>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:114
msgid ""
"The commit log message extracted from e-mail, usually except the title line "
"which comes from e-mail Subject."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-mailinfo.txt:115
#, no-wrap
msgid "<patch>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mailinfo.txt:117
msgid "The patch extracted from e-mail."
msgstr ""

