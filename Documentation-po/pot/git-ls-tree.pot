#. type: Title =
#: ../Documentation-sedout/git-ls-tree.txt:2
#, no-wrap
msgid "git-ls-tree(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:7
msgid "git-ls-tree - List the contents of a tree object"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:15
#, no-wrap
msgid ""
"'git ls-tree' [-d] [-r] [-t] [-l] [-z]\n"
"\t    [--name-only] [--name-status] [--object-only] [--full-name] "
"[--full-tree] [--abbrev[=<n>]] [--format=<format>]\n"
"\t    <tree-ish> [<path>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:20
msgid ""
"Lists the contents of a given tree object, like what \"/bin/ls -a\" does in "
"the current working directory.  Note that:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:25
msgid ""
"the behaviour is slightly different from that of \"/bin/ls\" in that the "
"'<path>' denotes just a list of patterns to match, e.g. so specifying "
"directory name (without `-r`) will behave differently, and order of the "
"arguments does not matter."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:35
msgid ""
"the behaviour is similar to that of \"/bin/ls\" in that the '<path>' is "
"taken as relative to the current working directory.  E.g. when you are in a "
"directory 'sub' that has a directory 'dir', you can run 'git ls-tree -r HEAD "
"dir' to list the contents of the tree (that is `sub/dir` in `HEAD`).  You "
"don't want to give a tree that is not at the root level (e.g. `git ls-tree "
"-r HEAD:sub dir`) in this case, as that would result in asking for "
"`sub/sub/dir` in the `HEAD` commit.  However, the current working directory "
"can be ignored by passing --full-tree option."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:37
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:38
#, no-wrap
msgid "<tree-ish>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:40
msgid "Id of a tree-ish."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:43
#, no-wrap
msgid ""
"`-d::`\n"
"\tShow only the named tree entry itself, not its children.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:46
#, no-wrap
msgid ""
"`-r::`\n"
"\tRecurse into sub-trees.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:50
#, no-wrap
msgid ""
"`-t::`\n"
"\tShow tree entries even when going to recurse them. Has no effect\n"
"\tif `-r` was not passed. `-d` implies `-t`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:54
#, no-wrap
msgid ""
"`-l::`\n"
"`--long::`\n"
"\tShow object size of blob (file) entries.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:58
#, no-wrap
msgid ""
"`-z::`\n"
"\t\\0 line termination on output and do not quote filenames.\n"
"\tSee OUTPUT FORMAT below for more information.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:63
#, no-wrap
msgid ""
"`--name-only::`\n"
"`--name-status::`\n"
"\tList only filenames (instead of the \"long\" output), one per line.\n"
"\tCannot be combined with `--object-only`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:71
#, no-wrap
msgid ""
"`--object-only::`\n"
"\tList only names of the objects, one per line. Cannot be combined\n"
"\twith `--name-only` or `--name-status`.\n"
"\tThis is equivalent to specifying `--format='%(objectname)'`, but\n"
"\tfor both this option and that exact format the command takes a\n"
"\thand-optimized codepath instead of going through the generic\n"
"\tformatting mechanism.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:77
#, no-wrap
msgid ""
"`--abbrev[=<n>]::`\n"
"\tInstead of showing the full 40-byte hexadecimal object\n"
"\tlines, show the shortest prefix that is at least '<n>'\n"
"\thexdigits long that uniquely refers the object.\n"
"\tNon default number of digits can be specified with --abbrev=<n>.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:81
#, no-wrap
msgid ""
"`--full-name::`\n"
"\tInstead of showing the path names relative to the current working\n"
"\tdirectory, show the full path names.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:85
#, no-wrap
msgid ""
"`--full-tree::`\n"
"\tDo not limit the listing to the current working directory.\n"
"\tImplies --full-name.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:95
#, no-wrap
msgid ""
"`--format=<format>::`\n"
"\tA string that interpolates `%(fieldname)` from the result\n"
"\tbeing shown. It also interpolates `%%` to `%`, and\n"
"\t`%xNN` where `NN` are hex digits interpolates to character\n"
"\twith hex code `NN`; for example `%x00` interpolates to\n"
"\t`\\0` (NUL), `%x09` to `\\t` (TAB) and `%x0a` to `\\n` (LF).\n"
"\tWhen specified, `--format` cannot be combined with other\n"
"\tformat-altering options, including `--long`, `--name-only`\n"
"\tand `--object-only`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:96
#, no-wrap
msgid "[<path>...]"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:100
msgid ""
"When paths are given, show them (note that this isn't really raw pathnames, "
"but rather a list of patterns to match).  Otherwise implicitly uses the root "
"level of the tree as the sole path argument."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:103
#, no-wrap
msgid "Output Format"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:108
msgid ""
"The output format of `ls-tree` is determined by either the `--format` "
"option, or other format-altering options such as `--name-only` etc.  (see "
"`--format` above)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:112
msgid ""
"The use of certain `--format` directives is equivalent to using those "
"options, but invoking the full formatting machinery can be slower than using "
"an appropriate formatting option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:116
msgid ""
"In cases where the `--format` would exactly map to an existing option "
"`ls-tree` will use the appropriate faster path. Thus the default format is "
"equivalent to:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:118
#, no-wrap
msgid "\t%(objectmode) %(objecttype) %(objectname)%x09%(path)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:121
msgid ""
"This output format is compatible with what `--index-info --stdin` of 'git "
"update-index' expects."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:123
msgid "When the `-l` option is used, format changes to"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:125
#, no-wrap
msgid ""
"\t%(objectmode) %(objecttype) %(objectname) "
"%(objectsize:padded)%x09%(path)\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:129
msgid ""
"Object size identified by <objectname> is given in bytes, and "
"right-justified with minimum width of 7 characters.  Object size is given "
"only for blobs (file) entries; for other entries `-` character is used in "
"place of size."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:134
msgid ""
"Without the `-z` option, pathnames with \"unusual\" characters are quoted as "
"explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1]).  Using `-z` the filename is output verbatim and the "
"line is terminated by a NUL byte."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:136
msgid "Customized format:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:141
msgid ""
"It is possible to print in a custom format by using the `--format` option, "
"which is able to interpolate different fields using a `%(fieldname)` "
"notation.  For example, if you only care about the \"objectname\" and "
"\"path\" fields, you can execute with a specific \"--format\" like"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:143
#, no-wrap
msgid "\tgit ls-tree --format='%(objectname) %(path)' <tree-ish>\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:145
#, no-wrap
msgid "FIELD NAMES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:150
msgid ""
"Various values from structured fields can be used to interpolate into the "
"resulting output. For each outputting line, the following names can be used:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:151
#, no-wrap
msgid "objectmode"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:153
msgid "The mode of the object."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:153
#, no-wrap
msgid "objecttype"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:155
msgid "The type of the object (`commit`, `blob` or `tree`)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:155
#, no-wrap
msgid "objectname"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:157
msgid "The name of the object."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:157
#, no-wrap
msgid "objectsize[:padded]"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:160
msgid ""
"The size of a `blob` object (\"-\" if it's a `commit` or `tree`).  It also "
"supports a padded format of size with \"%(objectsize:padded)\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-ls-tree.txt:160
#, no-wrap
msgid "path"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:162
msgid "The pathname of the object."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-ls-tree.txt:164
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-ls-tree.txt:165
msgid "Part of the linkgit:git[1] suite"
msgstr ""
