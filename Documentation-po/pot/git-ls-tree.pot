#. type: Title =
#: ../Documentation/git-ls-tree.txt:2
#, no-wrap
msgid "git-ls-tree(1)"
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:7
msgid "git-ls-tree - List the contents of a tree object"
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:15
#, no-wrap
msgid ""
"'git ls-tree' [-d] [-r] [-t] [-l] [-z]\n"
"\t    [--name-only] [--name-status] [--object-only] [--full-name] "
"[--full-tree] [--abbrev[=<n>]] [--format=<format>]\n"
"\t    <tree-ish> [<path>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:20
msgid ""
"Lists the contents of a given tree object, like what \"/bin/ls -a\" does in "
"the current working directory.  Note that:"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:25
msgid ""
"the behaviour is slightly different from that of \"/bin/ls\" in that the "
"'<path>' denotes just a list of patterns to match, e.g. so specifying "
"directory name (without `-r`) will behave differently, and order of the "
"arguments does not matter."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:35
msgid ""
"the behaviour is similar to that of \"/bin/ls\" in that the '<path>' is "
"taken as relative to the current working directory.  E.g. when you are in a "
"directory 'sub' that has a directory 'dir', you can run 'git ls-tree -r HEAD "
"dir' to list the contents of the tree (that is `sub/dir` in `HEAD`).  You "
"don't want to give a tree that is not at the root level (e.g. `git ls-tree "
"-r HEAD:sub dir`) in this case, as that would result in asking for "
"`sub/sub/dir` in the `HEAD` commit.  However, the current working directory "
"can be ignored by passing --full-tree option."
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:37
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:38
#, no-wrap
msgid "<tree-ish>"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:40
msgid "Id of a tree-ish."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:41
#, no-wrap
msgid "-d"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:43
msgid "Show only the named tree entry itself, not its children."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:44
#, no-wrap
msgid "-r"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:46
msgid "Recurse into sub-trees."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:47
#, no-wrap
msgid "-t"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:50
msgid ""
"Show tree entries even when going to recurse them. Has no effect if `-r` was "
"not passed. `-d` implies `-t`."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:51
#, no-wrap
msgid "-l"
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:52
#, no-wrap
msgid "--long"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:54
msgid "Show object size of blob (file) entries."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:55
#, no-wrap
msgid "-z"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:58
msgid ""
"\\0 line termination on output and do not quote filenames.  See OUTPUT "
"FORMAT below for more information."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:59
#, no-wrap
msgid "--name-only"
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:60
#, no-wrap
msgid "--name-status"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:63
msgid ""
"List only filenames (instead of the \"long\" output), one per line.  Cannot "
"be combined with `--object-only`."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:64
#, no-wrap
msgid "--object-only"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:71
msgid ""
"List only names of the objects, one per line. Cannot be combined with "
"`--name-only` or `--name-status`.  This is equivalent to specifying "
"`--format='%(objectname)'`, but for both this option and that exact format "
"the command takes a hand-optimized codepath instead of going through the "
"generic formatting mechanism."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:72
#, no-wrap
msgid "--abbrev[=<n>]"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:77
msgid ""
"Instead of showing the full 40-byte hexadecimal object lines, show the "
"shortest prefix that is at least '<n>' hexdigits long that uniquely refers "
"the object.  Non default number of digits can be specified with "
"--abbrev=<n>."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:78
#, no-wrap
msgid "--full-name"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:81
msgid ""
"Instead of showing the path names relative to the current working directory, "
"show the full path names."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:82
#, no-wrap
msgid "--full-tree"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:85
msgid ""
"Do not limit the listing to the current working directory.  Implies "
"--full-name."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:86
#, no-wrap
msgid "--format=<format>"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:95
msgid ""
"A string that interpolates `%(fieldname)` from the result being shown. It "
"also interpolates `%%` to `%`, and `%xNN` where `NN` are hex digits "
"interpolates to character with hex code `NN`; for example `%x00` "
"interpolates to `\\0` (NUL), `%x09` to `\\t` (TAB) and `%x0a` to `\\n` "
"(LF).  When specified, `--format` cannot be combined with other "
"format-altering options, including `--long`, `--name-only` and "
"`--object-only`."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:96
#, no-wrap
msgid "[<path>...]"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:100
msgid ""
"When paths are given, show them (note that this isn't really raw pathnames, "
"but rather a list of patterns to match).  Otherwise implicitly uses the root "
"level of the tree as the sole path argument."
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:103
#, no-wrap
msgid "Output Format"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:108
msgid ""
"The output format of `ls-tree` is determined by either the `--format` "
"option, or other format-altering options such as `--name-only` etc.  (see "
"`--format` above)."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:112
msgid ""
"The use of certain `--format` directives is equivalent to using those "
"options, but invoking the full formatting machinery can be slower than using "
"an appropriate formatting option."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:116
msgid ""
"In cases where the `--format` would exactly map to an existing option "
"`ls-tree` will use the appropriate faster path. Thus the default format is "
"equivalent to:"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:118
#, no-wrap
msgid "\t%(objectmode) %(objecttype) %(objectname)%x09%(path)\n"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:121
msgid ""
"This output format is compatible with what `--index-info --stdin` of 'git "
"update-index' expects."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:123
msgid "When the `-l` option is used, format changes to"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:125
#, no-wrap
msgid ""
"\t%(objectmode) %(objecttype) %(objectname) "
"%(objectsize:padded)%x09%(path)\n"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:129
msgid ""
"Object size identified by <objectname> is given in bytes, and "
"right-justified with minimum width of 7 characters.  Object size is given "
"only for blobs (file) entries; for other entries `-` character is used in "
"place of size."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:134
msgid ""
"Without the `-z` option, pathnames with \"unusual\" characters are quoted as "
"explained for the configuration variable `core.quotePath` (see "
"linkgit:git-config[1]).  Using `-z` the filename is output verbatim and the "
"line is terminated by a NUL byte."
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:136
msgid "Customized format:"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:141
msgid ""
"It is possible to print in a custom format by using the `--format` option, "
"which is able to interpolate different fields using a `%(fieldname)` "
"notation.  For example, if you only care about the \"objectname\" and "
"\"path\" fields, you can execute with a specific \"--format\" like"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:143
#, no-wrap
msgid "\tgit ls-tree --format='%(objectname) %(path)' <tree-ish>\n"
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:145
#, no-wrap
msgid "FIELD NAMES"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:150
msgid ""
"Various values from structured fields can be used to interpolate into the "
"resulting output. For each outputting line, the following names can be used:"
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:151
#, no-wrap
msgid "objectmode"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:153
msgid "The mode of the object."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:153
#, no-wrap
msgid "objecttype"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:155
msgid "The type of the object (`commit`, `blob` or `tree`)."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:155
#, no-wrap
msgid "objectname"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:157
msgid "The name of the object."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:157
#, no-wrap
msgid "objectsize[:padded]"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:160
msgid ""
"The size of a `blob` object (\"-\" if it's a `commit` or `tree`).  It also "
"supports a padded format of size with \"%(objectsize:padded)\"."
msgstr ""

#. type: Labeled list
#: ../Documentation/git-ls-tree.txt:160
#, no-wrap
msgid "path"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:162
msgid "The pathname of the object."
msgstr ""

#. type: Title -
#: ../Documentation/git-ls-tree.txt:164
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation/git-ls-tree.txt:165
msgid "Part of the linkgit:git[1] suite"
msgstr ""
