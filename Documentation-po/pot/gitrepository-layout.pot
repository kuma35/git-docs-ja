#: ../Documentation-sedout/gitrepository-layout.txt:310
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/gitrepository-layout.txt:311
msgid "Part of the linkgit:git[1] suite"
msgstr ""
