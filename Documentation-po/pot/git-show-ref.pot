#. type: Title =
#: ../Documentation-sedout/git-show-ref.txt:2
#, no-wrap
msgid "git-show-ref(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:7
msgid "git-show-ref - List references in a local repository"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:19
#, no-wrap
msgid ""
"'git show-ref' [--head] [-d | --dereference]\n"
"\t     [-s | --hash[=<n>]] [--abbrev[=<n>]] [--branches] [--tags]\n"
"\t     [--] [<pattern>...]\n"
"'git show-ref' --verify [-q | --quiet] [-d | --dereference]\n"
"\t     [-s | --hash[=<n>]] [--abbrev[=<n>]]\n"
"\t     [--] [<ref>...]\n"
"'git show-ref' --exclude-existing[=<pattern>]\n"
"'git show-ref' --exists <ref>\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:21
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:27
msgid ""
"Displays references available in a local repository along with the "
"associated commit IDs. Results can be filtered using a pattern and tags can "
"be dereferenced into object IDs. Additionally, it can be used to test "
"whether a particular ref exists."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:29
msgid "By default, shows the tags, heads, and remote refs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:33
msgid ""
"The `--exclude-existing` form is a filter that does the inverse. It reads "
"refs from stdin, one ref per line, and shows those that don't exist in the "
"local repository."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:37
msgid ""
"The `--exists` form can be used to check for the existence of a single "
"references. This form does not verify whether the reference resolves to an "
"actual object."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:40
msgid ""
"Use of this utility is encouraged in favor of directly accessing files under "
"the `.git` directory."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:42
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:44
#, no-wrap
msgid "`--head`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:47
msgid "Show the HEAD reference, even if it would normally be filtered out."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:48
#, no-wrap
msgid "`--branches`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:49
#, no-wrap
msgid "`--tags`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:56
msgid ""
"Limit to local branches and local tags, respectively.  These options are not "
"mutually exclusive; when given both, references stored in \"refs/heads\" and "
"\"refs/tags\" are displayed.  Note that `--heads` is a deprecated synonym "
"for `--branches` and may be removed in the future."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:57
#, no-wrap
msgid "`-d`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:58
#, no-wrap
msgid "`--dereference`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:62
msgid ""
"Dereference tags into object IDs as well. They will be shown with `^{}` "
"appended."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:63
#, no-wrap
msgid "`-s`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:64
#, no-wrap
msgid "`--hash[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:68
msgid ""
"Only show the OID, not the reference name. When combined with "
"`--dereference`, the dereferenced tag will still be shown after the OID."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:69
#, no-wrap
msgid "`--verify`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:74
msgid ""
"Enable stricter reference checking by requiring an exact ref path.  Aside "
"from returning an error code of 1, it will also print an error message if "
"`--quiet` was not specified."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:75
#, no-wrap
msgid "`--exists`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:80
msgid ""
"Check whether the given reference exists. Returns an exit code of 0 if it "
"does, 2 if it is missing, and 1 in case looking up the reference failed with "
"an error other than the reference being missing."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:81
#, no-wrap
msgid "`--abbrev[=<n>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:85
msgid ""
"Abbreviate the object name.  When using `--hash`, you do not have to say "
"`--hash --abbrev`; `--hash=n` would do."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:86
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:87
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:91
msgid ""
"Do not print any results to stdout. Can be used with `--verify` to silently "
"check if a reference exists."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:92
#, no-wrap
msgid "`--exclude-existing[=<pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:97
msgid ""
"Make `git show-ref` act as a filter that reads refs from stdin of the form "
"`^(?:<anything>\\s)?<refname>(?:\\^{})?$` and performs the following actions "
"on each:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:98
msgid "strip `^{}` at the end of line if any;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:99
msgid "ignore if pattern is provided and does not head-match refname;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:100
msgid "warn if refname is not a well-formed refname and skip;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:101
msgid "ignore if refname is a ref that exists in the local repository;"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:102
msgid "otherwise output the line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-show-ref.txt:104
#, no-wrap
msgid "<pattern>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:111
msgid ""
"Show references matching one or more patterns. Patterns are matched from the "
"end of the full name, and only complete parts are matched, e.g.  'master' "
"matches 'refs/heads/master', 'refs/remotes/origin/master', "
"'refs/tags/jedi/master' but not 'refs/heads/mymaster' or "
"'refs/remotes/master/jedi'."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:113
#, no-wrap
msgid "OUTPUT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:116
msgid "The output is in the format:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:119
#, no-wrap
msgid "<oid> SP <ref> LF\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:122
#: ../Documentation-sedout/git-show-ref.txt:142
msgid "For example,"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:133
#, no-wrap
msgid ""
"$ git show-ref --head --dereference\n"
"832e76a9899f560a90ffd62ae2ce83bbeff58f54 HEAD\n"
"832e76a9899f560a90ffd62ae2ce83bbeff58f54 refs/heads/master\n"
"832e76a9899f560a90ffd62ae2ce83bbeff58f54 refs/heads/origin\n"
"3521017556c5de4159da4615a39fa4d5d2c279b5 refs/tags/v0.99.9c\n"
"6ddc0964034342519a87fe013781abf31c6db6ad refs/tags/v0.99.9c^{}\n"
"055e4ae3ae6eb344cbabf2a5256a49ea66040131 refs/tags/v1.0rc4\n"
"423325a2d24638ddcc82ce47be5e40be550f4507 refs/tags/v1.0rc4^{}\n"
"...\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:136
msgid "When using `--hash` (and not `--dereference`), the output is in the format:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:139
#, no-wrap
msgid "<oid> LF\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:149
#, no-wrap
msgid ""
"$ git show-ref --branches --hash\n"
"2e3ba0114a1f52b47df29743d6915d056be13278\n"
"185008ae97960c8d551adcd9e23565194651b5d1\n"
"03adf42c988195b50e1a1935ba5fcbc39b2b029b\n"
"...\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:152
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:157
msgid ""
"To show all references called \"master\", whether tags or heads or anything "
"else, and regardless of how deep in the reference naming hierarchy they are, "
"use:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:160
#, no-wrap
msgid "\tgit show-ref master\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:164
msgid ""
"This will show \"refs/heads/master\" but also "
"\"refs/remote/other-repo/master\", if such references exist."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:166
msgid "When using the `--verify` flag, the command requires an exact path:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:169
#, no-wrap
msgid "\tgit show-ref --verify refs/heads/master\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:172
msgid "will only match the exact branch called \"master\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:175
msgid ""
"If nothing matches, `git show-ref` will return an error code of 1, and in "
"the case of verification, it will show an error message."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:178
msgid ""
"For scripting, you can ask it to be quiet with the `--quiet` flag, which "
"allows you to do things like"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:182
#, no-wrap
msgid ""
"\tgit show-ref --quiet --verify -- \"refs/heads/$headname\" ||\n"
"\t\techo \"$headname is not a valid branch\"\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:187
msgid ""
"to check whether a particular branch exists or not (notice how we don't "
"actually want to show any results, and we want to use the full refname for "
"it in order to not trigger the problem with ambiguous partial matches)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:191
msgid ""
"To show only tags, or only proper branch heads, use `--tags` and/or "
"`--branches` respectively (using both means that it shows tags and branches, "
"but not other random references under the refs/ subdirectory)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:194
msgid ""
"To do automatic tag object dereferencing, use the `-d` or `--dereference` "
"flag, so you can do"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-show-ref.txt:197
#, no-wrap
msgid "\tgit show-ref --tags --dereference\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:200
msgid "to get a listing of all tags together with what they dereference."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-show-ref.txt:202
#, no-wrap
msgid "FILES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-show-ref.txt:204
msgid "`.git/refs/*`, `.git/packed-refs`"
msgstr ""

