#. type: Plain text
#: ../Documentation-sedout/git-verify-commit.adoc:7
msgid "git-verify-commit - Check the GPG signature of commits"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-commit.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-commit.adoc:12
msgid "git verify-commit [-v | --verbose] [--raw] <commit>..."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-commit.adoc:14
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-commit.adoc:17
msgid ""
"Validates the GPG signature created by `git commit -S` on the commit objects "
"given on the command line."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-commit.adoc:19
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-commit.adoc:20
#, no-wrap
msgid "`--raw`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-commit.adoc:23
msgid ""
"Print the raw gpg status output to standard error instead of the normal "
"human-readable output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-commit.adoc:24
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-commit.adoc:25
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-commit.adoc:27
msgid "Print the contents of the commit object before validating it."
msgstr ""

