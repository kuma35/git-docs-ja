#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:2
#, no-wrap
msgid "Commit Limiting"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:7
msgid ""
"Besides specifying a range of commits that should be listed using the "
"special notations explained in the description, additional commit limiting "
"may be applied."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:12
msgid ""
"Using more options generally further limits the output (e.g.  "
"`--since=<date1>` limits to commits newer than _<date1>_, and using it with "
"`--grep=<pattern>` further limits to commits whose log message has a line "
"that matches _<pattern>_), unless otherwise noted."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:15
msgid ""
"Note that these are applied before commit ordering and formatting options, "
"such as `--reverse`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:16
#, no-wrap
msgid "`-<number>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:17
#, no-wrap
msgid "`-n <number>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:18
#, no-wrap
msgid "`--max-count=<number>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:20
msgid "Limit the output to _<number>_ commits."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:21
#, no-wrap
msgid "`--skip=<number>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:23
msgid "Skip _<number>_ commits before starting to show the commit output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:24
#, no-wrap
msgid "`--since=<date>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:25
#, no-wrap
msgid "`--after=<date>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:27
msgid "Show commits more recent than _<date>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:28
#, no-wrap
msgid "`--since-as-filter=<date>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:32
msgid ""
"Show all commits more recent than _<date>_. This visits all commits in the "
"range, rather than stopping at the first commit which is older than "
"_<date>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:33
#, no-wrap
msgid "`--until=<date>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:34
#, no-wrap
msgid "`--before=<date>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:36
msgid "Show commits older than _<date>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:38
#, no-wrap
msgid "`--max-age=<timestamp>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:39
#, no-wrap
msgid "`--min-age=<timestamp>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:41
msgid "Limit the commits output to specified time range."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:43
#, no-wrap
msgid "`--author=<pattern>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:44
#, no-wrap
msgid "`--committer=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:50
msgid ""
"Limit the commits output to ones with author/committer header lines that "
"match the _<pattern>_ regular expression.  With more than one "
"`--author=<pattern>`, commits whose author matches any of the _<pattern>_ "
"are chosen (similarly for multiple `--committer=<pattern>`)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:51
#, no-wrap
msgid "`--grep-reflog=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:57
msgid ""
"Limit the commits output to ones with reflog entries that match the "
"_<pattern>_ regular expression. With more than one `--grep-reflog`, commits "
"whose reflog message matches any of the given patterns are chosen.  It is an "
"error to use this option unless `--walk-reflogs` is in use."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:58
#, no-wrap
msgid "`--grep=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:64
msgid ""
"Limit the commits output to ones with a log message that matches the "
"_<pattern>_ regular expression.  With more than one `--grep=<pattern>`, "
"commits whose message matches any of the _<pattern>_ are chosen (but see "
"`--all-match`)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:68
msgid ""
"When `--notes` is in effect, the message from the notes is matched as if it "
"were part of the log message."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:70
#, no-wrap
msgid "`--all-match`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:73
msgid ""
"Limit the commits output to ones that match all given `--grep`, instead of "
"ones that match at least one."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:74
#, no-wrap
msgid "`--invert-grep`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:77
msgid ""
"Limit the commits output to ones with a log message that do not match the "
"_<pattern>_ specified with `--grep=<pattern>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:78
#, no-wrap
msgid "`-i`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:79
#, no-wrap
msgid "`--regexp-ignore-case`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:82
msgid ""
"Match the regular expression limiting patterns without regard to letter "
"case."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:83
#, no-wrap
msgid "`--basic-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:86
msgid ""
"Consider the limiting patterns to be basic regular expressions; this is the "
"default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:87
#, no-wrap
msgid "`-E`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:88
#, no-wrap
msgid "`--extended-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:91
msgid ""
"Consider the limiting patterns to be extended regular expressions instead of "
"the default basic regular expressions."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:92
#, no-wrap
msgid "`-F`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:93
#, no-wrap
msgid "`--fixed-strings`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:96
msgid ""
"Consider the limiting patterns to be fixed strings (don't interpret pattern "
"as a regular expression)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:97
#, no-wrap
msgid "`-P`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:98
#, no-wrap
msgid "`--perl-regexp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:101
msgid "Consider the limiting patterns to be Perl-compatible regular expressions."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:105
msgid ""
"Support for these types of regular expressions is an optional compile-time "
"dependency. If Git wasn't compiled with support for them providing this "
"option will cause it to die."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:106
#, no-wrap
msgid "`--remove-empty`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:108
msgid "Stop when a given path disappears from the tree."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:109
#, no-wrap
msgid "`--merges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:111
msgid "Print only merge commits. This is exactly the same as `--min-parents=2`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:112
#, no-wrap
msgid "`--no-merges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:115
msgid ""
"Do not print commits with more than one parent. This is exactly the same as "
"`--max-parents=1`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:116
#, no-wrap
msgid "`--min-parents=<number>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:117
#, no-wrap
msgid "`--max-parents=<number>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:118
#, no-wrap
msgid "`--no-min-parents`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:119
#, no-wrap
msgid "`--no-max-parents`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:124
msgid ""
"Show only commits which have at least (or at most) that many parent "
"commits. In particular, `--max-parents=1` is the same as `--no-merges`, "
"`--min-parents=2` is the same as `--merges`.  `--max-parents=0` gives all "
"root commits and `--min-parents=3` all octopus merges."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:128
msgid ""
"`--no-min-parents` and `--no-max-parents` reset these limits (to no limit)  "
"again.  Equivalent forms are `--min-parents=0` (any commit has 0 or more "
"parents) and `--max-parents=-1` (negative numbers denote no upper limit)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:129
#, no-wrap
msgid "`--first-parent`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:138
msgid ""
"When finding commits to include, follow only the first parent commit upon "
"seeing a merge commit.  This option can give a better overview when viewing "
"the evolution of a particular topic branch, because merges into a topic "
"branch tend to be only about adjusting to updated upstream from time to "
"time, and this option allows you to ignore the individual commits brought in "
"to your history by such a merge."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:142
msgid ""
"This option also changes default diff format for merge commits to "
"`first-parent`, see `--diff-merges=first-parent` for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:144
#, no-wrap
msgid "`--exclude-first-parent-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:150
msgid ""
"When finding commits to exclude (with a '{caret}'), follow only the first "
"parent commit upon seeing a merge commit.  This can be used to find the set "
"of changes in a topic branch from the point where it diverged from the "
"remote branch, given that arbitrary merges can be valid topic branch "
"changes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:151
#, no-wrap
msgid "`--not`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:158
msgid ""
"Reverses the meaning of the '{caret}' prefix (or lack thereof)  for all "
"following revision specifiers, up to the next `--not`.  When used on the "
"command line before --stdin, the revisions passed through stdin will not be "
"affected by it. Conversely, when passed via standard input, the revisions "
"passed on the command line will not be affected by it."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:159
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:162
msgid ""
"Pretend as if all the refs in `refs/`, along with `HEAD`, are listed on the "
"command line as _<commit>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:163
#, no-wrap
msgid "`--branches[=<pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:168
msgid ""
"Pretend as if all the refs in `refs/heads` are listed on the command line as "
"_<commit>_. If _<pattern>_ is given, limit branches to ones matching given "
"shell glob. If _<pattern>_ lacks '?', '{asterisk}', or '[', '/{asterisk}' at "
"the end is implied."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:169
#, no-wrap
msgid "`--tags[=<pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:174
msgid ""
"Pretend as if all the refs in `refs/tags` are listed on the command line as "
"_<commit>_. If _<pattern>_ is given, limit tags to ones matching given shell "
"glob. If pattern lacks '?', '{asterisk}', or '[', '/{asterisk}' at the end "
"is implied."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:175
#, no-wrap
msgid "`--remotes[=<pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:180
msgid ""
"Pretend as if all the refs in `refs/remotes` are listed on the command line "
"as _<commit>_. If _<pattern>_ is given, limit remote-tracking branches to "
"ones matching given shell glob.  If pattern lacks '?', '{asterisk}', or '[', "
"'/{asterisk}' at the end is implied."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:181
#, no-wrap
msgid "`--glob=<glob-pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:186
msgid ""
"Pretend as if all the refs matching shell glob _<glob-pattern>_ are listed "
"on the command line as _<commit>_. Leading 'refs/', is automatically "
"prepended if missing. If pattern lacks '?', '{asterisk}', or '[', "
"'/{asterisk}' at the end is implied."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:187
#, no-wrap
msgid "`--exclude=<glob-pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:195
msgid ""
"Do not include refs matching _<glob-pattern>_ that the next `--all`, "
"`--branches`, `--tags`, `--remotes`, or `--glob` would otherwise "
"consider. Repetitions of this option accumulate exclusion patterns up to the "
"next `--all`, `--branches`, `--tags`, `--remotes`, or `--glob` option (other "
"options or arguments do not clear accumulated patterns)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:201
msgid ""
"The patterns given should not begin with `refs/heads`, `refs/tags`, or "
"`refs/remotes` when applied to `--branches`, `--tags`, or `--remotes`, "
"respectively, and they must begin with `refs/` when applied to `--glob` or "
"`--all`. If a trailing '/{asterisk}' is intended, it must be given "
"explicitly."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:202
#, no-wrap
msgid "`--exclude-hidden=(fetch|receive|uploadpack)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:209
msgid ""
"Do not include refs that would be hidden by `git-fetch`, `git-receive-pack` "
"or `git-upload-pack` by consulting the appropriate `fetch.hideRefs`, "
"`receive.hideRefs` or `uploadpack.hideRefs` configuration along with "
"`transfer.hideRefs` (see linkgit:git-config[1]). This option affects the "
"next pseudo-ref option `--all` or `--glob` and is cleared after processing "
"them."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:210
#, no-wrap
msgid "`--reflog`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:213
msgid ""
"Pretend as if all objects mentioned by reflogs are listed on the command "
"line as _<commit>_."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:214
#, no-wrap
msgid "`--alternate-refs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:221
msgid ""
"Pretend as if all objects mentioned as ref tips of alternate repositories "
"were listed on the command line. An alternate repository is any repository "
"whose object directory is specified in `objects/info/alternates`.  The set "
"of included objects may be modified by `core.alternateRefsCommand`, etc. See "
"linkgit:git-config[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:222
#, no-wrap
msgid "`--single-worktree`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:229
msgid ""
"By default, all working trees will be examined by the following options when "
"there are more than one (see linkgit:git-worktree[1]): `--all`, `--reflog` "
"and `--indexed-objects`.  This option forces them to examine the current "
"working tree only."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:230
#, no-wrap
msgid "`--ignore-missing`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:233
msgid ""
"Upon seeing an invalid object name in the input, pretend as if the bad input "
"was not given."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:235
#: ../Documentation-sedout/rev-list-options.adoc:822
#, no-wrap
msgid "`--bisect`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:240
msgid ""
"Pretend as if the bad bisection ref `refs/bisect/bad` was listed and as if "
"it was followed by `--not` and the good bisection refs `refs/bisect/good-*` "
"on the command line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:242
#, no-wrap
msgid "`--stdin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:250
msgid ""
"In addition to getting arguments from the command line, read them from "
"standard input as well. This accepts commits and pseudo-options like `--all` "
"and `--glob=`. When a `--` separator is seen, the following input is treated "
"as paths and used to limit the result. Flags like `--not` which are read via "
"standard input are only respected for arguments passed in the same way and "
"will not influence any subsequent command line arguments."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:252
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:258
msgid ""
"Don't print anything to standard output.  This form is primarily meant to "
"allow the caller to test the exit status to see if a range of objects is "
"fully connected (or not).  It is faster than redirecting stdout to "
"`/dev/null` as the output does not have to be formatted."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:259
#, no-wrap
msgid "`--disk-usage`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:260
#, no-wrap
msgid "`--disk-usage=human`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:270
msgid ""
"Suppress normal output; instead, print the sum of the bytes used for on-disk "
"storage by the selected commits or objects. This is equivalent to piping the "
"output into `git cat-file --batch-check='%(objectsize:disk)'`, except that "
"it runs much faster (especially with `--use-bitmap-index`). See the "
"`CAVEATS` section in linkgit:git-cat-file[1] for the limitations of what "
"\"on-disk storage\" means.  With the optional value `human`, on-disk storage "
"size is shown in human-readable string(e.g. 12.24 Kib, 3.50 Mib)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:272
#, no-wrap
msgid "`--cherry-mark`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:275
msgid ""
"Like `--cherry-pick` (see below) but mark equivalent commits with `=` rather "
"than omitting them, and inequivalent ones with `+`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:276
#, no-wrap
msgid "`--cherry-pick`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:280
msgid ""
"Omit any commit that introduces the same change as another commit on the "
"``other side'' when the set of commits are limited with symmetric "
"difference."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:288
msgid ""
"For example, if you have two branches, `A` and `B`, a usual way to list all "
"commits on only one side of them is with `--left-right` (see the example "
"below in the description of the `--left-right` option). However, it shows "
"the commits that were cherry-picked from the other branch (for example, "
"``3rd on b'' may be cherry-picked from branch A). With this option, such "
"pairs of commits are excluded from the output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:289
#, no-wrap
msgid "`--left-only`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:290
#, no-wrap
msgid "`--right-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:294
msgid ""
"List only commits on the respective side of a symmetric difference, "
"i.e. only those which would be marked `<` resp. `>` by `--left-right`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:300
msgid ""
"For example, `--cherry-pick --right-only A...B` omits those commits from `B` "
"which are in `A` or are patch-equivalent to a commit in `A`. In other words, "
"this lists the `+` commits from `git cherry A B`.  More precisely, "
"`--cherry-pick --right-only --no-merges` gives the exact list."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:301
#, no-wrap
msgid "`--cherry`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:307
msgid ""
"A synonym for `--right-only --cherry-mark --no-merges`; useful to limit the "
"output to the commits on our side and mark those that have been applied to "
"the other side of a forked history with `git log --cherry "
"upstream...mybranch`, similar to `git cherry upstream mybranch`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:308
#, no-wrap
msgid "`-g`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:309
#, no-wrap
msgid "`--walk-reflogs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:315
msgid ""
"Instead of walking the commit ancestry chain, walk reflog entries from the "
"most recent one to older ones.  When this option is used you cannot specify "
"commits to exclude (that is, `^<commit>`, `<commit1>..<commit2>`, and "
"`<commit1>...<commit2>` notations cannot be used)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:322
msgid ""
"With `--pretty` format other than `oneline` and `reference` (for obvious "
"reasons), this causes the output to have two extra lines of information "
"taken from the reflog.  The reflog designator in the output may be shown as "
"`ref@{<Nth>}` (where _<Nth>_ is the reverse-chronological index in the "
"reflog) or as `ref@{<timestamp>}` (with the _<timestamp>_ for that entry), "
"depending on a few rules:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:326
msgid "If the starting point is specified as `ref@{<Nth>}`, show the index format."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:329
msgid ""
"If the starting point was specified as `ref@{now}`, show the timestamp "
"format."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:332
msgid ""
"If neither was used, but `--date` was given on the command line, show the "
"timestamp in the format requested by `--date`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:334
msgid "Otherwise, show the index format."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:340
msgid ""
"Under `--pretty=oneline`, the commit message is prefixed with this "
"information on the same line.  This option cannot be combined with "
"`--reverse`.  See also linkgit:git-reflog[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:342
msgid "Under `--pretty=reference`, this information will not be shown at all."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:343
#, no-wrap
msgid "`--merge`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:349
msgid ""
"Show commits touching conflicted paths in the range `HEAD...<other>`, where "
"`<other>` is the first existing pseudoref in `MERGE_HEAD`, "
"`CHERRY_PICK_HEAD`, `REVERT_HEAD` or `REBASE_HEAD`. Only works when the "
"index has unmerged entries. This option can be used to show relevant commits "
"when resolving conflicts from a 3-way merge."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:350
#, no-wrap
msgid "`--boundary`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:353
msgid "Output excluded boundary commits. Boundary commits are prefixed with `-`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:355
#, no-wrap
msgid "`--use-bitmap-index`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:360
msgid ""
"Try to speed up the traversal using the pack bitmap index (if one is "
"available). Note that when traversing with `--objects`, trees and blobs will "
"not have their associated path printed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:361
#, no-wrap
msgid "`--progress=<header>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:364
msgid ""
"Show progress reports on stderr as objects are considered. The `<header>` "
"text will be printed with each progress update."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:365
#, no-wrap
msgid "`-z`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:369
msgid ""
"Instead of being newline-delimited, each outputted object and its "
"accompanying metadata is delimited using NUL bytes. Output is printed in the "
"following form:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:372
#, no-wrap
msgid "<OID> NUL [<token>=<value> NUL]...\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:378
msgid ""
"Additional object metadata, such as object paths or boundary objects, is "
"printed using the `<token>=<value>` form. Token values are printed as-is "
"without any encoding/truncation. An OID entry never contains a '=' character "
"and thus is used to signal the start of a new object record. Examples:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:384
#, no-wrap
msgid ""
"<OID> NUL\n"
"<OID> NUL path=<path> NUL\n"
"<OID> NUL boundary=yes NUL\n"
"<OID> NUL missing=yes NUL [<token>=<value> NUL]...\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:388
msgid ""
"This mode is only compatible with the `--objects`, `--boundary`, and "
"`--missing` output options."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:391
#, no-wrap
msgid "History Simplification"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:397
msgid ""
"Sometimes you are only interested in parts of the history, for example the "
"commits modifying a particular <path>. But there are two parts of 'History "
"Simplification', one part is selecting the commits and the other is how to "
"do it, as there are various strategies to simplify the history."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:399
msgid "The following options select the commits to be shown:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:400
#, no-wrap
msgid "`<paths>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:402
msgid "Commits modifying the given <paths> are selected."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:403
#, no-wrap
msgid "`--simplify-by-decoration`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:405
msgid "Commits that are referred by some branch or tag are selected."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:407
msgid "Note that extra commits can be shown to give a meaningful history."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:409
msgid "The following options affect the way the simplification is performed:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:410
#, no-wrap
msgid "`Default mode`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:415
msgid ""
"Simplifies the history to the simplest history explaining the final state of "
"the tree. Simplest because it prunes some side branches if the end result is "
"the same (i.e. merging branches with the same content)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:416
#: ../Documentation-sedout/rev-list-options.adoc:773
#, no-wrap
msgid "`--show-pulls`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:421
msgid ""
"Include all commits from the default mode, but also any merge commits that "
"are not TREESAME to the first parent but are TREESAME to a later "
"parent. This mode is helpful for showing the merge commits that \"first "
"introduced\" a change to a branch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:422
#, no-wrap
msgid "`--full-history`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:424
msgid "Same as the default mode, but does not prune some history."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:425
#: ../Documentation-sedout/rev-list-options.adoc:563
#, no-wrap
msgid "`--dense`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:428
msgid "Only the selected commits are shown, plus some to have a meaningful history."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:429
#: ../Documentation-sedout/rev-list-options.adoc:567
#, no-wrap
msgid "`--sparse`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:431
msgid "All commits in the simplified history are shown."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:432
#: ../Documentation-sedout/rev-list-options.adoc:574
#, no-wrap
msgid "`--simplify-merges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:436
msgid ""
"Additional option to `--full-history` to remove some needless merges from "
"the resulting history, as there are no selected commits contributing to this "
"merge."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:437
#: ../Documentation-sedout/rev-list-options.adoc:621
#, no-wrap
msgid "`--ancestry-path[=<commit>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:446
msgid ""
"When given a range of commits to display (e.g. `<commit1>..<commit2>` or "
"`<commit2> ^<commit1>`), and a commit _<commit>_ in that range, only display "
"commits in that range that are ancestors of _<commit>_, descendants of "
"_<commit>_, or _<commit>_ itself.  If no commit is specified, use "
"_<commit1>_ (the excluded part of the range) as _<commit>_.  Can be passed "
"multiple times; if so, a commit is included if it is any of the commits "
"given or if it is an ancestor or descendant of one of them."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:448
msgid "A more detailed explanation follows."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:452
msgid ""
"Suppose you specified `foo` as the _<paths>_.  We shall call commits that "
"modify `foo` !TREESAME, and the rest TREESAME.  (In a diff filtered for "
"`foo`, they look different and equal, respectively.)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:456
msgid ""
"In the following, we will always refer to the same example history to "
"illustrate the differences between simplification settings.  We assume that "
"you are filtering for a file `foo` in this commit graph:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:463
#, no-wrap
msgid ""
"\t  .-A---M---N---O---P---Q\n"
"\t /     /   /   /   /   /\n"
"\tI     B   C   D   E   Y\n"
"\t \\   /   /   /   /   /\n"
"\t  `-------------'   X\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:467
msgid ""
"The horizontal line of history A---Q is taken to be the first parent of each "
"merge.  The commits are:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:471
msgid ""
"`I` is the initial commit, in which `foo` exists with contents `asdf`, and a "
"file `quux` exists with contents `quux`. Initial commits are compared to an "
"empty tree, so `I` is !TREESAME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:473
msgid "In `A`, `foo` contains just `foo`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:476
msgid ""
"`B` contains the same change as `A`.  Its merge `M` is trivial and hence "
"TREESAME to all parents."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:479
msgid ""
"`C` does not change `foo`, but its merge `N` changes it to `foobar`, so it "
"is not TREESAME to any parent."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:482
msgid ""
"`D` sets `foo` to `baz`. Its merge `O` combines the strings from `N` and `D` "
"to `foobarbaz`; i.e., it is not TREESAME to any parent."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:485
msgid ""
"`E` changes `quux` to `xyzzy`, and its merge `P` combines the strings to "
"`quux xyzzy`. `P` is TREESAME to `O`, but not to `E`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:489
msgid ""
"`X` is an independent root commit that added a new file `side`, and `Y` "
"modified it. `Y` is TREESAME to `X`. Its merge `Q` added `side` to `P`, and "
"`Q` is TREESAME to `P`, but not to `Y`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:494
msgid ""
"`rev-list` walks backwards through history, including or excluding commits "
"based on whether `--full-history` and/or parent rewriting (via `--parents` "
"or `--children`) are used. The following settings are available."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:495
#, no-wrap
msgid "Default mode"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:502
msgid ""
"Commits are included if they are not TREESAME to any parent (though this can "
"be changed, see `--sparse` below).  If the commit was a merge, and it was "
"TREESAME to one parent, follow only that parent.  (Even if there are several "
"TREESAME parents, follow only one of them.)  Otherwise, follow all parents."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:504
msgid "This results in:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:509
#, no-wrap
msgid ""
"\t  .-A---N---O\n"
"\t /     /   /\n"
"\tI---------D\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:515
msgid ""
"Note how the rule to only follow the TREESAME parent, if one is available, "
"removed `B` from consideration entirely.  `C` was considered via `N`, but is "
"TREESAME.  Root commits are compared to an empty tree, so `I` is !TREESAME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:519
msgid ""
"Parent/child relations are only visible with `--parents`, but that does not "
"affect the commits selected in default mode, so we have shown the parent "
"lines."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:520
#, no-wrap
msgid "`--full-history` without parent rewriting"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:526
msgid ""
"This mode differs from the default in one point: always follow all parents "
"of a merge, even if it is TREESAME to one of them.  Even if more than one "
"side of the merge has commits that are included, this does not imply that "
"the merge itself is! In the example, we get"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:529
#, no-wrap
msgid "\tI  A  B  N  D  O  P  Q\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:534
msgid ""
"`M` was excluded because it is TREESAME to both parents.  `E`, `C` and `B` "
"were all walked, but only `B` was !TREESAME, so the others do not appear."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:538
msgid ""
"Note that without parent rewriting, it is not really possible to talk about "
"the parent/child relationships between the commits, so we show them "
"disconnected."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:539
#, no-wrap
msgid "`--full-history` with parent rewriting"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:542
msgid ""
"Ordinary commits are only included if they are !TREESAME (though this can be "
"changed, see `--sparse` below)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:546
msgid ""
"Merges are always included.  However, their parent list is rewritten: Along "
"each parent, prune away commits that are not included themselves.  This "
"results in"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:553
#, no-wrap
msgid ""
"\t  .-A---M---N---O---P---Q\n"
"\t /     /   /   /   /\n"
"\tI     B   /   D   /\n"
"\t \\   /   /   /   /\n"
"\t  `-------------'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:559
msgid ""
"Compare to `--full-history` without rewriting above.  Note that `E` was "
"pruned away because it is TREESAME, but the parent list of P was rewritten "
"to contain `E`'s parent `I`.  The same happened for `C` and `N`, and `X`, "
"`Y` and `Q`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:562
msgid ""
"In addition to the above settings, you can change whether TREESAME affects "
"inclusion:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:566
msgid "Commits that are walked are included if they are not TREESAME to any parent."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:569
msgid "All commits that are walked are included."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:573
msgid ""
"Note that without `--full-history`, this still simplifies merges: if one of "
"the parents is TREESAME, we follow only that one, so the other sides of the "
"merge are never walked."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:577
msgid ""
"First, build a history graph in the same way that `--full-history` with "
"parent rewriting does (see above)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:580
msgid ""
"Then simplify each commit `C` to its replacement `C'` in the final history "
"according to the following rules:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:583
msgid "Set `C'` to `C`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:588
msgid ""
"Replace each parent `P` of `C'` with its simplification `P'`.  In the "
"process, drop parents that are ancestors of other parents or that are root "
"commits TREESAME to an empty tree, and remove duplicates, but take care to "
"never drop all parents that we are TREESAME to."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:592
msgid ""
"If after this parent rewriting, `C'` is a root or merge commit (has zero or "
">1 parents), a boundary commit, or !TREESAME, it remains.  Otherwise, it is "
"replaced with its only parent."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:596
msgid ""
"The effect of this is best shown by way of comparing to `--full-history` "
"with parent rewriting.  The example turns into:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:603
#, no-wrap
msgid ""
"\t  .-A---M---N---O\n"
"\t /     /       /\n"
"\tI     B       D\n"
"\t \\   /       /\n"
"\t  `---------'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:606
msgid "Note the major differences in `N`, `P`, and `Q` over `--full-history`:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:610
msgid ""
"`N`'s parent list had `I` removed, because it is an ancestor of the other "
"parent `M`.  Still, `N` remained because it is !TREESAME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:613
msgid ""
"`P`'s parent list similarly had `I` removed.  `P` was then removed "
"completely, because it had one parent and is TREESAME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:617
msgid ""
"`Q`'s parent list had `Y` simplified to `X`. `X` was then removed, because "
"it was a TREESAME root. `Q` was then removed completely, because it had one "
"parent and is TREESAME."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:620
msgid "There is another simplification mode available:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:625
msgid ""
"Limit the displayed commits to those which are an ancestor of _<commit>_, or "
"which are a descendant of _<commit>_, or are _<commit>_ itself."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:627
msgid "As an example use case, consider the following commit history:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:634
#, no-wrap
msgid ""
"\t    D---E-------F\n"
"\t   /     \\       \\\n"
"\t  B---C---G---H---I---J\n"
"\t /                     \\\n"
"\tA-------K---------------L--M\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:642
msgid ""
"A regular 'D..M' computes the set of commits that are ancestors of `M`, but "
"excludes the ones that are ancestors of `D`. This is useful to see what "
"happened to the history leading to `M` since `D`, in the sense that \"what "
"does `M` have that did not exist in `D`\". The result in this example would "
"be all the commits, except `A` and `B` (and `D` itself, of course)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:648
msgid ""
"When we want to find out what commits in `M` are contaminated with the bug "
"introduced by `D` and need fixing, however, we might want to view only the "
"subset of `D..M` that are actually descendants of `D`, i.e.  excluding `C` "
"and `K`. This is exactly what the `--ancestry-path` option does. Applied to "
"the `D..M` range, it results in:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:655
#, no-wrap
msgid ""
"\t\tE-------F\n"
"\t\t \\       \\\n"
"\t\t  G---H---I---J\n"
"\t\t\t       \\\n"
"\t\t\t\tL--M\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:660
msgid ""
"We can also use `--ancestry-path=D` instead of `--ancestry-path` which means "
"the same thing when applied to the `D..M` range but is just more explicit."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:665
msgid ""
"If we instead are interested in a given topic within this range, and all "
"commits affected by that topic, we may only want to view the subset of "
"`D..M` which contain that topic in their ancestry path.  So, using "
"`--ancestry-path=H D..M` for example would result in:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:672
#, no-wrap
msgid ""
"\t\tE\n"
"\t\t \\\n"
"\t      C---G---H---I---J\n"
"\t\t\t       \\\n"
"\t\t\t\tL--M\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:675
msgid "Whereas `--ancestry-path=K D..M` would result in"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:678
#, no-wrap
msgid "\t\tK---------------L--M\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:682
msgid ""
"Before discussing another option, `--show-pulls`, we need to create a new "
"example history."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:687
msgid ""
"A common problem users face when looking at simplified history is that a "
"commit they know changed a file somehow does not appear in the file's "
"simplified history. Let's demonstrate a new example and show how options "
"such as `--full-history` and `--simplify-merges` works in that case:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:695
#, no-wrap
msgid ""
"\t  .-A---M-----C--N---O---P\n"
"\t /     / \\  \\  \\/   /   /\n"
"\tI     B   \\  R-'`-Z'   /\n"
"\t \\   /     \\/         /\n"
"\t  \\ /      /\\        /\n"
"\t   `---X--'  `---Y--'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:708
msgid ""
"For this example, suppose `I` created `file.txt` which was modified by `A`, "
"`B`, and `X` in different ways. The single-parent commits `C`, `Z`, and `Y` "
"do not change `file.txt`. The merge commit `M` was created by resolving the "
"merge conflict to include both changes from `A` and `B` and hence is not "
"TREESAME to either. The merge commit `R`, however, was created by ignoring "
"the contents of `file.txt` at `M` and taking only the contents of `file.txt` "
"at `X`. Hence, `R` is TREESAME to `X` but not `M`. Finally, the natural "
"merge resolution to create `N` is to take the contents of `file.txt` at `R`, "
"so `N` is TREESAME to `R` but not `C`.  The merge commits `O` and `P` are "
"TREESAME to their first parents, but not to their second parents, `Z` and "
"`Y` respectively."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:712
msgid ""
"When using the default mode, `N` and `R` both have a TREESAME parent, so "
"those edges are walked and the others are ignored. The resulting history "
"graph is:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:715
#, no-wrap
msgid "\tI---X\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:720
msgid ""
"When using `--full-history`, Git walks every edge. This will discover the "
"commits `A` and `B` and the merge `M`, but also will reveal the merge "
"commits `O` and `P`. With parent rewriting, the resulting graph is:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:728
#, no-wrap
msgid ""
"\t  .-A---M--------N---O---P\n"
"\t /     / \\  \\  \\/   /   /\n"
"\tI     B   \\  R-'`--'   /\n"
"\t \\   /     \\/         /\n"
"\t  \\ /      /\\        /\n"
"\t   `---X--'  `------'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:736
msgid ""
"Here, the merge commits `O` and `P` contribute extra noise, as they did not "
"actually contribute a change to `file.txt`. They only merged a topic that "
"was based on an older version of `file.txt`. This is a common issue in "
"repositories using a workflow where many contributors work in parallel and "
"merge their topic branches along a single trunk: many unrelated merges "
"appear in the `--full-history` results."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:743
msgid ""
"When using the `--simplify-merges` option, the commits `O` and `P` disappear "
"from the results. This is because the rewritten second parents of `O` and "
"`P` are reachable from their first parents. Those edges are removed and then "
"the commits look like single-parent commits that are TREESAME to their "
"parent. This also happens to the commit `N`, resulting in a history view as "
"follows:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:751
#, no-wrap
msgid ""
"\t  .-A---M--.\n"
"\t /     /    \\\n"
"\tI     B      R\n"
"\t \\   /      /\n"
"\t  \\ /      /\n"
"\t   `---X--'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:758
msgid ""
"In this view, we see all of the important single-parent changes from `A`, "
"`B`, and `X`. We also see the carefully-resolved merge `M` and the "
"not-so-carefully-resolved merge `R`. This is usually enough information to "
"determine why the commits `A` and `B` \"disappeared\" from history in the "
"default view. However, there are a few issues with this approach."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:763
msgid ""
"The first issue is performance. Unlike any previous option, the "
"`--simplify-merges` option requires walking the entire commit history before "
"returning a single result. This can make the option difficult to use for "
"very large repositories."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:772
msgid ""
"The second issue is one of auditing. When many contributors are working on "
"the same repository, it is important which merge commits introduced a change "
"into an important branch. The problematic merge `R` above is not likely to "
"be the merge commit that was used to merge into an important "
"branch. Instead, the merge `N` was used to merge `R` and `X` into the "
"important branch. This commit may have information about why the change `X` "
"came to override the changes from `A` and `B` in its commit message."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:777
msgid ""
"In addition to the commits shown in the default history, show each merge "
"commit that is not TREESAME to its first parent but is TREESAME to a later "
"parent."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:782
msgid ""
"When a merge commit is included by `--show-pulls`, the merge is treated as "
"if it \"pulled\" the change from another branch. When using `--show-pulls` "
"on this example (and no other options) the resulting graph is:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:785
#, no-wrap
msgid "\tI---X---R---N\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:791
msgid ""
"Here, the merge commits `R` and `N` are included because they pulled the "
"commits `X` and `R` into the base branch, respectively. These merges are the "
"reason the commits `A` and `B` do not appear in the default history."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:794
msgid ""
"When `--show-pulls` is paired with `--simplify-merges`, the graph includes "
"all of the necessary information:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:802
#, no-wrap
msgid ""
"\t  .-A---M--.   N\n"
"\t /     /    \\ /\n"
"\tI     B      R\n"
"\t \\   /      /\n"
"\t  \\ /      /\n"
"\t   `---X--'\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:808
msgid ""
"Notice that since `M` is reachable from `R`, the edge from `N` to `M` was "
"simplified away. However, `N` still appears in the history as an important "
"commit because it \"pulled\" the change `R` into the main branch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:816
msgid ""
"The `--simplify-by-decoration` option allows you to view only the big "
"picture of the topology of the history, by omitting commits that are not "
"referenced by tags.  Commits are marked as !TREESAME (in other words, kept "
"after history simplification rules described above) if (1) they are "
"referenced by tags, or (2) they change the contents of the paths given on "
"the command line.  All other commits are marked as TREESAME (subject to be "
"simplified away)."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:820
#, no-wrap
msgid "Bisection Helpers"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:829
msgid ""
"Limit output to the one commit object which is roughly halfway between "
"included and excluded commits. Note that the bad bisection ref "
"`refs/bisect/bad` is added to the included commits (if it exists) and the "
"good bisection refs `refs/bisect/good-*` are added to the excluded commits "
"(if they exist). Thus, supposing there are no refs in `refs/bisect/`, if"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:832
#, no-wrap
msgid "\t$ git rev-list --bisect foo ^bar ^baz\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:835
msgid "outputs 'midpoint', the output of the two commands"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:839
#, no-wrap
msgid ""
"\t$ git rev-list foo ^midpoint\n"
"\t$ git rev-list midpoint ^bar ^baz\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:845
msgid ""
"would be of roughly the same length.  Finding the change which introduces a "
"regression is thus reduced to a binary search: repeatedly generate and test "
"new 'midpoint's until the commit chain is of length one."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:846
#, no-wrap
msgid "`--bisect-vars`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:857
msgid ""
"This calculates the same as `--bisect`, except that refs in `refs/bisect/` "
"are not used, and except that this outputs text ready to be eval'ed by the "
"shell. These lines will assign the name of the midpoint revision to the "
"variable `bisect_rev`, and the expected number of commits to be tested after "
"`bisect_rev` is tested to `bisect_nr`, the expected number of commits to be "
"tested if `bisect_rev` turns out to be good to `bisect_good`, the expected "
"number of commits to be tested if `bisect_rev` turns out to be bad to "
"`bisect_bad`, and the number of commits we are bisecting right now to "
"`bisect_all`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:858
#, no-wrap
msgid "`--bisect-all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:864
msgid ""
"This outputs all the commit objects between the included and excluded "
"commits, ordered by their distance to the included and excluded "
"commits. Refs in `refs/bisect/` are not used. The farthest from them is "
"displayed first. (This is the only one displayed by `--bisect`.)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:868
msgid ""
"This is useful because it makes it easy to choose a good commit to test when "
"you want to avoid to test some of them for some reason (they may not compile "
"for example)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:872
msgid ""
"This option can be used along with `--bisect-vars`, in this case, after all "
"the sorted commit objects, there will be the same text as if `--bisect-vars` "
"had been used alone."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:877
#, no-wrap
msgid "Commit Ordering"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:880
msgid "By default, the commits are shown in reverse chronological order."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:881
#, no-wrap
msgid "`--date-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:884
msgid ""
"Show no parents before all of its children are shown, but otherwise show "
"commits in the commit timestamp order."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:885
#, no-wrap
msgid "`--author-date-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:888
msgid ""
"Show no parents before all of its children are shown, but otherwise show "
"commits in the author timestamp order."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:889
#, no-wrap
msgid "`--topo-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:893
msgid ""
"Show no parents before all of its children are shown, and avoid showing "
"commits on multiple lines of history intermixed."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:895
msgid "For example, in a commit history like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:901
#, no-wrap
msgid ""
"    ---1----2----4----7\n"
"\t\\\t       \\\n"
"\t 3----5----6----8---\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:907
msgid ""
"where the numbers denote the order of commit timestamps, `git rev-list` and "
"friends with `--date-order` show the commits in the timestamp order: 8 7 6 5 "
"4 3 2 1."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:912
msgid ""
"With `--topo-order`, they would show 8 6 5 3 7 4 2 1 (or 8 7 4 2 6 5 3 1); "
"some older commits are shown before newer ones in order to avoid showing the "
"commits from two parallel development track mixed together."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:913
#, no-wrap
msgid "`--reverse`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:917
msgid ""
"Output the commits chosen to be shown (see 'Commit Limiting' section above) "
"in reverse order. Cannot be combined with `--walk-reflogs`."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:921
#, no-wrap
msgid "Object Traversal"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:924
msgid "These options are mostly targeted for packing of Git repositories."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:926
#, no-wrap
msgid "`--objects`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:931
msgid ""
"Print the object IDs of any object referenced by the listed commits.  "
"`--objects foo ^bar` thus means \"send me all object IDs which I need to "
"download if I have the commit object `bar` but not `foo`\". See also "
"`--object-names` below."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:932
#, no-wrap
msgid "`--in-commit-order`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:936
msgid ""
"Print tree and blob ids in order of the commits. The tree and blob ids are "
"printed after they are first referenced by a commit."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:937
#, no-wrap
msgid "`--objects-edge`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:943
msgid ""
"Similar to `--objects`, but also print the IDs of excluded commits prefixed "
"with a \"`-`\" character.  This is used by linkgit:git-pack-objects[1] to "
"build a ``thin'' pack, which records objects in deltified form based on "
"objects contained in these excluded commits to reduce network traffic."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:944
#, no-wrap
msgid "`--objects-edge-aggressive`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:948
msgid ""
"Similar to `--objects-edge`, but it tries harder to find excluded commits at "
"the cost of increased time.  This is used instead of `--objects-edge` to "
"build ``thin'' packs for shallow repositories."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:949
#, no-wrap
msgid "`--indexed-objects`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:953
msgid ""
"Pretend as if all trees and blobs used by the index are listed on the "
"command line.  Note that you probably want to use `--objects`, too."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:954
#, no-wrap
msgid "`--unpacked`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:957
msgid "Only useful with `--objects`; print the object IDs that are not in packs."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:958
#, no-wrap
msgid "`--object-names`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:966
msgid ""
"Only useful with `--objects`; print the names of the object IDs that are "
"found. This is the default behavior. Note that the \"name\" of each object "
"is ambiguous, and mostly intended as a hint for packing objects. In "
"particular: no distinction is made between the names of tags, trees, and "
"blobs; path names may be modified to remove newlines; and if an object would "
"appear multiple times with different names, only one name is shown."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:967
#, no-wrap
msgid "`--no-object-names`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:972
msgid ""
"Only useful with `--objects`; does not print the names of the object IDs "
"that are found. This inverts `--object-names`. This flag allows the output "
"to be more easily parsed by commands such as linkgit:git-cat-file[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:973
#, no-wrap
msgid "`--filter=<filter-spec>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:977
msgid ""
"Only useful with one of the `--objects*`; omits objects (usually blobs) from "
"the list of printed objects.  The _<filter-spec>_ may be one of the "
"following:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:979
msgid "The form `--filter=blob:none` omits all blobs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:984
msgid ""
"The form `--filter=blob:limit=<n>[kmg]` omits blobs of size at least _<n>_ "
"bytes or units.  _<n>_ may be zero.  The suffixes `k`, `m`, and `g` can be "
"used to name units in KiB, MiB, or GiB.  For example, `blob:limit=1k` is the "
"same as 'blob:limit=1024'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:987
msgid ""
"The form `--filter=object:type=(tag|commit|tree|blob)` omits all objects "
"which are not of the requested type."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:992
msgid ""
"The form `--filter=sparse:oid=<blob-ish>` uses a sparse-checkout "
"specification contained in the blob (or blob-expression) _<blob-ish>_ to "
"omit blobs that would not be required for a sparse checkout on the requested "
"refs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1002
msgid ""
"The form `--filter=tree:<depth>` omits all blobs and trees whose depth from "
"the root tree is >= _<depth>_ (minimum depth if an object is located at "
"multiple depths in the commits traversed). _<depth>_=0 will not include any "
"trees or blobs unless included explicitly in the command-line (or standard "
"input when `--stdin` is used). _<depth>_=1 will include only the tree and "
"blobs which are referenced directly by a commit reachable from _<commit>_ or "
"an explicitly-given object. _<depth>_=2 is like <depth>=1 while also "
"including trees and blobs one more level removed from an explicitly-given "
"commit or tree."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1006
msgid ""
"Note that the form `--filter=sparse:path=<path>` that wants to read from an "
"arbitrary path on the filesystem has been dropped for security reasons."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1009
msgid ""
"Multiple `--filter=` flags can be specified to combine filters. Only objects "
"which are accepted by every filter are included."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1018
msgid ""
"The form `--filter=combine:<filter1>+<filter2>+...<filterN>` can also be "
"used to combined several filters, but this is harder than just repeating the "
"`--filter` flag and is usually not necessary. Filters are joined by '{plus}' "
"and individual filters are %-encoded (i.e. URL-encoded).  Besides the "
"'{plus}' and '%' characters, the following characters are reserved and also "
"must be encoded: `~!@#$^&*()[]{}\\;\",<>?`+&#39;&#96;+ as well as all "
"characters with ASCII code &lt;= `0x20`, which includes space and newline."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1022
msgid ""
"Other arbitrary characters can also be encoded. For instance, "
"`combine:tree:3+blob:none` and `combine:tree%3A3+blob%3Anone` are "
"equivalent."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1023
#, no-wrap
msgid "`--no-filter`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1025
msgid "Turn off any previous `--filter=` argument."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1026
#, no-wrap
msgid "`--filter-provided-objects`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1030
msgid ""
"Filter the list of explicitly provided objects, which would otherwise always "
"be printed even if they did not match any of the filters. Only useful with "
"`--filter=`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1031
#, no-wrap
msgid "`--filter-print-omitted`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1034
msgid ""
"Only useful with `--filter=`; prints a list of the objects omitted by the "
"filter.  Object IDs are prefixed with a ``~'' character."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1035
#, no-wrap
msgid "`--missing=<missing-action>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1038
msgid ""
"A debug option to help with future \"partial clone\" development.  This "
"option specifies how missing objects are handled."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1041
msgid ""
"The form `--missing=error` requests that rev-list stop with an error if a "
"missing object is encountered.  This is the default action."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1045
msgid ""
"The form `--missing=allow-any` will allow object traversal to continue if a "
"missing object is encountered.  Missing objects will silently be omitted "
"from the results."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1049
msgid ""
"The form `--missing=allow-promisor` is like `allow-any`, but will only allow "
"object traversal to continue for EXPECTED promisor missing objects.  "
"Unexpected missing objects will raise an error."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1052
msgid ""
"The form `--missing=print` is like `allow-any`, but will also print a list "
"of the missing objects.  Object IDs are prefixed with a ``?'' character."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1062
msgid ""
"The form `--missing=print-info` is like `print`, but will also print "
"additional information about the missing object inferred from its containing "
"object. The information is all printed on the same line with the missing "
"object ID in the form: `?<oid> [<token>=<value>]...`. The `<token>=<value>` "
"pairs containing additional information are separated from each other by a "
"_SP_. The value is encoded in a token specific fashion, but _SP_ or _LF_ "
"contained in value are always expected to be represented in such a way that "
"the resulting encoded value does not have either of these two problematic "
"bytes. Each `<token>=<value>` may be one of the following:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1067
msgid ""
"The `path=<path>` shows the path of the missing object inferred from a "
"containing object. A path containing _SP_ or special characters is enclosed "
"in double-quotes in the C style as needed."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1070
msgid ""
"The `type=<type>` shows the type of the missing object inferred from a "
"containing object."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1075
msgid ""
"If some tips passed to the traversal are missing, they will be considered as "
"missing too, and the traversal will ignore them. In case we cannot get their "
"Object ID though, an error will be raised."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1076
#, no-wrap
msgid "`--exclude-promisor-objects`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1082
msgid ""
"(For internal use only.)  Prefilter object traversal at promisor boundary.  "
"This is used with partial clone.  This is stronger than "
"`--missing=allow-promisor` because it limits the traversal, rather than just "
"silencing errors about missing objects."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1084
#, no-wrap
msgid "`--no-walk[=(sorted|unsorted)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1092
msgid ""
"Only show the given commits, but do not traverse their ancestors.  This has "
"no effect if a range is specified. If the argument `unsorted` is given, the "
"commits are shown in the order they were given on the command "
"line. Otherwise (if `sorted` or no argument was given), the commits are "
"shown in reverse chronological order by commit time.  Cannot be combined "
"with `--graph`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1093
#, no-wrap
msgid "`--do-walk`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1095
msgid "Overrides a previous `--no-walk`."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/rev-list-options.adoc:1099
#, no-wrap
msgid "Commit Formatting"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1104
msgid ""
"Using these options, linkgit:git-rev-list[1] will act similar to the more "
"specialized family of commit log tools:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1106
msgid "linkgit:git-log[1], linkgit:git-show[1], and linkgit:git-whatchanged[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1109
msgid "linkgit:git-log[1] and linkgit:git-show[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1114
#, no-wrap
msgid "`--relative-date`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1116
msgid "Synonym for `--date=relative`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1117
#, no-wrap
msgid "`--date=<format>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1124
msgid ""
"Only takes effect for dates shown in human-readable format, such as when "
"using `--pretty`. `log.date` config variable sets a default value for the "
"log command's `--date` option. By default, dates are shown in the original "
"time zone (either committer's or author's). If `-local` is appended to the "
"format (e.g., `iso-local`), the user's local time zone is used instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1129
msgid ""
"`--date=relative` shows dates relative to the current time, e.g. ``2 hours "
"ago''. The `-local` option has no effect for `--date=relative`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1131
msgid "`--date=local` is an alias for `--date=default-local`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1134
msgid ""
"`--date=iso` (or `--date=iso8601`) shows timestamps in a ISO 8601-like "
"format.  The differences to the strict ISO 8601 format are:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1136
msgid "a space instead of the `T` date/time delimiter"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1137
msgid "a space between time and time zone"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1138
msgid "no colon between hours and minutes of the time zone"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1141
msgid ""
"`--date=iso-strict` (or `--date=iso8601-strict`) shows timestamps in strict "
"ISO 8601 format."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1144
msgid ""
"`--date=rfc` (or `--date=rfc2822`) shows timestamps in RFC 2822 format, "
"often found in email messages."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1146
msgid ""
"`--date=short` shows only the date, but not the time, in `YYYY-MM-DD` "
"format."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1155
msgid ""
"`--date=raw` shows the date as seconds since the epoch (1970-01-01 00:00:00 "
"UTC), followed by a space, and then the timezone as an offset from UTC (a "
"`+` or `-` with four digits; the first two are hours, and the second two are "
"minutes). I.e., as if the timestamp were formatted with `strftime(\"%s "
"%z\")`).  Note that the `-local` option does not affect the "
"seconds-since-epoch value (which is always measured in UTC), but does switch "
"the accompanying timezone value."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1162
msgid ""
"`--date=human` shows the timezone if the timezone does not match the current "
"time-zone, and doesn't print the whole date if that matches (ie skip "
"printing year for dates that are \"this year\", but also skip the whole date "
"itself if it's in the last few days and we can just say what weekday it "
"was).  For older dates the hour and minute is also omitted."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1166
msgid ""
"`--date=unix` shows the date as a Unix epoch timestamp (seconds since "
"1970).  As with `--raw`, this is always in UTC and therefore `-local` has no "
"effect."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1173
msgid ""
"`--date=format:<format>` feeds the _<format>_ to your system `strftime`, "
"except for `%s`, `%z`, and `%Z`, which are handled internally.  Use "
"`--date=format:%c` to show the date in your system locale's preferred "
"format.  See the `strftime`(3) manual for a complete list of format "
"placeholders. When using `-local`, the correct syntax is "
"`--date=format-local:<format>`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1179
msgid ""
"`--date=default` is the default format, and is based on ctime(3)  output.  "
"It shows a single line with three-letter day of the week, three-letter "
"month, day-of-month, hour-minute-seconds in \"HH:MM:SS\" format, followed by "
"4-digit year, plus timezone information, unless the local time zone is used, "
"e.g. `Thu Jan 1 00:00:00 1970 +0000`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1182
#, no-wrap
msgid "`--header`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1185
msgid ""
"Print the contents of the commit in raw-format; each record is separated "
"with a NUL character."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1186
#, no-wrap
msgid "`--no-commit-header`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1190
msgid ""
"Suppress the header line containing \"commit\" and the object ID printed "
"before the specified format.  This has no effect on the built-in formats; "
"only custom formats are affected."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1191
#, no-wrap
msgid "`--commit-header`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1193
msgid "Overrides a previous `--no-commit-header`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1195
#, no-wrap
msgid "`--parents`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1198
msgid ""
"Print also the parents of the commit (in the form \"commit parent...\").  "
"Also enables parent rewriting, see 'History Simplification' above."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1199
#, no-wrap
msgid "`--children`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1202
msgid ""
"Print also the children of the commit (in the form \"commit child...\").  "
"Also enables parent rewriting, see 'History Simplification' above."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1204
#, no-wrap
msgid "`--timestamp`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1206
msgid "Print the raw commit timestamp."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1208
#, no-wrap
msgid "`--left-right`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1213
msgid ""
"Mark which side of a symmetric difference a commit is reachable from.  "
"Commits from the left side are prefixed with `<` and those from the right "
"with `>`.  If combined with `--boundary`, those commits are prefixed with "
"`-`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1215
msgid "For example, if you have this topology:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:1222
#, no-wrap
msgid ""
"\t     y---b---b  branch B\n"
"\t    / \\ /\n"
"\t   /   .\n"
"\t  /   / \\\n"
"\t o---x---a---a  branch A\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1225
msgid "you would get an output like this:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:1228
#, no-wrap
msgid "\t$ git rev-list --left-right --boundary --pretty=oneline A...B\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/rev-list-options.adoc:1235
#, no-wrap
msgid ""
"\t>bbbbbbb... 3rd on b\n"
"\t>bbbbbbb... 2nd on b\n"
"\t<aaaaaaa... 3rd on a\n"
"\t<aaaaaaa... 2nd on a\n"
"\t-yyyyyyy... 1st on b\n"
"\t-xxxxxxx... 1st on a\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1237
#, no-wrap
msgid "`--graph`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1243
msgid ""
"Draw a text-based graphical representation of the commit history on the left "
"hand side of the output.  This may cause extra lines to be printed in "
"between commits, in order for the graph history to be drawn properly.  "
"Cannot be combined with `--no-walk`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1245
msgid "This enables parent rewriting, see 'History Simplification' above."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1248
msgid ""
"This implies the `--topo-order` option by default, but the `--date-order` "
"option may also be specified."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1249
#, no-wrap
msgid "`--show-linear-break[=<barrier>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1255
msgid ""
"When `--graph` is not used, all history branches are flattened which can "
"make it hard to see that the two consecutive commits do not belong to a "
"linear branch. This option puts a barrier in between them in that case. If "
"_<barrier>_ is specified, it is the string that will be shown instead of the "
"default one."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/rev-list-options.adoc:1257
#, no-wrap
msgid "`--count`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/rev-list-options.adoc:1265
msgid ""
"Print a number stating how many commits would have been listed, and suppress "
"all other output.  When used together with `--left-right`, instead print the "
"counts for left and right commits, separated by a tab. When used together "
"with `--cherry-mark`, omit patch equivalent commits from these counts and "
"print the count for equivalent commits separated by a tab."
msgstr ""
