#, no-wrap
msgid "Fixes since Git 2.43.2"
msgstr ""

#. type: Plain text
#: ../Documentation/RelNotes/2.43.3.txt:12
msgid ""
"\"git commit -v --trailer=...\" was broken with recent update and placed the "
"trailer _after_ the divider line, which has been corrected."
msgstr ""
