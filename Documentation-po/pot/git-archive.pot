#. type: Title =
#: ../Documentation-sedout/git-archive.adoc:2
#, no-wrap
msgid "git-archive(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:7
msgid "git-archive - Create an archive of files from a named tree"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:16
#, no-wrap
msgid ""
"\t'git archive' [--format=<fmt>] [--list] [--prefix=<prefix>/] [<extra>]\n"
"\t\t      [-o <file> | --output=<file>] [--worktree-attributes]\n"
"\t\t      [--remote=<repo> [--exec=<git-upload-archive>]] <tree-ish>\n"
"\t\t      [<path>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:18
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:23
msgid ""
"Creates an archive of the specified format containing the tree structure for "
"the named tree, and writes it out to the standard output.  If <prefix> is "
"specified it is prepended to the filenames in the archive."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:32
msgid ""
"'git archive' behaves differently when given a tree ID as opposed to a "
"commit ID or tag ID. When a tree ID is provided, the current time is used as "
"the modification time of each file in the archive. On the other hand, when a "
"commit ID or tag ID is provided, the commit time as recorded in the "
"referenced commit object is used instead.  Additionally the commit ID is "
"stored in a global extended pax header if the tar format is used; it can be "
"extracted using 'git get-tar-commit-id'. In ZIP files it is stored as a file "
"comment."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:34
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:36
#, no-wrap
msgid "`--format=<fmt>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:44
msgid ""
"Format of the resulting archive. Possible values are `tar`, `zip`, `tar.gz`, "
"`tgz`, and any format defined using the configuration option "
"`tar.<format>.command`. If `--format` is not given, and the output file is "
"specified, the format is inferred from the filename if possible "
"(e.g. writing to `foo.zip` makes the output to be in the `zip` "
"format). Otherwise the output format is `tar`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:45
#, no-wrap
msgid "`-l`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:46
#, no-wrap
msgid "`--list`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:48
msgid "Show all available formats."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:49
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:50
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:52
msgid "Report progress to stderr."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:53
#, no-wrap
msgid "`--prefix=<prefix>/`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:57
msgid ""
"Prepend <prefix>/ to paths in the archive.  Can be repeated; its rightmost "
"value is used for all tracked files.  See below which value gets used by "
"`--add-file`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:58
#, no-wrap
msgid "`-o <file>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:59
#, no-wrap
msgid "`--output=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:61
msgid "Write the archive to <file> instead of stdout."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:62
#, no-wrap
msgid "`--add-file=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:67
msgid ""
"Add a non-tracked file to the archive.  Can be repeated to add multiple "
"files.  The path of the file in the archive is built by concatenating the "
"value of the last `--prefix` option (if any)  before this `--add-file` and "
"the basename of <file>."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:68
#, no-wrap
msgid "`--add-virtual-file=<path>:<content>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:71
msgid ""
"Add the specified contents to the archive.  Can be repeated to add multiple "
"files."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:78
msgid ""
"The `<path>` argument can start and end with a literal double-quote "
"character; the contained file name is interpreted as a C-style string, "
"i.e. the backslash is interpreted as escape character. The path must be "
"quoted if it contains a colon, to avoid the colon from being misinterpreted "
"as the separator between the path and the contents, or if the path begins or "
"ends with a double-quote character."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:82
msgid ""
"The file mode is limited to a regular file, and the option may be subject to "
"platform-dependent command-line limits. For non-trivial cases, write an "
"untracked file and use `--add-file` instead."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:86
msgid ""
"Note that unlike `--add-file` the path created in the archive is not "
"affected by the `--prefix` option, as a full `<path>` can be given as the "
"value of the option."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:87
#, no-wrap
msgid "`--worktree-attributes`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:90
msgid ""
"Look for attributes in .gitattributes files in the working tree as well (see "
"<<ATTRIBUTES>>)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:91
#, no-wrap
msgid "`--mtime=<time>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:95
msgid ""
"Set modification time of archive entries.  Without this option the committer "
"time is used if `<tree-ish>` is a commit or tag, and the current time if it "
"is a tree."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:96
#, no-wrap
msgid "<extra>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:99
msgid ""
"This can be any options that the archiver backend understands.  See next "
"section."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:100
#, no-wrap
msgid "`--remote=<repo>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:106
msgid ""
"Instead of making a tar archive from the local repository, retrieve a tar "
"archive from a remote repository. Note that the remote repository may place "
"restrictions on which sha1 expressions may be allowed in `<tree-ish>`. See "
"linkgit:git-upload-archive[1] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:107
#, no-wrap
msgid "`--exec=<git-upload-archive>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:110
msgid ""
"Used with --remote to specify the path to the 'git-upload-archive' on the "
"remote side."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:111
#, no-wrap
msgid "<tree-ish>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:113
msgid "The tree or commit to produce an archive for."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:114
#, no-wrap
msgid "<path>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:118
msgid ""
"Without an optional path parameter, all files and subdirectories of the "
"current working directory are included in the archive.  If one or more paths "
"are specified, only these are included."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:120
#, no-wrap
msgid "BACKEND EXTRA OPTIONS"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-archive.adoc:123
#, no-wrap
msgid "zip"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:124
#, no-wrap
msgid "`-<digit>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:129
msgid ""
"Specify compression level.  Larger values allow the command to spend more "
"time to compress to smaller size.  Supported values are from `-0` "
"(store-only) to `-9` (best ratio).  Default is `-6` if not given."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-archive.adoc:131
#, no-wrap
msgid "tar"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:132
#, no-wrap
msgid "`-<number>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:137
msgid ""
"Specify compression level. The value will be passed to the compression "
"command configured in `tar.<format>.command`. See manual page of the "
"configured command for the list of supported levels and the default level if "
"this option isn't specified."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:139
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:141
#, no-wrap
msgid "tar.umask"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:148
msgid ""
"This variable can be used to restrict the permission bits of tar archive "
"entries.  The default is 0002, which turns off the world write bit.  The "
"special value \"user\" indicates that the archiving user's umask will be "
"used instead.  See umask(2) for details.  If `--remote` is used then only "
"the configuration of the remote repository takes effect."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:149
#, no-wrap
msgid "tar.<format>.command"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:156
msgid ""
"This variable specifies a shell command through which the tar output "
"generated by `git archive` should be piped. The command is executed using "
"the shell with the generated tar file on its standard input, and should "
"produce the final output on its standard output. Any compression-level "
"options will be passed to the command (e.g., `-9`)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:160
msgid ""
"The `tar.gz` and `tgz` formats are defined automatically and use the magic "
"command `git archive gzip` by default, which invokes an internal "
"implementation of gzip."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:161
#, no-wrap
msgid "tar.<format>.remote"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:166
msgid ""
"If true, enable the format for use by remote clients via "
"linkgit:git-upload-archive[1]. Defaults to false for user-defined formats, "
"but true for the `tar.gz` and `tgz` formats."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:169
#, no-wrap
msgid "ATTRIBUTES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:171
#, no-wrap
msgid "export-ignore"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:174
msgid ""
"Files and directories with the attribute export-ignore won't be added to "
"archive files.  See linkgit:gitattributes[5] for details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:175
#, no-wrap
msgid "export-subst"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:179
msgid ""
"If the attribute export-subst is set for a file then Git will expand several "
"placeholders when adding this file to an archive.  See "
"linkgit:gitattributes[5] for details."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:187
msgid ""
"Note that attributes are by default taken from the `.gitattributes` files in "
"the tree that is being archived.  If you want to tweak the way the output is "
"generated after the fact (e.g. you committed without adding an appropriate "
"export-ignore in its `.gitattributes`), adjust the checked out "
"`.gitattributes` file as necessary and use `--worktree-attributes` option.  "
"Alternatively you can keep necessary attributes that should apply while "
"archiving any tree in your `$GIT_DIR/info/attributes` file."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-archive.adoc:189
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:190
#, no-wrap
msgid "`git archive --format=tar --prefix=junk/ HEAD | (cd /var/tmp/ && tar xf -)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:195
msgid ""
"Create a tar archive that contains the contents of the latest commit on the "
"current branch, and extract it in the `/var/tmp/junk` directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:196
#, no-wrap
msgid ""
"`git archive --format=tar --prefix=git-1.4.0/ v1.4.0 | gzip "
">git-1.4.0.tar.gz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:199
msgid "Create a compressed tarball for v1.4.0 release."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:200
#, no-wrap
msgid "`git archive --format=tar.gz --prefix=git-1.4.0/ v1.4.0 >git-1.4.0.tar.gz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:203
msgid "Same as above, but using the builtin tar.gz handling."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:204
#, no-wrap
msgid "`git archive --prefix=git-1.4.0/ -o git-1.4.0.tar.gz v1.4.0`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:207
msgid "Same as above, but the format is inferred from the output file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:208
#, no-wrap
msgid ""
"`git archive --format=tar --prefix=git-1.4.0/ v1.4.0^{tree} | gzip "
">git-1.4.0.tar.gz`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:212
msgid ""
"Create a compressed tarball for v1.4.0 release, but without a global "
"extended pax header."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:213
#, no-wrap
msgid ""
"`git archive --format=zip --prefix=git-docs/ HEAD:Documentation/ > "
"git-1.4.0-docs.zip`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:217
msgid ""
"Put everything in the current head's Documentation/ directory into "
"'git-1.4.0-docs.zip', with the prefix 'git-docs/'."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:218
#, no-wrap
msgid "`git archive -o latest.zip HEAD`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:223
msgid ""
"Create a Zip archive that contains the contents of the latest commit on the "
"current branch. Note that the output format is inferred by the extension of "
"the output file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:224
#, no-wrap
msgid ""
"`git archive -o latest.tar --prefix=build/ --add-file=configure --prefix= "
"HEAD`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:229
msgid ""
"Creates a tar archive that contains the contents of the latest commit on the "
"current branch with no prefix and the untracked file 'configure' with the "
"prefix 'build/'."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-archive.adoc:230
#, no-wrap
msgid "`git config tar.tar.xz.command \"xz -c\"`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-archive.adoc:235
msgid ""
"Configure a \"tar.xz\" format for making LZMA-compressed tarfiles.  You can "
"use it specifying `--format=tar.xz`, or by creating an output file like `-o "
"foo.tar.xz`."
msgstr ""

