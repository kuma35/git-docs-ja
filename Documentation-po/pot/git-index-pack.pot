#. type: Title =
#: ../Documentation-sedout/git-index-pack.txt:2
#, no-wrap
msgid "git-index-pack(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-index-pack.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:7
msgid "git-index-pack - Build pack index file for an existing packed archive"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-index-pack.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:15
#, no-wrap
msgid ""
"'git index-pack' [-v] [-o <index-file>] [--[no-]rev-index] <pack-file>\n"
"'git index-pack' --stdin [--fix-thin] [--keep] [-v] [-o <index-file>]\n"
"\t\t  [--[no-]rev-index] [<pack-file>]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-index-pack.txt:18
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:24
msgid ""
"Reads a packed archive (.pack) from the specified file, builds a pack index "
"file (.idx) for it, and optionally writes a reverse-index (.rev) for the "
"specified pack. The packed archive, together with the pack index, can then "
"be placed in the objects/pack/ directory of a Git repository."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-index-pack.txt:27
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:30
#, no-wrap
msgid ""
"`-v::`\n"
"\tBe verbose about what is going on, including progress status.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:38
#, no-wrap
msgid ""
"`-o`\n"
"\tWrite the generated pack index into the specified\n"
"\tfile.  Without this option the name of pack index\n"
"\tfile is constructed from the name of packed archive\n"
"\tfile by replacing .pack with .idx (and the program\n"
"\tfails if the name of packed archive does not end\n"
"\twith .pack).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:45
#, no-wrap
msgid ""
"`--[no-]rev-index::`\n"
"\tWhen this flag is provided, generate a reverse index\n"
"\t(a `.rev` file) corresponding to the given pack. If\n"
"\t`--verify` is given, ensure that the existing\n"
"\treverse index is correct. Takes precedence over\n"
"\t`pack.writeReverseIndex`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:55
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tWhen this flag is provided, the pack is read from stdin\n"
"\tinstead and a copy is then written to <pack-file>. If\n"
"\t<pack-file> is not specified, the pack is written to\n"
"\tobjects/pack/ directory of the current Git repository with\n"
"\ta default name determined from the pack content.  If\n"
"\t<pack-file> is not specified consider using --keep to\n"
"\tprevent a race condition between this process and\n"
"\t'git repack'.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:61
#, no-wrap
msgid ""
"`--fix-thin::`\n"
"\tFix a \"thin\" pack produced by `git pack-objects --thin` (see\n"
"\tlinkgit:git-pack-objects[1] for details) by adding the\n"
"\texcluded objects the deltified objects are based on to the\n"
"\tpack. This option only makes sense in conjunction with --stdin.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:69
#, no-wrap
msgid ""
"`--keep::`\n"
"\tBefore moving the index into its final destination\n"
"\tcreate an empty .keep file for the associated pack file.\n"
"\tThis option is usually necessary with --stdin to prevent a\n"
"\tsimultaneous 'git repack' process from deleting\n"
"\tthe newly constructed pack and index before refs can be\n"
"\tupdated to use objects contained in the pack.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:76
#, no-wrap
msgid ""
"`--keep=<msg>::`\n"
"\tLike --keep, create a .keep file before moving the index into\n"
"\tits final destination.  However, instead of creating an empty file\n"
"\tplace '<msg>' followed by an LF into the .keep file.  The '<msg>'\n"
"\tmessage can later be searched for within all .keep files to\n"
"\tlocate any which have outlived their usefulness.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:81
#, no-wrap
msgid ""
"`--index-version=<version>[,<offset>]::`\n"
"\tThis is intended to be used by the test suite only. It allows\n"
"\tto force the version for the generated pack index, and to force\n"
"\t64-bit index entries on objects located above the given offset.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:89
#, no-wrap
msgid ""
"`--strict[=<msg-id>=<severity>...]::`\n"
"\tDie, if the pack contains broken objects or links. An optional\n"
"\tcomma-separated list of `<msg-id>=<severity>` can be passed to change\n"
"\tthe severity of some possible issues, e.g.,\n"
"\t `--strict=\"missingEmail=ignore,badTagName=error\"`. See the entry for "
"the\n"
"\t`fsck.<msg-id>` configuration options in linkgit:git-fsck[1] for more\n"
"\tinformation on the possible values of `<msg-id>` and `<severity>`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:92
#, no-wrap
msgid ""
"`--progress-title::`\n"
"\tFor internal use only.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:95
msgid ""
"Set the title of the progress bar. The title is \"Receiving objects\" by "
"default and \"Indexing objects\" when `--stdin` is specified."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:98
#, no-wrap
msgid ""
"`--check-self-contained-and-connected::`\n"
"\tDie if the pack contains broken links. For internal use only.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:105
#, no-wrap
msgid ""
"`--fsck-objects[=<msg-id>=<severity>...]::`\n"
"\tDie if the pack contains broken objects, but unlike `--strict`, don't\n"
"\tchoke on broken links. If the pack contains a tree pointing to a\n"
"\t.gitmodules blob that does not exist, prints the hash of that blob\n"
"\t(for the caller to check) after the hash that goes into the name of the\n"
"\tpack/idx file (see \"Notes\").\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:111
msgid ""
"An optional comma-separated list of `<msg-id>=<severity>` can be passed to "
"change the severity of some possible issues, e.g., "
"`--fsck-objects=\"missingEmail=ignore,badTagName=ignore\"`. See the entry "
"for the `fsck.<msg-id>` configuration options in linkgit:git-fsck[1] for "
"more information on the possible values of `<msg-id>` and `<severity>`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:121
#, no-wrap
msgid ""
"`--threads=<n>::`\n"
"\tSpecifies the number of threads to spawn when resolving\n"
"\tdeltas. This requires that index-pack be compiled with\n"
"\tpthreads otherwise this option is ignored with a warning.\n"
"\tThis is meant to reduce packing time on multiprocessor\n"
"\tmachines. The required amount of memory for the delta search\n"
"\twindow is however multiplied by the number of threads.\n"
"\tSpecifying 0 will cause Git to auto-detect the number of CPU's\n"
"\tand use maximum 3 threads.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:124
#, no-wrap
msgid ""
"`--max-input-size=<size>::`\n"
"\tDie, if the pack is larger than <size>.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:130
#, no-wrap
msgid ""
"`--object-format=<hash-algorithm>::`\n"
"\tSpecify the given object format (hash algorithm) for the pack.  The "
"valid\n"
"\tvalues are 'sha1' and (if enabled) 'sha256'.  The default is the algorithm "
"for\n"
"\tthe current repository (set by `extensions.objectFormat`), or 'sha1' if "
"no\n"
"\tvalue is set or outside a repository.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:132
msgid "This option cannot be used with --stdin."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:142
#, no-wrap
msgid ""
"`--promisor[=<message>]::`\n"
"\tBefore committing the pack-index, create a .promisor file for this\n"
"\tpack. Particularly helpful when writing a promisor pack with --fix-thin\n"
"\tsince the name of the pack is not final until the pack has been fully\n"
"\twritten. If a `<message>` is provided, then that content will be\n"
"\twritten to the .promisor file for future reference. See\n"
"\tlink:technical/partial-clone.html[partial clone] for more information.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:147
msgid ""
"Also, if there are objects in the given pack that references non-promisor "
"objects (in the repo), repacks those non-promisor objects into a promisor "
"pack. This avoids a situation in which a repo has non-promisor objects that "
"are accessible through promisor objects."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:149
msgid "Requires <pack-file> to not be specified."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-index-pack.txt:151
#, no-wrap
msgid "NOTES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-index-pack.txt:159
msgid ""
"Once the index has been created, the hash that goes into the name of the "
"pack/idx file is printed to stdout. If --stdin was also used then this is "
"prefixed by either \"pack\\t\", or \"keep\\t\" if a new .keep file was "
"successfully created. This is useful to remove a .keep file used as a lock "
"to prevent the race with 'git repack' mentioned above."
msgstr ""

