#. type: Title =
#: ../Documentation-sedout/git-notes.adoc:2
#, no-wrap
msgid "git-notes(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:7
msgid "git-notes - Add or inspect object notes"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:23
#, no-wrap
msgid ""
"\tgit notes [list [<object>]]\n"
"\tgit notes add [-f] [--allow-empty] [--[no-]separator | "
"--separator=<paragraph-break>] [--[no-]stripspace] [-F <file> | -m <msg> | "
"(-c | -C) <object>] [-e] [<object>]\n"
"\tgit notes copy [-f] ( --stdin | <from-object> [<to-object>] )\n"
"\tgit notes append [--allow-empty] [--[no-]separator | "
"--separator=<paragraph-break>] [--[no-]stripspace] [-F <file> | -m <msg> | "
"(-c | -C) <object>] [-e] [<object>]\n"
"\tgit notes edit [--allow-empty] [<object>] [--[no-]stripspace]\n"
"\tgit notes show [<object>]\n"
"\tgit notes merge [-v | -q] [-s <strategy> ] <notes-ref>\n"
"\tgit notes merge --commit [-v | -q]\n"
"\tgit notes merge --abort [-v | -q]\n"
"\tgit notes remove [--ignore-missing] [--stdin] [<object>...]\n"
"\tgit notes prune [-n] [-v]\n"
"\tgit notes get-ref\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:26
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:29
msgid ""
"Adds, removes, or reads notes attached to objects, without touching the "
"objects themselves."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:34
msgid ""
"By default, notes are saved to and read from `refs/notes/commits`, but this "
"default can be overridden.  See the OPTIONS, CONFIGURATION, and ENVIRONMENT "
"sections below.  If this ref does not exist, it will be quietly created when "
"it is first needed to store a note."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:41
msgid ""
"A typical use of notes is to supplement a commit message without changing "
"the commit itself. Notes can be shown by `git log` along with the original "
"commit message. To distinguish these notes from the message stored in the "
"commit object, the notes are indented like the message, after an unindented "
"line saying \"Notes (_<refname>_):\" (or \"Notes:\" for "
"`refs/notes/commits`)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:45
msgid ""
"Notes can also be added to patches prepared with `git format-patch` by using "
"the `--notes` option. Such notes are added as a patch commentary after a "
"three dash separator line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:48
msgid ""
"To change which notes are shown by `git log`, see the `notes.displayRef` "
"discussion in <<CONFIGURATION,CONFIGURATION>>."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:51
msgid ""
"See the `notes.rewrite.<command>` configuration for a way to carry notes "
"across commands that rewrite commits."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:54
#, no-wrap
msgid "SUBCOMMANDS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:56
#, no-wrap
msgid "`list`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:61
msgid ""
"List the notes object for a given object. If no object is given, show a list "
"of all note objects and the objects they annotate (in the format "
"\"`<note-object> <annotated-object>`\").  This is the default subcommand if "
"no subcommand is given."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:62
#, no-wrap
msgid "`add`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:73
msgid ""
"Add notes for a given object (defaults to `HEAD`). Abort if the object "
"already has notes (use `-f` to overwrite existing notes).  However, if "
"you're using `add` interactively (using an editor to supply the notes "
"contents), then - instead of aborting - the existing notes will be opened in "
"the editor (like the `edit` subcommand). If you specify multiple `-m` and "
"`-F`, a blank line will be inserted between the messages. Use the "
"`--separator` option to insert other delimiters. You can use `-e` to edit "
"and fine-tune the message(s) supplied from `-m` and `-F` options "
"interactively (using an editor) before adding the note."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:74
#, no-wrap
msgid "`copy`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:80
msgid ""
"Copy the notes for the first object onto the second object (defaults to "
"`HEAD`). Abort if the second object already has notes, or if the first "
"object has none (use `-f` to overwrite existing notes to the second "
"object). This subcommand is equivalent to: `git notes add [-f] -C $(git "
"notes list <from-object>) <to-object>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:82
msgid "In `--stdin` mode, take lines in the format"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.adoc:85
#, no-wrap
msgid "<from-object> SP <to-object> [ SP <rest> ] LF\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:90
msgid ""
"on standard input, and copy the notes from each _<from-object>_ to its "
"corresponding _<to-object>_.  (The optional _<rest>_ is ignored so that the "
"command can read the input given to the `post-rewrite` hook.)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:93
msgid "`--stdin` cannot be combined with object names given on the command line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:94
#, no-wrap
msgid "`append`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:103
msgid ""
"Append new message(s) given by `-m` or `-F` options to an existing note, or "
"add them as a new note if one does not exist, for the object (defaults to "
"`HEAD`).  When appending to an existing note, a blank line is added before "
"each new message as an inter-paragraph separator.  The separator can be "
"customized with the `--separator` option.  Edit the notes to be appended "
"given by `-m` and `-F` options with `-e` interactively (using an editor) "
"before appending the note."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:104
#, no-wrap
msgid "`edit`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:106
msgid "Edit the notes for a given object (defaults to `HEAD`)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:107
#, no-wrap
msgid "`show`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:109
msgid "Show the notes for a given object (defaults to `HEAD`)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:110
#, no-wrap
msgid "`merge`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:115
msgid ""
"Merge the given notes ref into the current notes ref.  This will try to "
"merge the changes made by the given notes ref (called \"remote\") since the "
"merge-base (if any) into the current notes ref (called \"local\")."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:124
msgid ""
"If conflicts arise and a strategy for automatically resolving conflicting "
"notes (see the \"NOTES MERGE STRATEGIES\" section) is not given, the "
"`manual` resolver is used. This resolver checks out the conflicting notes in "
"a special worktree (`.git/NOTES_MERGE_WORKTREE`), and instructs the user to "
"manually resolve the conflicts there.  When done, the user can either "
"finalize the merge with `git notes merge --commit`, or abort the merge with "
"`git notes merge --abort`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:125
#, no-wrap
msgid "`remove`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:130
msgid ""
"Remove the notes for given objects (defaults to `HEAD`). When giving zero or "
"one object from the command line, this is equivalent to specifying an empty "
"note message to the `edit` subcommand."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:134
msgid ""
"In `--stdin` mode, also remove the object names given on standard input. In "
"other words, `--stdin` can be combined with object names from the command "
"line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:135
#, no-wrap
msgid "`prune`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:137
msgid "Remove all notes for non-existing/unreachable objects."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:138
#, no-wrap
msgid "`get-ref`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:141
msgid ""
"Print the current notes ref. This provides an easy way to retrieve the "
"current notes ref (e.g. from scripts)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:143
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:144
#, no-wrap
msgid "`-f`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:145
#, no-wrap
msgid "`--force`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:148
msgid ""
"When adding notes to an object that already has notes, overwrite the "
"existing notes (instead of aborting)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:149
#, no-wrap
msgid "`-m <msg>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:150
#, no-wrap
msgid "`--message=<msg>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:154
msgid ""
"Use the given note message (instead of prompting).  If multiple `-m` options "
"are given, their values are concatenated as separate paragraphs."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:155
#, no-wrap
msgid "`-F <file>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:156
#, no-wrap
msgid "`--file=<file>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:159
msgid ""
"Take the note message from the given file.  Use `-` to read the note message "
"from the standard input."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:160
#, no-wrap
msgid "`-C <object>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:161
#, no-wrap
msgid "`--reuse-message=<object>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:166
msgid ""
"Take the given blob object (for example, another note) as the note "
"message. (Use `git notes copy <object>` instead to copy notes between "
"objects.)  Implies `--no-stripspace` since the default behavior is to copy "
"the message verbatim."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:167
#, no-wrap
msgid "`-c <object>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:168
#, no-wrap
msgid "`--reedit-message=<object>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:171
msgid ""
"Like `-C`, but with `-c` the editor is invoked, so that the user can further "
"edit the note message."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:172
#, no-wrap
msgid "`--allow-empty`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:175
msgid ""
"Allow an empty note object to be stored. The default behavior is to "
"automatically remove empty notes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:176
#, no-wrap
msgid "`--separator=<paragraph-break>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:177
#, no-wrap
msgid "`--separator`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:178
#, no-wrap
msgid "`--no-separator`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:183
msgid ""
"Specify a string used as a custom inter-paragraph separator (a newline is "
"added at the end as needed). If `--no-separator`, no separators will be "
"added between paragraphs.  Defaults to a blank line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:184
#, no-wrap
msgid "`--stripspace`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:185
#, no-wrap
msgid "`--no-stripspace`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:188
msgid "Clean up whitespace. Specifically (see linkgit:git-stripspace[1]):"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:191
msgid "remove trailing whitespace from all lines"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:192
msgid "collapse multiple consecutive empty lines into one empty line"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:193
msgid "remove empty lines from the beginning and end of the input"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:194
msgid "add a missing `\\n` to the last line if necessary."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:202
msgid ""
"`--stripspace` is the default except for `-C`/`--reuse-message`. However, "
"keep in mind that this depends on the order of similar options. For example, "
"for `-C <object> -m<message>`, `--stripspace` will be used because the "
"default for `-m` overrides the previous `-C`. This is a known limitation "
"that may be fixed in the future."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:203
#, no-wrap
msgid "`--ref=<ref>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:209
msgid ""
"Manipulate the notes tree in _<ref>_.  This overrides `GIT_NOTES_REF` and "
"the `core.notesRef` configuration.  The ref specifies the full refname when "
"it begins with `refs/notes/`; when it begins with `notes/`, `refs/` and "
"otherwise `refs/notes/` is prefixed to form a full name of the ref."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:210
#, no-wrap
msgid "`--ignore-missing`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:213
msgid ""
"Do not consider it an error to request removing notes from an object that "
"does not have notes attached to it."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:214
#, no-wrap
msgid "`--stdin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:216
msgid "Only valid for `remove` and `copy`. See the respective subcommands."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:217
#, no-wrap
msgid "`-n`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:218
#, no-wrap
msgid "`--dry-run`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:221
msgid ""
"Do not remove anything; just report the object names whose notes would be "
"removed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:222
#, no-wrap
msgid "`-s <strategy>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:223
#, no-wrap
msgid "`--strategy=<strategy>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:230
msgid ""
"When merging notes, resolve notes conflicts using the given strategy. The "
"following strategies are recognized: `manual` (default), `ours`, `theirs`, "
"`union` and `cat_sort_uniq`.  This option overrides the "
"`notes.mergeStrategy` configuration setting.  See the \"NOTES MERGE "
"STRATEGIES\" section below for more information on each notes merge "
"strategy."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:231
#, no-wrap
msgid "`--commit`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:239
msgid ""
"Finalize an in-progress `git notes merge`. Use this option when you have "
"resolved the conflicts that `git notes merge` stored in "
"`.git/NOTES_MERGE_WORKTREE`. This amends the partial merge commit created by "
"`git notes merge` (stored in `.git/NOTES_MERGE_PARTIAL`) by adding the notes "
"in `.git/NOTES_MERGE_WORKTREE`. The notes ref stored in the "
"`.git/NOTES_MERGE_REF` symref is updated to the resulting commit."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:240
#, no-wrap
msgid "`--abort`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:244
msgid ""
"Abort/reset an in-progress `git notes merge`, i.e. a notes merge with "
"conflicts. This simply removes all files related to the notes merge."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:245
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:246
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:248
msgid "When merging notes, operate quietly."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:249
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:250
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:254
msgid ""
"When merging notes, be more verbose.  When pruning notes, report all object "
"names whose notes are removed."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:257
#, no-wrap
msgid "DISCUSSION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:268
msgid ""
"Commit notes are blobs containing extra information about an object (usually "
"information to supplement a commit's message).  These blobs are taken from "
"notes refs.  A notes ref is usually a branch which contains \"files\" whose "
"paths are the object names for the objects they describe, with some "
"directory separators included for performance reasons footnote:[Permitted "
"pathnames have the form 'bf'`/`'fe'`/`'30'`/`'...'`/`'680d5a...': a sequence "
"of directory names of two hexadecimal digits each followed by a filename "
"with the rest of the object ID.]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:275
msgid ""
"Every notes change creates a new commit at the specified notes ref.  You can "
"therefore inspect the history of the notes by invoking, e.g., `git log -p "
"notes/commits`.  Currently the commit message only records which operation "
"triggered the update, and the commit authorship is determined according to "
"the usual rules (see linkgit:git-commit[1]).  These details may change in "
"the future."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:279
msgid ""
"It is also permitted for a notes ref to point directly to a tree object, in "
"which case the history of the notes can be read with `git log -p -g "
"<refname>`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:282
#, no-wrap
msgid "NOTES MERGE STRATEGIES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:291
msgid ""
"The default notes merge strategy is `manual`, which checks out conflicting "
"notes in a special work tree for resolving notes conflicts "
"(`.git/NOTES_MERGE_WORKTREE`), and instructs the user to resolve the "
"conflicts in that work tree.  When done, the user can either finalize the "
"merge with `git notes merge --commit`, or abort the merge with `git notes "
"merge --abort`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:294
msgid ""
"Users may select an automated merge strategy from among the following using "
"either `-s`/`--strategy` option or configuring `notes.mergeStrategy` "
"accordingly:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:297
msgid ""
"`ours` automatically resolves conflicting notes in favor of the local "
"version (i.e. the current notes ref)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:301
msgid ""
"`theirs` automatically resolves notes conflicts in favor of the remote "
"version (i.e. the given notes ref being merged into the current notes ref)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:304
msgid ""
"`union` automatically resolves notes conflicts by concatenating the local "
"and remote versions."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:314
msgid ""
"`cat_sort_uniq` is similar to `union`, but in addition to concatenating the "
"local and remote versions, this strategy also sorts the resulting lines, and "
"removes duplicate lines from the result. This is equivalent to applying the "
"\"cat | sort | uniq\" shell pipeline to the local and remote versions. This "
"strategy is useful if the notes follow a line-based format where one wants "
"to avoid duplicated lines in the merge result.  Note that if either the "
"local or remote version contain duplicate lines prior to the merge, these "
"will also be removed by this notes merge strategy."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:317
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:321
msgid ""
"You can use notes to add annotations with information that was not available "
"at the time a commit was written."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.adoc:327
#, no-wrap
msgid ""
"$ git notes add -m 'Tested-by: Johannes Sixt <j6t@kdbg.org>' 72a144e2\n"
"$ git show -s 72a144e\n"
"[...]\n"
"    Signed-off-by: Junio C Hamano <gitster@pobox.com>\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.adoc:330
#, no-wrap
msgid ""
"Notes:\n"
"    Tested-by: Johannes Sixt <j6t@kdbg.org>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:335
msgid ""
"In principle, a note is a regular Git blob, and any kind of (non-)format is "
"accepted.  You can binary-safely create notes from arbitrary files using "
"`git hash-object`:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.adoc:340
#, no-wrap
msgid ""
"$ cc *.c\n"
"$ blob=$(git hash-object -w a.out)\n"
"$ git notes --ref=built add --allow-empty -C \"$blob\" HEAD\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:347
msgid ""
"(You cannot simply use `git notes --ref=built add -F a.out HEAD` because "
"that is not binary-safe.)  Of course, it doesn't make much sense to display "
"non-text-format notes with `git log`, so if you use such notes, you'll "
"probably need to write some special-purpose tools to do something useful "
"with them."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:351
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:353
#, no-wrap
msgid "`core.notesRef`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:358
msgid ""
"Notes ref to read and manipulate instead of `refs/notes/commits`.  Must be "
"an unabbreviated ref name.  This setting can be overridden through the "
"environment and command line."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.adoc:365
#, no-wrap
msgid "ENVIRONMENT"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:367
#, no-wrap
msgid "`GIT_NOTES_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:370
msgid ""
"Which ref to manipulate notes from, instead of `refs/notes/commits`.  This "
"overrides the `core.notesRef` setting."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:371
#, no-wrap
msgid "`GIT_NOTES_DISPLAY_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:377
msgid ""
"Colon-delimited list of refs or globs indicating which refs, in addition to "
"the default from `core.notesRef` or `GIT_NOTES_REF`, to read notes from when "
"showing commit messages.  This overrides the `notes.displayRef` setting."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:380
msgid ""
"A warning will be issued for refs that do not exist, but a glob that does "
"not match any refs is silently ignored."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:381
#, no-wrap
msgid "`GIT_NOTES_REWRITE_MODE`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:386
msgid ""
"When copying notes during a rewrite, what to do if the target commit already "
"has a note.  Must be one of `overwrite`, `concatenate`, `cat_sort_uniq`, or "
"`ignore`.  This overrides the `core.rewriteMode` setting."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.adoc:387
#, no-wrap
msgid "`GIT_NOTES_REWRITE_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:391
msgid ""
"When rewriting commits, which notes to copy from the original to the "
"rewritten commit.  Must be a colon-delimited list of refs or globs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.adoc:394
msgid ""
"If not set in the environment, the list of notes to copy depends on the "
"`notes.rewrite.<command>` and `notes.rewriteRef` settings."
msgstr ""

