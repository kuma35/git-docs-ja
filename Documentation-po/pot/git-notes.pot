#. type: Title =
#: ../Documentation-sedout/git-notes.txt:2
#, no-wrap
msgid "git-notes(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:7
msgid "git-notes - Add or inspect object notes"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:23
#, no-wrap
msgid ""
"\t'git notes' [list [<object>]]\n"
"\t'git notes' add [-f] [--allow-empty] [--[no-]separator | "
"--separator=<paragraph-break>] [--[no-]stripspace] [-F <file> | -m <msg> | "
"(-c | -C) <object>] [-e] [<object>]\n"
"\t'git notes' copy [-f] ( --stdin | <from-object> [<to-object>] )\n"
"\t'git notes' append [--allow-empty] [--[no-]separator | "
"--separator=<paragraph-break>] [--[no-]stripspace] [-F <file> | -m <msg> | "
"(-c | -C) <object>] [-e] [<object>]\n"
"\t'git notes' edit [--allow-empty] [<object>] [--[no-]stripspace]\n"
"\t'git notes' show [<object>]\n"
"\t'git notes' merge [-v | -q] [-s <strategy> ] <notes-ref>\n"
"\t'git notes' merge --commit [-v | -q]\n"
"\t'git notes' merge --abort [-v | -q]\n"
"\t'git notes' remove [--ignore-missing] [--stdin] [<object>...]\n"
"\t'git notes' prune [-n] [-v]\n"
"\t'git notes' get-ref\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:26
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:29
msgid ""
"Adds, removes, or reads notes attached to objects, without touching the "
"objects themselves."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:34
msgid ""
"By default, notes are saved to and read from `refs/notes/commits`, but this "
"default can be overridden.  See the OPTIONS, CONFIGURATION, and ENVIRONMENT "
"sections below.  If this ref does not exist, it will be quietly created when "
"it is first needed to store a note."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:41
msgid ""
"A typical use of notes is to supplement a commit message without changing "
"the commit itself. Notes can be shown by 'git log' along with the original "
"commit message. To distinguish these notes from the message stored in the "
"commit object, the notes are indented like the message, after an unindented "
"line saying \"Notes (<refname>):\" (or \"Notes:\" for `refs/notes/commits`)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:45
msgid ""
"Notes can also be added to patches prepared with `git format-patch` by using "
"the `--notes` option. Such notes are added as a patch commentary after a "
"three dash separator line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:48
msgid ""
"To change which notes are shown by 'git log', see the \"notes.displayRef\" "
"discussion in <<CONFIGURATION>>."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:51
msgid ""
"See the \"notes.rewrite.<command>\" configuration for a way to carry notes "
"across commands that rewrite commits."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:54
#, no-wrap
msgid "SUBCOMMANDS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:56
#, no-wrap
msgid "list"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:61
msgid ""
"List the notes object for a given object. If no object is given, show a list "
"of all note objects and the objects they annotate (in the format "
"\"<note-object> <annotated-object>\").  This is the default subcommand if no "
"subcommand is given."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:62
#, no-wrap
msgid "add"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:73
msgid ""
"Add notes for a given object (defaults to HEAD). Abort if the object already "
"has notes (use `-f` to overwrite existing notes).  However, if you're using "
"`add` interactively (using an editor to supply the notes contents), then - "
"instead of aborting - the existing notes will be opened in the editor (like "
"the `edit` subcommand). If you specify multiple `-m` and `-F`, a blank line "
"will be inserted between the messages. Use the `--separator` option to "
"insert other delimiters. You can use `-e` to edit and fine-tune the "
"message(s) supplied from `-m` and `-F` options interactively (using an "
"editor) before adding the note."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:74
#, no-wrap
msgid "copy"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:80
msgid ""
"Copy the notes for the first object onto the second object (defaults to "
"HEAD). Abort if the second object already has notes, or if the first object "
"has none (use -f to overwrite existing notes to the second object). This "
"subcommand is equivalent to: `git notes add [-f] -C $(git notes list "
"<from-object>) <to-object>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:82
msgid "In `--stdin` mode, take lines in the format"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.txt:85
#, no-wrap
msgid "<from-object> SP <to-object> [ SP <rest> ] LF\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:90
msgid ""
"on standard input, and copy the notes from each <from-object> to its "
"corresponding <to-object>.  (The optional `<rest>` is ignored so that the "
"command can read the input given to the `post-rewrite` hook.)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:91
#, no-wrap
msgid "append"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:100
msgid ""
"Append new message(s) given by `-m` or `-F` options to an existing note, or "
"add them as a new note if one does not exist, for the object (defaults to "
"HEAD).  When appending to an existing note, a blank line is added before "
"each new message as an inter-paragraph separator.  The separator can be "
"customized with the `--separator` option.  Edit the notes to be appended "
"given by `-m` and `-F` options with `-e` interactively (using an editor) "
"before appending the note."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:101
#, no-wrap
msgid "edit"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:103
msgid "Edit the notes for a given object (defaults to HEAD)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:104
#, no-wrap
msgid "show"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:106
msgid "Show the notes for a given object (defaults to HEAD)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:107
#, no-wrap
msgid "merge"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:112
msgid ""
"Merge the given notes ref into the current notes ref.  This will try to "
"merge the changes made by the given notes ref (called \"remote\") since the "
"merge-base (if any) into the current notes ref (called \"local\")."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:121
msgid ""
"If conflicts arise and a strategy for automatically resolving conflicting "
"notes (see the \"NOTES MERGE STRATEGIES\" section) is not given, the "
"\"manual\" resolver is used. This resolver checks out the conflicting notes "
"in a special worktree (`.git/NOTES_MERGE_WORKTREE`), and instructs the user "
"to manually resolve the conflicts there.  When done, the user can either "
"finalize the merge with 'git notes merge --commit', or abort the merge with "
"'git notes merge --abort'."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:122
#, no-wrap
msgid "remove"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:127
msgid ""
"Remove the notes for given objects (defaults to HEAD). When giving zero or "
"one object from the command line, this is equivalent to specifying an empty "
"note message to the `edit` subcommand."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:128
#, no-wrap
msgid "prune"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:130
msgid "Remove all notes for non-existing/unreachable objects."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:131
#, no-wrap
msgid "get-ref"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:134
msgid ""
"Print the current notes ref. This provides an easy way to retrieve the "
"current notes ref (e.g. from scripts)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:136
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:141
#, no-wrap
msgid ""
"`-f::`\n"
"`--force::`\n"
"\tWhen adding notes to an object that already has notes,\n"
"\toverwrite the existing notes (instead of aborting).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:150
#, no-wrap
msgid ""
"`-m`\n"
"`--message=<msg>::`\n"
"\tUse the given note message (instead of prompting).\n"
"\tIf multiple `-m` options are given, their values\n"
"\tare concatenated as separate paragraphs.\n"
"\tLines starting with `#` and empty lines other than a\n"
"\tsingle line between paragraphs will be stripped out.\n"
"\tIf you wish to keep them verbatim, use `--no-stripspace`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:158
#, no-wrap
msgid ""
"`-F`\n"
"`--file=<file>::`\n"
"\tTake the note message from the given file.  Use '-' to\n"
"\tread the note message from the standard input.\n"
"\tLines starting with `#` and empty lines other than a\n"
"\tsingle line between paragraphs will be stripped out.\n"
"\tIf you wish to keep them verbatim, use `--no-stripspace`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:167
#, no-wrap
msgid ""
"`-C`\n"
"`--reuse-message=<object>::`\n"
"\tTake the given blob object (for example, another note) as the\n"
"\tnote message. (Use `git notes copy <object>` instead to\n"
"\tcopy notes between objects.).  By default, message will be\n"
"\tcopied verbatim, but if you wish to strip out the lines\n"
"\tstarting with `#` and empty lines other than a single line\n"
"\tbetween paragraphs, use with`--stripspace` option.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:172
#, no-wrap
msgid ""
"`-c`\n"
"`--reedit-message=<object>::`\n"
"\tLike '-C', but with `-c` the editor is invoked, so that\n"
"\tthe user can further edit the note message.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:176
#, no-wrap
msgid ""
"`--allow-empty::`\n"
"\tAllow an empty note object to be stored. The default behavior is\n"
"\tto automatically remove empty notes.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:182
#, no-wrap
msgid ""
"`--[no-]separator,`\n"
"\tSpecify a string used as a custom inter-paragraph separator\n"
"\t(a newline is added at the end as needed). If `--no-separator`, no\n"
"\tseparators will be added between paragraphs.  Defaults to a blank\n"
"\tline.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:189
#, no-wrap
msgid ""
"`--[no-]stripspace::`\n"
"\tStrip leading and trailing whitespace from the note message.\n"
"\tAlso strip out empty lines other than a single line between\n"
"\tparagraphs. Lines starting with `#` will be stripped out\n"
"\tin non-editor cases like `-m`, `-F` and `-C`, but not in\n"
"\teditor case like `git notes edit`, `-c`, etc.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:196
#, no-wrap
msgid ""
"`--ref`\n"
"\tManipulate the notes tree in <ref>.  This overrides\n"
"\t`GIT_NOTES_REF` and the \"core.notesRef\" configuration.  The ref\n"
"\tspecifies the full refname when it begins with `refs/notes/`; when it\n"
"\tbegins with `notes/`, `refs/` and otherwise `refs/notes/` is prefixed\n"
"\tto form a full name of the ref.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:200
#, no-wrap
msgid ""
"`--ignore-missing::`\n"
"\tDo not consider it an error to request removing notes from an\n"
"\tobject that does not have notes attached to it.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:205
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tAlso read the object names to remove notes from the standard\n"
"\tinput (there is no reason you cannot combine this with object\n"
"\tnames from the command line).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:210
#, no-wrap
msgid ""
"`-n::`\n"
"`--dry-run::`\n"
"\tDo not remove anything; just report the object names whose notes\n"
"\twould be removed.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:219
#, no-wrap
msgid ""
"`-s`\n"
"`--strategy=<strategy>::`\n"
"\tWhen merging notes, resolve notes conflicts using the given\n"
"\tstrategy. The following strategies are recognized: \"manual\"\n"
"\t(default), \"ours\", \"theirs\", \"union\" and \"cat_sort_uniq\".\n"
"\tThis option overrides the \"notes.mergeStrategy\" configuration setting.\n"
"\tSee the \"NOTES MERGE STRATEGIES\" section below for more\n"
"\tinformation on each notes merge strategy.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:228
#, no-wrap
msgid ""
"`--commit::`\n"
"\tFinalize an in-progress 'git notes merge'. Use this option\n"
"\twhen you have resolved the conflicts that 'git notes merge'\n"
"\tstored in .git/NOTES_MERGE_WORKTREE. This amends the partial\n"
"\tmerge commit created by 'git notes merge' (stored in\n"
"\t.git/NOTES_MERGE_PARTIAL) by adding the notes in\n"
"\t.git/NOTES_MERGE_WORKTREE. The notes ref stored in the\n"
"\t.git/NOTES_MERGE_REF symref is updated to the resulting commit.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:233
#, no-wrap
msgid ""
"`--abort::`\n"
"\tAbort/reset an in-progress 'git notes merge', i.e. a notes merge\n"
"\twith conflicts. This simply removes all files related to the\n"
"\tnotes merge.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:237
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tWhen merging notes, operate quietly.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:243
#, no-wrap
msgid ""
"`-v::`\n"
"`--verbose::`\n"
"\tWhen merging notes, be more verbose.\n"
"\tWhen pruning notes, report all object names whose notes are\n"
"\tremoved.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:246
#, no-wrap
msgid "DISCUSSION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:257
msgid ""
"Commit notes are blobs containing extra information about an object (usually "
"information to supplement a commit's message).  These blobs are taken from "
"notes refs.  A notes ref is usually a branch which contains \"files\" whose "
"paths are the object names for the objects they describe, with some "
"directory separators included for performance reasons footnote:[Permitted "
"pathnames have the form 'bf'`/`'fe'`/`'30'`/`'...'`/`'680d5a...': a sequence "
"of directory names of two hexadecimal digits each followed by a filename "
"with the rest of the object ID.]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:264
msgid ""
"Every notes change creates a new commit at the specified notes ref.  You can "
"therefore inspect the history of the notes by invoking, e.g., `git log -p "
"notes/commits`.  Currently the commit message only records which operation "
"triggered the update, and the commit authorship is determined according to "
"the usual rules (see linkgit:git-commit[1]).  These details may change in "
"the future."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:268
msgid ""
"It is also permitted for a notes ref to point directly to a tree object, in "
"which case the history of the notes can be read with `git log -p -g "
"<refname>`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:271
#, no-wrap
msgid "NOTES MERGE STRATEGIES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:280
msgid ""
"The default notes merge strategy is \"manual\", which checks out conflicting "
"notes in a special work tree for resolving notes conflicts "
"(`.git/NOTES_MERGE_WORKTREE`), and instructs the user to resolve the "
"conflicts in that work tree.  When done, the user can either finalize the "
"merge with 'git notes merge --commit', or abort the merge with 'git notes "
"merge --abort'."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:283
msgid ""
"Users may select an automated merge strategy from among the following using "
"either -s/--strategy option or configuring notes.mergeStrategy accordingly:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:286
msgid ""
"\"ours\" automatically resolves conflicting notes in favor of the local "
"version (i.e. the current notes ref)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:290
msgid ""
"\"theirs\" automatically resolves notes conflicts in favor of the remote "
"version (i.e. the given notes ref being merged into the current notes ref)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:293
msgid ""
"\"union\" automatically resolves notes conflicts by concatenating the local "
"and remote versions."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:303
msgid ""
"\"cat_sort_uniq\" is similar to \"union\", but in addition to concatenating "
"the local and remote versions, this strategy also sorts the resulting lines, "
"and removes duplicate lines from the result. This is equivalent to applying "
"the \"cat | sort | uniq\" shell pipeline to the local and remote "
"versions. This strategy is useful if the notes follow a line-based format "
"where one wants to avoid duplicated lines in the merge result.  Note that if "
"either the local or remote version contain duplicate lines prior to the "
"merge, these will also be removed by this notes merge strategy."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:306
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:310
msgid ""
"You can use notes to add annotations with information that was not available "
"at the time a commit was written."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.txt:316
#, no-wrap
msgid ""
"$ git notes add -m 'Tested-by: Johannes Sixt <j6t@kdbg.org>' 72a144e2\n"
"$ git show -s 72a144e\n"
"[...]\n"
"    Signed-off-by: Junio C Hamano <gitster@pobox.com>\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.txt:319
#, no-wrap
msgid ""
"Notes:\n"
"    Tested-by: Johannes Sixt <j6t@kdbg.org>\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:324
msgid ""
"In principle, a note is a regular Git blob, and any kind of (non-)format is "
"accepted.  You can binary-safely create notes from arbitrary files using "
"'git hash-object':"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-notes.txt:329
#, no-wrap
msgid ""
"$ cc *.c\n"
"$ blob=$(git hash-object -w a.out)\n"
"$ git notes --ref=built add --allow-empty -C \"$blob\" HEAD\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:336
msgid ""
"(You cannot simply use `git notes --ref=built add -F a.out HEAD` because "
"that is not binary-safe.)  Of course, it doesn't make much sense to display "
"non-text-format notes with 'git log', so if you use such notes, you'll "
"probably need to write some special-purpose tools to do something useful "
"with them."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:340
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:342
#, no-wrap
msgid "core.notesRef"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:347
msgid ""
"Notes ref to read and manipulate instead of `refs/notes/commits`.  Must be "
"an unabbreviated ref name.  This setting can be overridden through the "
"environment and command line."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:354
#, no-wrap
msgid "ENVIRONMENT"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:356
#, no-wrap
msgid "`GIT_NOTES_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:359
msgid ""
"Which ref to manipulate notes from, instead of `refs/notes/commits`.  This "
"overrides the `core.notesRef` setting."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:360
#, no-wrap
msgid "`GIT_NOTES_DISPLAY_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:366
msgid ""
"Colon-delimited list of refs or globs indicating which refs, in addition to "
"the default from `core.notesRef` or `GIT_NOTES_REF`, to read notes from when "
"showing commit messages.  This overrides the `notes.displayRef` setting."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:369
msgid ""
"A warning will be issued for refs that do not exist, but a glob that does "
"not match any refs is silently ignored."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:370
#, no-wrap
msgid "`GIT_NOTES_REWRITE_MODE`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:375
msgid ""
"When copying notes during a rewrite, what to do if the target commit already "
"has a note.  Must be one of `overwrite`, `concatenate`, `cat_sort_uniq`, or "
"`ignore`.  This overrides the `core.rewriteMode` setting."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-notes.txt:376
#, no-wrap
msgid "`GIT_NOTES_REWRITE_REF`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:380
msgid ""
"When rewriting commits, which notes to copy from the original to the "
"rewritten commit.  Must be a colon-delimited list of refs or globs."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:383
msgid ""
"If not set in the environment, the list of notes to copy depends on the "
"`notes.rewrite.<command>` and `notes.rewriteRef` settings."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-notes.txt:385
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-notes.txt:386
msgid "Part of the linkgit:git[1] suite"
msgstr ""
