#. type: Title =
#: ../Documentation-sedout/git-hash-object.txt:2
#, no-wrap
msgid "git-hash-object(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:7
msgid ""
"git-hash-object - Compute object ID and optionally create an object from a "
"file"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:15
#, no-wrap
msgid ""
"'git hash-object' [-t <type>] [-w] [--path=<file> | --no-filters]\n"
"\t\t[--stdin [--literally]] [--] <file>...\n"
"'git hash-object' [-t <type>] [-w] --stdin-paths [--no-filters]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:23
msgid ""
"Computes the object ID value for an object with specified type with the "
"contents of the named file (which can be outside of the work tree), and "
"optionally writes the resulting object into the object database.  Reports "
"its object ID to its standard output.  When <type> is not specified, it "
"defaults to \"blob\"."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.txt:25
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:30
#, no-wrap
msgid ""
"`-t`\n"
"\tSpecify the type of object to be created (default: \"blob\"). Possible\n"
"\tvalues are `commit`, `tree`, `blob`, and `tag`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:33
#, no-wrap
msgid ""
"`-w::`\n"
"\tActually write the object into the object database.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:36
#, no-wrap
msgid ""
"`--stdin::`\n"
"\tRead the object from standard input instead of from a file.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:40
#, no-wrap
msgid ""
"`--stdin-paths::`\n"
"\tRead file names from the standard input, one per line, instead\n"
"\tof from the command-line.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:50
#, no-wrap
msgid ""
"`--path::`\n"
"\tHash object as if it were located at the given path. The location of\n"
"\tthe file does not directly influence the hash value, but the path is\n"
"\tused to determine which Git filters should be applied to the object\n"
"\tbefore it can be placed in the object database.  As a result of\n"
"\tapplying filters, the actual blob put into the object database may\n"
"\tdiffer from the given file. This option is mainly useful for hashing\n"
"\ttemporary files located outside of the working directory or files\n"
"\tread from stdin.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:56
#, no-wrap
msgid ""
"`--no-filters::`\n"
"\tHash the contents as is, ignoring any input filter that would\n"
"\thave been chosen by the attributes mechanism, including the end-of-line\n"
"\tconversion. If the file is read from standard input then this\n"
"\tis always implied, unless the `--path` option is given.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.txt:62
#, no-wrap
msgid ""
"`--literally::`\n"
"\tAllow `--stdin` to hash any garbage into a loose object which might not\n"
"\totherwise pass standard object parsing or git-fsck checks. Useful for\n"
"\tstress-testing Git itself or reproducing characteristics of corrupt or\n"
"\tbogus objects encountered in the wild.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.txt:64
#, no-wrap
msgid "GIT"
msgstr ""

