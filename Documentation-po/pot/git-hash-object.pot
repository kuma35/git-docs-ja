#. type: Title =
#: ../Documentation-sedout/git-hash-object.adoc:2
#, no-wrap
msgid "git-hash-object(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:7
msgid ""
"git-hash-object - Compute object ID and optionally create an object from a "
"file"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:15
#, no-wrap
msgid ""
"\t'git hash-object' [-t <type>] [-w] [--path=<file> | --no-filters]\n"
"\t\t\t[--stdin [--literally]] [--] <file>...\n"
"\t'git hash-object' [-t <type>] [-w] --stdin-paths [--no-filters]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.adoc:17
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:23
msgid ""
"Computes the object ID value for an object with specified type with the "
"contents of the named file (which can be outside of the work tree), and "
"optionally writes the resulting object into the object database.  Reports "
"its object ID to its standard output.  When <type> is not specified, it "
"defaults to \"blob\"."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.adoc:25
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:27
#, no-wrap
msgid "`-t <type>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:30
msgid ""
"Specify the type of object to be created (default: \"blob\"). Possible "
"values are `commit`, `tree`, `blob`, and `tag`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:31
#, no-wrap
msgid "`-w`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:33
msgid "Actually write the object into the object database."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:34
#, no-wrap
msgid "`--stdin`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:36
msgid "Read the object from standard input instead of from a file."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:37
#, no-wrap
msgid "`--stdin-paths`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:40
msgid ""
"Read file names from the standard input, one per line, instead of from the "
"command-line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:41
#, no-wrap
msgid "`--path`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:50
msgid ""
"Hash object as if it were located at the given path. The location of the "
"file does not directly influence the hash value, but the path is used to "
"determine which Git filters should be applied to the object before it can be "
"placed in the object database.  As a result of applying filters, the actual "
"blob put into the object database may differ from the given file. This "
"option is mainly useful for hashing temporary files located outside of the "
"working directory or files read from stdin."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:51
#, no-wrap
msgid "`--no-filters`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:56
msgid ""
"Hash the contents as is, ignoring any input filter that would have been "
"chosen by the attributes mechanism, including the end-of-line conversion. If "
"the file is read from standard input then this is always implied, unless the "
"`--path` option is given."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-hash-object.adoc:57
#, no-wrap
msgid "`--literally`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:62
msgid ""
"Allow `--stdin` to hash any garbage into a loose object which might not "
"otherwise pass standard object parsing or git-fsck checks. Useful for "
"stress-testing Git itself or reproducing characteristics of corrupt or bogus "
"objects encountered in the wild."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-hash-object.adoc:64
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-hash-object.adoc:65
msgid "Part of the linkgit:git[1] suite"
msgstr ""
