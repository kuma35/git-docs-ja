#. type: Title =
#: ../Documentation-sedout/git-am.adoc:2
#, no-wrap
msgid "git-am(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:7
msgid "git-am - Apply a series of patches from a mailbox"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:22
#, no-wrap
msgid ""
"'git am' [--signoff] [--keep] [--[no-]keep-cr] [--[no-]utf8] [--no-verify]\n"
"\t [--[no-]3way] [--interactive] [--committer-date-is-author-date]\n"
"\t [--ignore-date] [--ignore-space-change | --ignore-whitespace]\n"
"\t [--whitespace=<action>] [-C<n>] [-p<n>] [--directory=<dir>]\n"
"\t [--exclude=<path>] [--include=<path>] [--reject] [-q | --quiet]\n"
"\t [--[no-]scissors] [-S[<keyid>]] [--patch-format=<format>]\n"
"\t [--quoted-cr=<action>]\n"
"\t [--empty=(stop|drop|keep)]\n"
"\t [(<mbox> | <Maildir>)...]\n"
"'git am' (--continue | --skip | --abort | --quit | --retry | "
"--show-current-patch[=(diff|raw)] | --allow-empty)\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:24
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:30
msgid ""
"Splits mail messages in a mailbox into commit log messages, authorship "
"information, and patches, and applies them to the current branch. You could "
"think of it as a reverse operation of linkgit:git-format-patch[1] run on a "
"branch with a straight history without merges."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:32
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:33
#, no-wrap
msgid "(<mbox>|<Maildir>)..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:37
msgid ""
"The list of mailbox files to read patches from. If you do not supply this "
"argument, the command reads from the standard input.  If you supply "
"directories, they will be treated as Maildirs."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:38
#, no-wrap
msgid "`-s`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:39
#, no-wrap
msgid "`--signoff`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:43
msgid ""
"Add a `Signed-off-by` trailer to the commit message, using the committer "
"identity of yourself.  See the signoff option in linkgit:git-commit[1] for "
"more information."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:44
#, no-wrap
msgid "`-k`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:45
#, no-wrap
msgid "`--keep`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:47
msgid "Pass `-k` flag to 'git mailinfo' (see linkgit:git-mailinfo[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:48
#, no-wrap
msgid "`--keep-non-patch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:50
msgid "Pass `-b` flag to 'git mailinfo' (see linkgit:git-mailinfo[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:51
#, no-wrap
msgid "`--keep-cr`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:52
#, no-wrap
msgid "`--no-keep-cr`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:57
msgid ""
"With `--keep-cr`, call 'git mailsplit' (see linkgit:git-mailsplit[1])  with "
"the same option, to prevent it from stripping CR at the end of "
"lines. `am.keepcr` configuration variable can be used to specify the default "
"behaviour.  `--no-keep-cr` is useful to override `am.keepcr`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:58
#, no-wrap
msgid "`-c`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:59
#, no-wrap
msgid "`--scissors`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:63
msgid ""
"Remove everything in body before a scissors line (see "
"linkgit:git-mailinfo[1]). Can be activated by default using the "
"`mailinfo.scissors` configuration variable."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:64
#, no-wrap
msgid "`--no-scissors`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:66
msgid "Ignore scissors lines (see linkgit:git-mailinfo[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:67
#, no-wrap
msgid "`--quoted-cr=<action>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:69
msgid ""
"This flag will be passed down to 'git mailinfo' (see "
"linkgit:git-mailinfo[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:70
#, no-wrap
msgid "`--empty=(drop|keep|stop)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:72
msgid "How to handle an e-mail message lacking a patch:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:74
#, no-wrap
msgid "`drop`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:76
msgid "The e-mail message will be skipped."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:76
#, no-wrap
msgid "`keep`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:79
msgid ""
"An empty commit will be created, with the contents of the e-mail message as "
"its log."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:79
#, no-wrap
msgid "`stop`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:82
msgid ""
"The command will fail, stopping in the middle of the current `am` "
"session. This is the default behavior."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:84
#, no-wrap
msgid "`-m`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:85
#, no-wrap
msgid "`--message-id`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:90
msgid ""
"Pass the `-m` flag to 'git mailinfo' (see linkgit:git-mailinfo[1]), so that "
"the Message-ID header is added to the commit message.  The `am.messageid` "
"configuration variable can be used to specify the default behaviour."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:91
#, no-wrap
msgid "`--no-message-id`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:94
msgid ""
"Do not add the Message-ID header to the commit message.  `no-message-id` is "
"useful to override `am.messageid`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:95
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:96
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:98
msgid "Be quiet. Only print error messages."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:99
#, no-wrap
msgid "`-u`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:100
#, no-wrap
msgid "`--utf8`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:106
msgid ""
"Pass `-u` flag to 'git mailinfo' (see linkgit:git-mailinfo[1]).  The "
"proposed commit log message taken from the e-mail is re-coded into UTF-8 "
"encoding (configuration variable `i18n.commitEncoding` can be used to "
"specify the project's preferred encoding if it is not UTF-8)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:109
#, no-wrap
msgid ""
"This was optional in prior versions of git, but now it is the\n"
"default.   You can use `--no-utf8` to override this.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:110
#, no-wrap
msgid "`--no-utf8`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:113
msgid "Pass `-n` flag to 'git mailinfo' (see linkgit:git-mailinfo[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:114
#, no-wrap
msgid "`-3`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:115
#, no-wrap
msgid "`--3way`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:116
#, no-wrap
msgid "`--no-3way`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:123
msgid ""
"When the patch does not apply cleanly, fall back on 3-way merge if the patch "
"records the identity of blobs it is supposed to apply to and we have those "
"blobs available locally. `--no-3way` can be used to override am.threeWay "
"configuration variable. For more information, see am.threeWay in "
"linkgit:git-config[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:126
#, no-wrap
msgid "`--ignore-space-change`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:127
#, no-wrap
msgid "`--ignore-whitespace`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:128
#, no-wrap
msgid "`--whitespace=<action>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:129
#, no-wrap
msgid "`-C<n>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:130
#, no-wrap
msgid "`-p<n>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:131
#, no-wrap
msgid "`--directory=<dir>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:132
#, no-wrap
msgid "`--exclude=<path>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:133
#, no-wrap
msgid "`--include=<path>`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:134
#, no-wrap
msgid "`--reject`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:138
msgid ""
"These flags are passed to the 'git apply' (see linkgit:git-apply[1])  "
"program that applies the patch."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:141
msgid ""
"Valid <action> for the `--whitespace` option are: `nowarn`, `warn`, `fix`, "
"`error`, and `error-all`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:142
#, no-wrap
msgid "`--patch-format`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:148
msgid ""
"By default the command will try to detect the patch format "
"automatically. This option allows the user to bypass the automatic detection "
"and specify the patch format that the patch(es) should be interpreted "
"as. Valid formats are mbox, mboxrd, stgit, stgit-series, and hg."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:149
#, no-wrap
msgid "`-i`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:150
#, no-wrap
msgid "`--interactive`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:152
msgid "Run interactively."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:153
#, no-wrap
msgid "`-n`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:154
#, no-wrap
msgid "`--no-verify`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:158
msgid ""
"By default, the pre-applypatch and applypatch-msg hooks are run.  When any "
"of `--no-verify` or `-n` is given, these are bypassed.  See also "
"linkgit:githooks[5]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:159
#, no-wrap
msgid "`--committer-date-is-author-date`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:165
msgid ""
"By default the command records the date from the e-mail message as the "
"commit author date, and uses the time of commit creation as the committer "
"date. This allows the user to lie about the committer date by using the same "
"value as the author date."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:166
#, no-wrap
msgid "`--ignore-date`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:172
msgid ""
"By default the command records the date from the e-mail message as the "
"commit author date, and uses the time of commit creation as the committer "
"date. This allows the user to lie about the author date by using the same "
"value as the committer date."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:173
#, no-wrap
msgid "`--skip`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:176
msgid ""
"Skip the current patch.  This is only meaningful when restarting an aborted "
"patch."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:177
#, no-wrap
msgid "`-S[<keyid>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:178
#, no-wrap
msgid "`--gpg-sign[=<keyid>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:179
#, no-wrap
msgid "`--no-gpg-sign`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:185
msgid ""
"GPG-sign commits. The `keyid` argument is optional and defaults to the "
"committer identity; if specified, it must be stuck to the option without a "
"space. `--no-gpg-sign` is useful to countermand both `commit.gpgSign` "
"configuration variable, and earlier `--gpg-sign`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:186
#, no-wrap
msgid "`--continue`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:187
#, no-wrap
msgid "`-r`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:188
#, no-wrap
msgid "`--resolved`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:195
msgid ""
"After a patch failure (e.g. attempting to apply conflicting patch), the user "
"has applied it by hand and the index file stores the result of the "
"application.  Make a commit using the authorship and commit log extracted "
"from the e-mail message and the current index file, and continue."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:196
#, no-wrap
msgid "`--resolvemsg=<msg>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:202
msgid ""
"When a patch failure occurs, <msg> will be printed to the screen before "
"exiting.  This overrides the standard message informing you to use "
"`--continue` or `--skip` to handle the failure.  This is solely for internal "
"use between 'git rebase' and 'git am'."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:203
#, no-wrap
msgid "`--abort`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:207
msgid ""
"Restore the original branch and abort the patching operation.  Revert the "
"contents of files involved in the am operation to their pre-am state."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:208
#, no-wrap
msgid "`--quit`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:211
msgid "Abort the patching operation but keep HEAD and the index untouched."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:212
#, no-wrap
msgid "`--retry`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:217
msgid ""
"Try to apply the last conflicting patch again. This is generally only useful "
"for passing extra options to the retry attempt (e.g., `--3way`), since "
"otherwise you'll just see the same failure again."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:218
#, no-wrap
msgid "`--show-current-patch[=(diff|raw)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:223
msgid ""
"Show the message at which `git am` has stopped due to conflicts.  If `raw` "
"is specified, show the raw contents of the e-mail message; if `diff`, show "
"the diff portion only.  Defaults to `raw`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-am.adoc:224
#, no-wrap
msgid "`--allow-empty`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:228
msgid ""
"After a patch failure on an input e-mail message lacking a patch, create an "
"empty commit with the contents of the e-mail message as its log message."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:230
#, no-wrap
msgid "DISCUSSION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:238
msgid ""
"The commit author name is taken from the \"From: \" line of the message, and "
"commit author date is taken from the \"Date: \" line of the message.  The "
"\"Subject: \" line is used as the title of the commit, after stripping "
"common prefix \"[PATCH <anything>]\".  The \"Subject: \" line is supposed to "
"concisely describe what the commit is about in one line of text."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:241
msgid ""
"\"From: \", \"Date: \", and \"Subject: \" lines starting the body override "
"the respective commit author name and title values taken from the headers."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:246
msgid ""
"The commit message is formed by the title taken from the \"Subject: \", a "
"blank line and the body of the message up to where the patch begins.  Excess "
"whitespace at the end of each line is automatically stripped."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:249
msgid ""
"The patch is expected to be inline, directly following the message.  Any "
"line that is of the form:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:251
msgid "three-dashes and end-of-line, or"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:252
msgid "a line that begins with \"diff -\", or"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:253
msgid "a line that begins with \"Index: \""
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:256
msgid ""
"is taken as the beginning of a patch, and the commit log message is "
"terminated before the first occurrence of such a line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:260
msgid ""
"When initially invoking `git am`, you give it the names of the mailboxes to "
"process.  Upon seeing the first patch that does not apply, it aborts in the "
"middle.  You can recover from this in one of two ways:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:263
msgid "skip the current patch by re-running the command with the `--skip` option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:267
msgid ""
"hand resolve the conflict in the working directory, and update the index "
"file to bring it into a state that the patch should have produced.  Then run "
"the command with the `--continue` option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:272
msgid ""
"The command refuses to process new mailboxes until the current operation is "
"finished, so if you decide to start over from scratch, run `git am --abort` "
"before running the command with mailbox names."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:278
msgid ""
"Before any patches are applied, ORIG_HEAD is set to the tip of the current "
"branch.  This is useful if you have problems with multiple commits, like "
"running 'git am' on the wrong branch or an error in the commits that is more "
"easily fixed by changing the mailbox (e.g.  errors in the \"From:\" lines)."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:280
#, no-wrap
msgid "HOOKS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:284
msgid ""
"This command can run `applypatch-msg`, `pre-applypatch`, and "
"`post-applypatch` hooks.  See linkgit:githooks[5] for more information."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:286
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:293
#, no-wrap
msgid "SEE ALSO"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:296
msgid "linkgit:git-apply[1], linkgit:git-format-patch[1]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-am.adoc:298
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-am.adoc:299
msgid "Part of the linkgit:git[1] suite"
msgstr ""
