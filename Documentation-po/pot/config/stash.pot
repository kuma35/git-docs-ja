#. type: Labeled list
#: ../Documentation-sedout/config/stash.adoc:9
#, no-wrap
msgid "`stash.index`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:12
msgid ""
"If this is set to true, `git stash apply` and `git stash pop` will behave as "
"if `--index` was supplied. Defaults to false."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:14
msgid "See the descriptions in linkgit:git-stash[1]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:18
msgid ""
"This also affects invocations of linkgit:git-stash[1] via `--autostash` from "
"commands like linkgit:git-merge[1], linkgit:git-rebase[1], and "
"linkgit:git-pull[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/stash.adoc:20
#, no-wrap
msgid "`stash.showIncludeUntracked`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:23
msgid ""
"If this is set to true, the `git stash show` command will show the untracked "
"files of a stash entry. Defaults to false. {see-show}"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/stash.adoc:24
#, no-wrap
msgid "`stash.showPatch`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:28
msgid ""
"If this is set to true, the `git stash show` command without an option will "
"show the stash entry in patch form.  Defaults to false.  {see-show}"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/stash.adoc:29
#, no-wrap
msgid "`stash.showStat`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/stash.adoc:32
msgid ""
"If this is set to true, the `git stash show` command without an option will "
"show a diffstat of the stash entry.  Defaults to true.  {see-show}"
msgstr ""
