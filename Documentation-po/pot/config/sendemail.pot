#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:1
#, no-wrap
msgid "sendemail.identity"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:6
msgid ""
"A configuration identity. When given, causes values in the "
"`sendemail.<identity>` subsection to take precedence over values in the "
"`sendemail` section. The default identity is the value of "
"`sendemail.identity`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:7
#, no-wrap
msgid "sendemail.smtpEncryption"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:10
msgid ""
"See linkgit:git-send-email[1] for description.  Note that this setting is "
"not subject to the `identity` mechanism."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:11
#, no-wrap
msgid "sendemail.smtpSSLCertPath"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:14
msgid ""
"Path to ca-certificates (either a directory or a single file).  Set it to an "
"empty string to disable certificate verification."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:15
#, no-wrap
msgid "sendemail.<identity>.*"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:20
msgid ""
"Identity-specific versions of the `sendemail.*` parameters found below, "
"taking precedence over those when this identity is selected, through either "
"the command-line or `sendemail.identity`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:21
#, no-wrap
msgid "sendemail.multiEdit"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:26
msgid ""
"If `true` (default), a single editor instance will be spawned to edit files "
"you have to edit (patches when `--annotate` is used, and the summary when "
"`--compose` is used). If `false`, files will be edited one after the other, "
"spawning a new editor each time."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:27
#, no-wrap
msgid "sendemail.confirm"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:32
msgid ""
"Sets the default for whether to confirm before sending. Must be one of "
"`always`, `never`, `cc`, `compose`, or `auto`. See `--confirm` in the "
"linkgit:git-send-email[1] documentation for the meaning of these values."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:33
#, no-wrap
msgid "sendemail.mailmap"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:36
msgid ""
"If `true`, makes linkgit:git-send-email[1] assume `--mailmap`, otherwise "
"assume `--no-mailmap`. `False` by default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:37
#, no-wrap
msgid "sendemail.mailmap.file"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:42
msgid ""
"The location of a linkgit:git-send-email[1] specific augmenting mailmap "
"file. The default mailmap and `mailmap.file` are loaded first. Thus, entries "
"in this file take precedence over entries in the default mailmap "
"locations. See linkgit:gitmailmap[5]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:43
#, no-wrap
msgid "sendemail.mailmap.blob"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:47
msgid ""
"Like `sendemail.mailmap.file`, but consider the value as a reference to a "
"blob in the repository. Entries in `sendemail.mailmap.file` take precedence "
"over entries here. See linkgit:gitmailmap[5]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:48
#, no-wrap
msgid "sendemail.aliasesFile"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:51
msgid ""
"To avoid typing long email addresses, point this to one or more email "
"aliases files.  You must also supply `sendemail.aliasFileType`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:52
#, no-wrap
msgid "sendemail.aliasFileType"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:55
msgid ""
"Format of the file(s) specified in sendemail.aliasesFile. Must be one of "
"`mutt`, `mailrc`, `pine`, `elm`, `gnus`, or `sendmail`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:60
msgid ""
"What an alias file in each format looks like can be found in the "
"documentation of the email program of the same name. The differences and "
"limitations from the standard formats are described below:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:62
#, no-wrap
msgid "sendmail"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:65
msgid ""
"Quoted aliases and quoted addresses are not supported: lines that contain a "
"`\"` symbol are ignored."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:67
msgid "Redirection to a file (`/path/name`) or pipe (`|command`) is not supported."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:68
msgid "File inclusion (`:include: /path/name`) is not supported."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:71
msgid ""
"Warnings are printed on the standard error output for any explicitly "
"unsupported constructs, and any other lines that are not recognized by the "
"parser."
msgstr ""

