#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:100
msgid ""
"These configuration variables all provide a default for "
"linkgit:git-send-email[1] command-line options. See its documentation for "
"details."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:101
#, no-wrap
msgid "sendemail.outlookidfix"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:105
msgid ""
"If `true`, makes linkgit:git-send-email[1] assume `--outlook-id-fix`, and if "
"`false` assume `--no-outlook-id-fix`. If not specified, it will behave the "
"same way as if `--outlook-id-fix` is not specified."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:106
#, no-wrap
msgid "sendemail.signedOffCc (deprecated)"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:108
msgid "Deprecated alias for `sendemail.signedOffByCc`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:109
#, no-wrap
msgid "sendemail.smtpBatchSize"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:114
msgid ""
"Number of messages to be sent per connection, after that a relogin will "
"happen.  If the value is `0` or undefined, send all messages in one "
"connection.  See also the `--batch-size` option of "
"linkgit:git-send-email[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:115
#, no-wrap
msgid "sendemail.smtpReloginDelay"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:118
msgid ""
"Seconds to wait before reconnecting to the smtp server.  See also the "
"`--relogin-delay` option of linkgit:git-send-email[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/sendemail.adoc:119
#, no-wrap
msgid "sendemail.forbidSendmailVariables"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/sendemail.adoc:122
msgid ""
"To avoid common misconfiguration mistakes, linkgit:git-send-email[1] will "
"abort with a warning if any configuration options for `sendmail` exist. Set "
"this variable to bypass the check."
msgstr ""
