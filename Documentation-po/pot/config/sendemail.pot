#. type: Labeled list
#: ../Documentation/config/sendemail.txt:102
#, no-wrap
msgid "sendemail.smtpBatchSize"
msgstr ""

#. type: Plain text
#: ../Documentation/config/sendemail.txt:107
msgid ""
"Number of messages to be sent per connection, after that a relogin will "
"happen.  If the value is 0 or undefined, send all messages in one "
"connection.  See also the `--batch-size` option of "
"linkgit:git-send-email[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/sendemail.txt:108
#, no-wrap
msgid "sendemail.smtpReloginDelay"
msgstr ""

#. type: Plain text
#: ../Documentation/config/sendemail.txt:111
msgid ""
"Seconds to wait before reconnecting to the smtp server.  See also the "
"`--relogin-delay` option of linkgit:git-send-email[1]."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/sendemail.txt:112
#, no-wrap
msgid "sendemail.forbidSendmailVariables"
msgstr ""

#. type: Plain text
#: ../Documentation/config/sendemail.txt:115
msgid ""
"To avoid common misconfiguration mistakes, linkgit:git-send-email[1] will "
"abort with a warning if any configuration options for \"sendmail\" "
"exist. Set this variable to bypass the check."
msgstr ""
