#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:1
#, no-wrap
msgid "`log.abbrevCommit`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:3
msgid "If `true`, make"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:6
#, no-wrap
msgid ""
"\tlinkgit:git-log[1], linkgit:git-show[1], and\n"
"\tlinkgit:git-whatchanged[1]\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:9
#, no-wrap
msgid "\tlinkgit:git-log[1] and linkgit:git-show[1]\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:12
#, no-wrap
msgid ""
"\tassume `--abbrev-commit`. You may\n"
"\toverride this option with `--no-abbrev-commit`.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:13
#, no-wrap
msgid "`log.date`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:17
msgid ""
"Set the default date-time mode for the `log` command.  Setting a value for "
"log.date is similar to using `git log`'s `--date` option.  See "
"linkgit:git-log[1] for details."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:21
msgid ""
"If the format is set to \"auto:foo\" and the pager is in use, format \"foo\" "
"will be used for the date format. Otherwise, \"default\" will be used."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:22
#, no-wrap
msgid "`log.decorate`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:25
msgid ""
"Print out the ref names of any commits that are shown by the log "
"command. Possible values are:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:27
#, no-wrap
msgid "`short`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:29
msgid ""
"the ref name prefixes `refs/heads/`, `refs/tags/` and `refs/remotes/` are "
"not printed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:29
#, no-wrap
msgid "`full`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:30
msgid "the full ref name (including prefix) are printed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:30
#, no-wrap
msgid "`auto`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:33
msgid ""
"if the output is going to a terminal, the ref names are shown as if `short` "
"were given, otherwise no ref names are shown."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:36
msgid "This is the same as the `--decorate` option of the `git log`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:37
#, no-wrap
msgid "`log.initialDecorationSet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:41
msgid ""
"By default, `git log` only shows decorations for certain known ref "
"namespaces. If 'all' is specified, then show all refs as decorations."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:42
#, no-wrap
msgid "`log.excludeDecoration`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:47
msgid ""
"Exclude the specified patterns from the log decorations. This is similar to "
"the `--decorate-refs-exclude` command-line option, but the config option can "
"be overridden by the `--decorate-refs` option."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:48
#, no-wrap
msgid "`log.diffMerges`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:52
msgid ""
"Set diff format to be used when `--diff-merges=on` is specified, see "
"`--diff-merges` in linkgit:git-log[1] for details. Defaults to `separate`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:53
#, no-wrap
msgid "`log.follow`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:58
msgid ""
"If `true`, `git log` will act as if the `--follow` option was used when a "
"single <path> is given.  This has the same limitations as `--follow`, "
"i.e. it cannot be used to follow multiple files and does not work well on "
"non-linear history."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:59
#, no-wrap
msgid "`log.graphColors`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:62
msgid ""
"A list of colors, separated by commas, that can be used to draw history "
"lines in `git log --graph`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:63
#, no-wrap
msgid "`log.showRoot`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:68
msgid ""
"If true, the initial commit will be shown as a big creation event.  This is "
"equivalent to a diff against an empty tree.  Tools like linkgit:git-log[1] "
"or linkgit:git-whatchanged[1], which normally hide the root commit will now "
"show it. True by default."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:69
#, no-wrap
msgid "`log.showSignature`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:72
msgid ""
"If true, makes linkgit:git-log[1], linkgit:git-show[1], and "
"linkgit:git-whatchanged[1] assume `--show-signature`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/config/log.adoc:73
#, no-wrap
msgid "`log.mailmap`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/config/log.adoc:76
msgid ""
"If true, makes linkgit:git-log[1], linkgit:git-show[1], and "
"linkgit:git-whatchanged[1] assume `--use-mailmap`, otherwise assume "
"`--no-use-mailmap`. True by default."
msgstr ""
