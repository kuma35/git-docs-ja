#. type: Labeled list
#: ../Documentation/config/log.txt:1
#, no-wrap
msgid "log.abbrevCommit"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:5
msgid ""
"If true, makes linkgit:git-log[1], linkgit:git-show[1], and "
"linkgit:git-whatchanged[1] assume `--abbrev-commit`. You may override this "
"option with `--no-abbrev-commit`."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:6
#, no-wrap
msgid "log.date"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:10
msgid ""
"Set the default date-time mode for the 'log' command.  Setting a value for "
"log.date is similar to using 'git log''s `--date` option.  See "
"linkgit:git-log[1] for details."
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:14
msgid ""
"If the format is set to \"auto:foo\" and the pager is in use, format \"foo\" "
"will be used for the date format. Otherwise, \"default\" will be used."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:15
#, no-wrap
msgid "log.decorate"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:24
msgid ""
"Print out the ref names of any commits that are shown by the log command. If "
"'short' is specified, the ref name prefixes 'refs/heads/', 'refs/tags/' and "
"'refs/remotes/' will not be printed. If 'full' is specified, the full ref "
"name (including prefix) will be printed.  If 'auto' is specified, then if "
"the output is going to a terminal, the ref names are shown as if 'short' "
"were given, otherwise no ref names are shown. This is the same as the "
"`--decorate` option of the `git log`."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:25
#, no-wrap
msgid "log.initialDecorationSet"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:29
msgid ""
"By default, `git log` only shows decorations for certain known ref "
"namespaces. If 'all' is specified, then show all refs as decorations."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:30
#, no-wrap
msgid "log.excludeDecoration"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:35
msgid ""
"Exclude the specified patterns from the log decorations. This is similar to "
"the `--decorate-refs-exclude` command-line option, but the config option can "
"be overridden by the `--decorate-refs` option."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:36
#, no-wrap
msgid "log.diffMerges"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:40
msgid ""
"Set diff format to be used when `--diff-merges=on` is specified, see "
"`--diff-merges` in linkgit:git-log[1] for details. Defaults to `separate`."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:41
#, no-wrap
msgid "log.follow"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:46
msgid ""
"If `true`, `git log` will act as if the `--follow` option was used when a "
"single <path> is given.  This has the same limitations as `--follow`, "
"i.e. it cannot be used to follow multiple files and does not work well on "
"non-linear history."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:47
#, no-wrap
msgid "log.graphColors"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:50
msgid ""
"A list of colors, separated by commas, that can be used to draw history "
"lines in `git log --graph`."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:51
#, no-wrap
msgid "log.showRoot"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:56
msgid ""
"If true, the initial commit will be shown as a big creation event.  This is "
"equivalent to a diff against an empty tree.  Tools like linkgit:git-log[1] "
"or linkgit:git-whatchanged[1], which normally hide the root commit will now "
"show it. True by default."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:57
#, no-wrap
msgid "log.showSignature"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:60
msgid ""
"If true, makes linkgit:git-log[1], linkgit:git-show[1], and "
"linkgit:git-whatchanged[1] assume `--show-signature`."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/log.txt:61
#, no-wrap
msgid "log.mailmap"
msgstr ""

#. type: Plain text
#: ../Documentation/config/log.txt:64
msgid ""
"If true, makes linkgit:git-log[1], linkgit:git-show[1], and "
"linkgit:git-whatchanged[1] assume `--use-mailmap`, otherwise assume "
"`--no-use-mailmap`. True by default."
msgstr ""
