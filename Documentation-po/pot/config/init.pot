#. type: Labeled list
#: ../Documentation/config/init.txt:6
#, no-wrap
msgid "`init.templateDir`"
msgstr ""

#. type: Plain text
#: ../Documentation/config/init.txt:8
msgid "Specify the directory from which templates will be copied. {see-git-init}"
msgstr ""

#. type: Labeled list
#: ../Documentation/config/init.txt:8
#, no-wrap
msgid "`init.defaultBranch`"
msgstr ""

#. type: Plain text
#: ../Documentation/config/init.txt:11
msgid ""
"Allows overriding the default branch name e.g. when initializing a new "
"repository."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/init.txt:11
#, no-wrap
msgid "`init.defaultObjectFormat`"
msgstr ""

#. type: Plain text
#: ../Documentation/config/init.txt:16
msgid ""
"Allows overriding the default object format for new repositories. See "
"`--object-format=` in linkgit:git-init[1]. Both the command line option and "
"the `GIT_DEFAULT_HASH` environment variable take precedence over this "
"config."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/init.txt:16
#, no-wrap
msgid "`init.defaultRefFormat`"
msgstr ""

#. type: Plain text
#: ../Documentation/config/init.txt:20
msgid ""
"Allows overriding the default ref storage format for new repositories.  See "
"`--ref-format=` in linkgit:git-init[1]. Both the command line option and the "
"`GIT_DEFAULT_REF_FORMAT` environment variable take precedence over this "
"config."
msgstr ""
