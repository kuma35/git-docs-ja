#. type: Labeled list
#: ../Documentation/config/difftool.txt:1
#, no-wrap
msgid "diff.tool"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:7
msgid ""
"Controls which diff tool is used by linkgit:git-difftool[1].  This variable "
"overrides the value configured in `merge.tool`.  The list below shows the "
"valid built-in values.  Any other value is treated as a custom diff tool and "
"requires that a corresponding difftool.<tool>.cmd variable is defined."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:8
#, no-wrap
msgid "diff.guitool"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:15
msgid ""
"Controls which diff tool is used by linkgit:git-difftool[1] when the "
"-g/--gui flag is specified. This variable overrides the value configured in "
"`merge.guitool`. The list below shows the valid built-in values. Any other "
"value is treated as a custom diff tool and requires that a corresponding "
"difftool.<guitool>.cmd variable is defined."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:16
#, no-wrap
msgid "difftool.<tool>.cmd"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:23
msgid ""
"Specify the command to invoke the specified diff tool.  The specified "
"command is evaluated in shell with the following variables available: "
"'LOCAL' is set to the name of the temporary file containing the contents of "
"the diff pre-image and 'REMOTE' is set to the name of the temporary file "
"containing the contents of the diff post-image."
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:25
msgid "See the `--tool=<tool>` option in linkgit:git-difftool[1] for more details."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:26
#, no-wrap
msgid "difftool.<tool>.path"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:29
msgid ""
"Override the path for the given tool.  This is useful in case your tool is "
"not in the PATH."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:30
#, no-wrap
msgid "difftool.trustExitCode"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:32
msgid "Exit difftool if the invoked diff tool returns a non-zero exit status."
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:34
msgid ""
"See the `--trust-exit-code` option in linkgit:git-difftool[1] for more "
"details."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:35
#, no-wrap
msgid "difftool.prompt"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:37
msgid "Prompt before each invocation of the diff tool."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/difftool.txt:38
#, no-wrap
msgid "difftool.guiDefault"
msgstr ""

#. type: Plain text
#: ../Documentation/config/difftool.txt:43
msgid ""
"Set `true` to use the `diff.guitool` by default (equivalent to specifying "
"the `--gui` argument), or `auto` to select `diff.guitool` or `diff.tool` "
"depending on the presence of a `DISPLAY` environment variable value. The "
"default is `false`, where the `--gui` argument must be provided explicitly "
"for the `diff.guitool` to be used."
msgstr ""
