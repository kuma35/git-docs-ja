#. type: Labeled list
#: ../Documentation/config/grep.txt:1
#, no-wrap
msgid "grep.lineNumber"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:3
msgid "If set to true, enable `-n` option by default."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:4
#, no-wrap
msgid "grep.column"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:6
msgid "If set to true, enable the `--column` option by default."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:7
#, no-wrap
msgid "grep.patternType"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:13
msgid ""
"Set the default matching behavior. Using a value of 'basic', 'extended', "
"'fixed', or 'perl' will enable the `--basic-regexp`, `--extended-regexp`, "
"`--fixed-strings`, or `--perl-regexp` option accordingly, while the value "
"'default' will use the `grep.extendedRegexp` option to choose between "
"'basic' and 'extended'."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:14
#, no-wrap
msgid "grep.extendedRegexp"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:18
msgid ""
"If set to true, enable `--extended-regexp` option by default. This option is "
"ignored when the `grep.patternType` option is set to a value other than "
"'default'."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:19
#, no-wrap
msgid "grep.threads"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:22
msgid ""
"Number of grep worker threads to use. If unset (or set to 0), Git will use "
"as many threads as the number of logical cores available."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:23
#, no-wrap
msgid "grep.fullName"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:25
msgid "If set to true, enable `--full-name` option by default."
msgstr ""

#. type: Labeled list
#: ../Documentation/config/grep.txt:26
#, no-wrap
msgid "grep.fallbackToNoIndex"
msgstr ""

#. type: Plain text
#: ../Documentation/config/grep.txt:28
msgid ""
"If set to true, fall back to `git grep --no-index` if `git grep` is executed "
"outside of a git repository.  Defaults to false."
msgstr ""
