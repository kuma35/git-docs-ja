#. type: Title =
#: ../Documentation-sedout/git-difftool.txt:2
#, no-wrap
msgid "git-difftool(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-difftool.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:7
msgid "git-difftool - Show changes using common diff tools"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-difftool.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:12
msgid "'git difftool' [<options>] [<commit> [<commit>]] [--] [<path>...]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-difftool.txt:14
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:19
msgid ""
"'git difftool' is a Git command that allows you to compare and edit files "
"between revisions using common diff tools.  'git difftool' is a frontend to "
"'git diff' and accepts the same options and arguments. See "
"linkgit:git-diff[1]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-difftool.txt:21
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:27
#, no-wrap
msgid ""
"`-d::`\n"
"`--dir-diff::`\n"
"\tCopy the modified files to a temporary location and perform\n"
"\ta directory diff on them. This mode never prompts before\n"
"\tlaunching the diff tool.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:31
#, no-wrap
msgid ""
"`-y::`\n"
"`--no-prompt::`\n"
"\tDo not prompt before launching a diff tool.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:36
#, no-wrap
msgid ""
"`--prompt::`\n"
"\tPrompt before each invocation of the diff tool.\n"
"\tThis is the default behaviour; the option is provided to\n"
"\toverride any configuration settings.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:40
#, no-wrap
msgid ""
"`--rotate-to=<file>::`\n"
"\tStart showing the diff for the given path,\n"
"\tthe paths before it will move to the end and output.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:44
#, no-wrap
msgid ""
"`--skip-to=<file>::`\n"
"\tStart showing the diff for the given path, skipping all\n"
"\tthe paths before it.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:50
#, no-wrap
msgid ""
"`-t`\n"
"`--tool=<tool>::`\n"
"\tUse the diff tool specified by <tool>.  Valid values include\n"
"\temerge, kompare, meld, and vimdiff. Run `git difftool --tool-help`\n"
"\tfor the list of valid <tool> settings.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:55
msgid ""
"If a diff tool is not specified, 'git difftool' will use the configuration "
"variable `diff.tool`.  If the configuration variable `diff.tool` is not set, "
"'git difftool' will pick a suitable default."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:61
msgid ""
"You can explicitly provide a full path to the tool by setting the "
"configuration variable `difftool.<tool>.path`. For example, you can "
"configure the absolute path to kdiff3 by setting "
"`difftool.kdiff3.path`. Otherwise, 'git difftool' assumes the tool is "
"available in PATH."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:66
msgid ""
"Instead of running one of the known diff tools, 'git difftool' can be "
"customized to run an alternative program by specifying the command line to "
"invoke in a configuration variable `difftool.<tool>.cmd`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:76
msgid ""
"When 'git difftool' is invoked with this tool (either through the `-t` or "
"`--tool` option or the `diff.tool` configuration variable)  the configured "
"command line will be invoked with the following variables available: "
"`$LOCAL` is set to the name of the temporary file containing the contents of "
"the diff pre-image and `$REMOTE` is set to the name of the temporary file "
"containing the contents of the diff post-image.  `$MERGED` is the name of "
"the file which is being compared. `$BASE` is provided for compatibility with "
"custom merge tool commands and has the same value as `$MERGED`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:79
#, no-wrap
msgid ""
"`--tool-help::`\n"
"\tPrint a list of diff tools that may be used with `--tool`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:85
#, no-wrap
msgid ""
"`--[no-]symlinks::`\n"
"\t'git difftool''s default behavior is to create symlinks to the\n"
"\tworking tree when run in `--dir-diff` mode and the right-hand\n"
"\tside of the comparison yields the same content as the file in\n"
"\tthe working tree.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:88
msgid ""
"Specifying `--no-symlinks` instructs 'git difftool' to create copies "
"instead.  `--no-symlinks` is the default on Windows."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:95
#, no-wrap
msgid ""
"`-x`\n"
"`--extcmd=<command>::`\n"
"\tSpecify a custom command for viewing diffs.\n"
"\t'git-difftool' ignores the configured defaults and runs\n"
"\t`<command> $LOCAL $REMOTE` when this option is specified.\n"
"\tAdditionally, `$BASE` is set in the environment.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:106
#, no-wrap
msgid ""
"`-g::`\n"
"`--[no-]gui::`\n"
"\tWhen 'git-difftool' is invoked with the `-g` or `--gui` option\n"
"\tthe default diff tool will be read from the configured\n"
"\t`diff.guitool` variable instead of `diff.tool`. This may be\n"
"\tselected automatically using the configuration variable\n"
"\t`difftool.guiDefault`. The `--no-gui` option can be used to\n"
"\toverride these settings. If `diff.guitool` is not set, we will\n"
"\tfallback in the order of `merge.guitool`, `diff.tool`,\n"
"\t`merge.tool` until a tool is found.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:111
#, no-wrap
msgid ""
"`--[no-]trust-exit-code::`\n"
"\tErrors reported by the diff tool are ignored by default.\n"
"\tUse `--trust-exit-code` to make 'git-difftool' exit when an\n"
"\tinvoked diff tool returns a non-zero exit code.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:114
msgid ""
"'git-difftool' will forward the exit code of the invoked tool when "
"`--trust-exit-code` is used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:116
msgid "See linkgit:git-diff[1] for the full list of supported options."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-difftool.txt:118
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-difftool.txt:121
msgid ""
"'git difftool' falls back to 'git mergetool' config variables when the "
"difftool equivalents have not been defined."
msgstr ""

