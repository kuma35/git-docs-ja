#. type: Title =
#: ../Documentation-sedout/git-mktree.txt:2
#, no-wrap
msgid "git-mktree(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mktree.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:7
msgid "git-mktree - Build a tree-object from ls-tree formatted text"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mktree.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:13
msgid "'git mktree' [-z] [--missing] [--batch]"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mktree.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:20
msgid ""
"Reads standard input in non-recursive `ls-tree` output format, and creates a "
"tree object.  The order of the tree entries is normalized by mktree so "
"pre-sorting the input is not required.  The object name of the tree object "
"built is written to the standard output."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mktree.txt:22
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:25
#, no-wrap
msgid ""
"`-z::`\n"
"\tRead the NUL-terminated `ls-tree -z` output instead.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:31
#, no-wrap
msgid ""
"`--missing::`\n"
"\tAllow missing objects.  The default behaviour (without this option)\n"
"\tis to verify that each tree entry's hash identifies an existing\n"
"\tobject.  This option has no effect on the treatment of gitlink entries\n"
"\t(aka \"submodules\") which are always allowed to be missing.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-mktree.txt:37
#, no-wrap
msgid ""
"`--batch::`\n"
"\tAllow building of more than one tree object before exiting.  Each\n"
"\ttree is separated by a single blank line. The final newline is\n"
"\toptional.  Note - if the `-z` option is used, lines are terminated\n"
"\twith NUL.\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-mktree.txt:39
#, no-wrap
msgid "GIT"
msgstr ""

