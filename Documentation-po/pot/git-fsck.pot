#. type: Title =
#: ../Documentation-sedout/git-fsck.adoc:2
#, no-wrap
msgid "git-fsck(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:7
msgid ""
"git-fsck - Verifies the connectivity and validity of the objects in the "
"database"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:16
#, no-wrap
msgid ""
"\t'git fsck' [--tags] [--root] [--unreachable] [--cache] [--no-reflogs]\n"
"\t\t [--[no-]full] [--strict] [--verbose] [--lost-found]\n"
"\t\t [--[no-]dangling] [--[no-]progress] [--connectivity-only]\n"
"\t\t [--[no-]name-objects] [--[no-]references] [<object>...]\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:18
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:20
msgid "Verifies the connectivity and validity of the objects in the database."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:22
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:23
#, no-wrap
msgid "<object>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:25
msgid "An object to treat as the head of an unreachability trace."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:29
msgid ""
"If no objects are given, 'git fsck' defaults to using the index file, all "
"SHA-1 references in the `refs` namespace, and all reflogs (unless "
"--no-reflogs is given) as heads."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:30
#, no-wrap
msgid "`--unreachable`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:33
msgid ""
"Print out objects that exist but that aren't reachable from any of the "
"reference nodes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:34
#, no-wrap
msgid "`--dangling`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:35
#, no-wrap
msgid "`--no-dangling`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:38
msgid ""
"Print objects that exist but that are never 'directly' used (default).  "
"`--no-dangling` can be used to omit this information from the output."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:39
#, no-wrap
msgid "`--root`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:41
msgid "Report root nodes."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:42
#, no-wrap
msgid "`--tags`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:44
msgid "Report tags."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:45
#, no-wrap
msgid "`--cache`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:48
msgid ""
"Consider any object recorded in the index also as a head node for an "
"unreachability trace."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:49
#, no-wrap
msgid "`--no-reflogs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:54
msgid ""
"Do not consider commits that are referenced only by an entry in a reflog to "
"be reachable.  This option is meant only to search for commits that used to "
"be in a ref, but now aren't, but are still in that corresponding reflog."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:55
#, no-wrap
msgid "`--full`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:64
msgid ""
"Check not just objects in GIT_OBJECT_DIRECTORY ($GIT_DIR/objects), but also "
"the ones found in alternate object pools listed in "
"GIT_ALTERNATE_OBJECT_DIRECTORIES or $GIT_DIR/objects/info/alternates, and in "
"packed Git archives found in $GIT_DIR/objects/pack and corresponding pack "
"subdirectories in alternate object pools.  This is now default; you can turn "
"it off with --no-full."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:65
#, no-wrap
msgid "`--connectivity-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:73
msgid ""
"Check only the connectivity of reachable objects, making sure that any "
"objects referenced by a reachable tag, commit, or tree are present. This "
"speeds up the operation by avoiding reading blobs entirely (though it does "
"still check that referenced blobs exist). This will detect corruption in "
"commits and trees, but not do any semantic checks (e.g., for format "
"errors). Corruption in blob objects will not be detected at all."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:77
msgid ""
"Unreachable tags, commits, and trees will also be accessed to find the tips "
"of dangling segments of history. Use `--no-dangling` if you don't care about "
"this output and want to speed it up further."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:78
#, no-wrap
msgid "`--strict`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:85
msgid ""
"Enable more strict checking, namely to catch a file mode recorded with g+w "
"bit set, which was created by older versions of Git.  Existing repositories, "
"including the Linux kernel, Git itself, and sparse repository have old "
"objects that trigger this check, but it is recommended to check new projects "
"with this flag."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:86
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:88
msgid "Be chatty."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:89
#, no-wrap
msgid "`--lost-found`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:94
msgid ""
"Write dangling objects into .git/lost-found/commit/ or "
".git/lost-found/other/, depending on type.  If the object is a blob, the "
"contents are written into the file, rather than its object name."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:95
#, no-wrap
msgid "`--name-objects`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:100
msgid ""
"When displaying names of reachable objects, in addition to the SHA-1 also "
"display a name that describes *how* they are reachable, compatible with "
"linkgit:git-rev-parse[1], e.g.  `HEAD@{1234567890}~25^2:src/`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:101
#, no-wrap
msgid "`--progress`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:102
#, no-wrap
msgid "`--no-progress`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:108
msgid ""
"Progress status is reported on the standard error stream by default when it "
"is attached to a terminal, unless --no-progress or --verbose is "
"specified. --progress forces progress status even if the standard error "
"stream is not directed to a terminal."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:109
#, no-wrap
msgid "`--references`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:110
#, no-wrap
msgid "`--no-references`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:114
msgid ""
"Control whether to check the references database consistency via 'git refs "
"verify'. See linkgit:git-refs[1] for details.  The default is to check the "
"references database."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:116
#, no-wrap
msgid "CONFIGURATION"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:123
#, no-wrap
msgid "DISCUSSION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:131
msgid ""
"git-fsck tests SHA-1 and general object sanity, and it does full tracking of "
"the resulting reachability and everything else. It prints out any corruption "
"it finds (missing or bad objects), and if you use the `--unreachable` flag "
"it will also print out objects that exist but that aren't reachable from any "
"of the specified head nodes (or the default set, as mentioned above)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:135
msgid ""
"Any corrupt objects you will have to find in backups or other archives "
"(i.e., you can just remove them and do an 'rsync' with some other site in "
"the hopes that somebody else has the object you have corrupted)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:138
msgid ""
"If core.commitGraph is true, the commit-graph file will also be inspected "
"using 'git commit-graph verify'. See linkgit:git-commit-graph[1]."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:140
#, no-wrap
msgid "Extracted Diagnostics"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:142
#, no-wrap
msgid "unreachable <type> <object>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:149
msgid ""
"The <type> object <object>, isn't actually referred to directly or "
"indirectly in any of the trees or commits seen. This can mean that there's "
"another root node that you're not specifying or that the tree is corrupt. If "
"you haven't missed a root node then you might as well delete unreachable "
"nodes since they can't be used."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:150
#, no-wrap
msgid "missing <type> <object>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:153
msgid ""
"The <type> object <object>, is referred to but isn't present in the "
"database."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:154
#, no-wrap
msgid "dangling <type> <object>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:157
msgid ""
"The <type> object <object>, is present in the database but never 'directly' "
"used. A dangling commit could be a root node."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:158
#, no-wrap
msgid "hash mismatch <object>"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:162
msgid ""
"The database has an object whose hash doesn't match the object database "
"value.  This indicates a serious data integrity problem."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:165
#, no-wrap
msgid "FSCK MESSAGES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:171
msgid ""
"The following lists the types of errors `git fsck` detects and what each "
"error means, with their default severity.  The severity of the error, other "
"than those that are marked as \"(FATAL)\", can be tweaked by setting the "
"corresponding `fsck.<msg-id>` configuration variable."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:176
#, no-wrap
msgid "Environment Variables"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:178
#, no-wrap
msgid "GIT_OBJECT_DIRECTORY"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:180
msgid "used to specify the object database root (usually $GIT_DIR/objects)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:181
#, no-wrap
msgid "GIT_INDEX_FILE"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:183
msgid "used to specify the index file of the index"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.adoc:184
#, no-wrap
msgid "GIT_ALTERNATE_OBJECT_DIRECTORIES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:186
msgid "used to specify additional object database roots (usually unset)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-fsck.adoc:188
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.adoc:189
msgid "Part of the linkgit:git[1] suite"
msgstr ""
