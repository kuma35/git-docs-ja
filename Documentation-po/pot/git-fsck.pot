#, no-wrap
msgid "GIT_OBJECT_DIRECTORY"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.txt:172
msgid "used to specify the object database root (usually $GIT_DIR/objects)"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.txt:173
#, no-wrap
msgid "GIT_INDEX_FILE"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.txt:175
msgid "used to specify the index file of the index"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-fsck.txt:176
#, no-wrap
msgid "GIT_ALTERNATE_OBJECT_DIRECTORIES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-fsck.txt:178
msgid "used to specify additional object database roots (usually unset)"
msgstr ""

