#. type: Title =
#: ../Documentation-sedout/git-for-each-repo.txt:2
#, no-wrap
msgid "git-for-each-repo(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:7
msgid "git-for-each-repo - Run a Git command on a list of repositories"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:13
msgid "'git for-each-repo' --config=<config> [--] <arguments>"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:20
msgid ""
"Run a Git command on a list of repositories. The arguments after the known "
"options or `--` indicator are used as the arguments for the Git subprocess."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:22
msgid "THIS COMMAND IS EXPERIMENTAL. THE BEHAVIOR MAY CHANGE."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:25
msgid ""
"For example, we could run maintenance on each of a list of repositories "
"stored in a `maintenance.repo` config variable using"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-for-each-repo.txt:28
#, no-wrap
msgid "git for-each-repo --config=maintenance.repo maintenance run\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:32
msgid ""
"This will run `git -C <repo> maintenance run` for each value `<repo>` in the "
"multi-valued config variable `maintenance.repo`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:35
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:40
#, no-wrap
msgid ""
"`--config=<config>::`\n"
"\tUse the given config variable as a multi-valued list storing\n"
"\tabsolute path names. Iterate on that list of paths to run\n"
"\tthe given arguments.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:44
msgid ""
"These config values are loaded from system, global, and local Git config, as "
"available. If `git for-each-repo` is run in a directory that is not a Git "
"repository, then only the system and global config is used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:49
#, no-wrap
msgid ""
"`--keep-going::`\n"
"\tContinue with the remaining repositories if the command failed\n"
"\ton a repository. The exit code will still indicate that the\n"
"\toverall operation was not successful.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:54
msgid ""
"Note that the exact exit code of the failing command is not passed through "
"as the exit code of the `for-each-repo` command: If the command failed in "
"any of the specified repositories, the overall exit code will be 1."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:56
#, no-wrap
msgid "SUBPROCESS BEHAVIOR"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:61
msgid ""
"If any `git -C <repo> <arguments>` subprocess returns a non-zero exit code, "
"then the `git for-each-repo` process returns that exit code without running "
"more subprocesses."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:64
msgid ""
"Each `git -C <repo> <arguments>` subprocess inherits the standard file "
"descriptors `stdin`, `stdout`, and `stderr`."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-for-each-repo.txt:67
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-for-each-repo.txt:68
msgid "Part of the linkgit:git[1] suite"
msgstr ""
