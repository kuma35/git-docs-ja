#. type: Title =
#: ../Documentation-sedout/git-verify-pack.adoc:2
#, no-wrap
msgid "git-verify-pack(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:7
msgid "git-verify-pack - Validate packed Git archive files"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:13
#, no-wrap
msgid "\tgit verify-pack [-v | --verbose] [-s | --stat-only] [--] <pack>.idx...\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:16
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:19
msgid ""
"Read each idx file for packed Git archive given on the command line, and "
"verify the idx file and the corresponding pack file."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:21
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-pack.adoc:22
#, no-wrap
msgid "`-v`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-pack.adoc:23
#, no-wrap
msgid "`--verbose`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:26
msgid ""
"After verifying the pack, show the list of objects contained in the pack and "
"a histogram of delta chain length."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-pack.adoc:27
#, no-wrap
msgid "`-s`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-pack.adoc:28
#, no-wrap
msgid "`--stat-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:31
msgid ""
"Do not verify the pack contents; only show the histogram of delta chain "
"length.  With `--verbose`, the list of objects is also shown."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-verify-pack.adoc:32
#, no-wrap
msgid "`--`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:34
msgid "Do not interpret any more arguments as options."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:36
#, no-wrap
msgid "OUTPUT FORMAT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:38
msgid "When specifying the `-v` option the format used is:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:40
#, no-wrap
msgid "\tobject-name type size size-in-packfile offset-in-packfile\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:42
msgid "for objects that are not deltified in the pack, and"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:44
#, no-wrap
msgid ""
"\tobject-name type size size-in-packfile offset-in-packfile depth "
"base-object-name\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:46
msgid "for objects that are deltified."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-verify-pack.adoc:48
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-verify-pack.adoc:49
msgid "Part of the linkgit:git[1] suite"
msgstr ""
