#. type: Title =
#: ../Documentation/gitformat-commit-graph.txt:2
#, no-wrap
msgid "gitformat-commit-graph(5)"
msgstr ""

#. type: Title -
#: ../Documentation/gitformat-commit-graph.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:7
msgid "gitformat-commit-graph - Git commit-graph format"
msgstr ""

#. type: Title -
#: ../Documentation/gitformat-commit-graph.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:13
#, no-wrap
msgid ""
"$GIT_DIR/objects/info/commit-graph\n"
"$GIT_DIR/objects/info/commit-graphs/*\n"
msgstr ""

#. type: Title -
#: ../Documentation/gitformat-commit-graph.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:19
msgid ""
"The Git commit-graph stores a list of commit OIDs and some associated "
"metadata, including:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:21
msgid "The generation number of the commit."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:23
msgid "The root tree OID."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:25
msgid "The commit date."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:28
msgid ""
"The parents of the commit, stored using positional references within the "
"graph file."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:31
msgid ""
"The Bloom filter of the commit carrying the paths that were changed between "
"the commit and its first parent, if requested."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:36
msgid ""
"These positional references are stored as unsigned 32-bit integers "
"corresponding to the array position within the list of commit OIDs. Due to "
"some special constants we use to track parents, we can store at most (1 << "
"30) + (1 << 29) + (1 << 28) - 1 (around 1.8 billion) commits."
msgstr ""

#. type: Title ==
#: ../Documentation/gitformat-commit-graph.txt:37
#, no-wrap
msgid "Commit-graph files have the following format:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:43
msgid ""
"In order to allow extensions that add extra data to the graph, we organize "
"the body into \"chunks\" and provide a binary lookup table at the beginning "
"of the body. The header includes certain values, such as number of chunks "
"and hash type."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:45
msgid "All multi-byte numbers are in network byte order."
msgstr ""

#. type: Title ===
#: ../Documentation/gitformat-commit-graph.txt:46
#, no-wrap
msgid "HEADER:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:49
msgid "4-byte signature:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:51
msgid "The signature is: {'C', 'G', 'P', 'H'}"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:53
msgid "1-byte version number:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:55
msgid "Currently, the only valid version is 1."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:57
msgid "1-byte Hash Version"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:59
msgid "We infer the hash length (H) from this value:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:62
#, no-wrap
msgid ""
" 1 => SHA-1\n"
" 2 => SHA-256\n"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:66
msgid ""
"If the hash type does not match the repository's hash algorithm, the "
"commit-graph file should be ignored with a warning presented to the user."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:68
msgid "1-byte number (C) of \"chunks\""
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:70
msgid "1-byte number (B) of base commit-graphs"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:73
msgid "We infer the length (H*B) of the Base Graphs chunk from this value."
msgstr ""

#. type: Title ===
#: ../Documentation/gitformat-commit-graph.txt:75
#, no-wrap
msgid "CHUNK LOOKUP:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:78
msgid "(C + 1) * 12 bytes listing the table of contents for the chunks:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:84
msgid ""
"First 4 bytes describe the chunk id. Value 0 is a terminating label.  Other "
"8 bytes provide the byte-offset in current file for chunk to start. (Chunks "
"are ordered contiguously in the file, so you can infer the length using the "
"next chunk position if necessary.) Each chunk ID appears at most once."
msgstr ""

#. --
#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:89
msgid ""
"The CHUNK LOOKUP matches the table of contents from the chunk-based file "
"format, see linkgit:gitformat-chunk[5]"
msgstr ""

#. type: Title ===
#: ../Documentation/gitformat-commit-graph.txt:90
#, no-wrap
msgid "CHUNK DATA:"
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:92
#, no-wrap
msgid "OID Fanout (ID: {'O', 'I', 'D', 'F'}) (256 * 4 bytes)"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:96
msgid ""
"The ith entry, F[i], stores the number of OIDs with first byte at most "
"i. Thus F[255] stores the total number of commits (N)."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:97
#, no-wrap
msgid "OID Lookup (ID: {'O', 'I', 'D', 'L'}) (N * H bytes)"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:99
msgid "The OIDs for all commits in the graph, sorted in ascending order."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:100
#, no-wrap
msgid "Commit Data (ID: {'C', 'D', 'A', 'T' }) (N * (H + 16) bytes)"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:102
msgid "The first H bytes are for the OID of the root tree."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:107
msgid ""
"The next 8 bytes are for the positions of the first two parents of the ith "
"commit. Stores value 0x70000000 if no parent in that position. If there are "
"more than two parents, the second value has its most-significant bit on and "
"the other bits store an array position into the Extra Edge List chunk."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:114
msgid ""
"The next 8 bytes store the topological level (generation number v1)  of the "
"commit and the commit time in seconds since EPOCH. The generation number "
"uses the higher 30 bits of the first 4 bytes, while the commit time uses the "
"32 bits of the second 4 bytes, along with the lowest 2 bits of the lowest "
"byte, storing the 33rd and 34th bit of the commit time."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:115
#, no-wrap
msgid "Generation Data (ID: {'G', 'D', 'A', '2' }) (N * 4 bytes) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:118
msgid ""
"This list of 4-byte values store corrected commit date offsets for the "
"commits, arranged in the same order as commit data chunk."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:122
msgid ""
"If the corrected commit date offset cannot be stored within 31 bits, the "
"value has its most-significant bit on and the other bits store the position "
"of corrected commit date into the Generation Data Overflow chunk."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:125
msgid ""
"Generation Data chunk is present only when commit-graph file is written by "
"compatible versions of Git and in case of split commit-graph chains, the "
"topmost layer also has Generation Data chunk."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:126
#, no-wrap
msgid "Generation Data Overflow (ID: {'G', 'D', 'O', '2' }) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:130
msgid ""
"This list of 8-byte values stores the corrected commit date offsets for "
"commits with corrected commit date offsets that cannot be stored within 31 "
"bits."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:133
msgid ""
"Generation Data Overflow chunk is present only when Generation Data chunk is "
"present and at least one corrected commit date offset cannot be stored "
"within 31 bits."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:134
#, no-wrap
msgid "Extra Edge List (ID: {'E', 'D', 'G', 'E'}) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:141
msgid ""
"This list of 4-byte values store the second through nth parents for all "
"octopus merges. The second parent value in the commit data stores an array "
"position within this list along with the most-significant bit on. Starting "
"at that array position, iterate through this list of commit positions for "
"the parents until reaching a value with the most-significant bit on. The "
"other bits correspond to the position of the last parent."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:142
#, no-wrap
msgid "Bloom Filter Index (ID: {'B', 'I', 'D', 'X'}) (N * 4 bytes) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:147
msgid ""
"The ith entry, BIDX[i], stores the number of bytes in all Bloom filters from "
"commit 0 to commit i (inclusive) in lexicographic order. The Bloom filter "
"for the i-th commit spans from BIDX[i-1] to BIDX[i] (plus header length), "
"where BIDX[-1] is 0."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:148
msgid "The BIDX chunk is ignored if the BDAT chunk is not present."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:149
#, no-wrap
msgid "Bloom Filter Data (ID: {'B', 'D', 'A', 'T'}) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:151
msgid "It starts with header consisting of three unsigned 32-bit integers:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:161
msgid ""
"Version of the hash algorithm being used. We currently support value 2 which "
"corresponds to the 32-bit version of the murmur3 hash implemented exactly as "
"described in https://en.wikipedia.org/wiki/MurmurHash#Algorithm and the "
"double hashing technique using seed values 0x293ae76f and 0x7e646e2 as "
"described in https://doi.org/10.1007/978-3-540-30494-4_26 \"Bloom Filters in "
"Probabilistic Verification\". Version 1 Bloom filters have a bug that "
"appears when char is signed and the repository has path names that have "
"characters >= 0x80; Git supports reading and writing them, but this ability "
"will be removed in a future version of Git."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:163
msgid ""
"The number of times a path is hashed and hence the number of bit positions "
"that cumulatively determine whether a file is present in the commit."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:166
msgid ""
"The minimum number of bits 'b' per entry in the Bloom filter. If the filter "
"contains 'n' entries, then the filter size is the minimum number of 64-bit "
"words that contain n*b bits."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:168
msgid ""
"The rest of the chunk is the concatenation of all the computed Bloom filters "
"for the commits in lexicographic order."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:170
msgid ""
"Note: Commits with no changes or more than 512 changes have Bloom filters of "
"length one, with either all bits set to zero or one respectively."
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:171
msgid "The BDAT chunk is present if and only if BIDX is present."
msgstr ""

#. type: Title ====
#: ../Documentation/gitformat-commit-graph.txt:172
#, no-wrap
msgid "Base Graphs List (ID: {'B', 'A', 'S', 'E'}) [Optional]"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:177
msgid ""
"This list of H-byte hashes describe a set of B commit-graph files that form "
"a commit-graph chain. The graph position for the ith commit in this file's "
"OID Lookup chunk is equal to i plus the number of commits in all base "
"graphs.  If B is non-zero, this chunk must exist."
msgstr ""

#. type: Title ===
#: ../Documentation/gitformat-commit-graph.txt:178
#, no-wrap
msgid "TRAILER:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:181
msgid "H-byte HASH-checksum of all of the above."
msgstr ""

#. type: Title ==
#: ../Documentation/gitformat-commit-graph.txt:182
#, no-wrap
msgid "Historical Notes:"
msgstr ""

#. type: Plain text
#: ../Documentation/gitformat-commit-graph.txt:189
msgid ""
"The Generation Data (GDA2) and Generation Data Overflow (GDO2) chunks have "
"the number '2' in their chunk IDs because a previous version of Git wrote "
"possibly erroneous data in these chunks with the IDs \"GDAT\" and "
"\"GDOV\". By changing the IDs, newer versions of Git will silently ignore "
"those older chunks and write the new information without trusting the "
"incorrect data."
msgstr ""

