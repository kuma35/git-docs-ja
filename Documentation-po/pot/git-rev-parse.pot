#. type: Title =
#: ../Documentation-sedout/git-rev-parse.adoc:2
#, no-wrap
msgid "git-rev-parse(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.adoc:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:7
msgid "git-rev-parse - Pick out and massage parameters"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:13
msgid "'git rev-parse' [<options>] <arg>..."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.adoc:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:25
msgid ""
"Many Git porcelainish commands take a mixture of flags (i.e. parameters that "
"begin with a dash '-') and parameters meant for the underlying 'git "
"rev-list' command they use internally and flags and parameters for the other "
"commands they use downstream of 'git rev-list'.  The primary purpose of this "
"command is to allow calling programs to distinguish between them.  There are "
"a few other operation modes that have nothing to do with the above \"help "
"parse command line options\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:30
msgid ""
"Unless otherwise specified, most of the options and operation modes require "
"you to run this command inside a git repository or a working tree that is "
"under the control of a git repository, and will give you a fatal error "
"otherwise."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.adoc:33
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:36
#, no-wrap
msgid "Operation Modes"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:39
msgid "Each of these options must appear first on the command line."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:40
#, no-wrap
msgid "`--parseopt`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:44
msgid ""
"Use 'git rev-parse' in option parsing mode (see PARSEOPT section below).  "
"The command in this mode can be used outside a repository or a working tree "
"controlled by a repository."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:45
#, no-wrap
msgid "`--sq-quote`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:51
msgid ""
"Use 'git rev-parse' in shell quoting mode (see SQ-QUOTE section below). In "
"contrast to the `--sq` option below, this mode only does quoting. Nothing "
"else is done to command input.  The command in this mode can be used outside "
"a repository or a working tree controlled by a repository."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:53
#, no-wrap
msgid "Options for --parseopt"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:55
#, no-wrap
msgid "`--keep-dashdash`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:58
msgid ""
"Only meaningful in `--parseopt` mode. Tells the option parser to echo out "
"the first `--` met instead of skipping it."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:59
#, no-wrap
msgid "`--stop-at-non-option`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:63
msgid ""
"Only meaningful in `--parseopt` mode.  Lets the option parser stop at the "
"first non-option argument.  This can be used to parse sub-commands that take "
"options themselves."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:64
#, no-wrap
msgid "`--stuck-long`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:67
msgid ""
"Only meaningful in `--parseopt` mode. Output the options in their long form "
"if available, and with their arguments stuck."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:69
#, no-wrap
msgid "Options for Filtering"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:71
#, no-wrap
msgid "`--revs-only`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:74
msgid "Do not output flags and parameters not meant for 'git rev-list' command."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:75
#, no-wrap
msgid "`--no-revs`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:78
msgid "Do not output flags and parameters meant for 'git rev-list' command."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:79
#, no-wrap
msgid "`--flags`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:81
msgid "Do not output non-flag parameters."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:82
#, no-wrap
msgid "`--no-flags`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:84
msgid "Do not output flag parameters."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:86
#, no-wrap
msgid "Options for Output"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:88
#, no-wrap
msgid "`--default <arg>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:91
msgid "If there is no parameter given by the user, use `<arg>` instead."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:92
#, no-wrap
msgid "`--prefix <arg>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:97
msgid ""
"Behave as if 'git rev-parse' was invoked from the `<arg>` subdirectory of "
"the working tree.  Any relative filenames are resolved as if they are "
"prefixed by `<arg>` and will be printed in that form."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:101
msgid ""
"This can be used to convert arguments to a command run in a subdirectory so "
"that they can still be used after moving to the top-level of the "
"repository.  For example:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.adoc:107
#, no-wrap
msgid ""
"prefix=$(git rev-parse --show-prefix)\n"
"cd \"$(git rev-parse --show-toplevel)\"\n"
"# rev-parse provides the -- needed for 'set'\n"
"eval \"set $(git rev-parse --sq --prefix \"$prefix\" -- \"$@\")\"\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:109
#, no-wrap
msgid "`--verify`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:114
msgid ""
"Verify that exactly one parameter is provided, and that it can be turned "
"into a raw 20-byte SHA-1 that can be used to access the object database. If "
"so, emit it to the standard output; otherwise, error out."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:123
msgid ""
"If you want to make sure that the output actually names an object in your "
"object database and/or can be used as a specific type of object you require, "
"you can add the `^{type}` peeling operator to the parameter.  For example, "
"`git rev-parse \"$VAR^{commit}\"` will make sure `$VAR` names an existing "
"object that is a commit-ish (i.e. a commit, or an annotated tag that points "
"at a commit).  To make sure that `$VAR` names an existing object of any "
"type, `git rev-parse \"$VAR^{object}\"` can be used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:127
msgid ""
"Note that if you are verifying a name from an untrusted source, it is wise "
"to use `--end-of-options` so that the name argument is not mistaken for "
"another option."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:128
#, no-wrap
msgid "`-q`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:129
#, no-wrap
msgid "`--quiet`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:134
msgid ""
"Only meaningful in `--verify` mode. Do not output an error message if the "
"first argument is not a valid object name; instead exit with non-zero status "
"silently.  SHA-1s for valid object names are printed to stdout on success."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:135
#, no-wrap
msgid "`--sq`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:143
msgid ""
"Usually the output is made one line per flag and parameter.  This option "
"makes output a single line, properly quoted for consumption by shell.  "
"Useful when you expect your parameter to contain whitespaces and newlines "
"(e.g. when using pickaxe `-S` with 'git diff-{asterisk}'). In contrast to "
"the `--sq-quote` option, the command input is still interpreted as usual."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:144
#, no-wrap
msgid "`--short[=<length>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:149
msgid ""
"Same as `--verify` but shortens the object name to a unique prefix with at "
"least `length` characters. The minimum length is 4, the default is the "
"effective value of the `core.abbrev` configuration variable (see "
"linkgit:git-config[1])."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:150
#, no-wrap
msgid "`--not`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:154
msgid ""
"When showing object names, prefix them with '{caret}' and strip '{caret}' "
"prefix from the object names that already have one."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:155
#, no-wrap
msgid "`--abbrev-ref[=(strict|loose)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:159
msgid ""
"A non-ambiguous short name of the objects name.  The option "
"core.warnAmbiguousRefs is used to select the strict abbreviation mode."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:160
#, no-wrap
msgid "`--symbolic`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:164
msgid ""
"Usually the object names are output in SHA-1 form (with possible '{caret}' "
"prefix); this option makes them output in a form as close to the original "
"input as possible."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:165
#, no-wrap
msgid "`--symbolic-full-name`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:172
msgid ""
"This is similar to --symbolic, but it omits input that are not refs "
"(i.e. branch or tag names; or more explicitly disambiguating "
"\"heads/master\" form, when you want to name the \"master\" branch when "
"there is an unfortunately named tag \"master\"), and shows them as full "
"refnames (e.g. \"refs/heads/master\")."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:173
#, no-wrap
msgid "`--output-object-format=(sha1|sha256|storage)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:177
msgid ""
"Allow oids to be input from any object format that the current repository "
"supports."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:179
msgid "Specifying \"sha1\" translates if necessary and returns a sha1 oid."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:181
msgid "Specifying \"sha256\" translates if necessary and returns a sha256 oid."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:184
msgid ""
"Specifying \"storage\" translates if necessary and returns an oid in encoded "
"in the storage hash algorithm."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:186
#, no-wrap
msgid "Options for Objects"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:188
#, no-wrap
msgid "`--all`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:190
msgid "Show all refs found in `refs/`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:191
#, no-wrap
msgid "`--branches[=<pattern>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:192
#, no-wrap
msgid "`--tags[=<pattern>]`"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:193
#, no-wrap
msgid "`--remotes[=<pattern>]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:197
msgid ""
"Show all branches, tags, or remote-tracking branches, respectively (i.e., "
"refs found in `refs/heads`, `refs/tags`, or `refs/remotes`, respectively)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:201
msgid ""
"If a `pattern` is given, only refs matching the given shell glob are shown.  "
"If the pattern does not contain a globbing character (`?`, `*`, or `[`), it "
"is turned into a prefix match by appending `/*`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:202
#, no-wrap
msgid "`--glob=<pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:208
msgid ""
"Show all refs matching the shell glob pattern `pattern`. If the pattern does "
"not start with `refs/`, this is automatically prepended.  If the pattern "
"does not contain a globbing character (`?`, `*`, or `[`), it is turned into "
"a prefix match by appending `/*`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:209
#, no-wrap
msgid "`--exclude=<glob-pattern>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:216
msgid ""
"Do not include refs matching '<glob-pattern>' that the next `--all`, "
"`--branches`, `--tags`, `--remotes`, or `--glob` would otherwise "
"consider. Repetitions of this option accumulate exclusion patterns up to the "
"next `--all`, `--branches`, `--tags`, `--remotes`, or `--glob` option (other "
"options or arguments do not clear accumulated patterns)."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:222
msgid ""
"The patterns given should not begin with `refs/heads`, `refs/tags`, or "
"`refs/remotes` when applied to `--branches`, `--tags`, or `--remotes`, "
"respectively, and they must begin with `refs/` when applied to `--glob` or "
"`--all`. If a trailing '/{asterisk}' is intended, it must be given "
"explicitly."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:223
#, no-wrap
msgid "`--exclude-hidden=(fetch|receive|uploadpack)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:230
msgid ""
"Do not include refs that would be hidden by `git-fetch`, `git-receive-pack` "
"or `git-upload-pack` by consulting the appropriate `fetch.hideRefs`, "
"`receive.hideRefs` or `uploadpack.hideRefs` configuration along with "
"`transfer.hideRefs` (see linkgit:git-config[1]). This option affects the "
"next pseudo-ref option `--all` or `--glob` and is cleared after processing "
"them."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:231
#, no-wrap
msgid "`--disambiguate=<prefix>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:236
msgid ""
"Show every object whose name begins with the given prefix.  The <prefix> "
"must be at least 4 hexadecimal digits long to avoid listing each and every "
"object in the repository by mistake."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.adoc:238
#, no-wrap
msgid "Options for Files"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:240
#, no-wrap
msgid "`--local-env-vars`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:245
msgid ""
"List the GIT_* environment variables that are local to the repository "
"(e.g. GIT_DIR or GIT_WORK_TREE, but not GIT_EDITOR).  Only the names of the "
"variables are listed, not their value, even if they are set."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:246
#, no-wrap
msgid "`--path-format=(absolute|relative)`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:251
msgid ""
"Controls the behavior of certain other options. If specified as absolute, "
"the paths printed by those options will be absolute and canonical. If "
"specified as relative, the paths will be relative to the current working "
"directory if that is possible.  The default is option specific."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:255
msgid ""
"This option may be specified multiple times and affects only the arguments "
"that follow it on the command line, either to the end of the command line or "
"the next instance of this option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:257
msgid "The following options are modified by `--path-format`:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:258
#, no-wrap
msgid "`--git-dir`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:262
msgid ""
"Show `$GIT_DIR` if defined. Otherwise show the path to the .git "
"directory. The path shown, when relative, is relative to the current working "
"directory."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:266
msgid ""
"If `$GIT_DIR` is not defined and the current directory is not detected to "
"lie in a Git repository or work tree print a message to stderr and exit with "
"nonzero status."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:267
#, no-wrap
msgid "`--git-common-dir`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:269
msgid "Show `$GIT_COMMON_DIR` if defined, else `$GIT_DIR`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:270
#, no-wrap
msgid "`--resolve-git-dir <path>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:275
msgid ""
"Check if <path> is a valid repository or a gitfile that points at a valid "
"repository, and print the location of the repository.  If <path> is a "
"gitfile then the resolved path to the real repository is printed."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:276
#, no-wrap
msgid "`--git-path <path>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:282
msgid ""
"Resolve \"$GIT_DIR/<path>\" and takes other path relocation variables such "
"as $GIT_OBJECT_DIRECTORY, $GIT_INDEX_FILE... into account. For example, if "
"$GIT_OBJECT_DIRECTORY is set to /foo/bar then \"git rev-parse --git-path "
"objects/abc\" returns /foo/bar/abc."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:283
#, no-wrap
msgid "`--show-toplevel`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:286
msgid ""
"Show the (by default, absolute) path of the top-level directory of the "
"working tree. If there is no working tree, report an error."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:287
#, no-wrap
msgid "`--show-superproject-working-tree`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:292
msgid ""
"Show the absolute path of the root of the superproject's working tree (if "
"exists) that uses the current repository as its submodule.  Outputs nothing "
"if the current repository is not used as a submodule by any project."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:293
#, no-wrap
msgid "`--shared-index-path`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:296
msgid ""
"Show the path to the shared index file in split index mode, or empty if not "
"in split-index mode."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:298
msgid "The following options are unaffected by `--path-format`:"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:299
#, no-wrap
msgid "`--absolute-git-dir`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:302
msgid "Like `--git-dir`, but its output is always the canonicalized absolute path."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:303
#, no-wrap
msgid "`--is-inside-git-dir`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:306
msgid ""
"When the current working directory is below the repository directory print "
"\"true\", otherwise \"false\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:307
#, no-wrap
msgid "`--is-inside-work-tree`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:310
msgid ""
"When the current working directory is inside the work tree of the repository "
"print \"true\", otherwise \"false\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:311
#, no-wrap
msgid "`--is-bare-repository`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:313
msgid "When the repository is bare print \"true\", otherwise \"false\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:314
#, no-wrap
msgid "`--is-shallow-repository`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:316
msgid "When the repository is shallow print \"true\", otherwise \"false\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:317
#, no-wrap
msgid "`--show-cdup`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:321
msgid ""
"When the command is invoked from a subdirectory, show the path of the "
"top-level directory relative to the current directory (typically a sequence "
"of \"../\", or an empty string)."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:322
#, no-wrap
msgid "`--show-prefix`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:326
msgid ""
"When the command is invoked from a subdirectory, show the path of the "
"current directory relative to the top-level directory."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:327
#, no-wrap
msgid "`--show-object-format[=(storage|input|output|compat)]`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:333
msgid ""
"Show the object format (hash algorithm) used for the repository for storage "
"inside the `.git` directory, input, output, or compatibility. For input, "
"multiple algorithms may be printed, space-separated. If `compat` is "
"requested and no compatibility algorithm is enabled, prints an empty "
"line. If not specified, the default is \"storage\"."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.adoc:334
#, no-wrap
msgid "`--show-ref-format`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.adoc:336
msgid "Show the reference storage format used for the repository."
msgstr ""

#. type: Title ~
