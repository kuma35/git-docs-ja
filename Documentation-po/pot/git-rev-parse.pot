#. type: Title =
#: ../Documentation-sedout/git-rev-parse.txt:2
#, no-wrap
msgid "git-rev-parse(1)"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:5
#, no-wrap
msgid "NAME"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:7
msgid "git-rev-parse - Pick out and massage parameters"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:13
msgid "'git rev-parse' [<options>] <arg>..."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:25
msgid ""
"Many Git porcelainish commands take a mixture of flags (i.e. parameters that "
"begin with a dash '-') and parameters meant for the underlying 'git "
"rev-list' command they use internally and flags and parameters for the other "
"commands they use downstream of 'git rev-list'.  The primary purpose of this "
"command is to allow calling programs to distinguish between them.  There are "
"a few other operation modes that have nothing to do with the above \"help "
"parse command line options\"."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:30
msgid ""
"Unless otherwise specified, most of the options and operation modes require "
"you to run this command inside a git repository or a working tree that is "
"under the control of a git repository, and will give you a fatal error "
"otherwise."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:33
#, no-wrap
msgid "OPTIONS"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:36
#, no-wrap
msgid "Operation Modes"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:39
msgid "Each of these options must appear first on the command line."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:44
#, no-wrap
msgid ""
"`--parseopt::`\n"
"\tUse 'git rev-parse' in option parsing mode (see PARSEOPT section below).\n"
"\tThe command in this mode can be used outside a repository or\n"
"\ta working tree controlled by a repository.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:51
#, no-wrap
msgid ""
"`--sq-quote::`\n"
"\tUse 'git rev-parse' in shell quoting mode (see SQ-QUOTE\n"
"\tsection below). In contrast to the `--sq` option below, this\n"
"\tmode only does quoting. Nothing else is done to command input.\n"
"\tThe command in this mode can be used outside a repository or\n"
"\ta working tree controlled by a repository.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:53
#, no-wrap
msgid "Options for --parseopt"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:58
#, no-wrap
msgid ""
"`--keep-dashdash::`\n"
"\tOnly meaningful in `--parseopt` mode. Tells the option parser to echo\n"
"\tout the first `--` met instead of skipping it.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:63
#, no-wrap
msgid ""
"`--stop-at-non-option::`\n"
"\tOnly meaningful in `--parseopt` mode.  Lets the option parser stop at\n"
"\tthe first non-option argument.  This can be used to parse sub-commands\n"
"\tthat take options themselves.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:67
#, no-wrap
msgid ""
"`--stuck-long::`\n"
"\tOnly meaningful in `--parseopt` mode. Output the options in their\n"
"\tlong form if available, and with their arguments stuck.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:69
#, no-wrap
msgid "Options for Filtering"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:74
#, no-wrap
msgid ""
"`--revs-only::`\n"
"\tDo not output flags and parameters not meant for\n"
"\t'git rev-list' command.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:78
#, no-wrap
msgid ""
"`--no-revs::`\n"
"\tDo not output flags and parameters meant for\n"
"\t'git rev-list' command.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:81
#, no-wrap
msgid ""
"`--flags::`\n"
"\tDo not output non-flag parameters.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:84
#, no-wrap
msgid ""
"`--no-flags::`\n"
"\tDo not output flag parameters.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:86
#, no-wrap
msgid "Options for Output"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:91
#, no-wrap
msgid ""
"`--default`\n"
"\tIf there is no parameter given by the user, use `<arg>`\n"
"\tinstead.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:97
#, no-wrap
msgid ""
"`--prefix`\n"
"\tBehave as if 'git rev-parse' was invoked from the `<arg>`\n"
"\tsubdirectory of the working tree.  Any relative filenames are\n"
"\tresolved as if they are prefixed by `<arg>` and will be printed\n"
"\tin that form.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:101
msgid ""
"This can be used to convert arguments to a command run in a subdirectory so "
"that they can still be used after moving to the top-level of the "
"repository.  For example:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:107
#, no-wrap
msgid ""
"prefix=$(git rev-parse --show-prefix)\n"
"cd \"$(git rev-parse --show-toplevel)\"\n"
"# rev-parse provides the -- needed for 'set'\n"
"eval \"set $(git rev-parse --sq --prefix \"$prefix\" -- \"$@\")\"\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:114
#, no-wrap
msgid ""
"`--verify::`\n"
"\tVerify that exactly one parameter is provided, and that it\n"
"\tcan be turned into a raw 20-byte SHA-1 that can be used to\n"
"\taccess the object database. If so, emit it to the standard\n"
"\toutput; otherwise, error out.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:123
msgid ""
"If you want to make sure that the output actually names an object in your "
"object database and/or can be used as a specific type of object you require, "
"you can add the `^{type}` peeling operator to the parameter.  For example, "
"`git rev-parse \"$VAR^{commit}\"` will make sure `$VAR` names an existing "
"object that is a commit-ish (i.e. a commit, or an annotated tag that points "
"at a commit).  To make sure that `$VAR` names an existing object of any "
"type, `git rev-parse \"$VAR^{object}\"` can be used."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:127
msgid ""
"Note that if you are verifying a name from an untrusted source, it is wise "
"to use `--end-of-options` so that the name argument is not mistaken for "
"another option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:134
#, no-wrap
msgid ""
"`-q::`\n"
"`--quiet::`\n"
"\tOnly meaningful in `--verify` mode. Do not output an error\n"
"\tmessage if the first argument is not a valid object name;\n"
"\tinstead exit with non-zero status silently.\n"
"\tSHA-1s for valid object names are printed to stdout on success.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:143
#, no-wrap
msgid ""
"`--sq::`\n"
"\tUsually the output is made one line per flag and\n"
"\tparameter.  This option makes output a single line,\n"
"\tproperly quoted for consumption by shell.  Useful when\n"
"\tyou expect your parameter to contain whitespaces and\n"
"\tnewlines (e.g. when using pickaxe `-S` with\n"
"\t'git diff-{asterisk}'). In contrast to the `--sq-quote` option,\n"
"\tthe command input is still interpreted as usual.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:149
#, no-wrap
msgid ""
"`--short[=<length>]::`\n"
"\tSame as `--verify` but shortens the object name to a unique\n"
"\tprefix with at least `length` characters. The minimum length\n"
"\tis 4, the default is the effective value of the `core.abbrev`\n"
"\tconfiguration variable (see linkgit:git-config[1]).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:154
#, no-wrap
msgid ""
"`--not::`\n"
"\tWhen showing object names, prefix them with '{caret}' and\n"
"\tstrip '{caret}' prefix from the object names that already have\n"
"\tone.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:159
#, no-wrap
msgid ""
"`--abbrev-ref[=(strict|loose)]::`\n"
"\tA non-ambiguous short name of the objects name.\n"
"\tThe option core.warnAmbiguousRefs is used to select the strict\n"
"\tabbreviation mode.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:164
#, no-wrap
msgid ""
"`--symbolic::`\n"
"\tUsually the object names are output in SHA-1 form (with\n"
"\tpossible '{caret}' prefix); this option makes them output in a\n"
"\tform as close to the original input as possible.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:172
#, no-wrap
msgid ""
"`--symbolic-full-name::`\n"
"\tThis is similar to --symbolic, but it omits input that\n"
"\tare not refs (i.e. branch or tag names; or more\n"
"\texplicitly disambiguating \"heads/master\" form, when you\n"
"\twant to name the \"master\" branch when there is an\n"
"\tunfortunately named tag \"master\"), and shows them as full\n"
"\trefnames (e.g. \"refs/heads/master\").\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:174
msgid "`--output-object-format=(sha1|sha256|storage)::`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:177
#, no-wrap
msgid ""
"\tAllow oids to be input from any object format that the current\n"
"\trepository supports.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:179
#, no-wrap
msgid "\tSpecifying \"sha1\" translates if necessary and returns a sha1 oid.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:181
#, no-wrap
msgid "\tSpecifying \"sha256\" translates if necessary and returns a sha256 oid.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:184
#, no-wrap
msgid ""
"\tSpecifying \"storage\" translates if necessary and returns an oid in\n"
"\tencoded in the storage hash algorithm.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:186
#, no-wrap
msgid "Options for Objects"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:190
#, no-wrap
msgid ""
"`--all::`\n"
"\tShow all refs found in `refs/`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:197
#, no-wrap
msgid ""
"`--branches[=<pattern>]::`\n"
"`--tags[=<pattern>]::`\n"
"`--remotes[=<pattern>]::`\n"
"\tShow all branches, tags, or remote-tracking branches,\n"
"\trespectively (i.e., refs found in `refs/heads`,\n"
"\t`refs/tags`, or `refs/remotes`, respectively).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:201
msgid ""
"If a `pattern` is given, only refs matching the given shell glob are shown.  "
"If the pattern does not contain a globbing character (`?`, `*`, or `[`), it "
"is turned into a prefix match by appending `/*`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:208
#, no-wrap
msgid ""
"`--glob=<pattern>::`\n"
"\tShow all refs matching the shell glob pattern `pattern`. If\n"
"\tthe pattern does not start with `refs/`, this is automatically\n"
"\tprepended.  If the pattern does not contain a globbing\n"
"\tcharacter (`?`, `*`, or `[`), it is turned into a prefix\n"
"\tmatch by appending `/*`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:216
#, no-wrap
msgid ""
"`--exclude=<glob-pattern>::`\n"
"\tDo not include refs matching '<glob-pattern>' that the next `--all`,\n"
"\t`--branches`, `--tags`, `--remotes`, or `--glob` would otherwise\n"
"\tconsider. Repetitions of this option accumulate exclusion patterns\n"
"\tup to the next `--all`, `--branches`, `--tags`, `--remotes`, or\n"
"\t`--glob` option (other options or arguments do not clear\n"
"\taccumulated patterns).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:222
msgid ""
"The patterns given should not begin with `refs/heads`, `refs/tags`, or "
"`refs/remotes` when applied to `--branches`, `--tags`, or `--remotes`, "
"respectively, and they must begin with `refs/` when applied to `--glob` or "
"`--all`. If a trailing '/{asterisk}' is intended, it must be given "
"explicitly."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:230
#, no-wrap
msgid ""
"`--exclude-hidden=(fetch|receive|uploadpack)::`\n"
"\tDo not include refs that would be hidden by `git-fetch`,\n"
"\t`git-receive-pack` or `git-upload-pack` by consulting the appropriate\n"
"\t`fetch.hideRefs`, `receive.hideRefs` or `uploadpack.hideRefs`\n"
"\tconfiguration along with `transfer.hideRefs` (see\n"
"\tlinkgit:git-config[1]). This option affects the next pseudo-ref option\n"
"\t`--all` or `--glob` and is cleared after processing them.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:236
#, no-wrap
msgid ""
"`--disambiguate=<prefix>::`\n"
"\tShow every object whose name begins with the given prefix.\n"
"\tThe <prefix> must be at least 4 hexadecimal digits long to\n"
"\tavoid listing each and every object in the repository by\n"
"\tmistake.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:238
#, no-wrap
msgid "Options for Files"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:245
#, no-wrap
msgid ""
"`--local-env-vars::`\n"
"\tList the GIT_* environment variables that are local to the\n"
"\trepository (e.g. GIT_DIR or GIT_WORK_TREE, but not GIT_EDITOR).\n"
"\tOnly the names of the variables are listed, not their value,\n"
"\teven if they are set.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:251
#, no-wrap
msgid ""
"`--path-format=(absolute|relative)::`\n"
"\tControls the behavior of certain other options. If specified as absolute, "
"the\n"
"\tpaths printed by those options will be absolute and canonical. If "
"specified as\n"
"\trelative, the paths will be relative to the current working directory if "
"that\n"
"\tis possible.  The default is option specific.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:255
msgid ""
"This option may be specified multiple times and affects only the arguments "
"that follow it on the command line, either to the end of the command line or "
"the next instance of this option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:257
msgid "The following options are modified by `--path-format`:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:262
#, no-wrap
msgid ""
"`--git-dir::`\n"
"\tShow `$GIT_DIR` if defined. Otherwise show the path to\n"
"\tthe .git directory. The path shown, when relative, is\n"
"\trelative to the current working directory.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:266
msgid ""
"If `$GIT_DIR` is not defined and the current directory is not detected to "
"lie in a Git repository or work tree print a message to stderr and exit with "
"nonzero status."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:269
#, no-wrap
msgid ""
"`--git-common-dir::`\n"
"\tShow `$GIT_COMMON_DIR` if defined, else `$GIT_DIR`.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:275
#, no-wrap
msgid ""
"`--resolve-git-dir`\n"
"\tCheck if <path> is a valid repository or a gitfile that\n"
"\tpoints at a valid repository, and print the location of the\n"
"\trepository.  If <path> is a gitfile then the resolved path\n"
"\tto the real repository is printed.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:282
#, no-wrap
msgid ""
"`--git-path`\n"
"\tResolve \"$GIT_DIR/<path>\" and takes other path relocation\n"
"\tvariables such as $GIT_OBJECT_DIRECTORY,\n"
"\t$GIT_INDEX_FILE... into account. For example, if\n"
"\t$GIT_OBJECT_DIRECTORY is set to /foo/bar then \"git rev-parse\n"
"\t--git-path objects/abc\" returns /foo/bar/abc.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:286
#, no-wrap
msgid ""
"`--show-toplevel::`\n"
"\tShow the (by default, absolute) path of the top-level directory\n"
"\tof the working tree. If there is no working tree, report an error.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:292
#, no-wrap
msgid ""
"`--show-superproject-working-tree::`\n"
"\tShow the absolute path of the root of the superproject's\n"
"\tworking tree (if exists) that uses the current repository as\n"
"\tits submodule.  Outputs nothing if the current repository is\n"
"\tnot used as a submodule by any project.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:296
#, no-wrap
msgid ""
"`--shared-index-path::`\n"
"\tShow the path to the shared index file in split index mode, or\n"
"\tempty if not in split-index mode.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:298
msgid "The following options are unaffected by `--path-format`:"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:302
#, no-wrap
msgid ""
"`--absolute-git-dir::`\n"
"\tLike `--git-dir`, but its output is always the canonicalized\n"
"\tabsolute path.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:306
#, no-wrap
msgid ""
"`--is-inside-git-dir::`\n"
"\tWhen the current working directory is below the repository\n"
"\tdirectory print \"true\", otherwise \"false\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:310
#, no-wrap
msgid ""
"`--is-inside-work-tree::`\n"
"\tWhen the current working directory is inside the work tree of the\n"
"\trepository print \"true\", otherwise \"false\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:313
#, no-wrap
msgid ""
"`--is-bare-repository::`\n"
"\tWhen the repository is bare print \"true\", otherwise \"false\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:316
#, no-wrap
msgid ""
"`--is-shallow-repository::`\n"
"\tWhen the repository is shallow print \"true\", otherwise \"false\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:321
#, no-wrap
msgid ""
"`--show-cdup::`\n"
"\tWhen the command is invoked from a subdirectory, show the\n"
"\tpath of the top-level directory relative to the current\n"
"\tdirectory (typically a sequence of \"../\", or an empty string).\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:326
#, no-wrap
msgid ""
"`--show-prefix::`\n"
"\tWhen the command is invoked from a subdirectory, show the\n"
"\tpath of the current directory relative to the top-level\n"
"\tdirectory.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:332
#, no-wrap
msgid ""
"`--show-object-format[=(storage|input|output)]::`\n"
"\tShow the object format (hash algorithm) used for the repository\n"
"\tfor storage inside the `.git` directory, input, or output. For\n"
"\tinput, multiple algorithms may be printed, space-separated.\n"
"\tIf not specified, the default is \"storage\".\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:335
#, no-wrap
msgid ""
"`--show-ref-format::`\n"
"\tShow the reference storage format used for the repository.\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:338
#, no-wrap
msgid "Other Options"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:344
#, no-wrap
msgid ""
"`--since=<datestring>::`\n"
"`--after=<datestring>::`\n"
"\tParse the date string, and output the corresponding\n"
"\t--max-age= parameter for 'git rev-list'.\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:349
#, no-wrap
msgid ""
"`--until=<datestring>::`\n"
"`--before=<datestring>::`\n"
"\tParse the date string, and output the corresponding\n"
"\t--min-age= parameter for 'git rev-list'.\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.txt:350
#, no-wrap
msgid "<arg>..."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:352
msgid "Flags and parameters to be parsed."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:357
#, no-wrap
msgid "PARSEOPT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:362
msgid ""
"In `--parseopt` mode, 'git rev-parse' helps massaging options to bring to "
"shell scripts the same facilities C builtins have. It works as an option "
"normalizer (e.g. splits single switches aggregate values), a bit like "
"`getopt(1)` does."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:367
msgid ""
"It takes on the standard input the specification of the options to parse and "
"understand, and echoes on the standard output a string suitable for `sh(1)` "
"`eval` to replace the arguments with normalized ones.  In case of error, it "
"outputs usage on the standard error stream, and exits with code 129."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:370
msgid ""
"Note: Make sure you quote the result when passing it to `eval`.  See below "
"for an example."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:372
#, no-wrap
msgid "Input Format"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:378
msgid ""
"'git rev-parse --parseopt' input format is fully text based. It has two "
"parts, separated by a line that contains only `--`. The lines before the "
"separator (should be one or more) are used for the usage.  The lines after "
"the separator describe the options."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:380
msgid "Each line of options has this format:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:383
#, no-wrap
msgid "<opt-spec><flags>*<arg-hint>? SP+ help LF\n"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.txt:385
#, no-wrap
msgid "`<opt-spec>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:390
msgid ""
"its format is the short option character, then the long option name "
"separated by a comma. Both parts are not required, though at least one is "
"necessary. May not contain any of the `<flags>` characters.  `h,help`, "
"`dry-run` and `f` are examples of correct `<opt-spec>`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.txt:391
#, no-wrap
msgid "`<flags>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:393
msgid "`<flags>` are of `*`, `=`, `?` or `!`."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:394
msgid "Use `=` if the option takes an argument."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:398
msgid ""
"Use `?` to mean that the option takes an optional argument. You probably "
"want to use the `--stuck-long` mode to be able to unambiguously parse the "
"optional argument."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:402
msgid ""
"Use `*` to mean that this option should not be listed in the usage generated "
"for the `-h` argument. It's shown for `--help-all` as documented in "
"linkgit:gitcli[7]."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:404
msgid "Use `!` to not make the corresponding negated long option available."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-rev-parse.txt:405
#, no-wrap
msgid "`<arg-hint>`"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:410
msgid ""
"`<arg-hint>`, if specified, is used as a name of the argument in the help "
"output, for options that take arguments. `<arg-hint>` is terminated by the "
"first whitespace.  It is customary to use a dash to separate words in a "
"multi-word argument hint."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:413
msgid ""
"The remainder of the line, after stripping the spaces, is used as the help "
"associated with the option."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:417
msgid ""
"Blank lines are ignored, and lines that don't match this specification are "
"used as option group headers (start the line with a space to create such "
"lines on purpose)."
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:419
#: ../Documentation-sedout/git-rev-parse.txt:475
#, no-wrap
msgid "Example"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:424
#, no-wrap
msgid ""
"OPTS_SPEC=\"\\\n"
"some-command [<options>] <args>...\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:426
#, no-wrap
msgid ""
"some-command does foo and bar!\n"
"--\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:428
#, no-wrap
msgid "h,help!   show the help\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:433
#, no-wrap
msgid ""
"foo       some nifty option --foo\n"
"bar=      some cool option --bar with an argument\n"
"baz=arg   another cool option --baz with a named argument\n"
"qux?path  qux may take a path argument but has meaning by itself\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:436
#, no-wrap
msgid ""
"  An option group Header\n"
"C?        option C with an optional argument\"\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:438
#, no-wrap
msgid ""
"eval \"$(echo \"$OPTS_SPEC\" | git rev-parse --parseopt -- \"$@\" || echo "
"exit $?)\"\n"
msgstr ""

#. type: Title ~
#: ../Documentation-sedout/git-rev-parse.txt:442
#, no-wrap
msgid "Usage text"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:446
msgid ""
"When `\"$@\"` is `-h` or `--help` in the above example, the following usage "
"text would be shown:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:449
#, no-wrap
msgid "usage: some-command [<options>] <args>...\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:451
#, no-wrap
msgid "    some-command does foo and bar!\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:457
#, no-wrap
msgid ""
"    -h, --help            show the help\n"
"    --[no-]foo            some nifty option --foo\n"
"    --[no-]bar ...        some cool option --bar with an argument\n"
"    --[no-]baz <arg>      another cool option --baz with a named argument\n"
"    --[no-]qux[=<path>]   qux may take a path argument but has meaning by "
"itself\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:460
#, no-wrap
msgid ""
"An option group Header\n"
"    -C[...]               option C with an optional argument\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:463
#, no-wrap
msgid "SQ-QUOTE"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:469
msgid ""
"In `--sq-quote` mode, 'git rev-parse' echoes on the standard output a single "
"line suitable for `sh(1)` `eval`. This line is made by normalizing the "
"arguments following `--sq-quote`. Nothing other than quoting the arguments "
"is done."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:473
msgid ""
"If you want command input to still be interpreted as usual by 'git "
"rev-parse' before the output is shell quoted, see the `--sq` option."
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:485
#, no-wrap
msgid ""
"$ cat >your-git-script.sh <<\\EOF\n"
"#!/bin/sh\n"
"args=$(git rev-parse --sq-quote \"$@\")   # quote user-supplied arguments\n"
"command=\"git frotz -n24 $args\"          # and use it inside a "
"handcrafted\n"
"\t\t\t\t\t# command line\n"
"eval \"$command\"\n"
"EOF\n"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:487
#, no-wrap
msgid "$ sh your-git-script.sh \"a b'c\"\n"
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:490
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:493
msgid "Print the object name of the current commit:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:496
#, no-wrap
msgid "$ git rev-parse --verify HEAD\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:499
msgid "Print the commit object name from the revision in the $REV shell variable:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:502
#, no-wrap
msgid "$ git rev-parse --verify --end-of-options $REV^{commit}\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:505
msgid "This will error out if $REV is empty or not a valid revision."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:507
msgid "Similar to above:"
msgstr ""

#. type: delimited block -
#: ../Documentation-sedout/git-rev-parse.txt:510
#, no-wrap
msgid "$ git rev-parse --default master --verify --end-of-options $REV\n"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:513
msgid "but if $REV is empty, the commit object name from master will be printed."
msgstr ""

#. type: Title -
#: ../Documentation-sedout/git-rev-parse.txt:515
#, no-wrap
msgid "GIT"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-rev-parse.txt:516
msgid "Part of the linkgit:git[1] suite"
msgstr ""
