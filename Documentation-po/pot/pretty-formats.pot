#. type: Labeled list
#: ../Documentation-sedout/pretty-formats.adoc:123
#, no-wrap
msgid "++%n++"
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/pretty-formats.adoc:124
msgid "newline"
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/pretty-formats.adoc:124
#, no-wrap
