#. type: Plain text
#: ../Documentation/config/add.txt:5
msgid ""
"Tells `git add` to continue adding files when some files cannot be added due "
"to indexing errors."
msgstr ""

#. type: Plain text
#: ../Documentation/config/add.txt:7
#, no-wrap
msgid "\tEquivalent to the `--ignore-errors` option.\n"
msgstr ""

#. type: Plain text
#: ../Documentation/config/add.txt:10
#, no-wrap
msgid "\tEquivalent to the `--ignore-errors` option of linkgit:git-add[1].\n"
msgstr ""

#. type: Plain text
#: ../Documentation/config/add.txt:12
#, no-wrap
msgid ""
"\t`add.ignore-errors` is deprecated, as it does not follow the usual\n"
"\tnaming convention for configuration variables.\n"
msgstr ""

#~ msgid ""
#~ "Tells 'git add' to continue adding files when some files cannot be added "
#~ "due to indexing errors. Equivalent to the `--ignore-errors` option of "
#~ "linkgit:git-add[1].  `add.ignore-errors` is deprecated, as it does not "
#~ "follow the usual naming convention for configuration variables."
#~ msgstr ""
#~ "インデックスエラーのために一部のファイルを追加できない場合にファイルの追加"
#~ "を続行するように `git add` に指示します。 linkgit:git-add[1] の `--ignore-"
#~ "errors` オプションと同等です。 `add.ignore-errors` は、構成変数の通常の命"
#~ "名規則に従わないため、非推奨になりました。"

#, no-wrap
#~ msgid "add.interactive.useBuiltin"
#~ msgstr "add.interactive.useBuiltin"

#~ msgid ""
#~ "Unused configuration variable. Used in Git versions v2.25.0 to v2.36.0 to "
#~ "enable the built-in version of linkgit:git-add[1]'s interactive mode, "
#~ "which then became the default in Git versions v2.37.0 to v2.39.0."
#~ msgstr ""
#~ "未使用の構成変数。 Git バージョン v2.25.0 〜 v2.36.0 で linkgit:git-"
#~ "add[1] の対話モード(interactive mode)の(Perlバージョンではなく)組み込み"
#~ "バージョンを有効にするために使用され、 その後 Git バージョン v2.37.0 〜 "
#~ "v2.39.0 では組み込みバージョン有効がデフォルトになっていました。"
