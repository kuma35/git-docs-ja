#: ../Documentation-sedout/git-interpret-trailers.txt:340
#, no-wrap
msgid ""
"body text\n"
"$ git interpret-trailers --trailer 'sign: Alice <alice@example.com>' --trailer 'sign: Bob <bob@example.com>' <msg.txt\n"
"subject\n"
msgstr ""
"body text\n"
"$ git interpret-trailers --trailer 'sign: Alice <alice@example.com>' --trailer 'sign: Bob <bob@example.com>' <msg.txt\n"
"subject\n"

