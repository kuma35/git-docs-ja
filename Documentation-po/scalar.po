#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/scalar.txt:179
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"
