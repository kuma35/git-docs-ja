#. type: Title =
#: ../Documentation-sedout/git-http-fetch.txt:2
#, no-wrap
msgid "git-http-fetch(1)"
msgstr "git-http-fetch(1)"

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:7
msgid "git-http-fetch - Download from a remote Git repository via HTTP"
msgstr "git-http-fetch - HTTPでリモートGitリポジトリからダウンロード"

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:13
#, fuzzy
#| msgid ""
#| "'git http-fetch' [-c] [-t] [-a] [-d] [-v] [-w <filename>] [--recover] [--"
#| "stdin | --packfile=<hash> | <commit>] <URL>\n"
msgid ""
"'git http-fetch' [-c] [-t] [-a] [-d] [-v] [-w <filename>] [--recover] [--"
"stdin | --packfile=<hash> | <commit>] <URL>"
msgstr ""
"'git http-fetch' [-c] [-t] [-a] [-d] [-v] [-w <filename>] [--recover] [--"
"stdin | --packfile=<hash> | <commit>] <URL>\n"

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:17
msgid "Downloads a remote Git repository via HTTP."
msgstr "HTTPでリモートGitリポジトリからダウンロード"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:21
msgid ""
"This command always gets all objects. Historically, there were three options "
"`-a`, `-c` and `-t` for choosing which objects to download. They are now "
"silently ignored."
msgstr ""
"このコマンドは常にすべてのオブジェクトを取得します。歴史的に、ダウンロードす"
"るオブジェクトを選択するには、 `-a` と `-c` と `-t` の3つのオプションがありま"
"した。それらは現在、何も警告を出さずに無視されます。"

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-http-fetch.txt:24
#, no-wrap
msgid "commit-id"
msgstr "commit-id"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:27
msgid "Either the hash or the filename under [URL]/refs/ to pull."
msgstr "プルするハッシュ、または [URL]/refs/ 下のファイル名 のいずれか。"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:32
#, fuzzy, no-wrap
#| msgid "These options are ignored for historical reasons."
msgid ""
"`-a,`\n"
"\tThese options are ignored for historical reasons.\n"
"`-v::`\n"
"\tReport what is downloaded.\n"
msgstr "これらのオプションは、歴史的な理由により無視されます。"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:36
#, fuzzy, no-wrap
#| msgid "Writes the commit-id into the filename under $GIT_DIR/refs/<filename> on the local end after the transfer is complete."
msgid ""
"`-w`\n"
"\tWrites the commit-id into the specified filename under $GIT_DIR/refs/<filename> on\n"
"        the local end after the transfer is complete.\n"
msgstr "転送が完了した後、ローカル側ドの $GIT_DIR/refs/<filename> の下のファイル名にcommit-idを書き込みます。"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:40
#, fuzzy, no-wrap
#| msgid "Instead of a commit id on the command line (which is not expected in this case), 'git http-fetch' expects lines on stdin in the format"
msgid ""
"`--stdin::`\n"
"\tInstead of a commit id on the command line (which is not expected in this\n"
"\tcase), 'git http-fetch' expects lines on stdin in the format\n"
msgstr "(この場合は期待されていない)コマンドラインのコミットIDの代わりに、 `githttp-fetch` は標準入力からの行を以下の形式であると期待します"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:42
#, fuzzy, no-wrap
#| msgid "<commit-id>['\\t'<filename-as-in--w>]\n"
msgid "\t\t<commit-id>['\\t'<filename-as-in--w>]\n"
msgstr "<commit-id>['\\t'<filename-as-in--w>]\n"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:51
#, fuzzy, no-wrap
#| msgid "For internal use only. Instead of a commit id on the command line (which is not expected in this case), 'git http-fetch' fetches the packfile directly at the given URL and uses index-pack to generate corresponding .idx and .keep files.  The hash is used to determine the name of the temporary file and is arbitrary. The output of index-pack is printed to stdout. Requires --index-pack-args."
msgid ""
"`--packfile=<hash>::`\n"
"\tFor internal use only. Instead of a commit id on the command\n"
"\tline (which is not expected in\n"
"\tthis case), 'git http-fetch' fetches the packfile directly at the given\n"
"\tURL and uses index-pack to generate corresponding .idx and .keep files.\n"
"\tThe hash is used to determine the name of the temporary file and is\n"
"\tarbitrary. The output of index-pack is printed to stdout. Requires\n"
"\t--index-pack-args.\n"
msgstr "内部使用のみ。 (この場合は期待されていない)コマンドラインのコミットIDの代わりに、 `git http-fetch` は指定されたURLで直接パックファイルをフェッチし、 index-pack を使用して対応する .idx ファイルと .keep ファイルを生成します。ハッシュは一時ファイルの名前を決定するために使用され、任意です。 index-pack の出力は stdout に出力されます。 `--index-pack-args` が必要です。"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:55
#, fuzzy, no-wrap
#| msgid "For internal use only. The command to run on the contents of the downloaded pack. Arguments are URL-encoded separated by spaces."
msgid ""
"`--index-pack-args=<args>::`\n"
"\tFor internal use only. The command to run on the contents of the\n"
"\tdownloaded pack. Arguments are URL-encoded separated by spaces.\n"
msgstr "内部使用のみ。 ダウンロードしたパックの内容に対して実行するコマンド。引数はスペースで区切られURLエンコードされます。"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:59
#, fuzzy, no-wrap
#| msgid "Verify that everything reachable from target is fetched.  Used after an earlier fetch is interrupted."
msgid ""
"`--recover::`\n"
"\tVerify that everything reachable from target is fetched.  Used after\n"
"\tan earlier fetch is interrupted.\n"
msgstr "ターゲットから到達可能なすべてのものがフェッチされていることを確認します。以前のフェッチが中断された後に使用されます。"

#. type: Title -
#: ../Documentation-sedout/git-http-fetch.txt:61
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/git-http-fetch.txt:62
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"

