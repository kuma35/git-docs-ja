#. type: Title =
#: ../Documentation/RelNotes/2.41.2.txt:2
#, no-wrap
msgid "Git v2.41.2 Release Notes"
msgstr ""

#. type: Plain text
#: ../Documentation/RelNotes/2.41.2.txt:9
msgid ""
"In preparing security fixes for four CVEs, we made overly aggressive "
"\"defense in depth\" changes that broke legitimate use cases like 'git lfs' "
"and 'git annex.' This release is to revert these misguided, if well-"
"intentioned, changes that were shipped in 2.41.1 and were not direct "
"security fixes."
msgstr ""

#. type: Plain text
#: ../Documentation/RelNotes/2.41.2.txt:16
#, no-wrap
msgid ""
"Jeff King (5):\n"
"      send-email: drop FakeTerm hack\n"
"      send-email: avoid creating more than one Term::ReadLine object\n"
"      ci: drop mention of BREW_INSTALL_PACKAGES variable\n"
"      ci: avoid bare \"gcc\" for osx-gcc job\n"
"      ci: stop installing \"gcc-13\" for osx-gcc\n"
msgstr ""

#. type: Plain text
#: ../Documentation/RelNotes/2.41.2.txt:24
#, no-wrap
msgid ""
"Johannes Schindelin (6):\n"
"      hook: plug a new memory leak\n"
"      init: use the correct path of the templates directory again\n"
"      Revert \"core.hooksPath: add some protection while cloning\"\n"
"      tests: verify that `clone -c core.hooksPath=/dev/null` works again\n"
"      clone: drop the protections where hooks aren't run\n"
"      Revert \"Add a helper function to compare file contents\"\n"
msgstr ""

#. type: Plain text
#: ../Documentation/RelNotes/2.41.2.txt:26
#, no-wrap
msgid ""
"Junio C Hamano (1):\n"
"      Revert \"fsck: warn about symlink pointing inside a gitdir\"\n"
msgstr ""
