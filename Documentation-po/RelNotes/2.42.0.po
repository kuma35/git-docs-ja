"pack-objects-parseopt-fix later to maint).  (merge 30c8c55cbf jc/tree-walk-"
"drop-base-offset later to maint).  (merge d089a06421 rs/bundle-parseopt-"
"cleanup later to maint).  (merge 823839bda1 ew/sha256-gcrypt-leak-fixes "
