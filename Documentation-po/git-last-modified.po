#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:7
msgid "git-last-modified - EXPERIMENTAL: Show when files were last modified"
msgstr ""
"git-last-modified - 実験的(EXPERIMENTAL): ファイルが最後に変更されたときを表"
"示"

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:13
#, fuzzy, no-wrap
#| msgid "git last-modified [--recursive] [--show-trees] [<revision-range>] [[--] <path>...]"
msgid "\tgit last-modified [--recursive] [--show-trees] [<revision-range>] [[--] <path>...]\n"
msgstr "git last-modified [--recursive] [--show-trees] [<revision-range>] [[--] <path>...]"

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:15
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:19
msgid ""
"Shows which commit last modified each of the relevant files and "
"subdirectories.  A commit renaming a path, or changing it's mode is also "
"taken into account."
msgstr ""

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:21
msgid "THIS COMMAND IS EXPERIMENTAL. THE BEHAVIOR MAY CHANGE."
msgstr ""
"※このコマンドは実験的な(EXPERIMENTAL)ものです。 動作は変更される可能性があり"
"ます。"

#. type: Title -
#: ../Documentation-sedout/git-last-modified.adoc:23
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:25
#, no-wrap
msgid "`-r`"
msgstr "`-r`"

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:26
#, no-wrap
msgid "`--recursive`"
msgstr "`--recursive`"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:29
msgid ""
"Instead of showing tree entries, step into subtrees and show all entries "
"inside them recursively."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:30
#, no-wrap
msgid "`-t`"
msgstr "`-t`"

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:31
#, no-wrap
msgid "`--show-trees`"
msgstr "`--show-trees`"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:34
msgid ""
"Show tree entries even when recursing into them. It has no effect without `--"
"recursive`."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:35
#, no-wrap
msgid "`<revision-range>`"
msgstr "`<revision-range>`"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:41
msgid ""
"Only traverse commits in the specified revision range. When no `<revision-"
"range>` is specified, it defaults to `HEAD` (i.e. the whole history leading "
"to the current commit). For a complete list of ways to spell `<revision-"
"range>`, see the 'Specifying Ranges' section of linkgit:gitrevisions[7]."
msgstr ""

#. type: Labeled list
#: ../Documentation-sedout/git-last-modified.adoc:42
#, no-wrap
msgid "`[--] <path>...`"
msgstr "`[--] <path>...`"

#. type: Plain text
#: ../Documentation-sedout/git-last-modified.adoc:46
msgid ""
"For each _<path>_ given, the commit which last modified it is returned.  "
"Without an optional path parameter, all files and subdirectories in path "
"traversal the are included in the output."
msgstr ""

