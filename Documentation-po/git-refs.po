#. type: Title =
#: ../Documentation-sedout/git-refs.txt:2
#, no-wrap
msgid "git-refs(1)"
msgstr "git-refs(1)"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:7
msgid "git-refs - Low-level access to refs"
msgstr "git-refs - ref への低レベル・アクセス"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:14
#, no-wrap
msgid ""
"\t'git refs migrate' --ref-format=<format> [--dry-run]\n"
"\t'git refs verify' [--strict] [--verbose]\n"
msgstr ""
"\t'git refs migrate' --ref-format=<format> [--dry-run]\n"
"\t'git refs verify' [--strict] [--verbose]\n"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:19
msgid "This command provides low-level access to refs."
msgstr "このコマンドは ref への低レベル・アクセスを提供します。"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:21
#, no-wrap
msgid "COMMANDS"
msgstr "COMMANDS"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:23
#, no-wrap
msgid "migrate"
msgstr "migrate"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:25
msgid "Migrate ref store between different formats."
msgstr "異なる形式間で ref ストアを移行します。"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:26
#, no-wrap
msgid "verify"
msgstr "verify"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:28
msgid "Verify reference database consistency."
msgstr "リファレンス・データーベースの一貫性を検証する。"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:30
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:33
msgid "The following options are specific to 'git refs migrate':"
msgstr "以下のオプション達は `git refs migrate` 用です:"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:34
#, no-wrap
msgid "`--ref-format=<format>`"
msgstr "`--ref-format=<format>`"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:36
msgid "The ref format to migrate the ref store to. Can be one of:"
msgstr "ref ストアを移行する対象の ref 形式。 以下のいずれかになります:"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:39
#, no-wrap
msgid "`--dry-run`"
msgstr "`--dry-run`"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:45
msgid ""
"Perform the migration, but do not modify the repository. The migrated refs "
"will be written into a separate directory that can be inspected separately. "
"The name of the directory will be reported on stdout. This can be used to "
"double check that the migration works as expected before performing the "
"actual migration."
msgstr "移行を実行しますが、 リポジトリーは変更しません。 移行された ref  は、 別個に検査できるように別のディレクトリに書き込まれます。 ディレクトリの名前は stdout で報告されます。 これを使用して、 実際の移行を実行する前に、 移行が予想どおりに機能することを再確認できます。"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:47
msgid "The following options are specific to 'git refs verify':"
msgstr "以下のオプション達は `git refs verify` 用です:"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:48
#, no-wrap
msgid "`--strict`"
msgstr "`--strict`"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:51
msgid ""
"Enable stricter error checking. This will cause warnings to be reported as "
"errors. See linkgit:git-fsck[1]."
msgstr "より厳格なエラー・チェックを有効にします。 これにより、 警告がエラーとして報告されます。 inkgit:git-fsck[1] 参照。"

#. type: Labeled list
#: ../Documentation-sedout/git-refs.txt:52
#, no-wrap
msgid "`--verbose`"
msgstr "`--verbose`"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:54
msgid "When verifying the reference database consistency, be chatty."
msgstr "ref データベースの一貫性を確認するときに、 おしゃべりにします。"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:56
#, no-wrap
msgid "KNOWN LIMITATIONS"
msgstr "既知の制限"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:59
msgid ""
"The ref format migration has several known limitations in its current form:"
msgstr "ref 形式の移行については、 現在の形式ではいくつかの既知の制限があります:"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:61
msgid "It is not possible to migrate repositories that have reflogs."
msgstr "reflog を持つリポジトリーの移行はできません。"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:63
msgid "It is not possible to migrate repositories that have worktrees."
msgstr "ワークツリーを持つリポジトリーの移行はできません。"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:69
msgid ""
"There is no way to block concurrent writes to the repository during an "
"ongoing migration. Concurrent writes can lead to an inconsistent migrated "
"state. Users are expected to block writes on a higher level. If your "
"repository is registered for scheduled maintenance, it is recommended to "
"unregister it first with git-maintenance(1)."
msgstr "移行の進行中、 リポジトリーへの並列書き込みをブロックする方法はありません。 並列書き込みは一貫性のない移行状態につながる可能性があります。 ユーザーは、 より高いレベルで書き込みをブロックすることが期待されています。 あなたのリポジトリーがスケジュールされたメンテナンスのために登録されている場合、  git-maintenance(1) で最初に登録解除することをお勧めします。"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:71
msgid "These limitations may eventually be lifted."
msgstr "これらの制限は将来的には解除される可能性があります。"

#. type: Title -
#: ../Documentation-sedout/git-refs.txt:73
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/git-refs.txt:74
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"
