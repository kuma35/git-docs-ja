#. type: Title =
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:2
#, no-wrap
msgid "git-fmt-merge-msg(1)"
msgstr "git-fmt-merge-msg(1)"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:7
msgid "git-fmt-merge-msg - Produce a merge commit message"
msgstr "git-fmt-merge-msg - マージ・コミット・メッセージを生成します"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:14
#, no-wrap
msgid ""
"\t'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | --no-log]\n"
"\t'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>\n"
msgstr ""
"\t'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | --no-log]\n"
"\t'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>\n"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:16
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:20
msgid ""
"Takes the list of merged objects on stdin and produces a suitable commit "
"message to be used for the merge commit, usually to be passed as the '<merge-"
"message>' argument of 'git merge'."
msgstr ""
"標準入力からマージされたオブジェクトのリストを取得し、マージコミットに使用さ"
"れる適切なコミットメッセージを生成します。通常は、 `git merge` の `<merge-"
"message>` 引数として渡されます。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:23
msgid ""
"This command is intended mostly for internal use by scripts automatically "
"invoking 'git merge'."
msgstr ""
"このコマンドは主に、 `git merge` を自動的に呼び出すスクリプトによる内部使用を"
"目的としています。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:25
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:27
#, no-wrap
msgid "`--log[=<n>]`"
msgstr "`--log[=<n>]`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:33
msgid ""
"In addition to branch names, populate the log message with one-line "
"descriptions from the actual commits that are being merged.  At most <n> "
"commits from each merge parent will be used (20 if <n> is omitted).  This "
"overrides the `merge.log` configuration variable."
msgstr ""
"ブランチ名に加えて、マージされている実際のコミットからの1行説明をログメッセー"
"ジに入力します。各マージ親からの最大で <n> のコミットが使用されます(<n> が省"
"略されている場合は20)。これは、 `merge.log` 構成変数をオーバーライドします。"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:34
#, no-wrap
msgid "`--no-log`"
msgstr "`--no-log`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:37
msgid "Do not list one-line descriptions from the actual commits being merged."
msgstr "マージされる実際のコミットからの1行説明をリストしません。"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:38
#, no-wrap
msgid "`--summary`"
msgstr "`--summary`"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:39
#, no-wrap
msgid "`--no-summary`"
msgstr "`--no-summary`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:42
msgid ""
"Synonyms to --log and --no-log; these are deprecated and will be removed in "
"the future."
msgstr ""
"`--log` や `--no-log` の同義語。これは非推奨であり、将来削除される予定です。"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:43
#, no-wrap
msgid "`-m <message>`"
msgstr "`-m <message>`"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:44
#, no-wrap
msgid "`--message <message>`"
msgstr "`--message <message>`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:47
msgid ""
"Use <message> instead of the branch names for the first line of the log "
"message.  For use with `--log`."
msgstr ""
"ログメッセージの最初の行に、ブランチ名の代わりに <message> を使用します。 `--"
"log` で使用します。"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:48
#, no-wrap
msgid "`--into-name <branch>`"
msgstr "`--into-name <branch>`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:51
msgid ""
"Prepare the merge message as if merging to the branch `<branch>`, instead of "
"the name of the real branch to which the merge is made."
msgstr ""
"マージ先の実際のブランチの名前ではなく、 ブランチ `<branch>` にマージするかの"
"ようにマージ・メッセージを準備します。"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:52
#, no-wrap
msgid "`-F <file>`"
msgstr "`-F <file>`"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:53
#, no-wrap
msgid "`--file <file>`"
msgstr "`--file <file>`"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:56
msgid "Take the list of merged objects from <file> instead of stdin."
msgstr ""
"標準入力の代わりに <file> からマージされたオブジェクトのリストを取得します。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:58
#, no-wrap
msgid "CONFIGURATION"
msgstr "CONFIGURATION"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:61
#, no-wrap
msgid "merge.summary"
msgstr "merge.summary"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:64
msgid ""
"Synonym to `merge.log`; this is deprecated and will be removed in the future."
msgstr "`merge.log` の同義語。これは非推奨であり、将来削除される予定です。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:66
#, no-wrap
msgid "EXAMPLES"
msgstr "EXAMPLES"

#. type: delimited block -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:71
#, no-wrap
msgid ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"
msgstr ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:75
msgid ""
"Print a log message describing a merge of the \"master\" branch from the "
"\"origin\" remote."
msgstr ""
"「origin」リモートからの「master」ブランチのマージを説明するログメッセージを"
"出力します。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.adoc:78
#, no-wrap
msgid "SEE ALSO"
msgstr "SEE ALSO"

