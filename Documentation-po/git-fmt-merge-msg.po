#. type: Title =
#: ../Documentation-sedout/git-fmt-merge-msg.txt:2
#, no-wrap
msgid "git-fmt-merge-msg(1)"
msgstr "git-fmt-merge-msg(1)"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:7
msgid "git-fmt-merge-msg - Produce a merge commit message"
msgstr ""
"git-fmt-merge-msg - git-fmt-merge-msg-マージコミットメッセージを生成します"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:14
#, fuzzy
#| msgid ""
#| "'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | "
#| "--no-log]\n"
#| "'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>\n"
msgid ""
"'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | --"
"no-log] 'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>"
msgstr ""
"'git fmt-merge-msg' [-m <message>] [--into-name <branch>] [--log[=<n>] | --"
"no-log]\n"
"'git fmt-merge-msg' [-m <message>] [--log[=<n>] | --no-log] -F <file>\n"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:16
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:20
msgid ""
"Takes the list of merged objects on stdin and produces a suitable commit "
"message to be used for the merge commit, usually to be passed as the '<merge-"
"message>' argument of 'git merge'."
msgstr ""
"標準入力からマージされたオブジェクトのリストを取得し、マージコミットに使用さ"
"れる適切なコミットメッセージを生成します。通常は、 `git merge` の `<merge-"
"message>` 引数として渡されます。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:23
msgid ""
"This command is intended mostly for internal use by scripts automatically "
"invoking 'git merge'."
msgstr ""
"このコマンドは主に、 `git merge` を自動的に呼び出すスクリプトによる内部使用を"
"目的としています。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:25
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:33
#, fuzzy, no-wrap
#| msgid "In addition to branch names, populate the log message with one-line descriptions from the actual commits that are being merged.  At most <n> commits from each merge parent will be used (20 if <n> is omitted).  This overrides the `merge.log` configuration variable."
msgid ""
"`--log[=<n>]::`\n"
"\tIn addition to branch names, populate the log message with\n"
"\tone-line descriptions from the actual commits that are being\n"
"\tmerged.  At most <n> commits from each merge parent will be\n"
"\tused (20 if <n> is omitted).  This overrides the `merge.log`\n"
"\tconfiguration variable.\n"
msgstr "ブランチ名に加えて、マージされている実際のコミットからの1行説明をログメッセージに入力します。各マージ親からの最大で <n> のコミットが使用されます(<n> が省略されている場合は20)。これは、 `merge.log` 構成変数をオーバーライドします。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:37
#, fuzzy, no-wrap
#| msgid "Do not list one-line descriptions from the actual commits being merged."
msgid ""
"`--no-log::`\n"
"\tDo not list one-line descriptions from the actual commits being\n"
"\tmerged.\n"
msgstr "マージされる実際のコミットからの1行説明をリストしません。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:41
#, fuzzy, no-wrap
#| msgid "Synonyms to --log and --no-log; these are deprecated and will be removed in the future."
msgid ""
"`--[no-]summary::`\n"
"\tSynonyms to --log and --no-log; these are deprecated and will be\n"
"\tremoved in the future.\n"
msgstr "`--log` や `--no-log` の同義語。これは非推奨であり、将来削除される予定です。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:46
#, fuzzy, no-wrap
#| msgid "Use <message> instead of the branch names for the first line of the log message.  For use with `--log`."
msgid ""
"`-m`\n"
"`--message`\n"
"\tUse <message> instead of the branch names for the first line\n"
"\tof the log message.  For use with `--log`.\n"
msgstr "ログメッセージの最初の行に、ブランチ名の代わりに <message> を使用します。 `--log` で使用します。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:50
#, fuzzy, no-wrap
#| msgid "Prepare the merge message as if merging to the branch `<branch>`, instead of the name of the real branch to which the merge is made."
msgid ""
"`--into-name`\n"
"\tPrepare the merge message as if merging to the branch `<branch>`,\n"
"\tinstead of the name of the real branch to which the merge is made.\n"
msgstr "マージ先の実際のブランチの名前ではなく、 ブランチ `<branch>` にマージするかのようにマージ・メッセージを準備します。"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:55
#, fuzzy, no-wrap
#| msgid "Take the list of merged objects from <file> instead of stdin."
msgid ""
"`-F`\n"
"`--file`\n"
"\tTake the list of merged objects from <file> instead of\n"
"\tstdin.\n"
msgstr "標準入力の代わりに <file> からマージされたオブジェクトのリストを取得します。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:57
#, no-wrap
msgid "CONFIGURATION"
msgstr "CONFIGURATION"

#. type: Labeled list
#: ../Documentation-sedout/git-fmt-merge-msg.txt:60
#, no-wrap
msgid "merge.summary"
msgstr "merge.summary"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:63
msgid ""
"Synonym to `merge.log`; this is deprecated and will be removed in the future."
msgstr "`merge.log` の同義語。これは非推奨であり、将来削除される予定です。"

#. type: Title -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:65
#, no-wrap
msgid "EXAMPLES"
msgstr "EXAMPLES"

#. type: delimited block -
#: ../Documentation-sedout/git-fmt-merge-msg.txt:70
#, no-wrap
msgid ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"
msgstr ""
"$ git fetch origin master\n"
"$ git fmt-merge-msg --log <$GIT_DIR/FETCH_HEAD\n"

#. type: Plain text
#: ../Documentation-sedout/git-fmt-merge-msg.txt:74
msgid ""
"Print a log message describing a merge of the \"master\" branch from the "
"\"origin\" remote."
msgstr ""
"「origin」リモートからの「master」ブランチのマージを説明するログメッセージを"
"出力します。"

