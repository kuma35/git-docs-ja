#. type: Title =
#: ../Documentation-sedout/git-mailsplit.txt:2
#, no-wrap
msgid "git-mailsplit(1)"
msgstr "git-mailsplit(1)"

#. type: Title -
#: ../Documentation-sedout/git-mailsplit.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:7
msgid "git-mailsplit - Simple UNIX mbox splitter program"
msgstr "git-mailsplit - 簡易 UNIX mbox 分割プログラム"

#. type: Title -
#: ../Documentation-sedout/git-mailsplit.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:13
#, no-wrap
msgid ""
"'git mailsplit' [-b] [-f<nn>] [-d<prec>] [--keep-cr] [--mboxrd]\n"
"\t\t-o<directory> [--] [(<mbox>|<Maildir>)...]\n"
msgstr ""
"'git mailsplit' [-b] [-f<nn>] [-d<prec>] [--keep-cr] [--mboxrd]\n"
"\t\t-o<directory> [--] [(<mbox>|<Maildir>)...]\n"

#. type: Title -
#: ../Documentation-sedout/git-mailsplit.txt:15
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:18
msgid ""
"Splits a mbox file or a Maildir into a list of files: \"0001\" \"0002\" ..  "
"in the specified directory so you can process them further from there."
msgstr ""
"mboxファイルまたはMaildirを指定のディレクトリ内でファイルのリストに分割し"
"(\"0001\" \"0002\" ..)、そこからさらに処理できるようにします。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:21
msgid ""
"Maildir splitting relies upon filenames being sorted to output patches in "
"the correct order."
msgstr ""
"Maildirの分割は、ファイル名が正しい順序でパッチを出力するためにソートされてい"
"ることに依存しています。"

#. type: Title -
#: ../Documentation-sedout/git-mailsplit.txt:23
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-mailsplit.txt:24
#, no-wrap
msgid "<mbox>"
msgstr "<mbox>"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:27
msgid ""
"Mbox file to split.  If not given, the mbox is read from the standard input."
msgstr ""
"分割するmboxファイル。指定しない場合、mboxは標準入力から読み取られます。"

#. type: Labeled list
#: ../Documentation-sedout/git-mailsplit.txt:28
#, no-wrap
msgid "<Maildir>"
msgstr "<Maildir>"

# Maildirとは
#
# Wikipediaの概要から要点だけ抜き出すと…
#
#     ・Maildirは、広く使われている電子メール格納フォーマットの一種
#     ・個々のメッセージは個別のファイルとして一意な名前付きで保持
#     ・Maildirサブディレクトリとして tmp、new、cur がある。
#     @Wikipedia 
#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:31
msgid ""
"Root of the Maildir to split. This directory should contain the cur, tmp and "
"new subdirectories."
msgstr ""
"分割するMaildirのルート。このディレクトリには、cur と tmp とnew サブディレク"
"トリが含まれている必要があります。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:34
#, fuzzy, no-wrap
#| msgid "Directory in which to place the individual messages."
msgid ""
"`-o<directory>::`\n"
"\tDirectory in which to place the individual messages.\n"
msgstr "個々のメッセージを配置するディレクトリ。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:38
#, fuzzy, no-wrap
#| msgid "If any file doesn't begin with a From line, assume it is a single mail message instead of signaling error."
msgid ""
"`-b::`\n"
"\tIf any file doesn't begin with a From line, assume it is a\n"
"\tsingle mail message instead of signaling an error.\n"
msgstr "ファイルがFrom行で始まらない場合は、エラーにするのではなく、単一のメールメッセージであると想定してください。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:43
#, fuzzy, no-wrap
#| msgid "Instead of the default 4 digits with leading zeros, different precision can be specified for the generated filenames."
msgid ""
"`-d<prec>::`\n"
"\tInstead of the default 4 digits with leading zeros,\n"
"\tdifferent precision can be specified for the generated\n"
"\tfilenames.\n"
msgstr "先行ゼロを含むデフォルトの4桁の代わりに、生成するファイル名に異なる桁数を指定できます。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:47
#, fuzzy, no-wrap
#| msgid "Skip the first <nn> numbers, for example if -f3 is specified, start the numbering with 0004."
msgid ""
"`-f<nn>::`\n"
"\tSkip the first <nn> numbers, for example if -f3 is specified,\n"
"\tstart the numbering with 0004.\n"
msgstr "出力ファイル名の最初の <nn> 番号までをスキップします。たとえば、 -f3 が指定されている場合は、番号を0004から始めます。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:50
#, fuzzy, no-wrap
#| msgid "Do not remove `\\r` from lines ending with `\\r\\n`."
msgid ""
"`--keep-cr::`\n"
"\tDo not remove `\\r` from lines ending with `\\r\\n`.\n"
msgstr "`\\r\\n` で終わる行から `\\r` を削除しないでください。"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:54
#, fuzzy, no-wrap
#| msgid "Input is of the \"mboxrd\" format and \"^>+From \" line escaping is reversed."
msgid ""
"`--mboxrd::`\n"
"\tInput is of the \"mboxrd\" format and \"^>+From \" line escaping is\n"
"\treversed.\n"
msgstr "入力は「mboxrd」形式であり、 \"^>+From \" 行のエスケープは逆になります。"

#. type: Title -
#: ../Documentation-sedout/git-mailsplit.txt:56
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/git-mailsplit.txt:57
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"

