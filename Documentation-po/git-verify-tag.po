#. type: Title =
#: ../Documentation-sedout/git-verify-tag.adoc:2
#, no-wrap
msgid "git-verify-tag(1)"
msgstr "git-verify-tag(1)"

#. type: Title -
#: ../Documentation-sedout/git-verify-tag.adoc:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:7
msgid "git-verify-tag - Check the GPG signature of tags"
msgstr "git-verify-tag - タグのGPG署名を確認する"

#. type: Title -
#: ../Documentation-sedout/git-verify-tag.adoc:9
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:12
#, no-wrap
msgid "\tgit verify-tag [-v | --verbose] [--format=<format>] [--raw] <tag>...\n"
msgstr "\tgit verify-tag [-v | --verbose] [--format=<format>] [--raw] <tag>...\n"

#. type: Title -
#: ../Documentation-sedout/git-verify-tag.adoc:14
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:17
msgid ""
"Validates the gpg signature created by `git tag` in the tag objects listed "
"on the command line."
msgstr "コマンドラインに列挙されたタグオブジェクトに対して、 `git tag` によって作成されたgpg署名を検証します。"

#. type: Title -
#: ../Documentation-sedout/git-verify-tag.adoc:19
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation-sedout/git-verify-tag.adoc:20
#, no-wrap
msgid "`--raw`"
msgstr "`--raw`"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:23
msgid ""
"Print the raw gpg status output to standard error instead of the normal "
"human-readable output."
msgstr ""
"通常の人間が読める形式の出力の代わりに、生のgpgステータス出力を標準エラーに出"
"力します。"

#. type: Labeled list
#: ../Documentation-sedout/git-verify-tag.adoc:24
#, no-wrap
msgid "`-v`"
msgstr "`-v`"

#. type: Labeled list
#: ../Documentation-sedout/git-verify-tag.adoc:25
#, no-wrap
msgid "`--verbose`"
msgstr "`--verbose`"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:27
msgid "Print the contents of the tag object before validating it."
msgstr "検証する前に、タグオブジェクトの内容を出力します。"

#. type: Title -
#: ../Documentation-sedout/git-verify-tag.adoc:29
#, no-wrap
msgid "GIT"
msgstr "GIT"

#. type: Plain text
#: ../Documentation-sedout/git-verify-tag.adoc:30
msgid "Part of the linkgit:git[1] suite"
msgstr "Part of the linkgit:git[1] suite"
