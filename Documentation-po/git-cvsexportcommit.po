#. type: Title =
#: ../Documentation-sedout/git-cvsexportcommit.txt:2
#, no-wrap
msgid "git-cvsexportcommit(1)"
msgstr "git-cvsexportcommit(1)"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:7
msgid "git-cvsexportcommit - Export a single commit to a CVS checkout"
msgstr ""
"git-cvsexportcommit - 単一のコミットをCVSチェックアウトにエクスポートします"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:10
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:14
#, no-wrap
msgid ""
"'git cvsexportcommit' [-h] [-u] [-v] [-c] [-P] [-p] [-a] [-d <cvsroot>]\n"
"\t[-w <cvs-workdir>] [-W] [-f] [-m <msgprefix>] [<parent-commit>] <commit-id>\n"
msgstr ""
"'git cvsexportcommit' [-h] [-u] [-v] [-c] [-P] [-p] [-a] [-d <cvsroot>]\n"
"\t[-w <cvs-workdir>] [-W] [-f] [-m <msgprefix>] [<parent-commit>] <commit-id>\n"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:17
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:20
msgid ""
"Exports a commit from Git to a CVS checkout, making it easier to merge "
"patches from a Git repository into a CVS repository."
msgstr ""
"コミットをGitからCVSチェックアウトにエクスポートし、GitリポジトリからCVSリポ"
"ジトリへのパッチのマージを容易にします。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:24
msgid ""
"Specify the name of a CVS checkout using the -w switch or execute it from "
"the root of the CVS working copy. In the latter case GIT_DIR must be "
"defined. See examples below."
msgstr ""
"`-w` スイッチを使用してCVSチェックアウトの名前を指定するか、CVS作業コピーの"
"ルートから実行します。後者の場合、GIT_DIRを定義する必要があります。以下の例を"
"参照してください。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:28
msgid ""
"It does its best to do the safe thing, it will check that the files are "
"unchanged and up to date in the CVS checkout, and it will not autocommit by "
"default."
msgstr ""
"安全寄りに最大限振って、CVSチェックアウトでファイルが変更されておらず、最新で"
"あることを確認したら、デフォルトでは自動コミットしません。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:30
msgid ""
"Supports file additions, removals, and commits that affect binary files."
msgstr ""
"バイナリファイルに影響するファイルの追加、削除、およびコミットをサポートしま"
"す。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:33
msgid ""
"If the commit is a merge commit, you must tell 'git cvsexportcommit' what "
"parent the changeset should be done against."
msgstr ""
"コミットがマージコミットの場合は、あなたは `git cvsexportcommit` にchangeset"
"の対象となる親を指定する必要があります。"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:35
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:40
#, fuzzy, no-wrap
#| msgid "Commit automatically if the patch applied cleanly. It will not commit if any hunks fail to apply or there were other problems."
msgid ""
"`-c::`\n"
"\tCommit automatically if the patch applied cleanly. It will not\n"
"\tcommit if any hunks fail to apply or there were other problems.\n"
msgstr "パッチが正常に適用された場合、自動的にコミットします。ハンクが適用されない場合、またはその他の問題が発生した場合、コミットされません。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:44
#, fuzzy, no-wrap
#| msgid "Be pedantic (paranoid) when applying patches. Invokes patch with --fuzz=0"
msgid ""
"`-p::`\n"
"\tBe pedantic (paranoid) when applying patches. Invokes patch with\n"
"\t--fuzz=0\n"
msgstr "パッチを適用するときは、pedantic(衒学的)(paranoid;病的なほど疑り深い)にする。 `--fuzz=0` でpatchを呼び出します。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:48
#, fuzzy, no-wrap
#| msgid "Add authorship information. Adds Author line, and Committer (if different from Author) to the message."
msgid ""
"`-a::`\n"
"\tAdd authorship information. Adds Author line, and Committer (if\n"
"\tdifferent from Author) to the message.\n"
msgstr "著者情報を追加します。作者行と(作成者と異なる場合)コミッターをメッセージに追加します。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:53
#, fuzzy, no-wrap
#| msgid "Set an alternative CVSROOT to use.  This corresponds to the CVS -d parameter.  Usually users will not want to set this, except if using CVS in an asymmetric fashion."
msgid ""
"`-d::`\n"
"\tSet an alternative CVSROOT to use.  This corresponds to the CVS\n"
"\t-d parameter.  Usually users will not want to set this, except\n"
"\tif using CVS in an asymmetric fashion.\n"
msgstr "使用する代替CVSROOTを設定します。これは、 `CVS -d` パラメーターに対応します。 非対称的な方法でCVSを使用する場合を除いて、通常、ユーザーはこれを設定することは無いと思います。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:56
#, fuzzy, no-wrap
#| msgid "Force the merge even if the files are not up to date."
msgid ""
"`-f::`\n"
"\tForce the merge even if the files are not up to date.\n"
msgstr "ファイルが最新でない場合でも、強制的にマージします。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:59
#, fuzzy, no-wrap
#| msgid "Force the parent commit, even if it is not a direct parent."
msgid ""
"`-P::`\n"
"\tForce the parent commit, even if it is not a direct parent.\n"
msgstr "直接の親でなくても、親を強制的にコミットします。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:63
#, fuzzy, no-wrap
#| msgid "Prepend the commit message with the provided prefix.  Useful for patch series and the like."
msgid ""
"`-m::`\n"
"\tPrepend the commit message with the provided prefix.\n"
"\tUseful for patch series and the like.\n"
msgstr "コミットメッセージの前に、指定のプレフィックスを付けます。パッチシリーズなどに便利です。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:66
#, fuzzy, no-wrap
#| msgid "Update affected files from CVS repository before attempting export."
msgid ""
"`-u::`\n"
"\tUpdate affected files from CVS repository before attempting export.\n"
msgstr "エクスポートを試みる前に、影響を受けるファイルをCVSリポジトリから更新してください。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:70
#, fuzzy, no-wrap
#| msgid "Reverse CVS keyword expansion (e.g. $Revision: 1.2.3.4$ becomes $Revision$) in working CVS checkout before applying patch."
msgid ""
"`-k::`\n"
"\tReverse CVS keyword expansion (e.g. $Revision: 1.2.3.4$\n"
"\tbecomes $Revision$) in working CVS checkout before applying patch.\n"
msgstr "パッチを適用する前に、CVSチェックアウトの動作でCVSキーワード拡張を逆にします。 (例: $Revision: 1.2.3.4$ は $Revision$ になります)"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:76
#, fuzzy, no-wrap
#| msgid "Specify the location of the CVS checkout to use for the export. This option does not require GIT_DIR to be set before execution if the current directory is within a Git repository.  The default is the value of 'cvsexportcommit.cvsdir'."
msgid ""
"`-w::`\n"
"\tSpecify the location of the CVS checkout to use for the export. This\n"
"\toption does not require GIT_DIR to be set before execution if the\n"
"\tcurrent directory is within a Git repository.  The default is the\n"
"\tvalue of 'cvsexportcommit.cvsdir'.\n"
msgstr "エクスポートに使用するCVSチェックアウトの場所を指定します。現在のディレクトリがGitリポジトリ内にある場合、このオプションでは、実行前にGIT_DIRを設定する必要はありません。 デフォルトは `cvsexportcommit.cvsdir` の値です。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:81
#, fuzzy, no-wrap
#| msgid "Tell cvsexportcommit that the current working directory is not only a Git checkout, but also the CVS checkout.  Therefore, Git will reset the working directory to the parent commit before proceeding."
msgid ""
"`-W::`\n"
"\tTell cvsexportcommit that the current working directory is not only\n"
"\ta Git checkout, but also the CVS checkout.  Therefore, Git will\n"
"\treset the working directory to the parent commit before proceeding.\n"
msgstr "現在の作業ディレクトリがGitチェックアウトであるだけでなく、CVSチェックアウトでもあることをcvsexportcommitに伝えます。したがって、Gitは続行する前に作業ディレクトリを親コミットにリセットします。"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:84
#, fuzzy, no-wrap
#| msgid "Verbose."
msgid ""
"`-v::`\n"
"\tVerbose.\n"
msgstr "おしゃべりにします。"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:86
#, no-wrap
msgid "CONFIGURATION"
msgstr "CONFIGURATION"

#. type: Labeled list
#: ../Documentation-sedout/git-cvsexportcommit.txt:87
#, no-wrap
msgid "cvsexportcommit.cvsdir"
msgstr "cvsexportcommit.cvsdir"

#. type: Plain text
#: ../Documentation-sedout/git-cvsexportcommit.txt:89
msgid "The default location of the CVS checkout to use for the export."
msgstr "エクスポートに使用するCVSチェックアウトのデフォルトの場所。"

#. type: Title -
#: ../Documentation-sedout/git-cvsexportcommit.txt:91
#, no-wrap
msgid "EXAMPLES"
msgstr "EXAMPLES"

#. type: Labeled list
#: ../Documentation-sedout/git-cvsexportcommit.txt:93
#, no-wrap
msgid "Merge one patch into CVS"
msgstr "1つのパッチをCVSにマージします"

#. type: delimited block -
#: ../Documentation-sedout/git-cvsexportcommit.txt:100
#, no-wrap
msgid ""
"$ export GIT_DIR=~/project/.git\n"
"$ cd ~/project_cvs_checkout\n"
"$ git cvsexportcommit -v <commit-sha1>\n"
"$ cvs commit -F .msg <files>\n"
msgstr ""
"$ export GIT_DIR=~/project/.git\n"
"$ cd ~/project_cvs_checkout\n"
"$ git cvsexportcommit -v <commit-sha1>\n"
"$ cvs commit -F .msg <files>\n"

#. type: Labeled list
#: ../Documentation-sedout/git-cvsexportcommit.txt:102
#, no-wrap
msgid "Merge one patch into CVS (-c and -w options). The working directory is within the Git Repo"
msgstr "1つのパッチをCVSにマージします( `-c` および `-w` オプション)。作業ディレクトリはGitリポジトリ内にあります"

#. type: delimited block -
#: ../Documentation-sedout/git-cvsexportcommit.txt:106
#, no-wrap
msgid "\t$ git cvsexportcommit -v -c -w ~/project_cvs_checkout <commit-sha1>\n"
msgstr "\t$ git cvsexportcommit -v -c -w ~/project_cvs_checkout <commit-sha1>\n"

#. type: Labeled list
#: ../Documentation-sedout/git-cvsexportcommit.txt:108
#, no-wrap
msgid "Merge pending patches into CVS automatically -- only if you really know what you are doing"
msgstr "保留中のパッチをCVSに自動的にマージします -- 自分が何をしているかを本当に知っている場合だけにしましょう。"

#. type: delimited block -
#: ../Documentation-sedout/git-cvsexportcommit.txt:114
#, no-wrap
msgid ""
"$ export GIT_DIR=~/project/.git\n"
"$ cd ~/project_cvs_checkout\n"
"$ git cherry cvshead myhead | sed -n 's/^+ //p' | xargs -l1 git cvsexportcommit -c -p -v\n"
msgstr ""
"$ export GIT_DIR=~/project/.git\n"
"$ cd ~/project_cvs_checkout\n"
"$ git cherry cvshead myhead | sed -n 's/^+ //p' | xargs -l1 git cvsexportcommit -c -p -v\n"

