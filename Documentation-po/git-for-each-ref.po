#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation-sedout/git-for-each-ref.adoc:18
#, fuzzy, no-wrap
#| msgid ""
#| "'git for-each-ref' [--count=<count>] [--shell|--perl|--python|--tcl]\n"
#| "\t\t   [(--sort=<key>)...] [--format=<format>]\n"
#| "\t\t   [--include-root-refs] [ --stdin | <pattern>... ]\n"
#| "\t\t   [--points-at=<object>]\n"
#| "\t\t   [--merged[=<object>]] [--no-merged[=<object>]]\n"
#| "\t\t   [--contains[=<object>]] [--no-contains[=<object>]]\n"
#| "\t\t   [--exclude=<pattern> ...]\n"
msgid ""
"git for-each-ref [--count=<count>] [--shell|--perl|--python|--tcl]\n"
"\t\t   [(--sort=<key>)...] [--format=<format>]\n"
"\t\t   [--include-root-refs] [--points-at=<object>]\n"
"\t\t   [--merged[=<object>]] [--no-merged[=<object>]]\n"
"\t\t   [--contains[=<object>]] [--no-contains[=<object>]]\n"
"\t\t   [(--exclude=<pattern>)...] [--start-after=<marker>]\n"
"\t\t   [ --stdin | (<pattern>...)]\n"
msgstr ""
"'git for-each-ref' [--count=<count>] [--shell|--perl|--python|--tcl]\n"
"\t\t   [(--sort=<key>)...] [--format=<format>]\n"
"\t\t   [--include-root-refs] [ --stdin | <pattern>... ]\n"
"\t\t   [--points-at=<object>]\n"
"\t\t   [--merged[=<object>]] [--no-merged[=<object>]]\n"
"\t\t   [--contains[=<object>]] [--no-contains[=<object>]]\n"
"\t\t   [--exclude=<pattern> ...]\n"

#. type: Title -
#: ../Documentation-sedout/git-for-each-ref.adoc:20
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

# interpolate:ここではMS-wordの差し込み文書に着想を得て、「差し込み」と訳す事にする。
#. type: Plain text
#: ../Documentation-sedout/git-for-each-ref.adoc:28
#, fuzzy
#| msgid ""
#| "Iterate over all refs that match `<pattern>` and show them according to "
#| "the given `<format>`, after sorting them according to the given set of "
#| "`<key>`.  If `<count>` is given, stop after showing that many refs.  The "
#| "interpolated values in `<format>` can optionally be quoted as string "
#| "literals in the specified host language allowing their direct evaluation "
#| "in that language."
msgid ""
"Iterate over all refs that match _<pattern>_ and show them according to the "
"given _<format>_, after sorting them according to the given set of _<key>_.  "
"If _<count>_ is given, stop after showing that many refs.  The interpolated "
"values in _<format>_ can optionally be quoted as string literals in the "
"specified host language allowing their direct evaluation in that language."
msgstr ""
"`<pattern>` に一致するすべてのrefを繰り返し、指定された `<key>` の組に従って"
"並べ替えた後、指定の `<format>` に従って表示します。 `<count>` が指定されてい"
"る場合は、その数のrefを表示した後で停止します。 `<format>` のプレースホルダで"
"差し込みされる値は、オプションで、指定のホストプログラム言語の文字列リテラル"
"となるようクォートでき、そのホストプログラム言語で直接評価できます。"

