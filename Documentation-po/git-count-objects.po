#. type: Title =
#: ../Documentation/git-count-objects.txt:2
#, no-wrap
msgid "git-count-objects(1)"
msgstr "git-count-objects(1)"

#. type: Title -
#: ../Documentation/git-count-objects.txt:5
#, no-wrap
msgid "NAME"
msgstr "NAME"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:7
msgid ""
"git-count-objects - Count unpacked number of objects and their disk "
"consumption"
msgstr ""
"git-count-objects - パックされていない(unpack)オブジェクトの数とそのディスク"
"消費量を計量します"

#. type: Title -
#: ../Documentation/git-count-objects.txt:9
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:12
#, no-wrap
msgid "'git count-objects' [-v] [-H | --human-readable]\n"
msgstr "'git count-objects' [-v] [-H | --human-readable]\n"

#. type: Title -
#: ../Documentation/git-count-objects.txt:14
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:17
#, fuzzy
#| msgid ""
#| "This counts the number of unpacked object files and disk space consumed "
#| "by them, to help you decide when it is a good time to repack."
msgid ""
"Counts the number of unpacked object files and disk space consumed by them, "
"to help you decide when it is a good time to repack."
msgstr ""
"これは、パックされていないオブジェクトファイルの数とそれらによって消費された"
"ディスク領域を計量し、再パックするのに適した時期を判断するのに役立ちます。"

#. type: Title -
#: ../Documentation/git-count-objects.txt:20
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: Labeled list
#: ../Documentation/git-count-objects.txt:21
#, fuzzy, no-wrap
#| msgid "`-v`"
msgid "-v"
msgstr "`-v`"

#. type: Labeled list
#: ../Documentation/git-count-objects.txt:22
#, fuzzy, no-wrap
#| msgid "`--verbose`"
msgid "--verbose"
msgstr "`--verbose`"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:24
msgid "Provide more detailed reports:"
msgstr ""

#. type: Plain text
#: ../Documentation/git-count-objects.txt:26
msgid "count: the number of loose objects"
msgstr ""
"count: 緩いオブジェクト(loose objects;ファイルごとに１つのオブジェクトな形式)"
"の数"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:28
msgid ""
"size: disk space consumed by loose objects, in KiB (unless -H is specified)"
msgstr ""
"size: 緩いオブジェクトによって消費される、KiB単位のディスク容量(-H が指定され"
"ていない場合)"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:30
msgid "in-pack: the number of in-pack objects"
msgstr "in-pack: パック内にあるオブジェクトの数"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:32
msgid ""
"size-pack: disk space consumed by the packs, in KiB (unless -H is specified)"
msgstr ""
"size-pack: パック群によって消費される、KiB単位のディスク容量(-Hが指定されてい"
"ない場合)"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:35
msgid ""
"prune-packable: the number of loose objects that are also present in the "
"packs. These objects could be pruned using `git prune-packed`."
msgstr ""
"prune-packable: パック内にも同じものが存在する緩いオブジェクトの数。これらの"
"緩いオブジェクトは、`git prune-packed` を使用して剪定する(prune)事ができま"
"す。"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:38
#, fuzzy
#| msgid ""
#| "garbage: the number of files in object database that are neither valid "
#| "loose objects nor valid packs"
msgid ""
"garbage: the number of files in the object database that are neither valid "
"loose objects nor valid packs"
msgstr ""
"garbage: オブジェクトデータベース内の、有効な緩いオブジェクトでも有効なパック"
"でもないファイルの数"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:41
msgid ""
"size-garbage: disk space consumed by garbage files, in KiB (unless -H is "
"specified)"
msgstr ""
"size-garbage: garbageファイルによって消費されるKiB単位のディスク容量(-Hが指定"
"されていない場合)"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:46
msgid ""
"alternate: absolute path of alternate object databases; may appear multiple "
"times, one line per path. Note that if the path contains non-printable "
"characters, it may be surrounded by double-quotes and contain C-style "
"backslashed escape sequences."
msgstr ""
"alternate: 代替オブジェクトデータベース群の絶対パス。パスごとに1行ずつ、複数"
"回表示される場合があります。パスに印刷不可能な文字が含まれている場合は、二重"
"引用符で囲まれ、C言語スタイルのバックスラッシュエスケープシーケンスが含まれて"
"いる可能性があることに注意してください。"

#. type: Labeled list
#: ../Documentation/git-count-objects.txt:47
#, fuzzy, no-wrap
#| msgid "`-H`"
msgid "-H"
msgstr "`-H`"

#. type: Labeled list
#: ../Documentation/git-count-objects.txt:48
#, fuzzy, no-wrap
#| msgid "`--human-readable`"
msgid "--human-readable"
msgstr "`--human-readable`"

#. type: Plain text
#: ../Documentation/git-count-objects.txt:51
msgid "Print sizes in human readable format"
msgstr "人間に分かりやすい形式でサイズを出力する"

