msgstr ""
"Credit for finding the vulnerability goes to <reporter>, credit for fixing\n"
"it goes to <developer>.\n"

#. type: delimited block .
#: ../Documentation-sedout/howto/coordinate-embargoed-releases.txt:215
#: ../Documentation-sedout/howto/coordinate-embargoed-releases.txt:246
#, no-wrap
msgid ""
"Thanks,\n"
"<name>\n"
msgstr ""
"Thanks,\n"
"<name>\n"

#. type: Title ~
#: ../Documentation-sedout/howto/coordinate-embargoed-releases.txt:219
#, no-wrap
msgid "Example mail to oss-security@lists.openwall.com"
msgstr "oss-security@lists.openwall.com へのメール例"

#. type: delimited block .
#: ../Documentation-sedout/howto/coordinate-embargoed-releases.txt:225
#, no-wrap
msgid ""
"To: oss-security@lists.openwall.com\n"
"Cc: git-security@googlegroups.com, <other people involved in the report/fix>\n"
"Subject: git: <copy from security advisory>\n"
msgstr ""
"To: oss-security@lists.openwall.com\n"
"Cc: git-security@googlegroups.com, <other people involved in the report/fix>\n"
